# Recoder Connect — local/CI env. Worker secrets are set with
# `wrangler secret put <name>`, never read from a file in production; this
# file is only for local dev (`wrangler dev --local`) and the migration/
# product-sync Node scripts.

# Node-only (migrations, scripts/create-dodo-products.ts does NOT need this —
# it talks to Dodo directly, not Postgres). The Worker uses HYPERDRIVE instead.
RECODER_CONNECT_DATABASE_URL=postgresql://recoder_connect_runtime:password@127.0.0.1:5443/recoder_connect

BETTER_AUTH_SECRET=
SCRIBASE_MAIL_API_KEY=
SCRIBASE_MAIL_API_URL=https://api.scribase.com
SCRIBASE_MAIL_FROM="Recoder <connect@mail.recoder.xyz>"

# Owner action queued: no Dodo business exists for Recoder yet (see
# plans/recoder-connect.md). Leave these empty until it does — every code
# path here degrades truthfully (503, never a fake checkout) when they are.
RECODER_CONNECT_DODO_API_KEY=
RECODER_CONNECT_DODO_WEBHOOK_SECRET=
RECODER_CONNECT_DODO_PRODUCT_PRO_MONTHLY=
RECODER_CONNECT_DODO_PRODUCT_PRO_ANNUAL=
RECODER_CONNECT_DODO_PRODUCT_TEAM_MONTHLY=
RECODER_CONNECT_DODO_TEST_MODE=true
