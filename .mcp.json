{
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "@anthropic-ai/mcp-server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "recoder": {
      "command": "node",
      "args": [
        "/Users/arhansubasi/recoder.xyz/mcp/recoder-a2a-server.js"
      ],
      "env": {
        "RECODER_DOCKER_URL": "https://docker.recoder.xyz",
        "RECODER_API_URL": "https://api.recoder.xyz",
        "RECODER_DAYTONA_URL": "http://77.42.23.19:3900/api",
        "DAYTONA_API_KEY": "${DAYTONA_API_KEY}",
        "RECODER_API_TOKEN": "${RECODER_API_TOKEN}",
        "RECODER_SESSION_TOKEN": "${RECODER_SESSION_TOKEN}"
      }
    },
    "pal": {
      "command": "/Users/arhansubasi/recoder.xyz/py/pal-mcp-server/.pal_venv/bin/python",
      "args": [
        "server.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "CUSTOM_API_URL": "http://localhost:11434/v1"
      }
    }
  }
}
