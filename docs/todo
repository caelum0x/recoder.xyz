## `packages/oss-registry`

This prevents OSS sprawl.

```text
packages/oss-registry/src/
├── descriptor.ts
├── registry.ts
├── health.ts
├── licenses.ts
├── patch-policy.ts
└── index.ts
```

Descriptor:

```ts
type OSSComponentDescriptor = {
  id: string;
  name: string;
  kind:
    | "issue-graph"
    | "code-intelligence"
    | "planner"
    | "protocol"
    | "runtime"
    | "mcp-server"
    | "sandbox"
    | "memory"
    | "browser"
    | "network"
    | "observability"
    | "workflow"
    | "support";

  contract:
    | "TaskGraph"
    | "RepoContextProvider"
    | "PALPlanner"
    | "RuntimeAdapter"
    | "McpServer"
    | "SandboxProvider"
    | "MemoryStore"
    | "EventBus"
    | "TelemetryBackend";

  source: {
    path?: string;
    repo?: string;
    package?: string;
    image?: string;
    license?: string;
    version?: string;
    pinnedSha?: string;
  };

  healthCheck: {
    command?: string;
    endpoint?: string;
  };

  patchPolicy: "none" | "local_patch" | "vendored" | "forked";
};
```

Example `oss/manifests/oss-components.yaml`:

```yaml
components:
  - id: beads
    name: Beads
    kind: issue-graph
    contract: TaskGraph
    source:
      path: .beads
    healthCheck:
      command: pnpm beads:health
    patchPolicy: local_patch

  - id: git-nexus
    name: Git Nexus
    kind: code-intelligence
    contract: RepoContextProvider
    source:
      path: packages/git-nexus
    healthCheck:
      command: pnpm -F git-nexus health
    patchPolicy: local_patch

  - id: pal
    name: PAL
    kind: planner
    contract: PALPlanner
    source:
      path: packages/pal
    healthCheck:
      command: pnpm -F pal health
    patchPolicy: local_patch

  - id: mcp
    name: Recoder MCP
    kind: protocol
    contract: McpServer
    source:
      path: mcp
    healthCheck:
      command: pnpm mcp:smoke
    patchPolicy: local_patch

  - id: a2a
    name: Recoder A2A
    kind: protocol
    contract: RuntimeAdapter
    source:
      path: packages/a2a-sdk
    healthCheck:
      command: pnpm a2a:smoke
    patchPolicy: local_patch

  - id: claude-code
    name: Claude Code
    kind: runtime
    contract: RuntimeAdapter
    source:
      path: .claude
    healthCheck:
      command: pnpm runtime:claude:health
    patchPolicy: none

  - id: codex
    name: Codex
    kind: runtime
    contract: RuntimeAdapter
    source:
      path: mcp/recoder-codex-adapter
    healthCheck:
      command: pnpm runtime:codex:health
    patchPolicy: local_patch

  - id: playwright-mcp
    name: Playwright MCP
    kind: browser
    contract: McpServer
    source:
      path: .playwright-mcp
    healthCheck:
      command: pnpm browser:smoke
    patchPolicy: local_patch

  - id: daytona
    name: Daytona
    kind: sandbox
    contract: SandboxProvider
    source:
      path: daytona-projects
    healthCheck:
      command: pnpm sandbox:daytona:health
    patchPolicy: local_patch

  - id: openziti-zrok
    name: OpenZiti / zrok
    kind: network
    contract: NetworkProvider
    source:
      path: infra
    healthCheck:
      command: pnpm network:health
    patchPolicy: local_patch
```

