#!/usr/bin/env sh

# CRITICAL: Scan for secrets before committing
echo "🔍 Scanning for secrets..."

# Skip hook temporarily if SKIP_HOOKS is set
if [ "$SKIP_HOOKS" = "true" ]; then
    echo "⚠️  SKIP_HOOKS=true - bypassing security checks"
    exit 0
fi

SECRETS_FOUND=0

# 1. Use the strict leak scanner (high-confidence token patterns) if available.
#    This catches real API keys, DB connection strings with creds, etc.
#    It uses an allowlist to skip known-safe files.
if [ -x "scripts/scan-secrets-strict.sh" ]; then
  if ! scripts/scan-secrets-strict.sh; then
    echo "❌ ERROR: Strict secret scan failed!"
    SECRETS_FOUND=1
  fi
fi

# 2. Block .env files (except examples/templates)
if git diff --cached --name-only | grep -E "\.env$|\.env\.local$|\.env\.production$" | grep -v "\.env\.example$" | grep -v "\.env\..*\.template$"; then
  echo "❌ ERROR: .env file detected in staged files!"
  echo "Never commit .env files. Use .env.example instead."
  SECRETS_FOUND=1
fi

# 3. Block SSH keys and PEM files
if git diff --cached --name-only | grep -E "\.(pem|key|pub)$|id_rsa|id_dsa|id_ecdsa|id_ed25519|private-key"; then
  echo "❌ ERROR: SSH key or private key detected in staged files!"
  echo "Never commit SSH keys or private keys."
  SECRETS_FOUND=1
fi

if [ $SECRETS_FOUND -eq 1 ]; then
  echo ""
  echo "🚨 COMMIT BLOCKED: Secrets detected!"
  echo "To fix:"
  echo "  1. Remove secrets from files"
  echo "  2. Add files to .gitignore"
  echo "  3. Use environment variables"
  exit 1
fi

echo "✅ No secrets detected - commit allowed"
