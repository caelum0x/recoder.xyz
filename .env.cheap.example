# Recoder LEAN single-box stack — environment template.
#
# Copy to `.env.cheap` and fill the REQUIRED values, then:
#   docker compose --env-file .env.cheap -f docker-compose.cheap.yml up -d --build
#
# `deploy/redeploy.sh` auto-generates the [auto] secrets below if left empty.
# NEVER commit a filled-in .env.cheap. NO REAL SECRETS belong in this file.

# ============================================================================
# REQUIRED — the stack will not start without these.
# ============================================================================

# Postgres superuser the whole stack runs as. Owns recoder_main /
# recoder_backend / recoder_pm. Choose a strong password (NOT auto-generated so
# you keep control of the credential that owns your data).
POSTGRES_USER=recoder
POSTGRES_PASSWORD=

# Shared key for worker->backend /internal/* calls. [auto] 64-hex if empty.
INTERNAL_SERVICE_KEY=

# Governance audit signing key (tamper-evident audit chain). [auto] 64-hex.
RECODER_GOVERNANCE_SIGNING_KEY=

# Better Auth server secret (session/JWT signing). [auto] 64-hex.
BETTER_AUTH_SECRET=

# ============================================================================
# TLS / DNS — for Caddy auto-HTTPS
# ============================================================================

# Public hostnames. Point their DNS A/AAAA records at the box's IP. Caddy
# provisions Let's Encrypt certs for them automatically on first request.
RECODER_APP_DOMAIN=recoder.xyz
RECODER_AGENTS_DOMAIN=agents.recoder.xyz

# Let's Encrypt account email (expiry notices). Optional but recommended.
ACME_EMAIL=

# Set to "off" ONLY for local HTTP testing without DNS. Leave "on" in prod.
CADDY_AUTO_HTTPS=on

# ============================================================================
# OPTIONAL — features degrade safely (truthful health) when unset.
# ============================================================================

# --- Billing (Polar) — missing keys disable billing, report unavailable ---
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production

# --- Model providers (BYOK) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
