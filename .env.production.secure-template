# Recoder.xyz Production Environment Configuration
# SECURITY: Copy this to .env.production and fill with REAL values
# NEVER commit the actual .env.production file to git!

# ==========================================
# CORE APPLICATION SETTINGS
# ==========================================
NODE_ENV=production
PRODUCTION_ENGINE_URL=https://engine.recoder.xyz
BACKEND_URL=https://api.recoder.xyz

# ==========================================
# DOMAIN CONFIGURATION
# ==========================================
MAIN_DOMAIN=https://recoder.xyz
API_DOMAIN=https://api.recoder.xyz
ENGINE_DOMAIN=https://engine.recoder.xyz
WEB_DOMAIN=https://app.recoder.xyz
CHAT_DOMAIN=https://chat.recoder.xyz

# Next Auth URLs for production
NEXTAUTH_URL=https://app.recoder.xyz
NEXTAUTH_URL_CHAT=https://chat.recoder.xyz
NEXT_PUBLIC_RETURN_URL=https://app.recoder.xyz/subscription/success
NEXT_PUBLIC_CANCEL_URL=https://app.recoder.xyz/pricing

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Generate new credentials from your database provider
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
POSTGRES_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Redis - use strong password
REDIS_URL=redis://:YOUR_STRONG_REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD

# ==========================================
# JWT & AUTHENTICATION
# Generate new secrets with: openssl rand -hex 32
# ==========================================
NEXTAUTH_SECRET="GENERATE_NEW_64_CHAR_HEX_SECRET"
AUTH_SECRET="GENERATE_NEW_64_CHAR_HEX_SECRET"
UNIFIED_AUTH_SECRET="GENERATE_NEW_64_CHAR_HEX_SECRET"
JWT_SECRET="GENERATE_NEW_64_CHAR_HEX_SECRET"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# OAUTH PROVIDERS
# Regenerate from Google Cloud Console and GitHub Developer Settings
# ==========================================
# Google OAuth
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# GitHub OAuth
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"

# ==========================================
# AI PROVIDER API KEYS
# Regenerate from each provider's dashboard
# ==========================================
# OpenRouter (Primary AI Provider)
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# Anthropic Claude
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# OpenAI
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Groq
GROQ_API_KEY="YOUR_GROQ_API_KEY"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Google AI
GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY"
GOOGLE_AI_API_KEY="YOUR_GOOGLE_AI_API_KEY"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Additional AI Providers
MISTRAL_API_KEY="YOUR_MISTRAL_API_KEY"
TOGETHER_API_KEY="YOUR_TOGETHER_API_KEY"
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
XAI_API_KEY="YOUR_XAI_API_KEY"
FIREWORKS_API_KEY="YOUR_FIREWORKS_API_KEY"
CEREBRAS_API_KEY="YOUR_CEREBRAS_API_KEY"

# ==========================================
# PAYMENT PROCESSING
# Regenerate from payment provider dashboard
# ==========================================
DODO_PAYMENTS_API_KEY="YOUR_DODO_API_KEY"
DODO_API_BASE_URL="https://api.dodopayments.com"
DODO_WEBHOOK_SECRET="YOUR_DODO_WEBHOOK_SECRET"

# ==========================================
# MONITORING & ANALYTICS
# ==========================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=YOUR_STRONG_GRAFANA_PASSWORD

# ==========================================
# SECURITY SETTINGS
# ==========================================
# CORS Origins (comma-separated)
CORS_ORIGINS=https://recoder.xyz,https://app.recoder.xyz,https://chat.recoder.xyz,https://api.recoder.xyz,https://engine.recoder.xyz

# Encryption key - Generate with: openssl rand -hex 32
ENCRYPTION_KEY="GENERATE_NEW_64_CHAR_HEX_STRING"

# Internal service key for backend-to-backend auth
INTERNAL_SERVICE_KEY="GENERATE_NEW_64_CHAR_HEX_STRING"

# App API URL for docker-backend to verify sessions
APP_API_URL="https://app.recoder.xyz"

# ==========================================
# FEATURE FLAGS
# ==========================================
ENABLE_REGISTRATION=true
ENABLE_AI_FEATURES=true
ENABLE_PREMIUM_FEATURES=true
ENABLE_ANALYTICS=true

# ==========================================
# DEPLOYMENT INFO
# ==========================================
DEPLOYMENT_ENV=production
BUILD_VERSION=1.0.0
