# Recoder.xyz Domain Production Environment
# For deployment to recoder.xyz with HTTPS SSL

#====================================
# Domain Configuration
#====================================
WEB_URL=https://recoder.xyz
CHAT_URL=https://chat.recoder.xyz
API_URL=https://api.recoder.xyz
ENGINE_URL=https://engine.recoder.xyz

# Next.js Public URLs
NEXT_PUBLIC_WEB_URL=https://recoder.xyz
NEXT_PUBLIC_CHAT_URL=https://chat.recoder.xyz
NEXT_PUBLIC_API_URL=https://api.recoder.xyz
NEXT_PUBLIC_ENGINE_URL=https://engine.recoder.xyz

#====================================
# Database Configuration
#====================================
DB_USER=recoder
DB_PASSWORD=prod_secure_db_pass_2024_recoder_xyz_enterprise
DATABASE_URL=postgresql://recoder:prod_secure_db_pass_2024_recoder_xyz_enterprise@postgres:5432/recoder_production

#====================================
# Redis Configuration
#====================================
REDIS_PASSWORD=prod_secure_redis_pass_2024_recoder_xyz_cache
REDIS_URL=redis://:prod_secure_redis_pass_2024_recoder_xyz_cache@redis:6379

#====================================
# Security & Authentication
#====================================
JWT_SECRET=prod_jwt_secret_2024_recoder_xyz_secure_token_32_chars_minimum_enterprise_grade
NEXTAUTH_SECRET=prod_nextauth_secret_2024_recoder_xyz_auth_32_chars_minimum_enterprise_grade
AUTH_SECRET=prod_auth_secret_2024_recoder_xyz_chat_32_chars_minimum_enterprise_grade

# NextAuth URLs
NEXTAUTH_URL=https://recoder.xyz
NEXTAUTH_URL_CHAT=https://chat.recoder.xyz

#====================================
# SSL/TLS Configuration
#====================================
ACME_EMAIL=admin@recoder.xyz

#====================================
# AI API Keys (Production - UPDATE WITH YOUR KEYS)
#====================================
# Anthropic Claude (Primary)
ANTHROPIC_API_KEY=sk-ant-your_production_anthropic_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Groq (Fast Inference)
GROQ_API_KEY=gsk_your_production_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini
GOOGLE_API_KEY=your_production_google_key_here

# OpenAI (Backup)
OPENAI_API_KEY=sk-your_production_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek (Cost-effective)
DEEPSEEK_API_KEY=sk-your_production_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Mistral AI
MISTRAL_API_KEY=your_production_mistral_key_here

# Together AI
TOGETHER_API_KEY=your_production_together_key_here

# OpenRouter (Multi-model)
OPENROUTER_API_KEY=sk-or-your_production_openrouter_key_here

# X.AI Grok
XAI_API_KEY=your_production_xai_key_here

# Fireworks AI
FIREWORKS_API_KEY=your_production_fireworks_key_here

# Cerebras
CEREBRAS_API_KEY=your_production_cerebras_key_here

#====================================
# Local AI Configuration
#====================================
OLLAMA_BASE_URL=https://ollama.recoder.xyz
LM_STUDIO_BASE_URL=http://lm-studio:1234

#====================================
# Monitoring & Analytics
#====================================
GRAFANA_PASSWORD=prod_grafana_admin_2024_recoder_xyz_monitoring

#====================================
# Feature Flags
#====================================
FEATURE_REASONING_ENGINE=true
FEATURE_BLOCKCHAIN_AGENT=true
FEATURE_MOBILE_AGENT=true
FEATURE_DEPLOYMENT_PIPELINE=true

#====================================
# Rate Limiting & Usage
#====================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
PREMIUM_TOKEN_LIMIT=400000
PREMIUM_REQUEST_LIMIT=5000
PRO_TOKEN_LIMIT=2000000
PRO_REQUEST_LIMIT=25000

#====================================
# Security & Compliance
#====================================
SECURITY_SCAN_ENABLED=true
VULNERABILITY_CHECK_ENABLED=true
ANALYTICS_ENABLED=true
TELEMETRY_ENDPOINT=https://api.recoder.xyz/telemetry

#====================================
# Deployment Configuration
#====================================
NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=production
DOCKER_REGISTRY=registry.hub.docker.com
KUBERNETES_NAMESPACE=recoder

# Health check endpoints
HEALTH_CHECK_ENABLED=true
METRICS_ENDPOINT=/api/metrics
STATUS_ENDPOINT=/api/health

#====================================
# Launch Status
#====================================
LAUNCH_READY=true
WEB_PLATFORM_READY=true
CHAT_PLATFORM_READY=true
DATABASE_READY=true
AUTH_READY=true
PAYMENTS_READY=true
AI_PROVIDERS_READY=true
SECURITY_READY=true
MONITORING_READY=true

#====================================
# Payment Processing (Production)
#====================================
# Replace with production Stripe keys
STRIPE_SECRET_KEY=sk_live_your_production_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_production_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_production_stripe_webhook_secret_here

# DODO Payments (Primary Payment Processor)
DODO_PAYMENTS_API_KEY=your_production_dodo_payments_key_here
DODO_API_BASE_URL=https://live.dodopayments.com
DODO_WEBHOOK_SECRET=recoder-production-webhook-secret-2024

# Payment URLs
NEXT_PUBLIC_RETURN_URL=https://recoder.xyz/subscription/success
NEXT_PUBLIC_CANCEL_URL=https://recoder.xyz/pricing

# Subscription Plans
NEXT_PUBLIC_WEEKLY_PLAN_PRICE=10
NEXT_PUBLIC_MONTHLY_PLAN_PRICE=20  
NEXT_PUBLIC_ENTERPRISE_PLAN_PRICE=100