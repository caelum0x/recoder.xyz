# Server auth - required unless OPS_RECORDER_AUTH_DISABLED=true for local-only testing
OPS_RECORDER_API_KEY=replace_with_a_random_32_plus_char_value

# GitHub
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO=owner/repo

# Linear
LINEAR_API_KEY=your_linear_api_key
LINEAR_TEAM_ID=your_linear_team_uuid

# Detection thresholds
STALE_PR_DAYS=5
STALE_ISSUE_DAYS=7
LINEAR_NO_PR_DAYS=3

# Persistence (optional). When set, detected signals are stored durably in
# Postgres (recoder_backend) instead of in-process memory. First match wins:
#   WORK_SIGNALS_DATABASE_URL  ->  RECODER_BACKEND_DATABASE_URL  ->  DATABASE_URL
# If none are set the service runs with the in-memory store (no persistence
# across restarts) and logs a warning.
# WORK_SIGNALS_DATABASE_URL=postgresql://recoder:password@127.0.0.1:5432/recoder_backend

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
