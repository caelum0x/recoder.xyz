# Recoder.xyz Production Environment Configuration
# Copy this file and update with your production values

# Database Configuration
DATABASE_URL=postgresql://recoder:secure_password@localhost:5432/recoder_production
DB_USER=recoder
DB_PASSWORD=secure_password
DB_NAME=recoder_production

# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_a_secure_random_string
NEXTAUTH_URL=https://recoder.xyz

# AI Provider API Keys (Add your keys here)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# OAuth Provider Configuration
GITHUB_ID=your_github_oauth_app_id
GITHUB_SECRET=your_github_oauth_app_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
DISCORD_CLIENT_ID=your_discord_oauth_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret

# Backend Service Configuration
RECODER_BACKEND_URL=https://api.recoder.xyz
CLI_ROUTER_ENDPOINT=http://localhost:3456/api/router/select

# Domain Configuration
WEB_DOMAIN=recoder.xyz
API_DOMAIN=api.recoder.xyz
CHAT_DOMAIN=chat.recoder.xyz

# Security Configuration
JWT_SECRET=your_jwt_secret_for_api_keys
SESSION_SYNC_SECRET=your_session_sync_secret

# Deployment Configuration
PUSH_IMAGES=false
USE_REGISTRY=false

# Monitoring Configuration
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# Analytics Configuration
PLAUSIBLE_DOMAIN=recoder.xyz

# File Upload Configuration
S3_BUCKET=recoder-uploads
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Development flags
NODE_ENV=production
DEBUG_MODE=false