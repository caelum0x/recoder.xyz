# ---------------------------------------------------------------------------
# Recoder marketing site (site/) — public environment template
#
# These NEXT_PUBLIC_* values are inlined at BUILD time (`next build`). To flip
# the /download page from the "Get early access" waitlist to a real, signed
# download you must set them BEFORE building the site, then redeploy:
#
#   cp site/.env.example site/.env.production   # (or .env.local for a dev build)
#   # fill the values below, then:
#   pnpm --filter ./site build && pnpm --filter ./site start
#
# All values are read by site/lib/releases.ts. Every URL is validated (http(s)
# only) and every checksum must be 64 hex chars, so a blank or malformed value
# fails safe: the page simply stays in waitlist mode. Nothing here is a secret —
# these ship to the browser by design. Leave a line blank to keep it unset.
# ---------------------------------------------------------------------------

# Flip the public Download CTA on. MUST be exactly "public" (case-insensitive)
# for real download cards to render. Any other value (or unset) keeps the site
# in invite-only private-beta mode even when artifact URLs below are set — so
# beta testers can be handed a direct URL out-of-band without lighting up the
# public page. Set this to "public" only when a broad launch is intended.
NEXT_PUBLIC_RELEASE_VISIBILITY=

# Direct macOS (Apple Silicon / arm64) artifact URL — the signed + notarized
# .dmg. This is what makes the macOS "Download" card resolve. The published,
# versioned artifact lives where scripts/publish-desktop-release-local.sh
# assembled + the owner uploaded it (default host: dl.recoder.xyz/releases).
# Example shape (fill with the REAL published version/host — do not guess):
#   NEXT_PUBLIC_DOWNLOAD_MACOS_URL=https://dl.recoder.xyz/releases/Recoder-<version>-arm64.dmg
NEXT_PUBLIC_DOWNLOAD_MACOS_URL=

# SHA-256 (64 hex chars) of the macOS .dmg above. When set, the card shows a
# "Verify checksum" affordance so users can prove integrity before installing.
# Take this straight from the SHA256SUMS file emitted by the publish script:
#   grep '\.dmg$' dist/desktop-release/SHA256SUMS | awk '{print $1}'
NEXT_PUBLIC_DOWNLOAD_MACOS_SHA256=

# Human-readable version label shown on the download card (display only), e.g.
#   NEXT_PUBLIC_RELEASE_VERSION=v0.16.1
NEXT_PUBLIC_RELEASE_VERSION=

# Optional fallback: the GitHub releases *page* (…/releases). If set, the macOS
# card can point here when NEXT_PUBLIC_DOWNLOAD_MACOS_URL is not set. It never
# lights up Windows/Linux cards (see below).
NEXT_PUBLIC_GITHUB_RELEASES_URL=

# Windows / Linux: SEAMS ONLY — leave unset. No such build exists today (the
# embedded engine binaries are arm64-darwin only), and site/lib/releases.ts
# deliberately does NOT let these inherit the releases-page fallback, so a card
# only appears once its OWN direct artifact URL is a real, hosted build. Fill
# these in the day a signed Windows/Linux artifact is actually published.
NEXT_PUBLIC_DOWNLOAD_WINDOWS_URL=
NEXT_PUBLIC_DOWNLOAD_WINDOWS_SHA256=
NEXT_PUBLIC_DOWNLOAD_LINUX_URL=
NEXT_PUBLIC_DOWNLOAD_LINUX_SHA256=
