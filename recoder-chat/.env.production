#################################################################################
# 🌐 PLATFORM URLS & PORTS
#################################################################################
# Production URLs (change for deployment)
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_CHAT_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_ENGINE_URL="http://localhost:8001"

# Development ports
WEB_PLATFORM_PORT="3000"
CHAT_PLATFORM_PORT="3001"
BACKEND_API_PORT="8000"
PRODUCTION_ENGINE_PORT="8001"

#################################################################################
# 🔧 DEVELOPMENT & BUILD CONFIGURATION
#################################################################################
NODE_ENV="production"
SKIP_ENV_VALIDATION="false"
BUILD_ANALYZE="false"
LOG_LEVEL="info"

# Feature flags
FEATURE_REASONING_ENGINE="true"
FEATURE_BLOCKCHAIN_AGENT="true"
FEATURE_MOBILE_AGENT="true"
FEATURE_DEPLOYMENT_PIPELINE="true"

#################################################################################
# 📱 VS CODE EXTENSION CONFIGURATION
#################################################################################
EXTENSION_API_BASE_URL="http://localhost:8000"
EXTENSION_AUTH_PROVIDER="unified"
EXTENSION_TELEMETRY_ENABLED="false"

#################################################################################
# 🚀 DEPLOYMENT CONFIGURATION
#################################################################################
DOCKER_REGISTRY="registry.hub.docker.com"
KUBERNETES_NAMESPACE="recoder"
DEPLOYMENT_ENVIRONMENT="production"

# Health check endpoints
HEALTH_CHECK_ENABLED="true"
METRICS_ENDPOINT="/api/metrics"
STATUS_ENDPOINT="/api/health"

#################################################################################
# 📊 USAGE & BILLING
#################################################################################
USAGE_TRACKING_ENABLED="true"
COST_MONITORING_ENABLED="true"
BILLING_CYCLE="monthly"
FREE_TIER_REQUESTS="1000"

#################################################################################
# 🎯 LAUNCH VERIFICATION
#################################################################################
# Set to "true" when all API keys are configured
LAUNCH_READY="false"

# Checklist (set each to "true" when verified)
WEB_PLATFORM_READY="false"
CHAT_PLATFORM_READY="false"
DATABASE_READY="true"
AUTH_READY="false"
PAYMENTS_READY="false"
AI_PROVIDERS_READY="false"
SECURITY_READY="false"
MONITORING_READY="false"

#################################################################################
# 🏁 QUICK LAUNCH INSTRUCTIONS
#################################################################################
# 1. Add your AI provider API keys above (at minimum: ANTHROPIC_API_KEY, GROQ_API_KEY)
# 2. Set LAUNCH_READY="true"
# 3. Run: pnpm install && pnpm build
# 4. Start platforms:
#    - Web Platform: cd recoder-web && pnpm dev (port 3000)
#    - Chat Platform: cd recoder-chat && pnpm dev (port 3001)
#    - Backend API: cd backend && pnpm start (port 8000)
#    - Production Engine: cd production-engine && pnpm start (port 8001)
# 5. Visit http://localhost:3000 for Web Platform
# 6. Visit http://localhost:3001 for Chat Platform
# 7. Test with: pnpm test
#################################################################################