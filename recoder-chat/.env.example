# Recoder Chat Platform Environment Variables  
# Copy to .env.local for development or set in Vercel dashboard for production

# Unified Authentication (Shared with all Recoder products)
NEXTAUTH_URL=https://chat.recoder.xyz
NEXTAUTH_SECRET=your-nextauth-secret-key-minimum-32-characters

# Unified Database (Same as main platform)
DATABASE_URL=postgresql://username:password@host:port/recoder_unified

# OAuth Providers (Same as main platform)
GITHUB_ID=your-github-oauth-app-id
GITHUB_SECRET=your-github-oauth-app-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
DISCORD_CLIENT_ID=your-discord-oauth-client-id
DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret

# Cross-domain Session Sync
SESSION_SYNC_SECRET=your-session-sync-secret-key-32-chars
API_ENCRYPTION_KEY=your-api-encryption-key-32-bytes-hex

# AI Provider API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key
GROQ_API_KEY=your-groq-api-key
GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-api-key
XAI_API_KEY=your-xai-api-key

# Environment
NODE_ENV=development
PORT=3001

# Domain Configuration
CHAT_DOMAIN=chat.recoder.xyz
MAIN_DOMAIN=recoder.xyz
WEB_DOMAIN=web.recoder.xyz

# Chat Platform Features
MAX_MESSAGE_LENGTH=4000
MAX_CONVERSATIONS=100
MAX_FILES_PER_MESSAGE=5
MAX_FILE_SIZE=5242880  # 5MB

# Optional: Analytics and Monitoring
VERCEL_ANALYTICS_ID=your-vercel-analytics-id
SENTRY_DSN=your-sentry-dsn

# Optional: File Storage for Chat
VERCEL_BLOB_READ_WRITE_TOKEN=your-vercel-blob-token