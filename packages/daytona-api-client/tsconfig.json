{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "lib": ["ES2021", "dom"],
    "declaration": true, "outDir": "./dist", "rootDir": "./src",
    "strict": false, "moduleResolution": "node", "esModuleInterop": true,
    "skipLibCheck": true, "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true, "isolatedModules": true, "types": ["node"]
  },
  "include": ["src/**/*"], "exclude": ["node_modules", "dist"]
}
