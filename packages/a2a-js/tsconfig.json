{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022","dom"],
    "declaration": true, "outDir": "./dist", "rootDir": "./src",
    "strict": false, "moduleResolution": "bundler", "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "isolatedModules": true, "types": ["node"]
  },
  "include": ["src/**/*"], "exclude": ["node_modules","dist","src/server/grpc","src/client/transports/grpc","src/grpc","src/samples"]
}
