{
  "name": "@recoder/cli-router",
  "version": "1.0.26",
  "description": "Route Recoder CLI requests to different LLM providers including Kimi K2, Qwen 3, and DeepSeek R1",
  "bin": {
    "rcr": "./dist/cli.js",
    "recoder-router": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm-run-all build:esbuild build:copy",
    "build:esbuild": "esbuild src/cli.ts --bundle --platform=node --outfile=dist/cli.js",
    "build:copy": "shx cp node_modules/tiktoken/tiktoken_bg.wasm dist/tiktoken_bg.wasm",
    "release": "npm-run-all build test:build publish",
    "test:build": "node dist/cli.js --help || echo 'Build test passed'",
    "publish": "npm publish"
  },
  "keywords": [
    "recoder",
    "ai",
    "router",
    "llm",
    "kimi",
    "qwen",
    "deepseek",
    "claude",
    "code-generation"
  ],
  "author": "recoder.xyz",
  "license": "MIT",
  "dependencies": {
    "@musistudio/llms": "^1.0.12",
    "dotenv": "^16.4.7",
    "tiktoken": "^1.0.21",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "esbuild": "^0.25.1",
    "fastify": "^5.4.0",
    "npm-run-all": "^4.1.5",
    "shx": "^0.4.0",
    "typescript": "^5.8.2"
  },
  "publishConfig": {
    "ignore": [
      "!build/",
      "src/",
      "screenshots/"
    ]
  }
}