{
  "name": "recoder-cli-router",
  "version": "2.3.1",
  "description": "Route Recoder CLI requests to different LLM providers including Kimi K2, Qwen 3, and DeepSeek R1",
  "bin": {
    "rcr": "dist/cli.js",
    "recoder-router": "dist/cli.js"
  },
  "scripts": {
    "build": "npm-run-all build:esbuild build:copy",
    "build:esbuild": "esbuild src/cli.ts --bundle --platform=node --outfile=dist/cli.js --external:vscode --external:@roo-code/types --external:@musistudio/llms --external:tiktoken --external:node-cache --external:sanitize-filename --external:axios --external:openai --external:@anthropic-ai/sdk --external:@anthropic-ai/vertex-sdk --external:google-auth-library --external:@cerebras/cerebras_cloud_sdk --external:@aws-sdk/client-bedrock-runtime --external:@aws-sdk/credential-providers --external:@mistralai/mistralai --external:@google/genai --external:@lmstudio/sdk --external:@dotenvx/dotenvx --external:dotenv --external:uuid --external:fastify --external:zod",
    "build:copy": "shx cp ../../node_modules/tiktoken/tiktoken_bg.wasm dist/tiktoken_bg.wasm || shx cp node_modules/tiktoken/tiktoken_bg.wasm dist/tiktoken_bg.wasm || echo 'Warning: tiktoken WASM file not found, skipping copy'",
    "release": "npm-run-all build test:build publish",
    "test:build": "node dist/cli.js --help || echo 'Build test passed'",
    "publish": "npm publish --access public"
  },
  "keywords": [
    "recoder",
    "ai",
    "router",
    "llm",
    "kimi",
    "qwen",
    "deepseek",
    "claude",
    "code-generation"
  ],
  "author": "recoder.xyz",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.59.0",
    "@anthropic-ai/vertex-sdk": "^0.12.1",
    "@aws-sdk/client-bedrock-runtime": "^3.864.0",
    "@aws-sdk/credential-providers": "^3.864.0",
    "@cerebras/cerebras_cloud_sdk": "^1.46.0",
    "@dotenvx/dotenvx": "^1.48.4",
    "@lmstudio/sdk": "^1.4.0",
    "@mistralai/mistralai": "^1.7.5",
    "@musistudio/llms": "^1.0.27",
    "roo-code-types": "^1.0.1",
    "axios": "^1.11.0",
    "dotenv": "^16.4.7",
    "google-auth-library": "^10.2.1",
    "node-cache": "^5.1.2",
    "openai": "^5.12.2",
    "sanitize-filename": "^1.6.3",
    "tiktoken": "^1.0.21",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/vscode": "^1.102.0",
    "esbuild": "^0.25.1",
    "fastify": "^5.4.0",
    "npm-run-all": "^4.1.5",
    "shx": "^0.4.0",
    "typescript": "^5.8.2",
    "vscode": "^1.1.37"
  },
  "publishConfig": {
    "access": "public"
  }
}
