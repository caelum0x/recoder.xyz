# ==============================================
# RECODER CLI ROUTER - Environment Configuration
# ==============================================
# Copy this to .env and configure based on your setup
# 
# 🔄 CLI-TO-WEB BRIDGE: Routes CLI requests to web interface
# 🌐 LOCAL-FIRST: Works offline with local backend

#====================================
# 🏗️ ROUTER CONFIGURATION
#====================================

# Server Settings
NODE_ENV=development
PORT=8080
SERVICE_NAME=recoder-cli-router

# Router Configuration
ROUTER_VERSION=1.0.0
MAX_CONNECTIONS=100
CONNECTION_TIMEOUT=30000

#====================================
# 🔄 SERVICE CONNECTIONS
#====================================

# Backend API Connection
BACKEND_API_URL=http://localhost:3001
BACKEND_TIMEOUT=10000

# Web Interface Connection
WEB_URL=http://localhost:3000
WEB_FALLBACK_URL=http://localhost:3000

# Production Engine Connection (optional)
PRODUCTION_ENGINE_URL=http://localhost:3002

# CLI Client Configuration
CLI_CLIENT_TIMEOUT=5000
MAX_CLI_CLIENTS=50

#====================================
# 🔐 AUTHENTICATION & SECURITY
#====================================

# Router Authentication
ROUTER_AUTH_SECRET=your-router-auth-secret-key-here
CLI_AUTH_TOKEN=your-cli-auth-token-here

# Session Configuration
SESSION_SECRET=your-session-secret-key-here
SESSION_TIMEOUT_MINUTES=30

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1

#====================================
# 🚀 PERFORMANCE & CACHING
#====================================

# Caching Configuration
ENABLE_CACHE=true
CACHE_TTL_SECONDS=300
MAX_CACHE_SIZE_MB=50

# Connection Pooling
POOL_MIN_CONNECTIONS=2
POOL_MAX_CONNECTIONS=10
POOL_IDLE_TIMEOUT=30000

# Request Optimization
ENABLE_REQUEST_COMPRESSION=true
MAX_REQUEST_SIZE_MB=10

#====================================
# 📊 MONITORING & LOGGING
#====================================

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs/router.log

# Health Monitoring
HEALTH_CHECK_INTERVAL=30000
ENABLE_HEALTH_ENDPOINT=true

# Metrics Collection
ENABLE_METRICS=true
METRICS_PORT=9091
METRICS_PATH=/metrics

#====================================
# 🔄 ROUTING CONFIGURATION
#====================================

# Route Patterns
DEFAULT_ROUTE=/
API_ROUTE_PREFIX=/api
HEALTH_ROUTE=/health
STATUS_ROUTE=/status

# Route Timeouts
ROUTE_TIMEOUT_SECONDS=30
LONG_POLL_TIMEOUT_SECONDS=60
STREAMING_TIMEOUT_SECONDS=300

# Route Priorities (1-10, 10 = highest)
CLI_ROUTE_PRIORITY=10
WEB_ROUTE_PRIORITY=5
API_ROUTE_PRIORITY=8

#====================================
# 🌐 WEB INTEGRATION
#====================================

# Browser Integration
AUTO_OPEN_BROWSER=true
DEFAULT_BROWSER=default
BROWSER_WINDOW_SIZE=1200x800

# URL Handling
ENABLE_URL_REWRITING=true
BASE_PATH=/cli
STATIC_FILES_PATH=./public

#====================================
# 🔧 CLI INTEGRATION
#====================================

# CLI Command Routing
ENABLE_CLI_COMMANDS=true
CLI_COMMAND_PREFIX=recoder
MAX_COMMAND_ARGS=20

# CLI Response Formatting
CLI_OUTPUT_FORMAT=json
ENABLE_COLORED_OUTPUT=true
MAX_OUTPUT_LENGTH=10000

#====================================
# 📡 WEBSOCKET CONFIGURATION
#====================================

# WebSocket Settings
ENABLE_WEBSOCKETS=true
WEBSOCKET_PORT=8081
WEBSOCKET_PATH=/ws

# Real-time Features
ENABLE_LIVE_UPDATES=true
UPDATE_INTERVAL_MS=1000
MAX_WEBSOCKET_CONNECTIONS=100

#====================================
# 🛡️ SECURITY SETTINGS
#====================================

# Security Headers
ENABLE_SECURITY_HEADERS=true
CSP_POLICY=default-src 'self'

# Rate Limiting
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=100
RATE_LIMIT_WINDOW_MS=60000

# Request Validation
VALIDATE_REQUEST_ORIGIN=true
ALLOWED_USER_AGENTS=recoder-cli/*

#====================================
# 🔄 PROXY CONFIGURATION
#====================================

# Reverse Proxy Settings
ENABLE_PROXY=true
PROXY_TIMEOUT=30000
PROXY_RETRY_ATTEMPTS=3

# Load Balancing (for multiple backends)
ENABLE_LOAD_BALANCING=false
BACKEND_SERVERS=http://localhost:3001
LOAD_BALANCE_STRATEGY=round-robin

#====================================
# 📁 FILE HANDLING
#====================================

# File Upload/Download
ENABLE_FILE_UPLOADS=true
MAX_FILE_SIZE_MB=100
UPLOAD_DIRECTORY=./uploads
TEMP_DIRECTORY=./temp

# Static File Serving
SERVE_STATIC_FILES=true
STATIC_CACHE_TTL=3600
ENABLE_GZIP=true

#====================================
# 🐳 CONTAINER CONFIGURATION
#====================================

# Docker Integration (if running in container)
CONTAINER_MODE=false
DOCKER_SOCKET=/var/run/docker.sock

# Health Check for Containers
CONTAINER_HEALTH_CMD=curl -f http://localhost:8080/health
CONTAINER_HEALTH_INTERVAL=30s

#====================================
# 🔧 DEVELOPMENT SETTINGS
#====================================

# Development Features
ENABLE_DEV_FEATURES=true
ENABLE_DEBUG_ROUTES=true
ENABLE_HOT_RELOAD=true

# Testing Configuration
ENABLE_TEST_ROUTES=true
MOCK_BACKEND_RESPONSES=false
TEST_DATA_PATH=./test-data

#====================================
# 🏭 PRODUCTION OPTIMIZATIONS
#====================================

# Production Settings (uncomment for production)
# NODE_ENV=production
# ENABLE_REQUEST_LOGGING=false
# COMPRESS_RESPONSES=true
# CACHE_STATIC_ASSETS=true

# SSL/TLS Configuration (for HTTPS)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
# FORCE_HTTPS=true

# Process Management
# PM2_INSTANCES=max
# PM2_MAX_MEMORY_RESTART=1000M

#====================================
# 🔗 EXTERNAL INTEGRATIONS
#====================================

# GitHub Integration (for repository routing)
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
ENABLE_GITHUB_INTEGRATION=false

# Slack Integration (for notifications)
SLACK_WEBHOOK_URL=your-slack-webhook-url
ENABLE_SLACK_NOTIFICATIONS=false

#====================================
# 💡 QUICK START GUIDE
#====================================
# 
# Local Development:
# 1. Start backend: cd ../../backend && npm run dev
# 2. Start web: cd ../../recoder-web && npm run dev  
# 3. Install dependencies: npm install
# 4. Start router: npm run dev
# 5. Test: curl http://localhost:8080/health
# 
# ✅ Router bridges CLI commands to web interface!
# 
# 🔄 How it works:
#   - CLI sends requests to router (port 8080)
#   - Router forwards to backend (port 3001)
#   - Router serves web UI when needed (port 3000)
#   - Real-time updates via WebSocket