# ==============================================
# CLI ROUTER - Configuration Example
# ==============================================
# Copy this to .env if you need custom configuration

#====================================
# 🏗️ ROUTER CONFIGURATION
#====================================

# Server Settings
NODE_ENV=development
PORT=8080
SERVICE_NAME=cli-router

# Router Configuration
ROUTER_VERSION=2.0.0
MAX_CONNECTIONS=100
REQUEST_TIMEOUT=30000

# API Configuration (configure your preferred backend)
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Gemini CLI OAuth (required only for Gemini CLI provider flow)
GEMINI_CLI_OAUTH_CLIENT_SECRET=replace-with-gemini-cli-oauth-client-secret

# Logging
LOG_LEVEL=info

#====================================
# ⚡ DAYTONA SANDBOX EXECUTION
#====================================
# Daytona provides isolated sandbox containers for code execution
RECODER_DAYTONA_URL=http://localhost:3900/api
DAYTONA_API_KEY=your-daytona-api-key

#====================================
# 🔗 A2A (AGENT-TO-AGENT) BRIDGE
#====================================
# Connect to the Recoder A2A platform for multi-agent delegation
RECODER_API_URL=https://api.recoder.xyz
RECODER_API_TOKEN=your-recoder-api-token
RECODER_DOCKER_URL=https://docker.recoder.xyz

#====================================
# 🔧 CUSTOMIZATION
#====================================
# Configure routing rules and providers in your config.json file
# See config.example.json for reference
