# ==============================================
# RECODER CLI ROUTER - Configuration Example
# ==============================================
# Copy this to .env if you need custom configuration
# 
# 🔄 CLI REQUEST ROUTER: Routes CLI requests to recoder.xyz backend
# 🌐 AUTHENTICATION: Uses recoder.xyz account (like Claude Code)
# 🔑 NO API KEYS NEEDED: Users authenticate with recoder.xyz

#====================================
# 🏗️ ROUTER CONFIGURATION
#====================================

# Server Settings
NODE_ENV=development
PORT=8080
SERVICE_NAME=recoder-cli-router

# Router Configuration
ROUTER_VERSION=2.0.0
MAX_CONNECTIONS=100
REQUEST_TIMEOUT=30000

# Recoder.xyz Backend Integration
RECODER_API_URL=https://api.recoder.xyz
RECODER_WEB_URL=https://recoder.xyz

# Local Development (optional)
# RECODER_API_URL=http://localhost:3001
# RECODER_WEB_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

#====================================
# 🚀 USER EXPERIENCE
#====================================
# Users will authenticate via:
# 1. `recoder auth login` - opens recoder.xyz auth page
# 2. User logs in with their recoder.xyz account
# 3. Router gets auth token from backend
# 4. All AI requests route through recoder.xyz (no user API keys needed)

# This is similar to Claude Code's authentication model