# Production Configuration for CLI Router
# Uses centralized OpenRouter API key for premium AI model access

# OpenRouter Configuration - Centralized API Key
OPENROUTER_API_KEY=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

# Router Configuration
NODE_ENV=production
PORT=8081
BACKEND_URL=https://api.recoder.xyz
PRODUCTION_ENGINE_URL=https://engine.recoder.xyz

# Premium Model Configuration
DEFAULT_PREMIUM_MODEL=anthropic/claude-sonnet-4
DEFAULT_FAST_MODEL=google/gemini-2.5-flash
DEFAULT_CODING_MODEL=qwen/qwen3-coder
DEFAULT_REASONING_MODEL=deepseek/deepseek-v3-0324

# Cost Optimization Settings
ENABLE_COST_OPTIMIZATION=true
COST_SAVINGS_TARGET=65  # Target 65% cost savings
ENABLE_MODEL_SWITCHING=true
ENABLE_REQUEST_BATCHING=true

# Rate Limiting
REQUESTS_PER_MINUTE=500
TOKENS_PER_MINUTE=500000

# Analytics and Monitoring
ENABLE_ANALYTICS=true
ENABLE_COST_TRACKING=true
ANALYTICS_ENDPOINT=https://analytics.recoder.xyz

# Security
JWT_SECRET=router-jwt-secret-change-in-production
API_RATE_LIMIT=1000

# Enterprise Features
ENABLE_TEAM_MANAGEMENT=true
ENABLE_SHARED_API_POOLS=true
ENABLE_USAGE_QUOTAS=true

# Database and Cache
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://recoder:password@localhost:5432/recoder_router

# Subscription Tiers Access
FREE_TIER_MODELS=deepseek/deepseek-v3-0324-free,deepseek/r1-0528-free
PRO_TIER_MODELS=anthropic/claude-sonnet-4,google/gemini-2.5-flash,qwen/qwen3-coder,deepseek/deepseek-v3-0324
ENTERPRISE_TIER_MODELS=anthropic/claude-sonnet-4,google/gemini-2.5-flash,google/gemini-2.5-pro,qwen/qwen3-coder,deepseek/deepseek-v3-0324,moonshotai/kimi-k2