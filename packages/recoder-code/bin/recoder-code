function log(message) {
  var level = arguments.length > 1 && arguments[1] !== undefined ? arguments[1] : 'info';
  var timestamp = new Date().toISOString();
  var logMessage = "[".concat(timestamp, "] [").concat(String(level).toUpperCase(), "] ").concat(message, "\n");
  fs.appendFileSync(path.join(process.cwd(), 'recorder.log'), logMessage);
  if (program.opts().verbose || program.opts().debug) {
    console.log(logMessage.trim());
  }
}
function loadConfig() {
  var configPath = path.join(process.cwd(), '.recoderrc');
  try {
    var config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
    log('Configuration loaded successfully:', config);
    return config;
  } catch (err) {
    console.error('Error reading .recoderrc:', err.message);
    process.exit(1);
  }
}
