# Multi-stage production Dockerfile for Enhanced AI CLI
FROM node:20-alpine AS base

# Install security updates and necessary packages
RUN apk update && apk upgrade && \
    apk add --no-cache \
    dumb-init \
    curl \
    git \
    bash \
    && rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install dependencies
FROM base AS deps
RUN npm ci --only=production && npm cache clean --force

# Build stage
FROM base AS builder
COPY . .
RUN npm ci && npm run build

# Production stage
FROM base AS runner
ENV NODE_ENV=production
ENV PORT=8080

# Copy user and set permissions
USER nodejs

# Copy built application
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist
COPY --from=builder --chown=nodejs:nodejs /app/cli ./cli
COPY --from=builder --chown=nodejs:nodejs /app/config.js ./
COPY --from=builder --chown=nodejs:nodejs /app/index.js ./
COPY --from=builder --chown=nodejs:nodejs /app/package.json ./

# Copy production dependencies
COPY --from=deps --chown=nodejs:nodejs /app/node_modules ./node_modules

# Create necessary directories
USER root
RUN mkdir -p /app/logs /app/data /app/sessions && \
    chown -R nodejs:nodejs /app/logs /app/data /app/sessions
USER nodejs

# Health check
COPY --chown=nodejs:nodejs scripts/health-check.js ./scripts/
RUN chmod +x ./scripts/health-check.js

# Expose port
EXPOSE 8080

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

# Start the application
CMD ["node", "index.js", "--production"]