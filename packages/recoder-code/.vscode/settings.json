{
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.next/**": true,
    "**/out/**": true,
    "**/.turbo/**": true,
    "**/.cache/**": true,
    "**/logs/**": true,
    "**/sessions/**": true,
    "**/temp/**": true,
    "**/venv/**": true,
    "**/checkpoints/**": true,
    "**/datasets/cache/**": true,
    "**/models/cache/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/.cache": true,
    "**/logs": true,
    "**/sessions": true,
    "**/temp": true,
    "**/venv": true,
    "**/checkpoints": true,
    "**/datasets/cache": true,
    "**/models/cache": true
  },
  "typescript.tsserver.maxTsServerMemory": 2048,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false
}