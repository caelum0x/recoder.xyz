# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use (optional, defaults to anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Site information for OpenRouter tracking (optional)
OPENROUTER_SITE_NAME=Recoder Code
OPENROUTER_SITE_URL=https://openrouter.ai

# OpenRouter Model Fallbacks (comma-separated)
OPENROUTER_FALLBACK_MODELS=openai/gpt-4o,anthropic/claude-3-haiku,meta-llama/llama-3.1-8b-instruct

# OpenRouter Provider Preferences
OPENROUTER_SORT=price
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_DATA_COLLECTION=allow

# OpenRouter Advanced Options
OPENROUTER_QUANTIZATIONS=fp16,bf16
OPENROUTER_MAX_PRICE={"prompt": 5, "completion": 10}

# Database Configuration
POSTGRES_PASSWORD=your_secure_postgres_password

# Redis Configuration  
REDIS_PASSWORD=your_secure_redis_password

# API Keys
HUGGINGFACE_TOKEN=your_huggingface_token

# Monitoring
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password

# Security
JWT_SECRET=your_jwt_secret_key
ENCRYPTION_KEY=your_encryption_key

# Application Settings
NODE_ENV=production
LOG_LEVEL=info
ENABLE_MONITORING=true
ENABLE_METRICS=true

# Service URLs (for development)
ML_TRAINING_SERVICE_URL=http://localhost:8000
PLUGIN_REGISTRY_URL=http://localhost:3001
COLLABORATION_SERVICE_URL=http://localhost:3002

# Storage Configuration
STORAGE_TYPE=local
STORAGE_PATH=/app/storage

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000