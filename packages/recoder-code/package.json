{
  "name": "recoder-code-workspace",
  "version": "2.4.5",
  "private": true,
  "description": "Workspace root for the Recoder Code package set.",
  "main": "index.js",
  "scripts": {
    "start": "node cli/run.js",
    "cli": "node cli/run.js",
    "setup": "node setup.js",
    "setup:global": "node setup-global-npm.js",
    "setup:enterprise": "node setup.js --enterprise",
    "validate": "node validate.js",
    "build": "npm run build:core && npm run build:mcp-eternos && npm run build:cli && npm run build:vscode",
    "build:core": "npm run build --workspace=packages/core",
    "build:mcp-eternos": "npm run build --workspace=packages/mcp-eternos",
    "build:cli": "npm run build --workspace=packages/cli",
    "build:vscode": "npm run compile --workspace=packages/vscode-ide-companion",
    "build:production": "npm run build",
    "test": "jest",
    "test:integration": "node test-integration.js",
    "test:e2e": "bash test-end-to-end-integration.sh",
    "test:cli": "node test-run-cli.js",
    "test:performance": "node scripts/performance-benchmark.js",
    "test:security": "npm audit && node scripts/security-audit.js",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "dev": "node cli/run.js --dev",
    "demo": "node examples/demo-scenarios.js",
    "docs:generate": "node scripts/generate-docs.js",
    "security:audit": "npm audit --audit-level moderate",
    "optimize": "node scripts/optimize-package.js",
    "health-check": "node scripts/health-check.js",
    "todo": "node cli/todo-manager.js",
    "todo:list": "node cli/todo-manager.js list",
    "todo:stats": "node cli/todo-manager.js stats",
    "production:check": "npm run lint && npm run typecheck && npm run security:audit",
    "production:bundle": "npm run production:check && npm run build:production",
    "production:deploy": "npm run production:bundle && npm publish --access public --workspace=packages/cli",
    "postinstall": "node -e \"console.log('\\\\n📦 Recoder Code workspace ready.\\\\n\\\\nCLI package: packages/cli\\\\nCore package: packages/core\\\\nPublished CLI: recoder-code\\\\n')\"",
    "prepare": "echo 'Package prepared for distribution'",
    "prepublishOnly": "npm run prepare && npm run security:audit"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "axios": "^1.12.2",
    "chai": "^6.0.1",
    "chalk": "^5.6.2",
    "chokidar": "^4.0.3",
    "commander": "^14.0.1",
    "diff": "^8.0.2",
    "dotenv": "^17.2.2",
    "ignore": "^7.0.5",
    "ink": "^6.3.1",
    "inquirer": "^9.3.8",
    "jsdom": "^27.0.0",
    "openai": "^5.21.0",
    "openrouter-client": "^1.6.0",
    "pg-connection-string": "^2.9.1",
    "react": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "semver": "^7.6.3",
    "typeorm": "^0.3.27",
    "ws": "^8.18.0",
    "zod": "^3.25.76",
    "recoder-code-core": "^2.4.5"
  },
  "optionalDependencies": {
    "@google-cloud/speech": "^7.2.0",
    "node-record-lpcm16": "^1.0.1",
    "say": "^0.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@types/chai": "^5.2.2",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.5.2",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "babel-jest": "^30.1.2",
    "eslint": "^9.36.0",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "ai",
    "cli",
    "chatgpt",
    "claude",
    "gemini",
    "deepseek",
    "qwen",
    "openrouter",
    "tool-calling",
    "function-calling",
    "agentic",
    "code-generation",
    "development",
    "automation",
    "productivity",
    "devtools",
    "coding-assistant",
    "ai-assistant",
    "terminal",
    "interactive-cli",
    "file-operations",
    "sandbox",
    "docker",
    "openai",
    "anthropic",
    "free-ai",
    "code-review",
    "refactoring",
    "debugging"
  ],
  "author": {
    "name": "Recoder Code Team",
    "email": "support@recoder-code.com",
    "url": "https://recoder.xyz"
  },
  "contributors": [
    {
      "name": "Recoder Code Team",
      "email": "support@recoder-code.com",
      "url": "https://recoder.xyz"
    }
  ],
  "license": "MIT",
  "type": "commonjs",
  "workspaces": [
    "packages/*"
  ],
  "homepage": "https://recoder.xyz",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "config": {
    "unsafe-perm": true
  },
  "volta": {
    "node": "20.11.0",
    "npm": "10.8.0"
  }
}
