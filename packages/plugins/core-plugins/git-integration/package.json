{
  "name": "@craft-code/git-integration",
  "version": "1.0.0",
  "description": "Git integration plugin for Craft Code",
  "main": "index.js",
  "author": "Craft Code Team",
  "license": "MIT",
  "craftCodePlugin": {
    "metadata": {
      "displayName": "Git Integration",
      "category": "version-control",
      "tags": ["git", "version-control", "scm"],
      "engines": {
        "craftCode": ">=1.0.0"
      },
      "dependencies": {},
      "capabilities": [
        "workspace:read",
        "workspace:write",
        "filesystem:read",
        "filesystem:write",
        "shell:execute",
        "ui:panels",
        "ui:commands"
      ]
    },
    "configuration": {
      "schema": {
        "autoFetch": {
          "type": "boolean",
          "title": "Auto Fetch",
          "description": "Automatically fetch from remote repositories",
          "default": true
        },
        "fetchInterval": {
          "type": "number",
          "title": "Fetch Interval (minutes)",
          "description": "How often to fetch from remotes",
          "default": 5,
          "minimum": 1
        },
        "showBranchInStatusBar": {
          "type": "boolean",
          "title": "Show Branch in Status Bar",
          "description": "Display current branch in the status bar",
          "default": true
        },
        "defaultRemote": {
          "type": "string",
          "title": "Default Remote",
          "description": "Default remote repository name",
          "default": "origin"
        }
      }
    },
    "contributes": {
      "commands": [
        {
          "command": "git.status",
          "title": "Git: Status",
          "category": "Git"
        },
        {
          "command": "git.commit",
          "title": "Git: Commit",
          "category": "Git"
        },
        {
          "command": "git.push",
          "title": "Git: Push",
          "category": "Git"
        },
        {
          "command": "git.pull",
          "title": "Git: Pull",
          "category": "Git"
        },
        {
          "command": "git.branch",
          "title": "Git: Branch",
          "category": "Git"
        },
        {
          "command": "git.checkout",
          "title": "Git: Checkout",
          "category": "Git"
        },
        {
          "command": "git.merge",
          "title": "Git: Merge",
          "category": "Git"
        },
        {
          "command": "git.log",
          "title": "Git: Log",
          "category": "Git"
        }
      ],
      "panels": [
        {
          "id": "git-explorer",
          "title": "Git",
          "icon": "git-branch",
          "location": "sidebar"
        }
      ],
      "statusBar": [
        {
          "id": "git-branch",
          "alignment": "left",
          "priority": 100
        }
      ]
    }
  }
}