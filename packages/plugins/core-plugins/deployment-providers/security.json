{
  "permissions": [
    "workspace:read",
    "workspace:write",
    "filesystem:read",
    "filesystem:write",
    "shell:execute",
    "ui:panels",
    "ui:commands",
    "ui:notifications",
    "ui:progress",
    "ui:statusbar",
    "ui:quickpick",
    "ui:dialogs",
    "network:access"
  ],
  "sandboxConfig": {
    "allowNetworkAccess": true,
    "allowFileSystemAccess": true,
    "allowShellAccess": true,
    "timeoutMs": 600000,
    "memoryLimitMB": 512,
    "cpuLimitPercent": 40,
    "allowedPaths": [
      ".",
      "/tmp",
      "/var/tmp",
      "~/.aws",
      "~/.config"
    ]
  },
  "trustedDomains": [
    "vercel.com",
    "api.vercel.com",
    "netlify.com",
    "api.netlify.com",
    "heroku.com",
    "api.heroku.com",
    "amazonaws.com",
    "console.aws.amazon.com",
    "azure.com",
    "portal.azure.com",
    "cloud.google.com"
  ],
  "publisher": {
    "id": "craft-code-team",
    "verified": true,
    "reputation": 100
  },
  "riskLevel": "high",
  "requiredConsent": [
    "File system access for deployment operations",
    "Shell access for deployment commands",
    "Network access for deployment APIs",
    "Access to cloud provider credentials",
    "Long-running deployment processes"
  ]
}