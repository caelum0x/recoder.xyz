{
  "name": "@craft-code/testing-frameworks",
  "version": "1.0.0",
  "description": "Multi-language testing framework integration for Craft Code",
  "main": "index.js",
  "author": "Craft Code Team",
  "license": "MIT",
  "craftCodePlugin": {
    "metadata": {
      "displayName": "Testing Frameworks",
      "category": "testing",
      "tags": ["testing", "jest", "mocha", "pytest", "junit", "test-runner"],
      "engines": {
        "craftCode": ">=1.0.0"
      },
      "dependencies": {},
      "capabilities": [
        "workspace:read",
        "workspace:write",
        "filesystem:read",
        "filesystem:write",
        "shell:execute",
        "ui:panels",
        "ui:commands",
        "ui:notifications",
        "ui:progress"
      ]
    },
    "configuration": {
      "schema": {
        "autoDetectFrameworks": {
          "type": "boolean",
          "title": "Auto-detect Test Frameworks",
          "description": "Automatically detect and configure test frameworks",
          "default": true
        },
        "runOnSave": {
          "type": "boolean",
          "title": "Run Tests on Save",
          "description": "Automatically run related tests when files are saved",
          "default": false
        },
        "showCoverage": {
          "type": "boolean",
          "title": "Show Coverage",
          "description": "Display test coverage information",
          "default": true
        },
        "parallelExecution": {
          "type": "boolean",
          "title": "Parallel Test Execution",
          "description": "Run tests in parallel when possible",
          "default": true
        },
        "testTimeout": {
          "type": "number",
          "title": "Test Timeout (seconds)",
          "description": "Maximum time to wait for test execution",
          "default": 30,
          "minimum": 5
        },
        "preferredFrameworks": {
          "type": "object",
          "title": "Preferred Frameworks",
          "description": "Preferred test framework for each language",
          "properties": {
            "javascript": {
              "type": "string",
              "enum": ["jest", "mocha", "jasmine", "vitest"],
              "default": "jest"
            },
            "python": {
              "type": "string",
              "enum": ["pytest", "unittest", "nose2"],
              "default": "pytest"
            },
            "java": {
              "type": "string",
              "enum": ["junit", "testng"],
              "default": "junit"
            },
            "csharp": {
              "type": "string",
              "enum": ["nunit", "xunit", "mstest"],
              "default": "xunit"
            }
          }
        }
      }
    },
    "contributes": {
      "commands": [
        {
          "command": "test.run.all",
          "title": "Test: Run All Tests",
          "category": "Test"
        },
        {
          "command": "test.run.file",
          "title": "Test: Run Current File Tests",
          "category": "Test"
        },
        {
          "command": "test.run.suite",
          "title": "Test: Run Test Suite",
          "category": "Test"
        },
        {
          "command": "test.run.single",
          "title": "Test: Run Single Test",
          "category": "Test"
        },
        {
          "command": "test.debug",
          "title": "Test: Debug Test",
          "category": "Test"
        },
        {
          "command": "test.coverage",
          "title": "Test: Generate Coverage Report",
          "category": "Test"
        },
        {
          "command": "test.watch",
          "title": "Test: Watch Mode",
          "category": "Test"
        },
        {
          "command": "test.configure",
          "title": "Test: Configure Framework",
          "category": "Test"
        }
      ],
      "panels": [
        {
          "id": "test-explorer",
          "title": "Test Explorer",
          "icon": "beaker",
          "location": "sidebar"
        },
        {
          "id": "test-output",
          "title": "Test Output",
          "icon": "output",
          "location": "panel"
        }
      ],
      "statusBar": [
        {
          "id": "test-status",
          "alignment": "left",
          "priority": 90
        }
      ]
    }
  }
}