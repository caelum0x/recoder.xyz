{
  "name": "@craft-code/docker-support",
  "version": "1.0.0",
  "description": "Docker container support and management for Craft Code",
  "main": "index.js",
  "author": "Craft Code Team",
  "license": "MIT",
  "craftCodePlugin": {
    "metadata": {
      "displayName": "Docker Support",
      "category": "containers",
      "tags": ["docker", "containers", "devops", "deployment"],
      "engines": {
        "craftCode": ">=1.0.0"
      },
      "dependencies": {},
      "capabilities": [
        "workspace:read",
        "workspace:write",
        "filesystem:read",
        "filesystem:write",
        "shell:execute",
        "ui:panels",
        "ui:commands",
        "ui:terminals"
      ]
    },
    "configuration": {
      "schema": {
        "dockerPath": {
          "type": "string",
          "title": "Docker Binary Path",
          "description": "Path to the Docker executable",
          "default": "docker"
        },
        "autoDetectContainers": {
          "type": "boolean",
          "title": "Auto-detect Containers",
          "description": "Automatically detect and monitor Docker containers",
          "default": true
        },
        "showContainerLogs": {
          "type": "boolean",
          "title": "Show Container Logs",
          "description": "Display container logs in the output panel",
          "default": true
        },
        "refreshInterval": {
          "type": "number",
          "title": "Refresh Interval (seconds)",
          "description": "How often to refresh container status",
          "default": 10,
          "minimum": 5
        },
        "defaultRegistry": {
          "type": "string",
          "title": "Default Registry",
          "description": "Default Docker registry for pulling images",
          "default": "docker.io"
        }
      }
    },
    "contributes": {
      "commands": [
        {
          "command": "docker.containers.list",
          "title": "Docker: List Containers",
          "category": "Docker"
        },
        {
          "command": "docker.containers.start",
          "title": "Docker: Start Container",
          "category": "Docker"
        },
        {
          "command": "docker.containers.stop",
          "title": "Docker: Stop Container",
          "category": "Docker"
        },
        {
          "command": "docker.containers.remove",
          "title": "Docker: Remove Container",
          "category": "Docker"
        },
        {
          "command": "docker.images.list",
          "title": "Docker: List Images",
          "category": "Docker"
        },
        {
          "command": "docker.images.pull",
          "title": "Docker: Pull Image",
          "category": "Docker"
        },
        {
          "command": "docker.build",
          "title": "Docker: Build Image",
          "category": "Docker"
        },
        {
          "command": "docker.compose.up",
          "title": "Docker Compose: Up",
          "category": "Docker"
        },
        {
          "command": "docker.compose.down",
          "title": "Docker Compose: Down",
          "category": "Docker"
        },
        {
          "command": "docker.logs",
          "title": "Docker: Show Logs",
          "category": "Docker"
        }
      ],
      "panels": [
        {
          "id": "docker-explorer",
          "title": "Docker",
          "icon": "package",
          "location": "sidebar"
        }
      ],
      "terminals": [
        {
          "id": "docker-terminal",
          "title": "Docker Terminal",
          "shellPath": "docker",
          "shellArgs": []
        }
      ]
    }
  }
}