{
  "permissions": [
    "workspace:read",
    "workspace:write",
    "filesystem:read",
    "filesystem:write",
    "shell:execute",
    "ui:panels",
    "ui:commands",
    "ui:terminals",
    "ui:output"
  ],
  "sandboxConfig": {
    "allowNetworkAccess": true,
    "allowFileSystemAccess": true,
    "allowShellAccess": true,
    "timeoutMs": 120000,
    "memoryLimitMB": 300,
    "cpuLimitPercent": 30,
    "allowedPaths": [
      ".",
      "/tmp",
      "/var/tmp",
      "/var/run/docker.sock"
    ]
  },
  "trustedDomains": [
    "docker.io",
    "registry.hub.docker.com",
    "quay.io",
    "gcr.io",
    "registry.gitlab.com"
  ],
  "publisher": {
    "id": "craft-code-team",
    "verified": true,
    "reputation": 100
  },
  "riskLevel": "high",
  "requiredConsent": [
    "File system access for Docker operations",
    "Shell access for Docker commands",
    "Network access for Docker registry operations",
    "Access to Docker daemon socket"
  ]
}