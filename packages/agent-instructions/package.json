{
  "name": "@recoder/agent-instructions",
  "version": "0.1.0",
  "description": "Instruction compiler for Recoder Agent OS",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.mjs",
      "require": "./dist/compiler.js"
    },
    "./agent-os-compiler": {
      "types": "./dist/agent-os-compiler.d.ts",
      "import": "./dist/agent-os-compiler.mjs",
      "require": "./dist/agent-os-compiler.js"
    },
    "./source-loader": {
      "types": "./dist/source-loader.d.ts",
      "import": "./dist/source-loader.mjs",
      "require": "./dist/source-loader.js"
    },
    "./provenance": {
      "types": "./dist/provenance.d.ts",
      "import": "./dist/provenance.mjs",
      "require": "./dist/provenance.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo dist node_modules",
    "test": "vitest run"
  },
  "dependencies": {
    "@recoder/agent-os": "workspace:*",
    "@recoder/a2a-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
