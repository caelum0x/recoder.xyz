{
  "name": "@recoder/performance",
  "version": "1.0.0",
  "description": "High-performance monitoring, caching, and optimization utilities for Recoder.xyz",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "test": "echo \"No tests specified\" && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js",
    "./middleware": "./dist/middleware/index.js",
    "./monitoring": "./dist/monitoring/index.js",
    "./caching": "./dist/caching/index.js",
    "./cdn": "./dist/cdn/index.js"
  },
  "dependencies": {
    "ioredis": "^5.3.0",
    "redis": "^4.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "express": "^4.18.0"
  },
  "keywords": [
    "performance",
    "monitoring",
    "caching",
    "cdn",
    "middleware",
    "redis",
    "optimization"
  ]
}
