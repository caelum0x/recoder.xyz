{
	"name": "@recoder/a2a-sdk",
	"version": "0.1.0",
	"private": true,
	"description": "Shared SDK helpers for A2A task state mapping, error taxonomy, envelope builders, and audit event emitters",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		"./package.json": "./package.json",
		".": "./src/index.ts",
		"./state-mapping": "./src/state-mapping.ts",
		"./error-mapping": "./src/error-mapping.ts",
		"./envelope-builders": "./src/envelope-builders.ts",
		"./audit-helpers": "./src/audit-helpers.ts",
		"./validation": "./src/validation.ts"
	},
	"scripts": {
		"build": "tsup",
		"check-types": "tsc --noEmit",
		"clean": "rm -rf .turbo dist node_modules",
		"test": "vitest run",
		"format": "biome check --write ."
	},
	"peerDependencies": {
		"@recoder/shared": "workspace:*"
	},
	"devDependencies": {
		"@recoder/tsconfig": "workspace:*",
		"@recoder/shared": "workspace:*",
		"tsup": "catalog:",
		"vitest": "catalog:"
	}
}
