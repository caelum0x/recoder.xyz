{
	"name": "@recoder/a2a-sdk",
	"version": "1.0.1",
	"description": "Shared SDK helpers for A2A task state mapping, error taxonomy, envelope builders, and audit event emitters",
	"license": "MIT",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./schemas": {
			"types": "./dist/schemas/index.d.ts",
			"import": "./dist/schemas/index.mjs",
			"require": "./dist/schemas/index.js"
		},
		"./state-mapping": {
			"types": "./dist/state-mapping.d.ts",
			"import": "./dist/state-mapping.mjs",
			"require": "./dist/state-mapping.js"
		},
		"./error-mapping": {
			"types": "./dist/error-mapping.d.ts",
			"import": "./dist/error-mapping.mjs",
			"require": "./dist/error-mapping.js"
		},
		"./envelope-builders": {
			"types": "./dist/envelope-builders.d.ts",
			"import": "./dist/envelope-builders.mjs",
			"require": "./dist/envelope-builders.js"
		},
		"./audit-helpers": {
			"types": "./dist/audit-helpers.d.ts",
			"import": "./dist/audit-helpers.mjs",
			"require": "./dist/audit-helpers.js"
		},
		"./validation": {
			"types": "./dist/validation.d.ts",
			"import": "./dist/validation.mjs",
			"require": "./dist/validation.js"
		},
		"./ingress": {
			"types": "./dist/ingress-contract/index.d.ts",
			"import": "./src/ingress-contract/index.ts",
			"require": "./dist/ingress-contract/index.js",
			"default": "./dist/ingress-contract/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsup",
		"check-types": "tsc --noEmit",
		"clean": "rm -rf .turbo dist node_modules",
		"test": "vitest run",
		"format": "biome check --write ."
	},
	"devDependencies": {
		"tsup": "^8.0.0",
		"typescript": "^5.0.0",
		"vitest": "^2.1.9"
	},
	"keywords": [
		"recoder",
		"a2a",
		"agent-to-agent",
		"sdk",
		"task-envelope",
		"audit-event"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/ArhansGit/recoder.xyz.git",
		"directory": "packages/a2a-sdk"
	},
	"publishConfig": {
		"access": "public"
	}
}
