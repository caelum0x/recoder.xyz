{
  "name": "@recoder/pi-ai",
  "version": "0.80.2",
  "description": "Recoder-owned vendor of pi ai (merged from earendil-works/pi).",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "require": "./dist/compat.cjs",
      "import": "./dist/compat.js"
    },
    "./oauth": {
      "types": "./dist/oauth.d.ts",
      "require": "./dist/oauth.cjs",
      "import": "./dist/oauth.js"
    },
    "./bedrock-provider": {
      "types": "./dist/bedrock-provider.d.ts",
      "require": "./dist/bedrock-provider.cjs",
      "import": "./dist/bedrock-provider.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.91.1",
    "@aws-sdk/client-bedrock-runtime": "3.1048.0",
    "@smithy/node-http-handler": "4.7.3",
    "@google/genai": "1.52.0",
    "@mistralai/mistralai": "2.2.6",
    "@opentelemetry/api": "1.9.0",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "openai": "6.26.0",
    "partial-json": "0.1.7",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
