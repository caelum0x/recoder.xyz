{
  "name": "@recoder/cli",
  "version": "1.0.0",
  "description": "Recoder CLI - AI-powered development platform with production-ready code generation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "recoder": "dist/index.js",
    "rec": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "code-generation",
    "development",
    "automation",
    "cli",
    "blockchain",
    "web3",
    "react",
    "nextjs",
    "production-ready"
  ],
  "author": "Recoder Team",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "inquirer": "^9.2.12",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "boxen": "^5.1.2",
    "figlet": "^1.7.0",
    "conf": "^10.2.0",
    "axios": "^1.6.2",
    "fs-extra": "^11.2.0",
    "handlebars": "^4.7.8",
    "yaml": "^2.3.4",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "semver": "^7.5.4",
    "winston": "^3.11.0",
    "chokidar": "^3.5.3",
    "update-notifier": "^6.0.2",
    "keytar": "^7.9.0",
    "open": "^8.4.2",
    "cli-table3": "^0.6.3",
    "lodash": "^4.17.21",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/semver": "^7.5.6",
    "@types/figlet": "^1.5.8",
    "@types/update-notifier": "^6.0.8",
    "@types/conf": "^3.0.2",
    "@types/cli-table3": "^0.5.4",
    "@types/lodash": "^4.14.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/recoder-team/recoder.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/recoder-team/recoder/issues"
  },
  "homepage": "https://recoder.xyz"
}