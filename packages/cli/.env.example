# ==============================================
# RECODER CLI - Environment Configuration
# ==============================================
# Copy this to .env and configure based on your setup
# 
# 🚀 LOCAL-FIRST: This CLI works great with JUST Ollama (no API keys needed!)
# 📡 CLOUD-ENHANCED: Add API keys for advanced AI models when available

#====================================
# 🤖 LOCAL AI (No API Keys Required)
#====================================

# Ollama Local AI (RECOMMENDED - Works offline!)
OLLAMA_BASE_URL=http://localhost:11434
# Install: brew install ollama && ollama pull tinyllama
# Available models: tinyllama, phi3:mini, llama3, codellama, deepseek-coder

#====================================
# 🚀 PRIMARY AI PROVIDERS
#====================================

# Anthropic Claude (Best for complex reasoning, security, blockchain)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# OpenAI (GPT-4, reliable but expensive)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini (Great for multimodal, large codebases, analysis)
GOOGLE_API_KEY=your-google-gemini-api-key-here

# Groq (Fastest inference, great for rapid iterations)
GROQ_API_KEY=gsk_your-groq-api-key-here

#====================================
# 🌟 SPECIALIZED PROVIDERS
#====================================

# Mistral (European privacy-focused, good for general coding)
MISTRAL_API_KEY=your-mistral-api-key-here

# Perplexity (Excellent for research, documentation, web search)
PERPLEXITY_API_KEY=pplx-your-perplexity-api-key-here

# Cohere (Text generation, classification, embeddings)
COHERE_API_KEY=your-cohere-api-key-here

# DeepSeek (Cost-optimized coding model)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

#====================================
# 🌏 REGIONAL PROVIDERS
#====================================

# Kimi/Moonshot (Chinese AI, good for analysis)
KIMI_API_KEY=your-kimi-api-key-here
MOONSHOT_API_KEY=your-moonshot-api-key-here

# Qwen/DashScope (Alibaba's models, coding focused)
QWEN_API_KEY=your-qwen-api-key-here
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# Together AI (Multi-model platform)
TOGETHER_API_KEY=your-together-api-key-here

# Hugging Face (Open-source models, cost-effective)
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# OpenRouter (RECOMMENDED - Access to multiple models via single API)
OPENROUTER_API_KEY=your-openrouter-api-key-here

#====================================
# 💰 COST OPTIMIZATION SETTINGS
#====================================

# Maximum daily spend limit (in USD)
RECODER_MAX_DAILY_COST=10.00

# Prefer free models when available (true/false)
RECODER_PREFER_FREE_MODELS=true

# Enable budget mode to prevent overspending (true/false)
RECODER_BUDGET_MODE=false

# Quality threshold for model selection (1-10)
RECODER_QUALITY_THRESHOLD=7.5

# Allow fallback to alternative models if primary fails
RECODER_ALLOW_FALLBACKS=true

# Track costs and usage statistics
RECODER_COST_TRACKING=true

#====================================
# 🎛️ PROVIDER PREFERENCES
#====================================

# Primary provider to use first
RECODER_PRIMARY_PROVIDER=openrouter

# Fallback providers (comma-separated, in order of preference)
RECODER_FALLBACK_PROVIDERS=ollama,gemini,groq,deepseek

# Disabled providers (comma-separated)
# RECODER_DISABLED_PROVIDERS=openai

#====================================
# ⚡ PERFORMANCE SETTINGS
#====================================

# Enable response caching for faster responses
RECODER_CACHE_ENABLED=true

# Maximum concurrent AI requests
RECODER_MAX_CONCURRENT=5

# Request timeout in milliseconds
RECODER_REQUEST_TIMEOUT=60000

#====================================
# 🏗️ RECODER-SPECIFIC SETTINGS
#====================================

# Only generate real, working code (no mocks/placeholders)
RECODER_REAL_CODE_ONLY=true

# Include tests with generated code
RECODER_INCLUDE_TESTS=false

# Include documentation with generated code
RECODER_INCLUDE_DOCS=false

# Generate deployment configurations
RECODER_GENERATE_DEPLOYMENT=false

# Enhanced logging for debugging
RECODER_ENABLE_LOGGING=true
RECODER_LOG_LEVEL=info

#====================================
# 🌐 BACKEND INTEGRATION (Optional)
#====================================
# Connect to recoder backend for cross-platform sync

# Backend API URL (leave as localhost for local development)
RECODER_API_URL=http://localhost:3001
RECODER_WEB_URL=http://localhost:3000

# Production URLs (uncomment for production)
# RECODER_API_URL=https://api.recoder.xyz
# RECODER_WEB_URL=https://recoder.xyz

#====================================
# 🛠️ CLI CONFIGURATION
#====================================

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Development mode (enables extra debugging)
NODE_ENV=development

# Custom providers configuration (advanced)
# RECODER_CUSTOM_PROVIDERS=path/to/custom/providers.json

#====================================
# 📊 USAGE TRACKING (Optional)
#====================================
# Enable telemetry for usage analytics (default: disabled)
# ENABLE_TELEMETRY=false

#====================================
# 🔄 PRODUCTION ENGINE (Optional)
#====================================
# URL for the production code generation engine
PRODUCTION_ENGINE_URL=http://localhost:3002

#====================================
# 💡 GETTING STARTED WITHOUT API KEYS
#====================================
# 
# 1. Install Ollama: brew install ollama
# 2. Pull a model: ollama pull tinyllama
# 3. Start Ollama: ollama serve  
# 4. Test CLI: recoder generate "hello world in javascript"
# 
# ✅ That's it! No API keys needed for basic functionality.
# 
# 🚀 To enhance with cloud AI:
#   - Add API keys above (uncomment the lines)
#   - CLI will automatically detect and use them
#   - Graceful fallback to Ollama if cloud APIs fail