{
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit --testPathIgnorePatterns=integration",
    "test:integration": "jest --testPathPattern=integration --testTimeout=30000",
    "test:e2e": "jest --testPathPattern=e2e --testTimeout=60000",
    "test:performance": "jest --testPathPattern=performance --testTimeout=120000",
    "test:security": "jest --testPathPattern=security --testTimeout=60000",
    "test:all": "node scripts/test-integration.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false --verbose",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:silent": "jest --silent",
    "test:verbose": "jest --verbose",
    "test:update-snapshots": "jest --updateSnapshot",
    "test:clear-cache": "jest --clearCache",
    "test:list-tests": "jest --listTests",
    "test:detect-leaks": "jest --detectLeaks",
    "test:force-exit": "jest --forceExit",
    "test:run-in-band": "jest --runInBand",
    "test:max-workers": "jest --maxWorkers=4",
    "test:bail": "jest --bail",
    "test:changed": "jest --onlyChanged",
    "test:related": "jest --findRelatedTests",
    "test:no-cache": "jest --no-cache",
    "test:setup": "node scripts/test-setup.js",
    "test:cleanup": "node scripts/test-cleanup.js",
    "test:report": "open test-reports/integration-test-report.html",
    "test:lint": "eslint src/**/*.{js,ts} --ext .js,.ts",
    "test:type-check": "tsc --noEmit",
    "test:validate": "npm run test:lint && npm run test:type-check && npm run test:unit",
    "test:pre-commit": "npm run test:validate && npm run test:integration",
    "test:pre-push": "npm run test:all",
    "test:benchmark": "jest --testNamePattern=benchmark --verbose",
    "test:smoke": "jest --testNamePattern=smoke --verbose",
    "test:regression": "jest --testNamePattern=regression --verbose",
    "test:api": "jest --testNamePattern=api --verbose",
    "test:cli": "jest --testNamePattern=cli --verbose",
    "test:commands": "jest --testNamePattern=commands --verbose",
    "test:services": "jest --testNamePattern=services --verbose",
    "test:utils": "jest --testNamePattern=utils --verbose",
    "test:auth": "jest --testNamePattern=auth --verbose",
    "test:project": "jest --testNamePattern=project --verbose",
    "test:template": "jest --testNamePattern=template --verbose",
    "test:agent": "jest --testNamePattern=agent --verbose",
    "test:validation": "jest --testNamePattern=validation --verbose",
    "test:error-handling": "jest --testNamePattern=error --verbose",
    "test:logging": "jest --testNamePattern=logging --verbose",
    "test:config": "jest --testNamePattern=config --verbose",
    "test:file-system": "jest --testNamePattern=filesystem --verbose",
    "test:network": "jest --testNamePattern=network --verbose",
    "test:concurrent": "jest --testNamePattern=concurrent --verbose",
    "test:timeout": "jest --testNamePattern=timeout --verbose",
    "test:memory": "jest --testNamePattern=memory --verbose",
    "test:load": "jest --testNamePattern=load --verbose",
    "test:stress": "jest --testNamePattern=stress --verbose",
    "test:edge-cases": "jest --testNamePattern=edge --verbose",
    "test:compatibility": "jest --testNamePattern=compatibility --verbose",
    "test:cross-platform": "jest --testNamePattern=platform --verbose"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,ts}",
      "<rootDir>/src/**/*.{test,spec}.{js,ts}"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,ts}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**",
      "!src/**/*.test.{js,ts}",
      "!src/**/*.spec.{js,ts}"
    ],
    "coverageReporters": ["text", "lcov", "html", "json"],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "testTimeout": 30000,
    "verbose": true,
    "detectOpenHandles": true,
    "forceExit": true,
    "maxConcurrency": 5,
    "setupFilesAfterEnv": ["<rootDir>/src/test-setup.ts"],
    "globalSetup": "<rootDir>/src/test-global-setup.ts",
    "globalTeardown": "<rootDir>/src/test-global-teardown.ts"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^4.9.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "supertest": "^6.3.0",
    "nock": "^13.3.0",
    "mock-fs": "^5.2.0",
    "tmp": "^0.2.1",
    "cross-env": "^7.0.3"
  },
  "testCategories": {
    "unit": "Tests individual functions and classes in isolation",
    "integration": "Tests interaction between multiple components",
    "e2e": "Tests complete user workflows from start to finish",
    "performance": "Tests system performance and resource usage",
    "security": "Tests security features and vulnerability resistance",
    "api": "Tests API endpoints and responses",
    "cli": "Tests command-line interface functionality",
    "commands": "Tests individual CLI commands",
    "services": "Tests service layer functionality",
    "utils": "Tests utility functions and helpers",
    "auth": "Tests authentication and authorization",
    "project": "Tests project management features",
    "template": "Tests template system functionality",
    "agent": "Tests agent management and execution",
    "validation": "Tests input validation and data integrity",
    "error-handling": "Tests error handling and recovery",
    "logging": "Tests logging and monitoring functionality",
    "config": "Tests configuration management",
    "file-system": "Tests file system operations",
    "network": "Tests network communication",
    "concurrent": "Tests concurrent operations",
    "timeout": "Tests timeout handling",
    "memory": "Tests memory usage and leaks",
    "load": "Tests system behavior under load",
    "stress": "Tests system behavior under stress",
    "edge-cases": "Tests edge cases and boundary conditions",
    "compatibility": "Tests compatibility with different versions",
    "cross-platform": "Tests cross-platform compatibility"
  }
}