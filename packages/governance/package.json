{
  "name": "@recoder/governance",
  "version": "0.1.0",
  "description": "Recoder Agent OS governance spine — fuses @recoder/agent-policy into a deny-biased policy chain, risk-tier routing, approval gateways, pure-TS permission enforcement, and a SHA-256 Merkle audit chain. Fails safe (DENY/needs_approval) when the Rust governance daemon is down.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo dist node_modules",
    "test": "node --test --import tsx 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "@recoder/agent-os": "workspace:*",
    "@recoder/agent-events": "workspace:*",
    "@recoder/agent-policy": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  }
}
