{
	"name": "@recoder/document-preprocessor",
	"version": "0.1.0",
	"description": "Document preprocessing utilities for text and image extraction",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"check-types": "tsc --noEmit",
		"dev": "tsup --watch",
		"test": "vitest run",
		"format": "biome check --write ."
	},
	"dependencies": {
		"@embedpdf/pdfium": "catalog:",
		"pngjs": "catalog:"
	},
	"devDependencies": {
		"@recoder/tsconfig": "workspace:^",
		"@types/node": "catalog:",
		"@types/pngjs": "catalog:",
		"tsup": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"keywords": [
		"pdf",
		"preprocessing",
		"rag"
	],
	"license": "MIT"
}
