  channelGatewayEvents       agency_channel_gateway_events[]
  serviceSkus                agency_service_skus[]
  deliveryPlaybooks          agency_delivery_playbooks[]
  agencyProjects             agency_projects[]
  quotes                     agency_quotes[]
  sows                       agency_sows[]
  invoices                   agency_invoices[]
  serviceCatalog             agency_service_catalog[]
  changeOrders               agency_change_orders[]
  costLedgerEntries          agency_cost_ledger_entries[]
  modelRoutingPolicies       agency_model_routing_policies[]
  generationCostLogs         agency_generation_cost_logs[]
  clientDigestSchedules      agency_client_digest_schedules[]
  teamCapacitySettings       agency_team_capacity_settings?
  alertSubscriptions         agency_alert_subscriptions[]
  agency_client_invitations  agency_client_invitations[]

  @@map("teams")
}

model agency_users {
  dbId                          Int                                 @id(map: "agency_users_pkey") @default(autoincrement()) @map("db_id")
  id                            String                              @unique(map: "agency_users_id_key")
  email                         String?                             @unique(map: "agency_users_email_key")
  displayName                   String?                             @map("display_name")
  avatarUrl                     String?                             @map("avatar_url")
  emailVerified                 Boolean                             @default(false) @map("email_verified")
  oauthCredentials              agency_oauth_credentials[]
  agencyAgents                  agency_agents[]
  workspacesCreated             agency_workspaces[]
  teamMemberships               agency_team_memberships[]
