  userSeatUsageReports       agency_user_seat_usage_reports[]
  agentTimeRestrictions      agency_agent_time_restrictions?
  invitations                agency_invitations[]
  githubRepositoryIndex      agency_github_repository_index[]
  documentVectorStores       agency_document_vector_stores[]
  dataStores                 agency_data_stores[]
  flowTriggers               agency_flow_triggers[]
  acts                       agency_acts[]
  apps                       agency_apps[]
  agencyApiKeys              agency_api_keys[]
  apiRateLimitCounters       agency_api_rate_limit_counters[]
