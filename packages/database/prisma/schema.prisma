generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model accounts {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now())
  users                 users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model agents {
  id            String          @id
  name          String
  type          String
  description   String?
  config        Json            @default("{}")
  status        String          @default("inactive")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  userId        String
  projectId     String?
  projects      projects?       @relation(fields: [projectId], references: [id])
  users         users           @relation(fields: [userId], references: [id], onDelete: Cascade)
  usage_records usage_records[]
}

model ai_generated_projects {
  id                    String                  @id
  sessionId             String                  @unique
  userId                String
  name                  String
  description           String?
  framework             String
  files                 Json                    @default("[]")
  chat                  Json                    @default("[]")
  isPublic              Boolean                 @default(false)
  previewUrl            String?
  deployUrl             String?
  stars                 Int                     @default(0)
  views                 Int                     @default(0)
  forks                 Int                     @default(0)
  lastSavedAt           DateTime                @default(now())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  users                 users                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  project_collaborators project_collaborators[]
  project_comments      project_comments[]
  project_shares        project_shares[]

  @@index([createdAt])
  @@index([framework])
  @@index([isPublic, stars])
  @@index([userId])
}

model ai_provider_status {
  id           String   @id
  provider     String   @unique
  status       String   @default("unknown")
  responseTime Float?
  errorRate    Float?
  lastCheckAt  DateTime @default(now())
  uptime       Float?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model analytics_reports {
  id                    String                  @id
  name                  String
  description           String?
  slug                  String                  @unique
  category              String
  type                  String
  dataSource            Json                    @default("{}")
  dimensions            Json                    @default("[]")
  metrics               Json                    @default("[]")
  visualizations        Json                    @default("[]")
  schedule              Json?                   @default("{}")
  settings              Json                    @default("{}")
  isActive              Boolean                 @default(true)
  isPublic              Boolean                 @default(false)
  version               String                  @default("1.0.0")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  userId                String
  users                 users                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  report_cache          report_cache[]
  report_comments       report_comments[]
  report_executions     report_executions[]
  report_exports        report_exports[]
  report_schedules      report_schedules[]
  report_share_accesses report_share_accesses[]
  report_shares         report_shares[]
  scheduled_executions  scheduled_executions[]

  @@index([slug, isPublic])
  @@index([type, isActive])
  @@index([userId, category])
}

model api_keys {
  id               String        @id
  userId           String
  keyHash          String        @unique
  keyPrefix        String
  name             String
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime      @default(now())
  isActive         Boolean       @default(true)
  usageCount       Int           @default(0)
  metadata         Json          @default("{}")
  lastResetAt      DateTime      @default(now())
  permissions      String[]      @default([])
  rateLimit        Json          @default("{}")
  rateLimitDaily   Int?
  rateLimitMonthly Int?
  sessionId        String?
  source           String        @default("web")
  updatedAt        DateTime
  cli_sessions     cli_sessions? @relation(fields: [sessionId], references: [id])
  users            users         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model audit_logs {
  id         String   @id
  action     String
  resource   String
  resourceId String?
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())
  userId     String?
  users      users?   @relation(fields: [userId], references: [id])
}

model backup_access {
  id          String   @id
  userId      String   @unique
  permissions String[] @default(["read"])
  databases   String[] @default([])
  operations  String[] @default([])
  maxBackups  Int?
  maxRestore  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  users       users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model backup_jobs {
  id                 String               @id
  type               String
  status             String               @default("pending")
  backupId           String               @unique
  storageLocation    String?
  storageProvider    String               @default("local")
  databaseName       String
  tableCount         Int                  @default(0)
  recordCount        Int                  @default(0)
  sizeBytes          Int                  @default(0)
  checksum           String?
  compressionType    String?
  encryptionType     String?
  scheduledFor       DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  duration           Int?
  errorMessage       String?
  retryCount         Int                  @default(0)
  maxRetries         Int                  @default(3)
  config             Json                 @default("{}")
  retention          Json                 @default("{}")
  metadata           Json                 @default("{}")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  backup_validations backup_validations[]
  restore_jobs       restore_jobs[]

  @@index([databaseName, createdAt])
  @@index([status, createdAt])
  @@index([type, status])
}

model backup_schedules {
  id                  String    @id
  name                String
  description         String?
  scheduleType        String
  cronExpression      String
  isActive            Boolean   @default(true)
  databaseName        String
  storageProvider     String    @default("local")
  storageConfig       Json      @default("{}")
  compressionType     String    @default("gzip")
  encryptionEnabled   Boolean   @default(false)
  retentionDaily      Int       @default(7)
  retentionWeekly     Int       @default(4)
  retentionMonthly    Int       @default(12)
  lastRunAt           DateTime?
  lastBackupId        String?
  nextRunAt           DateTime?
  consecutiveFailures Int       @default(0)
  notifyOnSuccess     Boolean   @default(false)
  notifyOnFailure     Boolean   @default(true)
  notificationConfig  Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime

  @@index([databaseName, scheduleType])
  @@index([isActive, nextRunAt])
}

model backup_storage {
  id                String    @id
  provider          String
  name              String
  config            Json      @default("{}")
  credentials       Json      @default("{}")
  bucket            String?
  region            String?
  endpoint          String?
  basePath          String    @default("/")
  isActive          Boolean   @default(true)
  lastTestAt        DateTime?
  testStatus        String?
  testError         String?
  totalBackups      Int       @default(0)
  totalSizeBytes    BigInt    @default(0)
  availableBytes    BigInt?
  usedBytes         BigInt    @default(0)
  encryptionEnabled Boolean   @default(true)
  encryptionKey     String?
  accessLevel       String    @default("private")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime

  @@unique([provider, bucket, basePath])
  @@index([provider, isActive])
}

model backup_validations {
  id              String      @id
  validationType  String
  status          String      @default("pending")
  checksumValid   Boolean?
  integrityValid  Boolean?
  restoreValid    Boolean?
  structureValid  Boolean?
  testDatabase    String?
  validationSteps Json        @default("[]")
  errors          String[]    @default([])
  warnings        String[]    @default([])
  validationTime  Int?
  testDataSize    Int?
  startedAt       DateTime?
  completedAt     DateTime?
  config          Json        @default("{}")
  metadata        Json        @default("{}")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime
  backupId        String
  backup_jobs     backup_jobs @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@index([backupId, validationType])
  @@index([status, createdAt])
}

model batch_executions {
  id             String           @id
  type           String
  requestCount   Int
  processingTime Int
  costSavings    Float
  status         String
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  metadata       Json             @default("{}")
  batch_requests batch_requests[]

  @@index([completedAt])
  @@index([createdAt])
  @@index([status])
  @@index([type])
}

model batch_requests {
  id                  String            @id
  userId              String
  type                String
  prompt              String
  parameters          Json              @default("{}")
  priority            String            @default("normal")
  timestamp           DateTime          @default(now())
  maxWaitTime         Int
  similarityThreshold Float             @default(0.7)
  batchId             String?
  status              String            @default("pending")
  batch_executions    batch_executions? @relation(fields: [batchId], references: [id])
  users               users             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([status])
  @@index([timestamp])
  @@index([type])
  @@index([userId])
}

model blockchain_networks {
  id                   String                 @id
  name                 String
  displayName          String
  chainId              Int                    @unique
  rpcUrl               String
  wsUrl                String?
  explorerUrl          String
  explorerApiUrl       String?
  symbol               String
  decimals             Int                    @default(18)
  isTestnet            Boolean                @default(false)
  isMainnet            Boolean                @default(false)
  gasPrice             BigInt?
  gasLimit             BigInt?
  maxFeePerGas         BigInt?
  maxPriorityFee       BigInt?
  supportsEIP1559      Boolean                @default(false)
  supportsContracts    Boolean                @default(true)
  isActive             Boolean                @default(true)
  lastChecked          DateTime?
  blockHeight          BigInt?
  description          String?
  website              String?
  documentation        String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  projectId            String?
  projects             projects?              @relation(fields: [projectId], references: [id])
  contract_deployments contract_deployments[]

  @@index([chainId, isActive])
  @@index([isMainnet, isTestnet])
}

model AuthCode {
  id          String   @id
  code        String   @unique
  userId      String
  clientId    String
  redirectUri String?
  scope       String?
  state       String?
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([userId])
  @@index([expiresAt])
}

model DeviceCode {
  id         String   @id @default(uuid())
  deviceCode String   @unique
  userCode   String   @unique
  clientId   String   @default("recoder-cli")
  scope      String?
  status     String   @default("pending")
  expiresAt  DateTime
  userId     String?
  createdAt  DateTime @default(now())
  user       users?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceCode])
  @@index([userCode])
  @@index([status])
  @@index([expiresAt])
}

model cli_sessions {
  id           String      @id
  userId       String
  deviceId     String?
  deviceName   String?
  deviceType   String      @default("cli")
  accessToken  String      @unique
  refreshToken String?     @unique
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  lastUsedAt   DateTime    @default(now())
  revokedAt    DateTime?
  isActive     Boolean     @default(true)
  ipAddress    String?
  userAgent    String?
  platformData Json?
  api_keys     api_keys[]
  users        users       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cli_usage    cli_usage[]

  @@index([accessToken])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([refreshToken])
  @@index([userId])
}

model cli_usage {
  id           String       @id
  sessionId    String
  requestType  String
  model        String?
  provider     String?
  tokens       Int?
  cost         Float?
  duration     Int?
  success      Boolean      @default(true)
  errorCode    String?
  errorMessage String?
  metadata     Json         @default("{}")
  timestamp    DateTime     @default(now())
  userId       String
  cli_sessions cli_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  users        users        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, model])
  @@index([sessionId, timestamp])
  @@index([timestamp])
  @@index([userId, timestamp])
}

model code_chunks {
  id                      String                    @id
  content                 String
  contentType             String
  filePath                String
  fileName                String
  fileExtension           String
  language                String
  startLine               Int?
  endLine                 Int?
  functionName            String?
  className               String?
  methodName              String?
  variableName            String?
  complexity              String?
  dependencies            String[]                  @default([])
  keywords                String[]                  @default([])
  summary                 String?
  metadata                Json                      @default("{}")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  knowledgeBaseId         String
  vectorId                String?                   @unique
  codebase_knowledge      codebase_knowledge        @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  vector_embeddings       vector_embeddings?        @relation(fields: [vectorId], references: [id])
  semantic_search_results semantic_search_results[]

  @@index([contentType, language])
  @@index([filePath])
  @@index([knowledgeBaseId, language])
}

model code_generations {
  id                String    @id
  prompt            String
  generatedCode     String?
  type              String
  framework         String?
  language          String
  aiProvider        String?
  model             String?
  tokensUsed        Int?
  generationTime    Int?
  complexity        String?
  files             Json      @default("[]")
  dependencies      String[]  @default([])
  instructions      String?
  tests             String?
  documentation     String?
  status            String    @default("completed")
  quality           String?
  validated         Boolean   @default(false)
  validationResults Json?
  used              Boolean   @default(false)
  userRating        Int?
  feedback          String?
  metadata          Json      @default("{}")
  version           String    @default("1.0.0")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  userId            String
  projectId         String?
  projects          projects? @relation(fields: [projectId], references: [id])
  users             users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([framework, language])
  @@index([projectId, type])
  @@index([userId, createdAt])
}

model codebase_knowledge {
  id                String              @id
  name              String
  description       String?
  repositoryUrl     String?
  type              String              @default("project")
  language          String?
  framework         String?
  visibility        String              @default("private")
  status            String              @default("active")
  totalFiles        Int                 @default(0)
  indexedFiles      Int                 @default(0)
  lastIndexedAt     DateTime?
  processingMeta    Json                @default("{}")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  userId            String
  projectId         String?
  code_chunks       code_chunks[]
  projects          projects?           @relation(fields: [projectId], references: [id])
  users             users               @relation(fields: [userId], references: [id], onDelete: Cascade)
  rag_sessions      rag_sessions[]
  semantic_queries  semantic_queries[]
  vector_embeddings vector_embeddings[]
}

model compilation_results {
  id                  String          @id
  solcVersion         String
  evmVersion          String
  optimizationEnabled Boolean         @default(true)
  optimizationRuns    Int             @default(200)
  success             Boolean         @default(false)
  warnings            Json            @default("[]")
  errors              Json            @default("[]")
  abi                 Json?
  bytecode            String?
  deployedBytecode    String?
  sourceMap           String?
  gasEstimates        Json?
  devdoc              Json?
  userdoc             Json?
  compilationTime     Int?
  metadata            Json?
  createdAt           DateTime        @default(now())
  contractId          String
  smart_contracts     smart_contracts @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, success])
  @@index([solcVersion, createdAt])
}

model component_templates {
  id           String   @id
  name         String
  description  String
  category     String
  framework    String
  type         String
  tags         String[] @default([])
  code         String
  dependencies String[] @default([])
  usageCount   Int      @default(0)
  quality      Float    @default(1)
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  metadata     Json     @default("{}")

  @@index([category, framework])
  @@index([description])
  @@index([lastUsedAt])
  @@index([name])
  @@index([quality])
  @@index([tags])
  @@index([type, category])
  @@index([usageCount])
}

model configurations {
  id          String   @id
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model contract_dependencies {
  id              String          @id
  name            String
  importPath      String
  version         String?
  dependencyType  String
  isDevDependency Boolean         @default(false)
  isRequired      Boolean         @default(true)
  resolvedPath    String?
  contentHash     String?
  description     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  contractId      String
  smart_contracts smart_contracts @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, importPath])
  @@index([dependencyType, version])
}

model contract_deployments {
  id                    String              @id
  contractAddress       String
  transactionHash       String
  blockNumber           BigInt
  blockTimestamp        DateTime
  deployerAddress       String
  constructorArgs       Json                @default("[]")
  gasUsed               BigInt?
  gasPrice              BigInt?
  deploymentCost        String?
  contractName          String
  contractVersion       String?
  verificationStatus    String              @default("unverified")
  verificationDate      DateTime?
  networkName           String
  chainId               Int
  isTestnet             Boolean             @default(false)
  status                String              @default("active")
  isActive              Boolean             @default(true)
  lastInteraction       DateTime?
  isUpgradeable         Boolean             @default(false)
  proxyAddress          String?
  implementationAddress String?
  description           String?
  tags                  String[]            @default([])
  metadata              Json                @default("{}")
  deploymentNotes       String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime
  projectId             String
  contractId            String
  networkId             String
  deployedBy            String
  solidityProjectId     String?
  smart_contracts       smart_contracts     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  users                 users               @relation(fields: [deployedBy], references: [id], onDelete: Cascade)
  blockchain_networks   blockchain_networks @relation(fields: [networkId], references: [id], onDelete: Cascade)
  projects              projects            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  solidity_projects     solidity_projects?  @relation(fields: [solidityProjectId], references: [id])

  @@unique([contractAddress, chainId])
  @@index([deployerAddress, createdAt])
  @@index([networkId, isActive])
  @@index([projectId, status])
}

model device_analytics {
  id              String   @id
  deviceType      String
  screenWidth     Int?
  screenHeight    Int?
  viewportWidth   Int?
  viewportHeight  Int?
  pixelRatio      Float?   @default(1.0)
  userAgent       String?
  browserName     String?
  browserVersion  String?
  platform        String?
  sessionId       String
  userId          String?
  pageUrl         String?
  component       String?
  loadTime        Int?
  renderTime      Int?
  interactionTime Int?
  breakpointUsed  String?
  layoutShifts    Int?     @default(0)
  scrollDepth     Float?
  timestamp       DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([deviceType, timestamp])
  @@index([sessionId, timestamp])
  @@index([userId, timestamp])
}

model dodo_charges {
  id                 String             @id
  subscriptionId     String
  dodoChargeId       String             @unique
  amount             Float
  currency           String             @default("USD")
  description        String
  status             String             @default("pending")
  createdAt          DateTime           @default(now())
  processedAt        DateTime?
  dodo_subscriptions dodo_subscriptions @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model dodo_subscriptions {
  id                 String         @id
  userId             String
  planId             String
  planName           String
  dodoSubscriptionId String         @unique
  status             String         @default("pending")
  amount             Float
  currency           String         @default("USD")
  nextBillingDate    DateTime
  cancelAtPeriodEnd  Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  lastPaymentAt      DateTime?
  cancelledAt        DateTime?
  dodo_charges       dodo_charges[]
  users              users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dodo_usage         dodo_usage[]
}

model dodo_usage {
  id                 String              @id
  userId             String
  subscriptionId     String?
  tokensUsed         Int
  requestsMade       Int
  aiProvider         String
  featureUsed        String
  costCents          Int
  periodStart        DateTime
  periodEnd          DateTime
  metadata           Json                @default("{}")
  createdAt          DateTime            @default(now())
  dodo_subscriptions dodo_subscriptions? @relation(fields: [subscriptionId], references: [id])
  users              users               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model dodo_webhook_events {
  id              String   @id
  provider        String   @default("dodo_payments")
  eventType       String
  payload         Json
  processed       Boolean  @default(false)
  processingError String?
  createdAt       DateTime @default(now())
}

model embedding_cache {
  id             String   @id
  contentHash    String   @unique
  content        String
  embedding      Float[]
  model          String
  provider       String
  dimension      Int
  hitCount       Int      @default(1)
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([contentHash])
  @@index([model, provider])
}

model file_uploads {
  id           String   @id
  filename     String
  originalName String
  mimetype     String
  size         Int
  path         String
  url          String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  userId       String
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model game_analytics_events {
  id             String         @id
  eventType      String
  eventName      String
  category       String?
  eventData      Json           @default("{}")
  properties     Json           @default("{}")
  metrics        Json           @default("{}")
  sessionId      String?
  userId         String?
  projectId      String?
  gameVersion    String?
  platform       String?
  deviceInfo     Json?          @default("{}")
  level          String?
  position       Json?
  serverRegion   String?
  timestamp      DateTime       @default(now())
  localTimestamp DateTime?
  sessionTime    Int?
  processed      Boolean        @default(false)
  batchId        String?
  projects       projects?      @relation(fields: [projectId], references: [id])
  game_sessions  game_sessions? @relation(fields: [sessionId], references: [sessionId])
  users          users?         @relation(fields: [userId], references: [id])

  @@index([eventType, timestamp])
  @@index([processed, timestamp])
  @@index([projectId, timestamp])
  @@index([sessionId, timestamp])
  @@index([userId, timestamp])
}

model game_assets {
  id           String    @id
  name         String
  assetType    String
  category     String?
  filePath     String?
  fileUrl      String?
  fileSize     Int?
  format       String?
  resolution   String?
  duration     Float?
  tags         String[]  @default([])
  dependencies String[]  @default([])
  metadata     Json      @default("{}")
  status       String    @default("active")
  version      String    @default("1.0.0")
