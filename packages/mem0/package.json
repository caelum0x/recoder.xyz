{
  "name": "@recoder/mem0",
  "version": "3.0.11",
  "description": "Recoder-owned vendor of the mem0 TS SDK (agent memory: LLM layer over a vector store). Merged from mem0/mem0-ts.",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./oss": {
      "types": "./dist/oss/index.d.ts",
      "require": "./dist/oss/index.js",
      "import": "./dist/oss/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "openai": "^4.93.0",
    "uuid": "^11.1.1",
    "zod": "catalog:",
    "@qdrant/js-client-rest": "^1.18.0",
    "@google/genai": "^1.40.0",
    "ollama": "^0.5.14",
    "pg": "catalog:"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "groq-sdk": "0.3.0",
    "@mistralai/mistralai": "^1.5.2",
    "@supabase/supabase-js": "catalog:",
    "redis": "^4.6.13",
    "better-sqlite3": "^12.6.2",
    "@langchain/core": "^1.1.47",
    "compromise": "^14.0.0",
    "natural": "^8.0.1"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
