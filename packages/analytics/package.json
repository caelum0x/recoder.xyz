{
  "name": "@recoder/analytics",
  "version": "1.0.0",
  "description": "Comprehensive analytics and monitoring for the Recoder.xyz ecosystem",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --noEmitOnError false --skipLibCheck",
    "build:watch": "tsc --watch --noEmitOnError false --skipLibCheck",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "analytics",
    "monitoring", 
    "telemetry",
    "recoder",
    "ai",
    "development",
    "metrics",
    "dashboard"
  ],
  "author": "Recoder.xyz Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/recoderxyz/recoder.git",
    "directory": "packages/analytics"
  },
  "homepage": "https://recoder.xyz",
  "bugs": {
    "url": "https://github.com/recoderxyz/recoder/issues"
  },
  "dependencies": {
    "events": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}