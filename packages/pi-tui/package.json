{
  "name": "@recoder/pi-tui",
  "version": "0.78.0",
  "description": "Recoder-owned vendor of pi pi-tui (merged from earendil-works/pi).",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "get-east-asian-width": "1.6.0",
    "marked": "15.0.12"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
