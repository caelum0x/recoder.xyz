{
  "name": "@recoder/runtime",
  "version": "0.1.0",
  "description": "Recoder's Runtime subsystem — drives the user's own coding-agent CLIs (Claude Code, Codex, opencode, pi, in-process) headless behind one uniform driver contract and streams every byte back to the control plane as RunEvent records.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsup",
    "check-types": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "clean": "rm -rf .turbo dist node_modules",
    "test": "node --test --import tsx 'tests/**/*.test.ts' 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@recoder/agent-os": "workspace:*",
    "@recoder/agent-runtimes": "workspace:*",
    "@recoder/agent-events": "workspace:*",
    "@recoder/pi-coding-agent": "workspace:*",
    "@recoder/pi-ai": "workspace:*",
    "@recoder/pi-agent-core": "workspace:*",
    "ai": "^5.0.133",
    "@ai-sdk/provider": "^1.1.3",
    "cross-spawn": "7.0.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  }
}
