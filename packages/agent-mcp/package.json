{
  "name": "@recoder/agent-mcp",
  "version": "0.1.0",
  "description": "MCP registry and permission contracts for Recoder Agent OS",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo dist node_modules",
    "test": "node --test --import tsx src/**/*.test.ts"
  },
  "dependencies": {
    "@recoder/agent-memory": "workspace:*",
    "@recoder/agent-os": "workspace:*",
    "@recoder/agent-policy": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  }
}
