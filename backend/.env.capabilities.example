# Self-hosted, keyless capability layer — copy the relevant lines into the
# docker-backend environment. Everything here uses your own infra (no SaaS keys).
#
# After `docker compose -f docker-compose.capabilities.yml up -d qdrant ollama`
# and pulling the Ollama models (see scripts/setup-capabilities.sh), these make
# mem0 (agent memory) and the LLM router run fully self-hosted.

# ── Agent memory (mem0 OSS) — Qdrant + Ollama, no MEM0_API_KEY ───────────────
QDRANT_URL=http://localhost:6333
MEM0_COLLECTION=recoder_mem0
MEM0_LLM_PROVIDER=ollama
MEM0_EMBEDDER_PROVIDER=ollama
MEM0_LLM_MODEL=llama3.1
MEM0_EMBED_MODEL=nomic-embed-text
# (Leave MEM0_API_KEY unset to use OSS mode. Set it only for managed mem0.)

# ── Unified LLM router — local inference, no keys ────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional self-hosted GPU inference (vLLM, OpenAI-compatible):
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# ── Browser verification (Stagehand AI checks) — reuse any local/BYO LLM ─────
# Deterministic checks need no key. AI checks use OPENAI_API_KEY/ANTHROPIC_API_KEY
# if you want them; otherwise the deterministic path is fully self-hosted.

# ── Zero-trust network (OpenZiti) — self-hosted controller, generated creds ──
# The controller (docker-compose.capabilities.yml, --profile ziti) serves a
# SELF-SIGNED cert, so the backend's Node fetch must trust its CA. Export the CA
# from the ziti-data volume and point NODE_EXTRA_CA_CERTS at it (preferred), or
# for local/dev only set NODE_TLS_REJECT_UNAUTHORIZED=0.
# ZITI_CONTROLLER_URL=https://localhost:1280   # Edge Management API host:port (1280)
# ZITI_ADMIN_USERNAME=admin
# ZITI_ADMIN_PASSWORD=recoder_ziti_admin        # matches ZITI_PWD default in compose
# ZITI_ADVERTISED_ADDRESS=localhost             # must match the host in ZITI_CONTROLLER_URL
# NODE_EXTRA_CA_CERTS=/abs/path/ziti-ca.pem     # export from: docker exec recoder-ziti-controller find /persistent -name '*.cert'
# NODE_TLS_REJECT_UNAUTHORIZED=0                # dev-only shortcut instead of the CA above

# ── Library docs (Context7) ──────────────────────────────────────────────────
# Public API works on the free tier with no key (rate-limited). For higher
# limits, set a key: CONTEXT7_API_KEY=...
# Self-hosted Context7 API (if you run one): CONTEXT7_API_URL=https://your-host/api
