    "@lmstudio/sdk": "^1.4.0",
    "@mistralai/mistralai": "^1.7.5",
    "@prisma/client": "^6.13.0",
    "@recoder/shared": "file:../packages/shared",
    "@roo-code/types": "^1.45.0",
    "@solana/web3.js": "^1.87.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/ioredis": "^4.28.10",
    "@types/json2csv": "^5.0.7",
    "@types/pg": "^8.15.5",
    "archiver": "^7.0.1",
