{
  "name": "backend",
  "version": "1.0.0",
  "description": "Recoder Backend API Server with enhanced planning and production code generation",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:prod": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:seed": "node src/db/seed.js",
    "db:reset": "prisma migrate reset --force",
    "generate": "prisma generate",
    "docker:build": "docker build -t recoder-backend .",
    "docker:run": "docker run -p 3001:3001 recoder-backend"
  },
  "keywords": [
    "api",
    "backend",
    "ai",
    "code-generation",
    "planning",
    "production"
  ],
  "author": "Recoder Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.9.1",
    "@anthropic-ai/vertex-sdk": "^0.13.0",
