# =============================================================================
# Recoder Backend — Python FastAPI Service (port 8000)
# =============================================================================
# Copy this file to .env and fill in your values.
# All Optional fields can be left empty if the feature is not needed.

# =============================================================================
# ENVIRONMENT
# =============================================================================

# Environment mode: "local", "staging", or "production"
ENV_MODE=local

# Number of uvicorn workers (default: 16)
WORKERS=16

# Frontend URL — used for CORS and redirect links
# Production: https://recoder.xyz | Local: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# =============================================================================
# DATABASE
# =============================================================================

# Primary PostgreSQL connection string (Neon, Supabase, or self-hosted)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional: read-replica for SELECT queries (improves performance)
# DATABASE_READ_REPLICA_URL=postgresql://user:password@read-host:5432/dbname?sslmode=require

# Optional: connection used by pooler (e.g. PgBouncer)
# DATABASE_POOLER_URL=

# Shared auth database — Better Auth sessions (cross-subdomain SSO)
# MUST point to the same database used by recoder-app for user/session tables
AUTH_DATABASE_URL=postgresql://user:password@host:5432/authdb?sslmode=require

# Secret for database-triggered webhook authentication
# DATABASE_WEBHOOK_SECRET=

# PostgreSQL tuning
# POSTGRES_RETRY_DELAY=0.1
# POSTGRES_USE_NULLPOOL=auto
# POSTGRES_ECHO=false

# =============================================================================
# REDIS
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_USERNAME=
# REDIS_SSL=false
# REDIS_MAX_CONNECTIONS=300

# Redis pool tuning (optional)
# REDIS_GENERAL_POOL_SIZE=200
# REDIS_STREAM_POOL_SIZE=50
# REDIS_OP_TIMEOUT=5.0
# REDIS_STREAM_TIMEOUT=10.0
# REDIS_SOCKET_TIMEOUT=10.0
# REDIS_SOCKET_CONNECT_TIMEOUT=5.0
# REDIS_HEALTH_CHECK_INTERVAL=15

# =============================================================================
# AI / LLM PROVIDERS
# =============================================================================

# Primary LLM provider: "bedrock", "anthropic", "minimax", "grok", "openai"
MAIN_LLM=bedrock

# Optional: override the default model for the selected provider
# MAIN_LLM_MODEL=

# Anthropic (required if MAIN_LLM=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (required for search embeddings, transcription, etc.)
OPENAI_API_KEY=sk-your-openai-key-here

# OpenRouter (alternative multi-model gateway)
OPENROUTER_API_KEY=sk-or-your-key-here
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OR_SITE_URL=https://www.recoder.xyz
# OR_APP_NAME=Recoder.xyz

# AWS Bedrock (required if MAIN_LLM=bedrock)
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-token
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_DEFAULT_REGION=us-west-2

# Additional AI providers (optional)
# GROQ_API_KEY=
# XAI_API_KEY=
# GEMINI_API_KEY=
# VOYAGE_API_KEY=
# MORPH_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_API_BASE=

# Replicate (image generation models)
# REPLICATE_API_TOKEN=

# =============================================================================
# MEMORY & KNOWLEDGE BASE
# =============================================================================

ENABLE_MEMORY=false
ENABLE_KNOWLEDGE_BASE=true
ENABLE_USER_CONTEXT=true

# Memory embedding configuration
# MEMORY_EMBEDDING_PROVIDER=openai
# MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_EXTRACTION_MODEL=recoder/basic

# =============================================================================
# SANDBOX (DAYTONA)
# =============================================================================
# Sandbox features are disabled if these are not configured.

# DAYTONA_API_KEY=your-daytona-api-key
# DAYTONA_SERVER_URL=https://your-daytona-server.com
# DAYTONA_TARGET=

# Sandbox pool tuning (optional)
# SANDBOX_POOL_ENABLED=false
# SANDBOX_POOL_MIN_SIZE=2
# SANDBOX_POOL_MAX_SIZE=10
# SANDBOX_POOL_REPLENISH_THRESHOLD=0.5
# SANDBOX_POOL_CHECK_INTERVAL=60
# SANDBOX_POOL_MAX_AGE=3600
# SANDBOX_POOL_PARALLEL_CREATE=3
# SANDBOX_POOL_BATCH_DELAY=1

# =============================================================================
# S3-COMPATIBLE STORAGE (AWS S3, Cloudflare R2, MinIO)
# =============================================================================

# S3_ENDPOINT_URL=https://your-s3-endpoint.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_REGION=auto
# S3_BUCKET_PREFIX=
# S3_PUBLIC_URL=

# =============================================================================
# SEARCH & TOOL API KEYS (all optional — tools disabled if not set)
# =============================================================================

# TAVILY_API_KEY=your-tavily-key
# RAPID_API_KEY=your-rapid-api-key
# SERPER_API_KEY=your-serper-key
# FIRECRAWL_API_KEY=your-firecrawl-key
# FIRECRAWL_URL=https://api.firecrawl.dev
# EXA_API_KEY=your-exa-key
# SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-key

# Apify (web scraping)
# APIFY_API_TOKEN=your-apify-token

# Reality Defender (deepfake detection)
# REALITY_DEFENDER_API_KEY=your-reality-defender-key

# Cloudflare (DNS/tunnels)
# CLOUDFLARE_API_TOKEN=your-cloudflare-token

# =============================================================================
# STRIPE BILLING
# =============================================================================

# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# STRIPE_DEFAULT_PLAN_ID=
# STRIPE_DEFAULT_TRIAL_DAYS=14

# =============================================================================
# REVENUECAT (MOBILE IN-APP PURCHASES)
# =============================================================================

# REVENUECAT_WEBHOOK_SECRET=
# REVENUECAT_API_KEY=
# REVENUECAT_PROJECT_ID=

# =============================================================================
# AUTH
# =============================================================================

# Auth provider URL and admin key (for session/auth flows)
# AUTH_PROVIDER_URL=
# AUTH_PROVIDER_ADMIN_KEY=

# Admin API key for server-side operations (auto-generated if not set)
# RECODER_ADMIN_API_KEY=your-admin-api-key

# API key system
# API_KEY_SECRET=default-secret-key-change-in-production

# MCP credential encryption
# MCP_CREDENTIAL_ENCRYPTION_KEY=your-32-byte-encryption-key
# ENCRYPTION_KEY=your-encryption-key

# System admin user ID (owns shared/fallback agents)
# SYSTEM_ADMIN_USER_ID=

# =============================================================================
# TWILIO (PHONE MFA)
# =============================================================================

# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM_NUMBER=+1234567890
# PHONE_NUMBER_MANDATORY=false

# =============================================================================
# COMPOSIO INTEGRATION
# =============================================================================

# COMPOSIO_API_KEY=your-composio-key
# COMPOSIO_API_BASE=https://backend.composio.dev
# COMPOSIO_WEBHOOK_SECRET=your-composio-webhook-secret

# =============================================================================
# WEBHOOKS & TRIGGERS
# =============================================================================

# WEBHOOK_BASE_URL=https://api.recoder.xyz
# TRIGGER_WEBHOOK_SECRET=your-trigger-webhook-secret
# VERCEL_PROTECTION_BYPASS_KEY=

# =============================================================================
# EMAIL (MAILTRAP)
# =============================================================================

# MAILTRAP_API_TOKEN=your-mailtrap-token
# MAILTRAP_SENDER_EMAIL=hey@recoder.xyz
# MAILTRAP_SENDER_NAME=Recoder Team

# =============================================================================
# GOOGLE INTEGRATION (Docs, Slides)
# =============================================================================

# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/v1/google/callback

# =============================================================================
# OBSERVABILITY
# =============================================================================

# LangFuse (LLM tracing)
# LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
# LANGFUSE_SECRET_KEY=your-langfuse-secret-key
# LANGFUSE_HOST=https://cloud.langfuse.com

# Braintrust (evaluation)
# BRAINTRUST_API_KEY=your-braintrust-key

# Novu (notifications)
# NOVU_SECRET_KEY=your-novu-secret-key
# NOVU_BACKEND_URL=https://api.novu.co

# Google Analytics (admin dashboard)
# GA_PROPERTY_ID=516492562
# GA_CREDENTIALS_JSON=

# Vercel Analytics
# VERCEL_DRAIN_SECRET=

# =============================================================================
# LOGGING
# =============================================================================

# LOGGING_LEVEL=DEBUG
# CLOUDWATCH_LOGGING_ENABLED=false
# CLOUDWATCH_LOG_LEVEL=INFO
# CLOUDWATCH_LOG_GROUP=recoder-backend
# CLOUDWATCH_LOG_STREAM=

# =============================================================================
# VAPI (VOICE)
# =============================================================================

# VAPI_PRIVATE_KEY=your-vapi-key
# VAPI_PHONE_NUMBER_ID=
# VAPI_SERVER_URL=

# =============================================================================
# FREESTYLE (DEPLOYMENT)
# =============================================================================

# FREESTYLE_API_KEY=your-freestyle-key

# =============================================================================
# AGENT EXECUTION
# =============================================================================

# MAX_PARALLEL_AGENT_RUNS=3
# AGENT_RUN_TIMEOUT_SECONDS=3000
# AGENT_STOP_CHECK_INTERVAL=2.0
# METRICS_LOG_INTERVAL_SECONDS=300

# Presence tracking (set to true to disable)
# DISABLE_PRESENCE=true

# Debug: save LLM API call inputs/outputs (never in production)
# DEBUG_SAVE_LLM_IO=false
# MOCK_IMAGE_GENERATION=false

# =============================================================================
# HTTP CLIENT TUNING
# =============================================================================

# HTTP_MAX_CONNECTIONS=100
# HTTP_MAX_KEEPALIVE=50
# HTTP_CONNECT_TIMEOUT=10.0
# HTTP_READ_TIMEOUT=60.0
# HTTP_WRITE_TIMEOUT=30.0
# HTTP_POOL_TIMEOUT=30.0
# HTTP_RETRIES=3

# =============================================================================
# LITELLM TUNING
# =============================================================================

# LITELLM_NUM_RETRIES=1
# LITELLM_STREAM_TIMEOUT=300

# =============================================================================
# STRESS TEST (ADMIN ONLY)
# =============================================================================

# STRESS_TEST_ALB_URL=
# STRESS_TEST_HOST_HEADER=api.recoder.xyz
# STRESS_TEST_BASE_URL=
