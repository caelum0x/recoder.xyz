# ==============================================
# RECODER BACKEND - Environment Configuration
# ==============================================
# Copy this to .env and configure based on your setup
# 
# 🚀 LOCAL DEVELOPMENT: Works with minimal setup
# 🌐 PRODUCTION: Configure all sections for full functionality

#====================================
# 🏗️ CORE SERVER CONFIGURATION
#====================================

# Server Settings
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# API Configuration
API_BASE_URL=http://localhost:3001
API_VERSION=v1

#====================================
# 🔐 AUTHENTICATION & SECURITY
#====================================

# JWT Configuration (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-256-bits-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your-session-secret-key-here
COOKIE_SECRET=your-cookie-secret-here

#====================================
# 🗄️ DATABASE CONFIGURATION
#====================================

# PostgreSQL Database (Primary)
DATABASE_URL=postgresql://postgres:password@localhost:5432/recoder_db

# Redis Cache & Sessions (Optional but recommended)
REDIS_URL=redis://localhost:6379

# Database Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10

#====================================
# 🤖 AI PROVIDERS - SAME AS CLI
#====================================

# Local AI (No API Keys Required)
OLLAMA_BASE_URL=http://localhost:11434

# Primary AI Providers
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_API_KEY=your-google-gemini-api-key-here
GROQ_API_KEY=gsk_your-groq-api-key-here

# Specialized Providers
MISTRAL_API_KEY=your-mistral-api-key-here
PERPLEXITY_API_KEY=pplx-your-perplexity-api-key-here
COHERE_API_KEY=your-cohere-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Regional Providers
KIMI_API_KEY=your-kimi-api-key-here
MOONSHOT_API_KEY=your-moonshot-api-key-here
QWEN_API_KEY=your-qwen-api-key-here
DASHSCOPE_API_KEY=your-dashscope-api-key-here
TOGETHER_API_KEY=your-together-api-key-here

#====================================
# 💰 PAYMENT PROCESSING
#====================================

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_endpoint_secret_here

# Stripe Price IDs (from your Stripe Dashboard)
STRIPE_FREE_PRICE_ID=price_free
STRIPE_PREMIUM_PRICE_ID=price_premium_monthly_20_usd
STRIPE_PRO_PRICE_ID=price_pro_monthly_100_usd
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_custom

# Alternative Payment Providers (Optional)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

#====================================
# 📊 USAGE LIMITS & QUOTAS
#====================================

# Free Tier (Ollama only)
FREE_TOKEN_LIMIT=0
FREE_REQUEST_LIMIT=100
FREE_DAILY_LIMIT=10

# Premium Tier ($20/month)
PREMIUM_TOKEN_LIMIT=500000
PREMIUM_REQUEST_LIMIT=5000
PREMIUM_COST_BUDGET=15.00

# Pro Tier ($100/month)
PRO_TOKEN_LIMIT=2500000
PRO_REQUEST_LIMIT=25000
PRO_COST_BUDGET=75.00

# Enterprise Tier (Unlimited)
ENTERPRISE_TOKEN_LIMIT=-1
ENTERPRISE_REQUEST_LIMIT=-1
ENTERPRISE_COST_BUDGET=-1

#====================================
# 🎯 AI MODEL COST OPTIMIZATION
#====================================

# Cost per 1M tokens (for budget tracking)
ANTHROPIC_COST_PER_1M=3.00
OPENAI_COST_PER_1M=2.00
GOOGLE_COST_PER_1M=1.25
GROQ_COST_PER_1M=0.27
MISTRAL_COST_PER_1M=0.25
DEEPSEEK_COST_PER_1M=0.14
COHERE_COST_PER_1M=1.00

# Usage distribution percentages
DEEPSEEK_USAGE_PERCENT=40
GROQ_USAGE_PERCENT=25
OLLAMA_USAGE_PERCENT=20
ANTHROPIC_USAGE_PERCENT=10
GOOGLE_USAGE_PERCENT=5

#====================================
# 📧 EMAIL & NOTIFICATIONS
#====================================

# SMTP Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SendGrid (Alternative)
# SENDGRID_API_KEY=your-sendgrid-api-key

#====================================
# 📈 ANALYTICS & MONITORING
#====================================

# Google Analytics (Optional)
GA_TRACKING_ID=UA-your-tracking-id

# Sentry Error Tracking (Optional)
SENTRY_DSN=your-sentry-dsn-here

# OpenTelemetry (Optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

#====================================
# 🔧 SERVICE INTEGRATIONS
#====================================

# GitHub Integration (for repository access)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Docker Registry (for deployments)
DOCKER_REGISTRY_URL=your-registry-url
DOCKER_REGISTRY_USERNAME=your-username
DOCKER_REGISTRY_PASSWORD=your-password

#====================================
# 🚀 PRODUCTION ENGINE CONNECTION
#====================================

# Production Code Generation Engine
PRODUCTION_ENGINE_URL=http://localhost:3002
PRODUCTION_ENGINE_SECRET=your-production-engine-secret

#====================================
# 🌐 CROSS-PLATFORM URLS
#====================================

# Frontend URLs (for CORS and redirects)
WEB_URL=http://localhost:3000
CLI_DOCS_URL=http://localhost:3000/docs
EXTENSION_STORE_URL=https://marketplace.visualstudio.com

# Production URLs (uncomment for production)
# WEB_URL=https://recoder.xyz
# API_BASE_URL=https://api.recoder.xyz
# CLI_DOCS_URL=https://recoder.xyz/docs

#====================================
# 📝 LOGGING & DEBUG
#====================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Enable specific debug namespaces
DEBUG=recoder:*

# Log File Paths
LOG_FILE_PATH=./logs/combined.log
ERROR_LOG_PATH=./logs/error.log

#====================================
# 💡 LOCAL DEVELOPMENT SETUP
#====================================
# 
# Quick Start (No API Keys):
# 1. Install PostgreSQL: brew install postgresql
# 2. Install Redis: brew install redis  
# 3. Create database: createdb recoder_db
# 4. Install Ollama: brew install ollama
# 5. Start services: redis-server & ollama serve
# 6. Run: npm run dev
# 
# ✅ Backend will work locally with just Ollama!
# 
# 🚀 For full functionality:
#   - Add Stripe keys for payments
#   - Add AI provider keys for enhanced models
#   - Configure SMTP for email notifications