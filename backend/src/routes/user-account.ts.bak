import { Router, Request, Response } from 'express';
import { body, validationResult } from 'express-validator';
import { authenticate } from '../middleware/auth';
import prisma from '../database/prisma';
import bcrypt from 'bcrypt';
import multer from 'multer';
import sharp from 'sharp';
import { v4 as uuidv4 } from 'uuid';
import path from 'path';
import fs from 'fs/promises';

const router = Router();

// Configure multer for avatar uploads
const storage = multer.memoryStorage();
const upload = multer({
  storage,
  limits: {
    fileSize: 5 * 1024 * 1024, // 5MB limit
  },
  fileFilter: (req, file, cb) => {
    if (file.mimetype.startsWith('image/')) {
      cb(null, true);
    } else {
      cb(new Error('Only image files are allowed'));
    }
  },
});

/**
 * GET /api/user/account/profile
 * Get user profile information
 */
router.get('/profile', authenticate, async (req: Request, res: Response): Promise<void> => {
  try {
    const userId = req.user?.id;
    if (!userId) {
      return res.status(401).json({ error: 'Unauthorized' });
    }

    const user = await prisma.user.findUnique({
      where: { id: userId },
      select: {
        id: true,
        email: true,
        name: true,
        organization: true,
        role: true,
        isActive: true,
        emailVerified: true,
        subscription: true,
        lastLoginAt: true,
        createdAt: true,
        updatedAt: true,
        preferences: {
          select: {
            uiPreferences: true,
            themePreferences: true,
            languagePreferences: true,
            notificationPreferences: true,
            privacyPreferences: true,
            accessibilityPreferences: true,
            developerPreferences: true
          }
        },
        _count: {
          select: {
            projects: true,
            templates: true
          }
        }
      }
    });

    if (!user) {
      return res.status(404).json({ error: 'User not found' });
    }

    res.json({
      resource: "user_account",
        resourceId: userId,
      user: {
        ...user,
        stats: {
          projectCount: user._count.projects,
          templateCount: user._count.templates
        }
      }
    });

  } catch (error) {
    console.error('Profile fetch error:', error);
    res.status(500).json({ error: 'Failed to fetch user profile' });
  }
});

/**
 * PUT /api/user/account/profile
 * Update user profile information
 */
router.put('/profile', [
  authenticate,
  body('name').optional().isLength({ min: 1, max: 100 }).withMessage('Name must be 1-100 characters'),
  body('organization').optional().isLength({ max: 100 }).withMessage('Organization must be max 100 characters'),
  body('bio').optional().isLength({ max: 500 }).withMessage('Bio must be max 500 characters'),
  body('location').optional().isLength({ max: 100 }).withMessage('Location must be max 100 characters'),
  body('website').optional().isURL().withMessage('Website must be a valid URL'),
  body('timezone').optional().isString().withMessage('Timezone must be a string'),
  body('language').optional().isString().withMessage('Language must be a string')
], async (req: Request, res: Response): Promise<void> => {
  try {
    const errors = validationResult(req);
    if (!errors.isEmpty()) {
      return res.status(400).json({
        error: 'Validation failed',
        details: errors.array()
      });
    }

    const userId = req.user?.id;
    if (!userId) {
      return res.status(401).json({ error: 'Unauthorized' });
    }

    const { name, organization, bio, location, website, timezone, language } = req.body;

    // Update user basic info
    const updateData: any = {};
    if (name !== undefined) updateData.name = name;
    if (organization !== undefined) updateData.organization = organization;

    // Update or create user preferences
    const preferencesData: any = {};
    if (bio !== undefined) preferencesData.bio = bio;
    if (location !== undefined) preferencesData.location = location;
    if (website !== undefined) preferencesData.website = website;
    if (timezone !== undefined) preferencesData.timezone = timezone;
    if (language !== undefined) preferencesData.language = language;

    const [updatedUser] = await Promise.all([
      // Update user basic info
      Object.keys(updateData).length > 0 ? prisma.user.update({
        where: { id: userId },
        data: updateData
      }) : null,
      
      // Update preferences
      Object.keys(preferencesData).length > 0 ? prisma.userPreferences.upsert({
        where: { userId },
        create: {
          userId,
          ...preferencesData
        },
        update: preferencesData
      }) : null
    ]);

    // Log profile update
    await prisma.auditLog.create({
      data: {
        userId,
        action: 'profile_updated',
        resource: 'user_profile',
        resourceId: userId,
        metadata: {
          updatedFields: [...Object.keys(updateData), ...Object.keys(preferencesData)]
        }
      }
    });

    res.json({
      resource: "user_account",
        resourceId: userId,
      message: 'Profile updated successfully'
    });

  } catch (error) {
    console.error('Profile update error:', error);
    res.status(500).json({ error: 'Failed to update profile' });
  }
});

/**
 * POST /api/user/account/avatar
 * Upload and update user avatar
 */
router.post('/avatar', [
  authenticate,
  upload.single('avatar')
], async (req: Request, res: Response): Promise<void> => {
  try {
    const userId = req.user?.id;
    if (!userId) {
      return res.status(401).json({ error: 'Unauthorized' });
    }

    if (!req.file) {
      return res.status(400).json({ error: 'No image file provided' });
    }

    // Create uploads directory if it doesn't exist
    const uploadsDir = path.join(process.cwd(), 'uploads', 'avatars');
    await fs.mkdir(uploadsDir, { recursive: true });

    // Generate unique filename
    const fileExtension = path.extname(req.file.originalname) || '.jpg';
    const filename = `${userId}_${uuidv4()}${fileExtension}`;
    const filePath = path.join(uploadsDir, filename);

    // Process image with sharp (resize, optimize)
    await sharp(req.file.buffer)
      .resize(200, 200, {
        fit: 'cover',
        position: 'center'
      })
      .jpeg({ quality: 90 })
      .toFile(filePath);

    // Update user preferences with avatar path
    const avatarUrl = `/uploads/avatars/${filename}`;
    await prisma.userPreferences.upsert({
      where: { userId },
      create: {
        userId,
        uiPreferences: { avatar: avatarUrl }
      },
      update: {
        uiPreferences: { avatar: avatarUrl }
      }
    });

    // Log avatar update
    await prisma.auditLog.create({
      data: {
        userId,
        action: 'avatar_updated',
        resource: 'user_avatar',
        resourceId: userId,
        metadata: {
          filename,
          fileSize: req.file.size
        }
      }
    });

    res.json({
      resource: "user_account",
        resourceId: userId,
      message: 'Avatar updated successfully',
      avatarUrl
    });

  } catch (error) {
    console.error('Avatar upload error:', error);
    res.status(500).json({ error: 'Failed to upload avatar' });
  }
});

/**
 * POST /api/user/account/change-password
 * Change user password
 */
router.post('/change-password', [
  authenticate,
  body('currentPassword').isLength({ min: 1 }).withMessage('Current password is required'),
  body('newPassword').isLength({ min: 8 }).withMessage('New password must be at least 8 characters'),
  body('confirmPassword').custom((value, { req }) => {
    if (value !== req.body.newPassword) {
      throw new Error('Password confirmation does not match');
    }
    return true;
  })
], async (req: Request, res: Response): Promise<void> => {
  try {
    const errors = validationResult(req);
    if (!errors.isEmpty()) {
      return res.status(400).json({
        error: 'Validation failed',
        details: errors.array()
      });
    }

    const userId = req.user?.id;
    if (!userId) {
      return res.status(401).json({ error: 'Unauthorized' });
    }

    const { currentPassword, newPassword } = req.body;

    // Get current user with password
    const user = await prisma.user.findUnique({
      where: { id: userId },
      select: { id: true, password: true }
    });

    if (!user || !user.password) {
      return res.status(400).json({ error: 'Unable to change password' });
    }

    // Verify current password
    const isCurrentPasswordValid = await bcrypt.compare(currentPassword, user.password);
    if (!isCurrentPasswordValid) {
      return res.status(400).json({ error: 'Current password is incorrect' });
    }

    // Hash new password
    const hashedNewPassword = await bcrypt.hash(newPassword, 12);

    // Update password
    await prisma.user.update({
      where: { id: userId },
      data: { password: hashedNewPassword }
    });

    // Log password change
    await prisma.auditLog.create({
      data: {
        userId,
        action: 'password_changed',
        resource: "user_account",
        resourceId: userId,
        metadata: {
          timestamp: new Date()
        }
      }
    });

    res.json({
      resource: "user_account",
        resourceId: userId,
      message: 'Password changed successfully'
    });

  } catch (error) {
    console.error('Password change error:', error);
    res.status(500).json({ error: 'Failed to change password' });
  }
});

/**
 * GET /api/user/account/export-data
 * Export user data for GDPR compliance
 */
router.get('/export-data', authenticate, async (req: Request, res: Response): Promise<void> => {
  try {
    const userId = req.user?.id;
    if (!userId) {
      return res.status(401).json({ error: 'Unauthorized' });
    }

    // Collect all user data
    const [user, projects, templates, agents, usageRecords, auditLogs, preferences] = await Promise.all([
      prisma.user.findUnique({
        where: { id: userId },
        select: {
          id: true,
          email: true,
          name: true,
          organization: true,
          role: true,
          subscription: true,
          createdAt: true,
          updatedAt: true,
          lastLoginAt: true
        }
      }),
      prisma.project.findMany({
        where: { userId },
        select: {
          id: true,
          name: true,
          type: true,
          description: true,
          status: true,
          createdAt: true,
          updatedAt: true
        }
      }),
      prisma.template.findMany({
        where: { userId },
        select: {
          id: true,
          name: true,
          category: true,
          description: true,
          createdAt: true
        }
      }),
      prisma.agent.findMany({
        where: { userId },
        select: {
          id: true,
          name: true,
          type: true,
          description: true,
          createdAt: true
        }
      }),
      prisma.usageRecord.findMany({
        where: { userId },
        select: {
          id: true,
          type: true,
          tokens: true,
          timestamp: true
        }
      }),
      prisma.auditLog.findMany({
        where: { userId },
        select: {
          id: true,
          action: true,
          resource: true,
          timestamp: true
        }
      }),
      prisma.userPreferences.findUnique({
        where: { userId }
      })
    ]);

    const exportData = {
      exportDate: new Date().toISOString(),
      user,
      projects,
      templates,
      agents,
      usageRecords,
      auditLogs,
      preferences,
      summary: {
        totalProjects: projects.length,
        totalTemplates: templates.length,
        totalAgents: agents.length,
        totalUsageRecords: usageRecords.length,
        totalAuditLogs: auditLogs.length
      }
    };

    // Log data export
    await prisma.auditLog.create({
      data: {
        userId,
        action: 'data_exported',
        resource: "user_account",
        resourceId: userId,
        metadata: {
          exportSize: JSON.stringify(exportData).length,
          timestamp: new Date()
        }
      }
    });

    res.json({
      resource: "user_account",
        resourceId: userId,
      data: exportData
    });

  } catch (error) {
    console.error('Data export error:', error);
    res.status(500).json({ error: 'Failed to export user data' });
  }
});

/**
 * POST /api/user/account/deactivate
 * Deactivate user account
 */
router.post('/deactivate', [
  authenticate,
  body('password').isLength({ min: 1 }).withMessage('Password is required for account deactivation'),
  body('reason').optional().isLength({ max: 500 }).withMessage('Reason must be max 500 characters')
], async (req: Request, res: Response): Promise<void> => {
  try {
    const errors = validationResult(req);
    if (!errors.isEmpty()) {
      return res.status(400).json({
        error: 'Validation failed',
        details: errors.array()
      });
    }

    const userId = req.user?.id;
    if (!userId) {
      return res.status(401).json({ error: 'Unauthorized' });
    }

    const { password, reason } = req.body;

    // Get current user with password
    const user = await prisma.user.findUnique({
      where: { id: userId },
      select: { id: true, password: true }
    });

    if (!user || !user.password) {
      return res.status(400).json({ error: 'Unable to deactivate account' });
    }

    // Verify password
    const isPasswordValid = await bcrypt.compare(password, user.password);
    if (!isPasswordValid) {
      return res.status(400).json({ error: 'Password is incorrect' });
    }

    // Deactivate account
    await prisma.user.update({
      where: { id: userId },
      data: { 
        isActive: false,
        updatedAt: new Date()
      }
    });

    // Log account deactivation
    await prisma.auditLog.create({
      data: {
        userId,
        action: 'account_deactivated',
        resource: "user_account",
        resourceId: userId,
        metadata: {
          reason: reason || 'No reason provided',
          timestamp: new Date()
        }
      }
    });

    res.json({
      resource: "user_account",
        resourceId: userId,
      message: 'Account deactivated successfully'
    });

  } catch (error) {
    console.error('Account deactivation error:', error);
    res.status(500).json({ error: 'Failed to deactivate account' });
  }
});

/**
 * DELETE /api/user/account/delete
 * Permanently delete user account
 */
router.delete('/delete', [
  authenticate,
  body('password').isLength({ min: 1 }).withMessage('Password is required for account deletion'),
  body('confirmation').equals('DELETE_MY_ACCOUNT').withMessage('Confirmation text must be "DELETE_MY_ACCOUNT"')
], async (req: Request, res: Response): Promise<void> => {
  try {
    const errors = validationResult(req);
    if (!errors.isEmpty()) {
      return res.status(400).json({
        error: 'Validation failed',
        details: errors.array()
      });
    }

    const userId = req.user?.id;
    if (!userId) {
      return res.status(401).json({ error: 'Unauthorized' });
    }

    const { password } = req.body;

    // Get current user with password
    const user = await prisma.user.findUnique({
      where: { id: userId },
      select: { id: true, password: true }
    });

    if (!user || !user.password) {
      return res.status(400).json({ error: 'Unable to delete account' });
    }

    // Verify password
    const isPasswordValid = await bcrypt.compare(password, user.password);
    if (!isPasswordValid) {
      return res.status(400).json({ error: 'Password is incorrect' });
    }

    // Log account deletion before deletion
    await prisma.auditLog.create({
      data: {
        userId,
        action: 'account_deleted',
        resource: "user_account",
        resourceId: userId,
        metadata: {
          timestamp: new Date(),
          deletionType: 'permanent'
        }
      }
    });

    // Delete user (cascade will handle related records)
    await prisma.user.delete({
      where: { id: userId }
    });

    res.json({
      resource: "user_account",
        resourceId: userId,
      message: 'Account deleted successfully'
    });

  } catch (error) {
    console.error('Account deletion error:', error);
    res.status(500).json({ error: 'Failed to delete account' });
  }
});

export default router;