// Mobile-specific database schema extensions
// Add these models to your main schema.prisma file

model UserDevice {
  id                      String    @id @default(cuid())
  userId                  String
  deviceId                String
  platform                String    // 'ios' or 'android'
  version                 String
  model                   String?
  pushToken               String?
  notificationPreferences Json?
  isActive                Boolean   @default(true)
  lastSeenAt              DateTime
  lastSyncAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unique constraints
  @@unique([userId, deviceId])
  @@map("user_devices")
}

model MobileSession {
  id           String    @id @default(cuid())
  userId       String
  deviceId     String
  sessionToken String    @unique
  refreshToken String    @unique
  expiresAt    DateTime
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mobile_sessions")
}

model OfflineAction {
  id         String    @id @default(cuid())
  userId     String
  deviceId   String
  uuid       String    @unique // Client-generated UUID for deduplication
  type       String    // 'create', 'update', 'delete'
  resource   String    // 'project', 'file', 'generation'
  data       Json
  timestamp  DateTime
  synced     Boolean   @default(false)
  syncedAt   DateTime?
  retries    Int       @default(0)
  error      String?
  createdAt  DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, synced])
  @@index([deviceId])
  @@map("offline_actions")
}

model MobileAnalytics {
  id         String   @id @default(cuid())
  userId     String?
  deviceId   String
  platform   String
  event      String   // 'app_open', 'code_generation', 'project_create', etc.
  properties Json?
  timestamp  DateTime
  sessionId  String?
  createdAt  DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([event])
  @@map("mobile_analytics")
}

model PushNotification {
  id        String    @id @default(cuid())
  userId    String
  deviceId  String?   // null for broadcast to all user devices
  title     String
  body      String
  data      Json?
  scheduled DateTime?
  sent      Boolean   @default(false)
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scheduled])
  @@index([sent])
  @@map("push_notifications")
}

// Extend existing models with mobile-specific fields
model Project {
  // ... existing fields
  mobileOptimized  Boolean @default(false)
  mobileFramework  String? // 'react-native', 'flutter', 'ionic'
  deploymentConfig Json?   // Mobile deployment configuration
  
  // Add mobile-specific relations if needed
  mobileBuilds MobileBuild[]
}

model MobileBuild {
  id           String    @id @default(cuid())
  projectId    String
  platform     String    // 'ios', 'android', 'both'
  buildNumber  String
  version      String
  status       String    // 'pending', 'building', 'success', 'failed'
  buildLog     String?
  downloadUrl  String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("mobile_builds")
}

model CodeGeneration {
  // ... existing fields
  isMobile        Boolean @default(false)
  mobileFramework String?
  platformTargets String[] // ['ios', 'android', 'web']
  complexity      String?  // 'simple', 'intermediate', 'advanced'
}

model Usage {
  // ... existing fields
  isMobile Boolean @default(false)
}

// Add mobile-specific relations to User model
model User {
  // ... existing fields
  devices         UserDevice[]
  mobileSessions  MobileSession[]
  offlineActions  OfflineAction[]
  mobileAnalytics MobileAnalytics[]
  pushNotifications PushNotification[]
}

