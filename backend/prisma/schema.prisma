// Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String?   // Optional for OAuth users
  name            String
  organization    String?
  role            String    @default("user")
  isActive        Boolean   @default(true)
  emailVerified   Boolean   @default(false)
  subscription    String    @default("free")
  apiKey          String?   @unique
  refreshToken    String?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  projects        Project[]
  templates       Template[]
  agents          Agent[]
  usageRecords    UsageRecord[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  paymentMethods  PaymentMethod[]
  devices         UserDevice[]
  syncStates      SyncState[]
  oauthAccounts   OAuthAccount[]
  integrations    Integration[]
  apiKeys         ApiKey[]
  auditLogs       AuditLog[]
  notifications   NotificationSettings?
  fileUploads     FileUpload[]
  webhooks        Webhook[]
  analytics       UsageAnalytics[]
  dodoSubscriptions DodoSubscription[]
  dodoUsage       DodoUsage[]
  knowledgeBases  CodebaseKnowledge[]
  semanticQueries SemanticQuery[]
  ragSessions     RAGSession[]
  restoreJobs     RestoreJob[]
  backupAccess    BackupAccess?
  preferences     UserPreferences?
  translations    Translation[]
  userRoles       UserRole[]
  
  // Analytics Report Relations
  analyticsReports        AnalyticsReport[]
  reportExecutions        ReportExecution[]
  reportExports           ReportExport[]
  reportSchedules         ReportSchedule[]
  scheduledExecutions     ScheduledExecution[]
  sharedReports           ReportShare[] @relation("SharedReports")
  receivedShares          ReportShareRecipient[] @relation("ReceivedShares")
  reportShareAccesses     ReportShareAccess[]
  authoredComments        ReportComment[] @relation("AuthoredComments")
  moderatedComments       ReportComment[] @relation("ModeratedComments")

  @@map("users")
}

model Project {
  id                      String    @id @default(cuid())
  name                    String
  type                    String    // web, mobile, desktop, api, blockchain, ai
  description             String?
  status                  String    @default("planning") // planning, active, completed, archived
  config                  Json      @default("{}")
  structure               Json?
  lastGenerated           DateTime?
  generatedCodeMetadata   Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Foreign keys
  userId                  String
  templateId              String?

  // Relations
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  template                Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  agents                  Agent[]
  usageRecords            UsageRecord[]
  analytics               UsageAnalytics[]
  knowledgeBases          CodebaseKnowledge[]

  @@map("projects")
}

model Template {
  id          String    @id @default(cuid())
  name        String
  category    String    // web, mobile, desktop, api, blockchain, ai
  description String?
  structure   Json
  config      Json      @default("{}")
  public      Boolean   @default(false)
  version     String    @default("1.0.0")
  imported    Boolean   @default(false)
  originalTemplateId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Foreign keys
  userId      String

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects    Project[]

  @@map("templates")
}

model Agent {
  id          String    @id @default(cuid())
  name        String
  type        String    // code, chat, analysis, deployment
  description String?
  config      Json      @default("{}")
  status      String    @default("inactive") // active, inactive, training, error
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Foreign keys
  userId      String
  projectId   String?

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  usageRecords UsageRecord[]

  @@map("agents")
}

model UsageRecord {
  id          String    @id @default(cuid())
  type        String    // api_usage, model_usage, code_generation, bandwidth, etc.
  metadata    Json      @default("{}")
  tokens      Int?
  cost        Float?
  duration    Int?
  success     Boolean   @default(true)
  timestamp   DateTime  @default(now())

  // Foreign keys
  userId      String
  projectId   String?
  agentId     String?

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agent       Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@map("usage_records")
}

model Subscription {
  id                    String    @id @default(cuid())
  planId                String
  status                String    // active, inactive, cancelled, past_due
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean   @default(false)
  cancelledAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Foreign keys
  userId                String
  paymentMethodId       String?

  // Relations
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethod         PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  invoices              Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id              String    @id @default(cuid())
  amount          Float
  currency        String    @default("USD")
  status          String    // draft, open, paid, void, uncollectible
  description     String?
  items           Json      @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  paidAt          DateTime?
  voidedAt        DateTime?

  // Foreign keys
  userId          String
  subscriptionId  String?

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@map("invoices")
}

model PaymentMethod {
  id          String    @id @default(cuid())
  type        String    // card, bank_account
  provider    String    @default("stripe")
  providerId  String
  brand       String?
  last4       String?
  expMonth    Int?
  expYear     Int?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Foreign keys
  userId      String

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@map("payment_methods")
}

model Integration {
  id          String    @id @default(cuid())
  name        String
  type        String    // ai, cloud, payment, blockchain
  provider    String
  config      Json      @default("{}")
  status      String    @default("inactive") // active, inactive, error
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Foreign keys
  userId      String

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("integrations")
}

model ApiKey {
  id            String    @id @default(cuid())
  name          String
  keyPrefix     String
  keyHash       String
  permissions   String[]  @default([])
  rateLimit     Json      @default("{}")
  metadata      Json      @default("{}")
  isActive      Boolean   @default(true)
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Foreign keys
  userId        String

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model AuditLog {
  id          String    @id @default(cuid())
  action      String
  resource    String
  resourceId  String?
  metadata    Json      @default("{}")
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime  @default(now())

  // Foreign keys
  userId      String?

  // Relations
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Configuration {
  id          String    @id @default(cuid())
  key         String    @unique
  value       Json
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("configurations")
}

model NotificationSettings {
  id                    String    @id @default(cuid())
  emailNotifications    Boolean   @default(true)
  pushNotifications     Boolean   @default(false)
  weeklyReports         Boolean   @default(true)
  securityAlerts        Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Foreign keys
  userId                String    @unique

  // Relations
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model FileUpload {
  id          String    @id @default(cuid())
  filename    String
  originalName String
  mimetype    String
  size        Int
  path        String
  url         String?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())

  // Foreign keys
  userId      String

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("file_uploads")
}

model Webhook {
  id          String    @id @default(cuid())
  url         String
  events      String[]
  secret      String?
  isActive    Boolean   @default(true)
  lastDelivery DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Foreign keys
  userId      String

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id          String    @id @default(cuid())
  event       String
  payload     Json
  response    Json?
  status      String    // success, failed, pending
  attempts    Int       @default(1)
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  // Foreign keys
  webhookId   String

  // Relations
  webhook     Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@map("webhook_deliveries")
}

// OAuth Account Management
model OAuthAccount {
  id            String  @id @default(cuid())
  provider      String  // google, github, microsoft
  providerId    String  // External provider's user ID
  email         String?
  accessToken   String?
  refreshToken  String?
  tokenExpiresAt DateTime?
  scope         String?
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Foreign keys
  userId        String

  // Relations
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

// Device Management for Cross-Platform Sync
model UserDevice {
  id            String    @id @default(cuid())
  name          String    // User-friendly device name
  deviceType    String    // web, cli, extension, mobile, desktop
  platform      String    // windows, macos, linux, android, ios, browser
  deviceId      String    // Unique device identifier
  pushToken     String?   // For push notifications
  lastActiveAt  DateTime  @default(now())
  isActive      Boolean   @default(true)
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Foreign keys
  userId        String

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("user_devices")
}

// Cross-Platform Sync States
model SyncState {
  id              String    @id @default(cuid())
  dataType        String    // projects, settings, history, preferences
  lastSyncAt      DateTime  @default(now())
  syncVersion     Int       @default(1)
  conflictData    Json?     // Store conflict resolution data
  syncStatus      String    @default("synced") // synced, pending, conflicted, failed
  deviceSyncMap   Json      @default("{}") // Track sync status per device
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Foreign keys
  userId          String

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dataType])
  @@map("sync_states")
}

// AI Provider Status and Configuration
model AIProviderStatus {
  id              String    @id @default(cuid())
  provider        String    // anthropic, groq, gemini, ollama, openai
  status          String    @default("unknown") // healthy, degraded, offline, error
  responseTime    Float?    // Average response time in ms
  errorRate       Float?    // Error rate percentage
  lastCheckAt     DateTime  @default(now())
  uptime          Float?    // Uptime percentage
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([provider])
  @@map("ai_provider_status")
}

// Enhanced Usage Analytics
model UsageAnalytics {
  id              String    @id @default(cuid())
  eventType       String    // api_call, code_generation, authentication, sync
  platform        String    // cli, web, mobile, extension, desktop
  provider        String?   // AI provider if applicable
  tokens          Int?
  cost            Float?
  duration        Int?      // Duration in milliseconds
  success         Boolean   @default(true)
  errorCode       String?
  errorMessage    String?
  metadata        Json      @default("{}")
  timestamp       DateTime  @default(now())

  // Foreign keys
  userId          String?
  deviceId        String?
  projectId       String?

  // Relations
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([platform, timestamp])
  @@index([provider, timestamp])
  @@map("usage_analytics")
}

// DODO Payments Integration Models
model DodoSubscription {
  id                   String   @id @default(cuid())
  userId               String
  planId               String   // "weekly", "monthly", "enterprise"  
  planName             String
  dodoSubscriptionId   String   @unique
  status               String   @default("pending") // "active", "cancelled", "expired", "failed"
  amount               Int      // in cents
  currency             String   @default("USD")
  nextBillingDate      DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usage                DodoUsage[]
  charges              DodoCharge[]

  @@map("dodo_subscriptions")
}

model DodoUsage {
  id               String   @id @default(cuid())
  userId           String
  subscriptionId   String?
  tokensUsed       Int
  requestsMade     Int
  aiProvider       String
  featureUsed      String
  costCents        Int
  periodStart      DateTime
  periodEnd        DateTime
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription     DodoSubscription? @relation(fields: [subscriptionId], references: [id])

  @@map("dodo_usage")
}

model DodoCharge {
  id               String           @id @default(cuid())
  subscriptionId   String
  dodoChargeId     String           @unique
  amount           Int              // in cents
  currency         String           @default("USD")
  description      String
  status           String           @default("pending") // "succeeded", "failed", "pending"
  createdAt        DateTime         @default(now())

  // Relations
  subscription     DodoSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("dodo_charges")
}

model DodoWebhookEvent {
  id               String   @id @default(cuid())
  provider         String   @default("dodo_payments")
  eventType        String
  payload          Json
  processed        Boolean  @default(false)
  processingError  String?
  createdAt        DateTime @default(now())

  @@map("dodo_webhook_events")
}

// RAG (Retrieval-Augmented Generation) System Models
// Vector embeddings and knowledge base for enhanced code understanding

model CodebaseKnowledge {
  id              String    @id @default(cuid())
  name            String
  description     String?
  repositoryUrl   String?
  type            String    @default("project") // project, library, framework, documentation
  language        String?   // programming language
  framework       String?   // framework/stack
  visibility      String    @default("private") // private, public, organization
  status          String    @default("active") // active, processing, indexed, error
  totalFiles      Int       @default(0)
  indexedFiles    Int       @default(0)
  lastIndexedAt   DateTime?
  processingMeta  Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Foreign keys
  userId          String
  projectId       String?

  // Relations
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  codeChunks      CodeChunk[]
  vectorEmbeddings VectorEmbedding[]
  semanticQueries SemanticQuery[]
  ragSessions     RAGSession[]

  @@map("codebase_knowledge")
}

model CodeChunk {
  id              String    @id @default(cuid())
  content         String    // Raw code content
  contentType     String    // function, class, method, variable, comment, import, etc.
  filePath        String
  fileName        String
  fileExtension   String
  language        String
  startLine       Int?
  endLine         Int?
  functionName    String?
  className       String?
  methodName      String?
  variableName    String?
  complexity      String?   // simple, medium, complex
  dependencies    String[]  @default([])
  keywords        String[]  @default([])
  summary         String?   // AI-generated summary
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Foreign keys
  knowledgeBaseId String
  vectorId        String?   @unique

  // Relations
  knowledgeBase   CodebaseKnowledge @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  vectorEmbedding VectorEmbedding?  @relation(fields: [vectorId], references: [id], onDelete: SetNull)
  searchResults   SemanticSearchResult[]

  @@index([knowledgeBaseId, language])
  @@index([contentType, language])
  @@index([filePath])
  @@map("code_chunks")
}

model VectorEmbedding {
  id              String    @id @default(cuid())
  embedding       Float[]   // Vector embedding array (for pgvector)
  embeddingModel  String    @default("text-embedding-3-small") // OpenAI, Cohere, etc.
  dimension       Int       @default(1536)
  provider        String    @default("openai") // openai, cohere, huggingface
  contentHash     String    // Hash of the content for deduplication
  similarity      Float?    // Similarity score (for search results)
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())

  // Foreign keys
  knowledgeBaseId String
  chunkId         String?   @unique

  // Relations
  knowledgeBase   CodebaseKnowledge @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  codeChunk       CodeChunk?
  searchResults   SemanticSearchResult[]

  @@index([knowledgeBaseId])
  @@index([contentHash])
  @@map("vector_embeddings")
}

model SemanticQuery {
  id              String    @id @default(cuid())
  query           String
  queryType       String    @default("search") // search, explain, generate, refactor
  intent          String?   // user intent classification
  language        String?   // programming language filter
  framework       String?   // framework filter
  complexity      String?   // complexity filter
  maxResults      Int       @default(10)
  threshold       Float     @default(0.7) // similarity threshold
  processingTime  Int?      // milliseconds
  totalResults    Int       @default(0)
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())

  // Foreign keys
  userId          String
  knowledgeBaseId String

  // Relations
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeBase   CodebaseKnowledge @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  searchResults   SemanticSearchResult[]

  @@index([userId, createdAt])
  @@index([knowledgeBaseId, queryType])
  @@map("semantic_queries")
}

model SemanticSearchResult {
  id              String    @id @default(cuid())
  rank            Int
  similarity      Float
  relevanceScore  Float?    // Combined relevance score
  contextWindow   String?   // Surrounding context
  explanation     String?   // AI explanation of relevance
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())

  // Foreign keys
  queryId         String
  chunkId         String
  vectorId        String

  // Relations
  query           SemanticQuery     @relation(fields: [queryId], references: [id], onDelete: Cascade)
  codeChunk       CodeChunk         @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  vectorEmbedding VectorEmbedding   @relation(fields: [vectorId], references: [id], onDelete: Cascade)

  @@index([queryId, rank])
  @@index([similarity])
  @@map("semantic_search_results")
}

model EmbeddingCache {
  id              String    @id @default(cuid())
  contentHash     String    @unique
  content         String
  embedding       Float[]
  model           String
  provider        String
  dimension       Int
  hitCount        Int       @default(1)
  lastAccessedAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@index([contentHash])
  @@index([model, provider])
  @@map("embedding_cache")
}

model RAGSession {
  id              String    @id @default(cuid())
  sessionType     String    @default("chat") // chat, generation, analysis
  context         Json      @default("{}")
  conversationId  String?
  totalQueries    Int       @default(0)
  totalTokens     Int       @default(0)
  totalCost       Float     @default(0)
  qualityScore    Float?    // User feedback quality score
  feedback        String?   // User feedback
  isActive        Boolean   @default(true)
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Foreign keys
  userId          String
  knowledgeBaseId String?

  // Relations
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeBase   CodebaseKnowledge? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  interactions    RAGInteraction[]

  @@index([userId, isActive])
  @@map("rag_sessions")
}

model RAGInteraction {
  id              String    @id @default(cuid())
  interactionType String    // query, response, feedback
  input           String?
  output          String?
  tokensUsed      Int?
  cost            Float?
  latency         Int?      // milliseconds
  provider        String?   // AI provider used
  model           String?   // AI model used
  retrievedChunks Int       @default(0)
  relevanceScore  Float?
  userRating      Int?      // 1-5 stars
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())

  // Foreign keys
  sessionId       String

  // Relations
  session         RAGSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("rag_interactions")
}

// Database Backup System Models
model BackupJob {
  id              String    @id @default(cuid())
  type            String    // "full", "incremental", "manual"
  status          String    @default("pending") // pending, in_progress, completed, failed, cancelled
  backupId        String    @unique // External backup identifier
  storageLocation String?   // S3 path, local path, etc.
  storageProvider String    @default("local") // local, aws-s3, gcp-storage
  
  // Backup Details
  databaseName    String
  tableCount      Int       @default(0)
  recordCount     Int       @default(0)
  sizeBytes       Int       @default(0)
  checksum        String?
  compressionType String?   // gzip, bzip2, none
  encryptionType  String?   // aes-256, none
  
  // Timing
  scheduledFor    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  duration        Int?      // milliseconds
  
  // Error Handling
  errorMessage    String?
  retryCount      Int       @default(0)
  maxRetries      Int       @default(3)
  
  // Configuration
  config          Json      @default("{}")
  retention       Json      @default("{}") // retention policy settings
  metadata        Json      @default("{}")
  
  // Tracking
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  restoreJobs     RestoreJob[]
  validationJobs  BackupValidation[]
  
  @@index([status, createdAt])
  @@index([type, status])
  @@index([databaseName, createdAt])
  @@map("backup_jobs")
}

model RestoreJob {
  id              String    @id @default(cuid())
  status          String    @default("pending") // pending, in_progress, completed, failed, cancelled
  restoreType     String    @default("full") // full, partial, point_in_time
  targetDatabase  String?   // target database name (if different)
  
  // Restore Options
  dryRun          Boolean   @default(false)
  cleanFirst      Boolean   @default(false)
  skipConstraints Boolean   @default(false)
  tablesToRestore String[]  @default([])
  pointInTime     DateTime?
  
  // Progress Tracking
  totalSteps      Int       @default(0)
  completedSteps  Int       @default(0)
  progressPercent Float     @default(0)
  currentStep     String?
  
  // Timing
  startedAt       DateTime?
  completedAt     DateTime?
  duration        Int?      // milliseconds
  
  // Error Handling
  errorMessage    String?
  warnings        String[]  @default([])
  
  // Results
  restoredTables  String[]  @default([])
  restoredRecords Int       @default(0)
  skippedTables   String[]  @default([])
  
  // Configuration
  config          Json      @default("{}")
  metadata        Json      @default("{}")
  
  // Tracking
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Foreign Keys
  backupId        String
  userId          String?   // User who initiated restore
  
  // Relations
  backup          BackupJob @relation(fields: [backupId], references: [id], onDelete: Cascade)
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([status, createdAt])
  @@index([backupId, createdAt])
  @@map("restore_jobs")
}

model BackupValidation {
  id              String    @id @default(cuid())
  validationType  String    // "integrity", "restore_test", "checksum", "structure"
  status          String    @default("pending") // pending, running, passed, failed
  
  // Validation Results
  checksumValid   Boolean?
  integrityValid  Boolean?
  restoreValid    Boolean?
  structureValid  Boolean?
  
  // Test Details
  testDatabase    String?   // temporary database for restore testing
  validationSteps Json      @default("[]")
  errors          String[]  @default([])
  warnings        String[]  @default([])
  
  // Performance Metrics
  validationTime  Int?      // milliseconds
  testDataSize    Int?      // bytes tested
  
  // Timing
  startedAt       DateTime?
  completedAt     DateTime?
  
  // Configuration
  config          Json      @default("{}")
  metadata        Json      @default("{}")
  
  // Tracking
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Foreign Keys
  backupId        String
  
  // Relations
  backup          BackupJob @relation(fields: [backupId], references: [id], onDelete: Cascade)
  
  @@index([backupId, validationType])
  @@index([status, createdAt])
  @@map("backup_validations")
}

model BackupSchedule {
  id              String    @id @default(cuid())
  name            String
  description     String?
  scheduleType    String    // "full", "incremental"
  cronExpression  String    // Cron expression for scheduling
  isActive        Boolean   @default(true)
  
  // Backup Configuration
  databaseName    String
  storageProvider String    @default("local")
  storageConfig   Json      @default("{}")
  compressionType String    @default("gzip")
  encryptionEnabled Boolean @default(false)
  
  // Retention Policy
  retentionDaily  Int       @default(7)   // days
  retentionWeekly Int       @default(4)   // weeks  
  retentionMonthly Int      @default(12)  // months
  
  // Monitoring
  lastRunAt       DateTime?
  lastBackupId    String?
  nextRunAt       DateTime?
  consecutiveFailures Int   @default(0)
  
  // Notifications
  notifyOnSuccess Boolean   @default(false)
  notifyOnFailure Boolean   @default(true)
  notificationConfig Json   @default("{}")
  
  // Tracking
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([isActive, nextRunAt])
  @@index([databaseName, scheduleType])
  @@map("backup_schedules")
}

model BackupStorage {
  id              String    @id @default(cuid())
  provider        String    // "local", "aws-s3", "gcp-storage", "azure-blob"
  name            String    // Human-readable name
  
  // Configuration
  config          Json      @default("{}")
  credentials     Json      @default("{}") // Encrypted credentials
  
  // Storage Details
  bucket          String?   // S3 bucket, GCS bucket, etc.
  region          String?
  endpoint        String?   // Custom endpoint
  basePath        String    @default("/") // Base path for backups
  
  // Status
  isActive        Boolean   @default(true)
  lastTestAt      DateTime?
  testStatus      String?   // "passed", "failed"
  testError       String?
  
  // Metrics
  totalBackups    Int       @default(0)
  totalSizeBytes  BigInt    @default(0)
  availableBytes  BigInt?   // Available storage space
  usedBytes       BigInt    @default(0)
  
  // Security
  encryptionEnabled Boolean @default(true)
  encryptionKey   String?   // Encrypted encryption key
  accessLevel     String    @default("private") // private, read-only, public
  
  // Tracking
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([provider, bucket, basePath])
  @@index([provider, isActive])
  @@map("backup_storage")
}

// Add backup-related fields to User model
model BackupAccess {
  id          String    @id @default(cuid())
  userId      String
  permissions String[]  @default(["read"]) // read, write, delete, manage
  
  // Scope
  databases   String[]  @default([]) // specific databases, empty = all
  operations  String[]  @default([]) // backup, restore, validate, schedule
  
  // Restrictions
  maxBackups  Int?      // Maximum backups user can create
  maxRestore  Int?      // Maximum restores per day
  
  // Tracking
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId])
  @@map("backup_access")
}

// User Preferences Model - Centralized user preferences
model UserPreferences {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  
  // Theme Preferences
  themePreferences        Json?     @default("{}")    // Theme settings across platforms
  
  // Language Preferences  
  languagePreferences     Json?     @default("{}")    // i18n and localization settings
  
  // UI Preferences
  uiPreferences           Json?     @default("{}")    // Layout, density, etc.
  
  // Notification Preferences
  notificationPreferences Json?     @default("{}")    // All notification settings
  
  // Privacy Preferences
  privacyPreferences      Json?     @default("{}")    // Data collection, analytics opt-in/out
  
  // Accessibility Preferences
  accessibilityPreferences Json?    @default("{}")    // Screen reader, contrast, etc.
  
  // Developer Preferences
  developerPreferences    Json?     @default("{}")    // Code style, AI model preferences, etc.
  
  // Tracking
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  
  // Relations
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_preferences")
}

// Translation Model - For internationalization
model Translation {
  id          String    @id @default(cuid())
  key         String    // Translation key (e.g., "common.welcome")
  locale      String    // Locale code (e.g., "en-US", "es-ES")
  value       String    // Translated text
  context     String?   // Context for translators
  pluralRule  String?   // Plural rule: zero, one, two, few, many, other
  category    String    @default("ui") // ui, messages, errors, marketing, legal, technical
  
  // Management
  version     String    @default("1.0.0")
  approved    Boolean   @default(false)
  reviewerId  String?   // User who approved the translation
  
  // Tracking
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastUpdated DateTime  @default(now())
  
  // Relations
  reviewer    User?     @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  
  @@unique([key, locale])
  @@index([locale, category])
  @@index([key, approved])
  @@map("translations")
}

// Responsive Design Breakpoint Configurations
model ResponsiveConfig {
  id              String    @id @default(cuid())
  name            String    // "mobile-first", "desktop-first", "custom"
  description     String?
  
  // Breakpoint Definitions
  breakpoints     Json      @default("{}")  // { mobile: "320px", tablet: "768px", desktop: "1024px", etc. }
  
  // Grid Configuration
  gridColumns     Json      @default("{}")  // Columns per breakpoint
  gridGutters     Json      @default("{}")  // Gutters per breakpoint
  
  // Typography Scale
  typographyScale Json      @default("{}")  // Font sizes per breakpoint
  
  // Spacing Scale
  spacingScale    Json      @default("{}")  // Margins/padding per breakpoint
  
  // Component Configurations
  componentRules  Json      @default("{}")  // Component-specific responsive rules
  
  // Usage
  isDefault       Boolean   @default(false)
  isActive        Boolean   @default(true)
  usageCount      Int       @default(0)
  
  // Tracking
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([isDefault, isActive])
  @@map("responsive_configs")
}

// Device Usage Analytics for Responsive Design
model DeviceAnalytics {
  id              String    @id @default(cuid())
  
  // Device Information
  deviceType      String    // mobile, tablet, desktop, tv, watch
  screenWidth     Int?
  screenHeight    Int?
  viewportWidth   Int?
  viewportHeight  Int?
  pixelRatio      Float?    @default(1.0)
  
  // Browser Information
  userAgent       String?
  browserName     String?
  browserVersion  String?
  platform        String?   // iOS, Android, Windows, macOS, Linux
  
  // Usage Data
  sessionId       String
  userId          String?
  pageUrl         String?
  component       String?   // Which component/page was accessed
  
  // Performance Metrics
  loadTime        Int?      // milliseconds
  renderTime      Int?      // milliseconds
  interactionTime Int?      // time to first interaction
  
  // Responsive Behavior
  breakpointUsed  String?   // Which breakpoint was active
  layoutShifts    Int?      @default(0)  // Count of layout shifts
  scrollDepth     Float?    // Percentage of page scrolled
  
  // Tracking
  timestamp       DateTime  @default(now())
  createdAt       DateTime  @default(now())
  
  @@index([deviceType, timestamp])
  @@index([userId, timestamp])
  @@index([sessionId, timestamp])
  @@map("device_analytics")
}

// Multi-Tenant Architecture Models
model Tenant {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  domain        String?   @unique
  customDomain  String?   @unique
  plan          String    @default("starter") // starter, professional, enterprise
  settings      String    // JSON string
  branding      String    // JSON string
  limits        String    // JSON string
  status        String    @default("active") // active, suspended, trial
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  users         TenantUser[]
  usage         TenantUsage[]
  roles         Role[]
  
  @@map("tenants")
}

model TenantUser {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  role        String    // admin, developer, viewer
  permissions String    // JSON string array
  status      String    @default("active") // active, inactive, invited
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("tenant_users")
}

model TenantUsage {
  id        String   @id @default(cuid())
  tenantId  String
  metric    String   // api_calls, storage, bandwidth, users, projects
  value     Int      @default(0)
  date      String   // YYYY-MM-DD format
  createdAt DateTime @default(now())

  // Relations
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, date], name: "tenantId_metric_date")
  @@index([tenantId, date])
  @@map("tenant_usage")
}

// Role-Based Access Control (RBAC) Models
model Role {
  id          String     @id @default(cuid())
  name        String
  description String?
  type        String     @default("custom") // system, tenant, custom
  permissions String     // JSON string array
  isActive    Boolean    @default(true)
  tenantId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  userRoles   UserRole[]
  tenant      Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([name, tenantId])
  @@index([type, isActive])
  @@map("roles")
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String
  roleId     String
  tenantId   String?
  expiresAt  DateTime?
  assignedBy String
  assignedAt DateTime  @default(now())

  // Relations  
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId], name: "userId_roleId_tenantId")
  @@index([userId, tenantId])
  @@map("user_roles")
}

// Advanced Analytics Report System Models
model AnalyticsReport {
  id              String    @id @default(cuid())
  name            String
  description     String?
  slug            String    @unique
  category        String    // usage, performance, financial, user_behavior, custom
  type            String    // summary, detailed, comparative, trending, real_time
  
  // Report Configuration
  dataSource      Json      @default("{}")  // Data source configuration
  dimensions      Json      @default("[]")  // Report dimensions
  metrics         Json      @default("[]")  // Report metrics
  visualizations  Json      @default("[]")  // Chart and visualization configs
  schedule        Json?     @default("{}")  // Schedule configuration
  settings        Json      @default("{}")  // Report settings
  
  // Status and Tracking
  isActive        Boolean   @default(true)
  isPublic        Boolean   @default(false)
  version         String    @default("1.0.0")
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Foreign Keys
  userId          String
  
  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions      ReportExecution[]
  exports         ReportExport[]
  schedules       ReportSchedule[]
  shares          ReportShare[]
  cache           ReportCache[]
  comments        ReportComment[]
  shareAccesses   ReportShareAccess[]
  scheduledExecutions ScheduledExecution[]
  
  @@index([userId, category])
  @@index([slug, isPublic])
  @@index([type, isActive])
  @@map("analytics_reports")
}

model ReportExecution {
  id              String    @id @default(cuid())
  status          String    @default("pending") // pending, running, completed, failed, cancelled
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  executionTime   Int?      // milliseconds
  results         Json?     // Execution results
  error           String?   // Error message if failed
  rowCount        Int?      // Number of rows returned
  cacheHit        Boolean   @default(false)
  
  // Configuration
  parameters      Json      @default("{}")  // Execution parameters
  metadata        Json      @default("{}")  // Additional metadata
  
  // Foreign Keys
  reportId        String
  userId          String
  scheduleId      String?   // If triggered by schedule
  
  // Relations
  report          AnalyticsReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule        ReportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  
  @@index([reportId, startedAt])
  @@index([userId, status])
  @@index([scheduleId, status])
  @@map("report_executions")
}

model ReportExport {
  id              String    @id @default(cuid())
  format          String    // pdf, xlsx, csv, json, zip
  status          String    @default("pending") // pending, processing, completed, failed
  filePath        String?   // Path to exported file
  fileUrl         String?   // Public URL if applicable
  fileSize        Int?      // File size in bytes
  downloadCount   Int       @default(0)
  
  // Export Configuration
  options         Json      @default("{}")  // Export options
  customization   Json      @default("{}")  // Customization settings
  
  // Security
  expiresAt       DateTime? // Export expiration
  accessToken     String?   // Access token for downloads
  
  // Timestamps
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  lastDownloadAt  DateTime?
  
  // Foreign Keys
  reportId        String
  userId          String
  
  // Relations
  report          AnalyticsReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([reportId, format])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("report_exports")
}

model ReportSchedule {
  id              String    @id @default(cuid())
  name            String
  description     String?
  
  // Schedule Configuration
  schedule        Json      @default("{}")  // Frequency, time, timezone config
  delivery        Json      @default("[]")  // Delivery method configurations
  exportOptions   Json      @default("{}")  // Export format and options
  
  // Status and Tracking
  isActive        Boolean   @default(true)
  lastRun         DateTime?
  nextRun         DateTime?
  runCount        Int       @default(0)
  failureCount    Int       @default(0)
  
  // Error Handling
  lastError       String?
  maxRetries      Int       @default(3)
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Foreign Keys
  reportId        String
  userId          String
  
  // Relations
  report          AnalyticsReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions      ReportExecution[]
  scheduledExecutions ScheduledExecution[]
  
  @@index([reportId, isActive])
  @@index([userId, nextRun])
  @@index([isActive, nextRun])
  @@map("report_schedules")
}

model ScheduledExecution {
  id              String    @id @default(cuid())
  status          String    @default("pending") // pending, running, completed, failed
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  executionTime   Int?      // milliseconds
  results         Json?     // Execution results
  error           String?   // Error message if failed
  deliveryResults Json?     // Delivery results for each method
  
  // Foreign Keys
  scheduleId      String
  reportId        String
  userId          String
  
  // Relations
  schedule        ReportSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  report          AnalyticsReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([scheduleId, startedAt])
  @@index([status, startedAt])
  @@map("scheduled_executions")
}

model ReportShare {
  id              String    @id @default(cuid())
  shareType       String    // user, team, public, link
  permission      String    // view, comment, edit, admin
  shareToken      String?   @unique  // For link shares
  publicUrl       String?   // Public URL for sharing
  message         String?   // Message from sharer
  
  // Share Configuration
  config          Json      @default("{}")  // Permission config, expiration, etc.
  
  // Access Control
  isActive        Boolean   @default(true)
  accessCount     Int       @default(0)
  lastAccessedAt  DateTime?
  expiresAt       DateTime? // Share expiration
  revokedAt       DateTime?
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Foreign Keys
  reportId        String
  sharedBy        String    // User who shared
  
  // Relations
  report          AnalyticsReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sharedByUser    User                  @relation("SharedReports", fields: [sharedBy], references: [id], onDelete: Cascade)
  recipients      ReportShareRecipient[]
  accesses        ReportShareAccess[]
  comments        ReportComment[]
  
  @@index([reportId, isActive])
  @@index([sharedBy, shareType])
  @@index([shareToken, isActive])
  @@map("report_shares")
}

model ReportShareRecipient {
  id              String    @id @default(cuid())
  recipientEmail  String
  permission      String    // view, comment, edit, admin
  status          String    @default("invited") // invited, active, declined, revoked
  
  // Access Tracking
  lastAccessedAt  DateTime?
  accessCount     Int       @default(0)
  
  // Management
  invitedAt       DateTime  @default(now())
  revokedAt       DateTime?
  
  // Foreign Keys
  shareId         String
  recipientId     String?   // User ID if registered
  
  // Relations
  share           ReportShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  recipient       User?       @relation("ReceivedShares", fields: [recipientId], references: [id], onDelete: SetNull)
  
  @@index([shareId, status])
  @@index([recipientId, status])
  @@index([recipientEmail, status])
  @@map("report_share_recipients")
}

model ReportShareAccess {
  id              String    @id @default(cuid())
  accessType      String    // view, download, export, comment
  ipAddress       String?
  userAgent       String?
  accessedAt      DateTime  @default(now())
  
  // Session Info
  sessionId       String?
  duration        Int?      // milliseconds
  
  // Metadata
  metadata        Json      @default("{}")
  
  // Foreign Keys
  shareId         String
  reportId        String
  userId          String?   // If logged in user
  
  // Relations
  share           ReportShare     @relation(fields: [shareId], references: [id], onDelete: Cascade)
  report          AnalyticsReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([shareId, accessedAt])
  @@index([reportId, accessType])
  @@index([userId, accessedAt])
  @@map("report_share_accesses")
}

model ReportComment {
  id              String    @id @default(cuid())
  content         String
  authorName      String?   // For anonymous comments
  authorEmail     String?   // For anonymous comments
  isPublic        Boolean   @default(false) // Public comments don't require login
  isDeleted       Boolean   @default(false)
  
  // Thread Support
  parentId        String?   // For reply threads
  threadDepth     Int       @default(0)
  
  // Moderation
  isModerated     Boolean   @default(false)
  moderatedBy     String?
  moderatedAt     DateTime?
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  
  // Foreign Keys
  reportId        String
  shareId         String?   // If comment is on a shared report
  userId          String?   // Null for anonymous comments
  
  // Relations
  report          AnalyticsReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  share           ReportShare?    @relation(fields: [shareId], references: [id], onDelete: SetNull)
  user            User?           @relation("AuthoredComments", fields: [userId], references: [id], onDelete: SetNull)
  moderator       User?           @relation("ModeratedComments", fields: [moderatedBy], references: [id], onDelete: SetNull)
  parent          ReportComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies         ReportComment[] @relation("CommentReplies")
  
  @@index([reportId, isDeleted])
  @@index([shareId, isDeleted])
  @@index([userId, createdAt])
  @@index([parentId, threadDepth])
  @@map("report_comments")
}

model ReportCache {
  id              String    @id @default(cuid())
  cacheKey        String    @unique
  data            Json      // Cached data
  metadata        Json      @default("{}")
  
  // Cache Management
  hitCount        Int       @default(0)
  lastHitAt       DateTime?
  expiresAt       DateTime
  
  // Data Info
  dataSize        Int?      // Size in bytes
  rowCount        Int?      // Number of rows
  
  // Timestamps
  createdAt       DateTime  @default(now())
  
  // Foreign Keys
  reportId        String
  
  // Relations
  report          AnalyticsReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  @@index([reportId, expiresAt])
  @@index([cacheKey, expiresAt])
  @@index([expiresAt]) // For cleanup
  @@map("report_cache")
}