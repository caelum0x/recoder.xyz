  requests       BatchRequest[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([completedAt])
  @@map("batch_executions")
}

model PromptCache {
  id         String    @id
  promptHash String    @unique
  prompt     String
  response   Json
  model      String
  provider   String
  parameters Json      @default("{}")
  hitCount   Int       @default(0)
  cost       Float     @default(0)
  tokens     Int       @default(0)
  quality    Float     @default(1)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime?
  tags       String[]  @default([])
  context    Json      @default("{}")

  @@index([promptHash])
  @@index([model, provider])
  @@index([expiresAt])
  @@index([hitCount])
  @@index([lastUsedAt])
  @@map("prompt_cache")
}

model ComponentTemplate {
  id           String   @id
  name         String
  description  String
  category     String
  framework    String
  type         String
  tags         String[] @default([])
  code         String
  dependencies String[] @default([])
  usageCount   Int      @default(0)
  quality      Float    @default(1)
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  metadata     Json     @default("{}")

  @@index([category, framework])
  @@index([type, category])
  @@index([usageCount])
  @@index([quality])
  @@index([lastUsedAt])
  @@index([tags])
  @@index([name])
  @@index([description])
  @@map("component_templates")
}
