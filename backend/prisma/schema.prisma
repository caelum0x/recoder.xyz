generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  password              String?
  name                  String
  organization          String?
  role                  String                 @default("user")
  isActive              Boolean                @default(true)
  emailVerified         Boolean                @default(false)
  subscription          String                 @default("free")
  apiKey                String?                @unique
  refreshToken          String?
  lastLoginAt           DateTime?
  avatar                String?
  twoFactorEnabled      Boolean                @default(false)
  totpSecret            String?
  totpSecretTemp        String?
  backupCodes           String?
  backupCodesTemp       String?
  twoFactorSetupAt      DateTime?
  twoFactorEnabledAt    DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  agents                Agent[]
  aiGeneratedProjects   AIGeneratedProject[]
  analyticsReports      AnalyticsReport[]
  apiKeys               ApiKey[]
  auditLogs             AuditLog[]
  backupAccess          BackupAccess?
  batchRequests         BatchRequest[]
  codeGenerations       CodeGeneration[]
  knowledgeBases        CodebaseKnowledge[]
  deployedContracts     ContractDeployment[]   @relation("DeployedContracts")
  dodoSubscriptions     DodoSubscription[]
  dodoUsage             DodoUsage[]
  fileUploads           FileUpload[]
  gameAnalyticsEvents   GameAnalyticsEvent[]
  gameAssets            GameAsset[]
  gameBuilds            GameBuild[]
  gameMatchPlayers      GameMatchPlayer[]
  gameRoomPlayers       GameRoomPlayer[]
  hostedRooms           GameRoom[]             @relation("HostedRooms")
  gameSessions          GameSession[]
  integrations          Integration[]
  invoices              Invoice[]
  matchmakingQueue      MatchmakingQueue[]
  mobileAnalytics       MobileAnalytics[]
  mobileSessions        MobileSession[]
  notifications         NotificationSettings?
  userNotifications     Notification[]
  oauthAccounts         OAuthAccount[]
  offlineActions        OfflineAction[]
  paymentIntents        PaymentIntent[]
  paymentMethods        PaymentMethod[]
  platformSessions      PlatformSession[]
  projectCollaborations ProjectCollaborator[]
  projectComments       ProjectComment[]
  projectShares         ProjectShare[]
  projects              Project[]
  pushNotifications     PushNotification[]
  ragSessions           RAGSession[]
  remoteAssistance      RemoteAssistance[]
  moderatedComments     ReportComment[]        @relation("ModeratedComments")
  authoredComments      ReportComment[]        @relation("AuthoredComments")
  reportExecutions      ReportExecution[]
  reportExports         ReportExport[]
  reportSchedules       ReportSchedule[]
  reportShareAccesses   ReportShareAccess[]
  receivedShares        ReportShareRecipient[] @relation("ReceivedShares")
  sharedReports         ReportShare[]          @relation("SharedReports")
  restoreJobs           RestoreJob[]
  scheduledExecutions   ScheduledExecution[]
  semanticQueries       SemanticQuery[]
  createdContracts      SmartContract[]        @relation("CreatedContracts")
  subscriptions         Subscription[]
  syncStates            SyncState[]
  templates             Template[]
  translations          Translation[]
  analytics             UsageAnalytics[]
  usageEvents           UsageEvent[]
  usageRecords          UsageRecord[]
  devices               UserDevice[]
  preferences           UserPreferences?
  userPricingHistory    UserPricingHistory[]
  userRoles             UserRole[]
  visualScripts         VisualScript[]
  webhooks              Webhook[]

  @@map("users")
}

model Project {
  id                    String               @id @default(cuid())
  name                  String
  type                  String
  description           String?
  status                String               @default("planning")
  framework             String?
  language              String?
  isPrivate             Boolean              @default(false)
  config                Json                 @default("{}")
  structure             Json?
  metadata              Json?                @default("{}")
  lastGenerated         DateTime?
  generatedCodeMetadata Json?
  projectPath           String?
  configuration         Json?                @default("{}")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  userId                String
  templateId            String?
  agents                Agent[]
  blockchainNetworks    BlockchainNetwork[]
  codeGenerations       CodeGeneration[]
  knowledgeBases        CodebaseKnowledge[]
  contractDeployments   ContractDeployment[]
  analyticsEvents       GameAnalyticsEvent[]
  gameAssets            GameAsset[]
  gameBuilds            GameBuild[]
  gameMatches           GameMatch[]
  gameRooms             GameRoom[]
  gameSessions          GameSession[]
  matchmakingQueue      MatchmakingQueue[]
  template              Template?            @relation(fields: [templateId], references: [id])
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  smartContracts        SmartContract[]
  solidityProjects      SolidityProject?
  unrealProject         UnrealProject?
  analytics             UsageAnalytics[]
  usageRecords          UsageRecord[]
  visualScripts         VisualScript[]

  @@map("projects")
}

model Template {
  id                 String    @id @default(cuid())
  name               String
  category           String
  description        String?
  structure          Json
  config             Json      @default("{}")
  public             Boolean   @default(false)
  version            String    @default("1.0.0")
  imported           Boolean   @default(false)
  originalTemplateId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  userId             String
  projects           Project[]
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("templates")
}

model Agent {
  id           String        @id @default(cuid())
  name         String
  type         String
  description  String?
  config       Json          @default("{}")
  status       String        @default("inactive")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageRecords UsageRecord[]

  @@map("agents")
}

model UsageRecord {
  id        String   @id @default(cuid())
  type      String
  metadata  Json     @default("{}")
  tokens    Int?
  cost      Float?
  duration  Int?
  success   Boolean  @default(true)
  timestamp DateTime @default(now())
  userId    String
  projectId String?
  agentId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("usage_records")
}

model Subscription {
  id                 String         @id @default(cuid())
  planId             String
  status             String
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean        @default(false)
  cancelledAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  userId             String
  paymentMethodId    String?
  invoices           Invoice[]
  paymentMethod      PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(cuid())
  amount         Float
  currency       String        @default("USD")
  status         String
  description    String?
  items          Json          @default("[]")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  paidAt         DateTime?
  voidedAt       DateTime?
  userId         String
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model PaymentMethod {
  id            String         @id @default(cuid())
  type          String
  provider      String         @default("stripe")
  providerId    String
  brand         String?
  last4         String?
  expMonth      Int?
  expYear       Int?
  isDefault     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@map("payment_methods")
}

model Integration {
  id        String   @id @default(cuid())
  name      String
  type      String
  provider  String
  config    Json     @default("{}")
  status    String   @default("inactive")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("integrations")
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyPrefix   String
  keyHash     String
  permissions String[]  @default([])
  rateLimit   Json      @default("{}")
  metadata    Json      @default("{}")
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String?
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Configuration {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("configurations")
}

model NotificationSettings {
  id                 String   @id @default(cuid())
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(false)
  weeklyReports      Boolean  @default(true)
  securityAlerts     Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model FileUpload {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimetype     String
  size         Int
  path         String
  url          String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("file_uploads")
}

model Webhook {
  id           String            @id @default(cuid())
  url          String
  events       String[]
  secret       String?
  isActive     Boolean           @default(true)
  lastDelivery DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  userId       String
  deliveries   WebhookDelivery[]
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

model WebhookDelivery {
  id          String    @id @default(cuid())
  event       String
  payload     Json
  response    Json?
  status      String
  attempts    Int       @default(1)
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  webhookId   String
  webhook     Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@map("webhook_deliveries")
}

model OAuthAccount {
  id             String    @id @default(cuid())
  provider       String
  providerId     String
  email          String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  scope          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model UserDevice {
  id                      String    @id @default(cuid())
  name                    String
  deviceType              String
  platform                String
  deviceId                String
  pushToken               String?
  version                 String?
  model                   String?
  lastActiveAt            DateTime  @default(now())
  lastSeenAt              DateTime?
  lastSyncAt              DateTime?
  notificationPreferences Json?     @default("{}")
  isActive                Boolean   @default(true)
  metadata                Json      @default("{}")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("user_devices")
}

model SyncState {
  id            String   @id @default(cuid())
  dataType      String
  lastSyncAt    DateTime @default(now())
  syncVersion   Int      @default(1)
  conflictData  Json?
  syncStatus    String   @default("synced")
  deviceSyncMap Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dataType])
  @@map("sync_states")
}

model AIProviderStatus {
  id           String   @id @default(cuid())
  provider     String   @unique
  status       String   @default("unknown")
  responseTime Float?
  errorRate    Float?
  lastCheckAt  DateTime @default(now())
  uptime       Float?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("ai_provider_status")
}

model UsageAnalytics {
  id           String   @id @default(cuid())
  eventType    String
  platform     String
  provider     String?
  tokens       Int?
  cost         Float?
  duration     Int?
  success      Boolean  @default(true)
  errorCode    String?
  errorMessage String?
  metadata     Json     @default("{}")
  timestamp    DateTime @default(now())
  userId       String?
  deviceId     String?
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
  @@index([platform, timestamp])
  @@index([provider, timestamp])
  @@map("usage_analytics")
}

model DodoSubscription {
  id                 String       @id @default(cuid())
  userId             String
  planId             String
  planName           String
  dodoSubscriptionId String       @unique
  status             String       @default("pending")
  amount             Float
  currency           String       @default("USD")
  nextBillingDate    DateTime
  cancelAtPeriodEnd  Boolean      @default(false)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  lastPaymentAt      DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  charges            DodoCharge[]
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  usage              DodoUsage[]

  @@map("dodo_subscriptions")
}

model DodoUsage {
  id             String            @id @default(cuid())
  userId         String
  subscriptionId String?
  tokensUsed     Int
  requestsMade   Int
  aiProvider     String
  featureUsed    String
  costCents      Int
  periodStart    DateTime
  periodEnd      DateTime
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now())
  subscription   DodoSubscription? @relation(fields: [subscriptionId], references: [id])
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dodo_usage")
}

model DodoCharge {
  id             String           @id @default(cuid())
  subscriptionId String
  dodoChargeId   String           @unique
  amount         Float
  currency       String           @default("USD")
  description    String
  status         String           @default("pending")
  processedAt    DateTime?
  createdAt      DateTime         @default(now())
  subscription   DodoSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("dodo_charges")
}

model DodoWebhookEvent {
  id              String   @id @default(cuid())
  provider        String   @default("dodo_payments")
  eventType       String
  payload         Json
  processed       Boolean  @default(false)
  processingError String?
  createdAt       DateTime @default(now())

  @@map("dodo_webhook_events")
}

model CodebaseKnowledge {
  id               String            @id @default(cuid())
  name             String
  description      String?
  repositoryUrl    String?
  type             String            @default("project")
  language         String?
  framework        String?
  visibility       String            @default("private")
  status           String            @default("active")
  totalFiles       Int               @default(0)
  indexedFiles     Int               @default(0)
  lastIndexedAt    DateTime?
  processingMeta   Json              @default("{}")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userId           String
  projectId        String?
  codeChunks       CodeChunk[]
  project          Project?          @relation(fields: [projectId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ragSessions      RAGSession[]
  semanticQueries  SemanticQuery[]
  vectorEmbeddings VectorEmbedding[]

  @@map("codebase_knowledge")
}

model CodeChunk {
  id              String                 @id @default(cuid())
  content         String
  contentType     String
  filePath        String
  fileName        String
  fileExtension   String
  language        String
  startLine       Int?
  endLine         Int?
  functionName    String?
  className       String?
  methodName      String?
  variableName    String?
  complexity      String?
  dependencies    String[]               @default([])
  keywords        String[]               @default([])
  summary         String?
  metadata        Json                   @default("{}")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  knowledgeBaseId String
  vectorId        String?                @unique
  knowledgeBase   CodebaseKnowledge      @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  vectorEmbedding VectorEmbedding?       @relation(fields: [vectorId], references: [id])
  searchResults   SemanticSearchResult[]

  @@index([knowledgeBaseId, language])
  @@index([contentType, language])
  @@index([filePath])
  @@map("code_chunks")
}

model VectorEmbedding {
  id              String                 @id @default(cuid())
  embedding       Float[]
  embeddingModel  String                 @default("text-embedding-3-small")
  dimension       Int                    @default(1536)
  provider        String                 @default("openai")
  contentHash     String
  similarity      Float?
  metadata        Json                   @default("{}")
  createdAt       DateTime               @default(now())
  knowledgeBaseId String
  chunkId         String?                @unique
  codeChunk       CodeChunk?
  searchResults   SemanticSearchResult[]
  knowledgeBase   CodebaseKnowledge      @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
  @@index([contentHash])
  @@map("vector_embeddings")
}

model SemanticQuery {
  id              String                 @id @default(cuid())
  query           String
  queryType       String                 @default("search")
  intent          String?
  language        String?
  framework       String?
  complexity      String?
  maxResults      Int                    @default(10)
  threshold       Float                  @default(0.7)
  processingTime  Int?
  totalResults    Int                    @default(0)
  metadata        Json                   @default("{}")
  createdAt       DateTime               @default(now())
  userId          String
  knowledgeBaseId String
  knowledgeBase   CodebaseKnowledge      @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchResults   SemanticSearchResult[]

  @@index([userId, createdAt])
  @@index([knowledgeBaseId, queryType])
  @@map("semantic_queries")
}

model SemanticSearchResult {
  id              String          @id @default(cuid())
  rank            Int
  similarity      Float
  relevanceScore  Float?
  contextWindow   String?
  explanation     String?
  metadata        Json            @default("{}")
  createdAt       DateTime        @default(now())
  queryId         String
  chunkId         String
  vectorId        String
  codeChunk       CodeChunk       @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  query           SemanticQuery   @relation(fields: [queryId], references: [id], onDelete: Cascade)
  vectorEmbedding VectorEmbedding @relation(fields: [vectorId], references: [id], onDelete: Cascade)

  @@index([queryId, rank])
  @@index([similarity])
  @@map("semantic_search_results")
}

model EmbeddingCache {
  id             String   @id @default(cuid())
  contentHash    String   @unique
  content        String
  embedding      Float[]
  model          String
  provider       String
  dimension      Int
  hitCount       Int      @default(1)
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([contentHash])
  @@index([model, provider])
  @@map("embedding_cache")
}

model RAGSession {
  id              String             @id @default(cuid())
  sessionType     String             @default("chat")
  context         Json               @default("{}")
  conversationId  String?
  totalQueries    Int                @default(0)
  totalTokens     Int                @default(0)
  totalCost       Float              @default(0)
  qualityScore    Float?
  feedback        String?
  isActive        Boolean            @default(true)
  endedAt         DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  userId          String
  knowledgeBaseId String?
  interactions    RAGInteraction[]
  knowledgeBase   CodebaseKnowledge? @relation(fields: [knowledgeBaseId], references: [id])
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("rag_sessions")
}

model RAGInteraction {
  id              String     @id @default(cuid())
  interactionType String
  input           String?
  output          String?
  tokensUsed      Int?
  cost            Float?
  latency         Int?
  provider        String?
  model           String?
  retrievedChunks Int        @default(0)
  relevanceScore  Float?
  userRating      Int?
  metadata        Json       @default("{}")
  createdAt       DateTime   @default(now())
  sessionId       String
  session         RAGSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("rag_interactions")
}

model BackupJob {
  id              String             @id @default(cuid())
  type            String
  status          String             @default("pending")
  backupId        String             @unique
  storageLocation String?
  storageProvider String             @default("local")
  databaseName    String
  tableCount      Int                @default(0)
  recordCount     Int                @default(0)
  sizeBytes       Int                @default(0)
  checksum        String?
  compressionType String?
  encryptionType  String?
  scheduledFor    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  duration        Int?
  errorMessage    String?
  retryCount      Int                @default(0)
  maxRetries      Int                @default(3)
  config          Json               @default("{}")
  retention       Json               @default("{}")
  metadata        Json               @default("{}")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  validationJobs  BackupValidation[]
  restoreJobs     RestoreJob[]

  @@index([status, createdAt])
  @@index([type, status])
  @@index([databaseName, createdAt])
  @@map("backup_jobs")
}

model RestoreJob {
  id              String    @id @default(cuid())
  status          String    @default("pending")
  restoreType     String    @default("full")
  targetDatabase  String?
  dryRun          Boolean   @default(false)
  cleanFirst      Boolean   @default(false)
  skipConstraints Boolean   @default(false)
  tablesToRestore String[]  @default([])
  pointInTime     DateTime?
  totalSteps      Int       @default(0)
  completedSteps  Int       @default(0)
  progressPercent Float     @default(0)
  currentStep     String?
  startedAt       DateTime?
  completedAt     DateTime?
  duration        Int?
  errorMessage    String?
  warnings        String[]  @default([])
  restoredTables  String[]  @default([])
  restoredRecords Int       @default(0)
  skippedTables   String[]  @default([])
  config          Json      @default("{}")
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  backupId        String
  userId          String?
  backup          BackupJob @relation(fields: [backupId], references: [id], onDelete: Cascade)
  user            User?     @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([backupId, createdAt])
  @@map("restore_jobs")
}

model BackupValidation {
  id              String    @id @default(cuid())
  validationType  String
  status          String    @default("pending")
  checksumValid   Boolean?
  integrityValid  Boolean?
  restoreValid    Boolean?
  structureValid  Boolean?
  testDatabase    String?
  validationSteps Json      @default("[]")
  errors          String[]  @default([])
  warnings        String[]  @default([])
  validationTime  Int?
  testDataSize    Int?
  startedAt       DateTime?
  completedAt     DateTime?
  config          Json      @default("{}")
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  backupId        String
  backup          BackupJob @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@index([backupId, validationType])
  @@index([status, createdAt])
  @@map("backup_validations")
}

model BackupSchedule {
  id                  String    @id @default(cuid())
  name                String
  description         String?
  scheduleType        String
  cronExpression      String
  isActive            Boolean   @default(true)
  databaseName        String
  storageProvider     String    @default("local")
