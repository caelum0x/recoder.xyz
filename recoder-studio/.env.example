# for signed cookie
COOKIE_SECRET=recoderxyz2024supersecretkey_change_this_in_production_minimum_32chars

# for OAuth token encryption (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# for cron job
CRON_SECRET=

## Enable @vercel/flags at all times in the development environment
DEVELOPER_FLAG="true"
STUDIO_INTEROP_MVP_FLAG="false"
STUDIO_INTEROP_ROLLOUT_STAGE="internal"
STUDIO_INTEROP_KILL_SWITCH="false"
STUDIO_INTEROP_ROLLOUT_PERCENT="0"

# Optional browser-side fallback overrides for local rollout testing.
NEXT_PUBLIC_ENABLE_INTEROP="false"
NEXT_PUBLIC_STUDIO_INTEROP_ROLLOUT_STAGE="internal"
NEXT_PUBLIC_STUDIO_INTEROP_KILL_SWITCH="false"
NEXT_PUBLIC_STUDIO_INTEROP_ROLLOUT_PERCENT="0"

# @vercel/flags API Reference https://vercel.com/docs/workflow-collaboration/feature-flags/vercel-flags
# @see https://vercel.com/docs/workflow-collaboration/feature-flags/supporting-feature-flags#flags_secret-environment-variable
FLAGS_SECRET=

# Google Tag Manager https://tagmanager.google.com/
# @see https://support.google.com/tagmanager/answer/6102821
GTM_ID=

# Langfuse https://langfuse.com/
# @see https://langfuse.com/docs/get-started
LANGFUSE_BASEURL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# OpenAI API https://openai.com/index/openai-api/
# @see https://platform.openai.com/docs/quickstart
OPENAI_API_KEY=sk-your-openai-api-key

# Vercel Postgres https://vercel.com/docs/storage/vercel-postgres
# @see https://vercel.com/docs/storage/vercel-postgres#getting-started
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_PRISMA_URL=
POSTGRES_URL=postgresql://neondb_owner:npg_LDgwo1PRFh2J@ep-rapid-queen-abgrjesz-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=30
POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NO_SSL=
POSTGRES_USER=

# Sentry https://sentry.io/
# @see https://docs.sentry.io/cli/configuration/
SENTRY_AUTH_TOKEN=

# Stripe https://stripe.com/
# @see https://docs.stripe.com/keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PLAN_PRICE_ID=
STRIPE_USER_SEAT_PRICE_ID=
STRIPE_MODEL_USAGE_PRICE_ID=
# Stripe Pricing Plans v2 (preview API)
STRIPE_PRO_PRICING_PLAN_ID=
STRIPE_PRO_LICENSE_FEE_COMPONENT_ID=
STRIPE_V2_WEBHOOK_SECRET=

# Better Auth — primary auth provider (hosted by recoder-app)
# Set to the URL of the recoder-app instance that runs Better Auth
BETTER_AUTH_SECRET=recoderxyz2024supersecretkey_change_this_in_production_minimum_32chars
BETTER_AUTH_URL=http://localhost:3000

# Supabase (DEPRECATED — only used by legacy migration scripts)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_URL=

# Cloudflare R2 (S3-compatible object storage)
# Endpoint format: https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
APP_STORAGE_BUCKET=public-assets
DOCUMENT_VECTOR_STORE_STORAGE_BUCKET=app
# Public base for object URLs.
# If base already includes bucket path, set R2_PUBLIC_BASE_INCLUDES_BUCKET=true.
# If using a template URL, include {bucket} placeholder.
R2_PUBLIC_BASE_URL=
R2_PUBLIC_BASE_INCLUDES_BUCKET=false

# SMTP Email Configuration
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Email Debug Mode (set "true" to skip sending emails and show debug output)
SEND_EMAIL_DEBUG=1


