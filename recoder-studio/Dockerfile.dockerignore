# Studio-specific .dockerignore
# Used by BuildKit when building with dockerfile: recoder-studio/Dockerfile
# More permissive than root .dockerignore since pnpm needs all workspace members

.git
.github
.claude

**/node_modules
**/.next
**/.turbo
**/.cache
**/.parcel-cache
**/*.tsbuildinfo
**/__pycache__
**/*.pyc

# Unrelated projects (not workspace members)
openclaw
recoder-agency
recoder-chat
recoder-pm
production-engine
deployment
backend
apps/desktop

# Large files
*.tar
*.tar.gz
*.zip
*.mp4
*.mov
logs
