# Recoder.xyz Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# ==========================================
# CORE APPLICATION SETTINGS
# ==========================================
NODE_ENV=production
PRODUCTION_ENGINE_URL=https://engine.recoder.xyz
BACKEND_URL=https://api.recoder.xyz

# ==========================================
# DOMAIN CONFIGURATION
# ==========================================
MAIN_DOMAIN=https://recoder.xyz
API_DOMAIN=https://api.recoder.xyz
ENGINE_DOMAIN=https://engine.recoder.xyz
WEB_DOMAIN=https://app.recoder.xyz
CHAT_DOMAIN=https://chat.recoder.xyz

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# PostgreSQL connection string
DATABASE_URL=postgresql://recoder:YOUR_DB_PASSWORD@postgres:5432/recoder
POSTGRES_DB=recoder
POSTGRES_USER=recoder
POSTGRES_PASSWORD=YOUR_SECURE_DB_PASSWORD

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD

# ==========================================
# JWT & AUTHENTICATION
# ==========================================
JWT_SECRET=YOUR_SUPER_SECURE_JWT_SECRET_64_CHARS_OR_MORE
JWT_REFRESH_SECRET=YOUR_SUPER_SECURE_REFRESH_SECRET_64_CHARS_OR_MORE
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# AI PROVIDER API KEYS
# ==========================================
# OpenRouter (Primary AI Provider)
OPENROUTER_API_KEY=sk-or-YOUR_OPENROUTER_API_KEY

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_API_KEY

# OpenAI
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY

# Groq
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY

# Google Gemini
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# ==========================================
# MONITORING & ANALYTICS
# ==========================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=YOUR_SECURE_GRAFANA_PASSWORD

# ==========================================
# SECURITY SETTINGS
# ==========================================
# CORS Origins (comma-separated)
CORS_ORIGINS=https://recoder.xyz,https://app.recoder.xyz,https://chat.recoder.xyz

# Encryption keys
ENCRYPTION_KEY=YOUR_32_CHAR_ENCRYPTION_KEY_HERE

# ==========================================
# EXTERNAL SERVICES
# ==========================================
# GitHub OAuth (for authentication)
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET