# VAPI_PRIVATE_KEY=
# VAPI_PHONE_NUMBER_ID=
# VAPI_SERVER_URL=

# Freestyle — deployment (optional)
# FREESTYLE_API_KEY=

# Agent execution (optional)
# MAX_PARALLEL_AGENT_RUNS=3
# AGENT_RUN_TIMEOUT_SECONDS=3000
# AGENT_STOP_CHECK_INTERVAL=2.0
# METRICS_LOG_INTERVAL_SECONDS=300

# Presence tracking (optional)
# DISABLE_PRESENCE=true

# Memory embedding config (optional)
# MEMORY_EMBEDDING_PROVIDER=openai
# MEMORY_EMBEDDING_MODEL=text-embedding-3-small

# Public API defaults (optional)
# PUBLIC_API_DEFAULT_MODEL=

# HTTP client tuning (optional)
# HTTP_MAX_CONNECTIONS=100
# HTTP_READ_TIMEOUT=60.0

# LiteLLM tuning (optional)
# LITELLM_NUM_RETRIES=1
# LITELLM_STREAM_TIMEOUT=300

# Deployment providers (optional)
# DEPLOY_PROVIDER=
# DEPLOY_TOKEN=
# DEPLOY_TEAM_ID=
# DEPLOY_ACCOUNT_ID=


# ============================================
# 19. CLI CONFIGURATION (recoder-app)
# ============================================
CLI_CALLBACK_PORT=8080
CLI_CLIENT_ID=recoder-cli
CLI_DEVICE_CODE_EXPIRY=900

# Cron secret for /api/cron/* endpoints (optional)
# Generate: openssl rand -hex 32
# CRON_SECRET=


# ============================================
# 20. openclaw-gateway
# ============================================
# [REQUIRED for OpenClaw] Token for gateway auth
OPENCLAW_GATEWAY_TOKEN=


# ============================================
# 21. TELEMETRY & DEPLOYMENT INFO
# ============================================
TELEMETRY_ENDPOINT=https://api.recoder.xyz/telemetry
# BUILD_VERSION=1.0.0

# Docker registry (optional, if using private images)
# DOCKER_REGISTRY=registry.hub.docker.com
# KUBERNETES_NAMESPACE=recoder

# Debug / logging (keep false in production)
DEBUG=false
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
# LOGGING_LEVEL=INFO
# DEBUG_AUTH=false
# DEBUG_SAVE_LLM_IO=false
