# ============================================
# RECODER.XYZ — PRODUCTION ENVIRONMENT
# ============================================
# Copy this file to .env.production and fill in real values.
# NEVER commit the filled .env.production to version control.
#
# Secret generation commands:
#   32-byte hex:    openssl rand -hex 32
#   base64 secret:  openssl rand -base64 32
#   16-byte base64: openssl rand -base64 16
#
# Services covered:
#   - recoder-app         (Next.js, port 3000)
#   - recoder-web         (Remix/Vite, port 5173)
#   - docker-backend      (Express, port 3100)
#   - backend             (FastAPI, port 8000)
#   - openclaw-gateway    (port 18789)
#   - redis, postgres, prometheus, grafana, alertmanager


# ============================================
# 1. INFRASTRUCTURE
# ============================================
NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=production

# --- Ports (internal defaults, override if needed) ---
# APP_PORT=3000          # recoder-app
# WEB_PORT=5173          # recoder-web
# DOCKER_BACKEND_PORT=3100
# BACKEND_PORT=8000      # FastAPI
# REDIS_PORT=6379

# FastAPI workers
WORKERS=16


