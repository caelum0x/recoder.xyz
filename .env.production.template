# Recoder.xyz Production Environment Variables
# Copy this file to .env.production and fill in the values

#====================================
# Domain Configuration
#====================================
WEB_URL=https://recoder.xyz
CHAT_URL=https://chat.recoder.xyz
API_URL=https://api.recoder.xyz
ENGINE_URL=https://engine.recoder.xyz

#====================================
# Database Configuration
#====================================
DB_USER=recoder
DB_PASSWORD=your_secure_database_password_here
DATABASE_URL=postgresql://recoder:your_secure_database_password_here@postgres:5432/recoder_production

#====================================
# Redis Configuration
#====================================
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379

#====================================
# Security & Authentication
#====================================
JWT_SECRET=your_super_secure_jwt_secret_minimum_32_characters
NEXTAUTH_SECRET=your_super_secure_nextauth_secret_minimum_32_characters
NEXTAUTH_URL=https://chat.recoder.xyz

#====================================
# SSL/TLS Configuration
#====================================
ACME_EMAIL=admin@recoder.xyz

#====================================
# Payment Processing (Stripe)
#====================================
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

#====================================
# AI API Keys
#====================================
# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# Groq (Fast Inference)
GROQ_API_KEY=gsk_your_groq_api_key

# Google Gemini
GOOGLE_API_KEY=your_google_api_key

# OpenAI (Backup)
OPENAI_API_KEY=sk-your_openai_api_key

# DeepSeek (Cost-effective)
DEEPSEEK_API_KEY=sk-your_deepseek_api_key

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key

# Together AI
TOGETHER_API_KEY=your_together_api_key

# OpenRouter (Multi-model)
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key

# X.AI Grok
XAI_API_KEY=your_xai_api_key

# Fireworks AI
FIREWORKS_API_KEY=your_fireworks_api_key

# Cerebras
CEREBRAS_API_KEY=your_cerebras_api_key

#====================================
# Local AI Configuration
#====================================
OLLAMA_BASE_URL=http://ollama:11434
LM_STUDIO_BASE_URL=http://lm-studio:1234

#====================================
# Monitoring & Analytics
#====================================
GRAFANA_PASSWORD=your_secure_grafana_password

#====================================
# Feature Flags
#====================================
FEATURE_REASONING_ENGINE=true
FEATURE_BLOCKCHAIN_AGENT=true
FEATURE_MOBILE_AGENT=true
FEATURE_DEPLOYMENT_PIPELINE=true

#====================================
# Rate Limiting & Usage
#====================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
PREMIUM_TOKEN_LIMIT=400000
PREMIUM_REQUEST_LIMIT=5000
PRO_TOKEN_LIMIT=2000000
PRO_REQUEST_LIMIT=25000

#====================================
# Deployment Configuration
#====================================
NODE_ENV=production
LAUNCH_READY=true
WEB_PLATFORM_READY=true
CHAT_PLATFORM_READY=true
DATABASE_READY=true
AUTH_READY=true
PAYMENTS_READY=true
AI_PROVIDERS_READY=true
SECURITY_READY=true
MONITORING_READY=true