# ----- Security -----
# API Key Encryption
API_ENCRYPTION_KEY=your-32-byte-encryption-key-change-this
JWT_SECRET=jwt_secret_key_change_in_production_minimum_32_characters

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ----- Feature Flags -----
ENABLE_DEVICE_FLOW=true
ENABLE_API_KEYS=true
ENABLE_OAUTH=true
ENABLE_TWO_FACTOR=false

# ----- CLI Configuration -----
CLI_CALLBACK_PORT=8080
CLI_CLIENT_ID=recoder-cli
CLI_DEVICE_CODE_EXPIRY=900

# ----- Development -----
DEBUG=false
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
