{
  "name": "recoder-main-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/verify-next-security.js",
    "build": "pnpm exec prisma generate && next build",
    "start": "next start",
    "cms:importmap": "payload generate:importmap",
    "cms:migrate": "payload migrate",
    "cms:migrate:create": "payload migrate:create",
    "cms:migrate:status": "payload migrate:status",
    "cms:seed": "node scripts/seed-payload-cms.ts",
    "cms:types": "payload generate:types",
    "lint": "next lint",
    "typecheck": "pnpm exec tsc --noEmit",
    "check": "pnpm run typecheck",
    "ci:preflight": "[ -x ./node_modules/.bin/tsc ] && [ -x ./node_modules/.bin/eslint ] && node -e \"try{const mod=require('@prisma/client');if(!mod||typeof mod.PrismaClient!=='function'){console.error('PrismaClient export is unavailable in local @prisma/client build.');process.exit(10)}}catch(err){console.error('Unable to load @prisma/client PrismaClient export:', err?.message||String(err));process.exit(10)}\" || (echo 'Missing local toolchain or Prisma generated client (tsc/eslint/@prisma/client). Install dependencies and run prisma generate when registry/lockfile is available.' >&2; exit 10)",
    "ci:check": "pnpm run typecheck",
    "ci:check:noninteractive": "pnpm run ci:preflight && CI=1 NEXT_TELEMETRY_DISABLED=1 pnpm run ci:check",
    "ci:install-and-check": "pnpm run ci:check:noninteractive",
    "ci:install-and-check:local": "pnpm run ci:check:noninteractive",
    "test": "pnpm exec playwright test",
    "test:unit": "vitest --run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:ui": "pnpm exec playwright test --ui",
    "test:headed": "pnpm exec playwright test --headed",
    "test:debug": "pnpm exec playwright test --debug",
    "test:report": "pnpm exec playwright show-report",
    "test:codegen": "pnpm exec playwright codegen",
    "smoke:static": "bash scripts/smoke-static-assets.sh",
    "smoke:admin-push": "bash scripts/smoke-admin-push.sh",
    "load-test": "k6 run k6-load-test.js",
    "load-test:cloud": "k6 cloud k6-load-test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "@neondatabase/serverless": "^1.0.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.65.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/instrumentation-fetch": "^0.57.0",
    "@opentelemetry/instrumentation-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.207.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "@payloadcms/db-postgres": "3.81.0",
    "@payloadcms/next": "3.81.0",
    "@prisma/client": "^6.18.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@recoder/auth": "workspace:*",
    "@recoder/database": "workspace:*",
    "@recoder/design-tokens": "workspace:*",
    "@recoder/ui": "workspace:*",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/nextjs": "^10.27.0",
    "@sentry/node": "^10.27.0",
    "@types/nodemailer": "^7.0.2",
    "@types/qrcode": "^1.5.6",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.3.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dodopayments": "^2.6.0",
    "graphql": "16.13.2",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^0.400.0",
    "mjml": "^4.16.1",
    "nanoid": "^5.1.6",
    "next": "15.4.11",
    "next-intl": "^4.6.1",
    "nodemailer": "^7.0.9",
    "otplib": "^12.0.1",
    "payload": "3.81.0",
    "php-serialize": "^5.1.3",
    "prisma": "^6.17.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "standardwebhooks": "^1.0.0",
    "tailwind-merge": "^3.3.1",
    "ua-parser-js": "^2.0.6",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.19.22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^2.0.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.4",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.2",
    "vitest": "^2.0.1"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
