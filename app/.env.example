# ==========================================
# Recoder.xyz Environment Configuration
# ==========================================

# ----- Application URLs -----
NODE_ENV=development

# Development URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
BACKEND_URL=http://localhost:3001
PRODUCTION_ENGINE_URL=http://localhost:3002
NEXT_PUBLIC_WEB_IDE_URL=http://localhost:3002

# Production URLs (uncomment and use these for production)
# NEXT_PUBLIC_APP_URL=https://recoder.xyz
# NEXT_PUBLIC_API_URL=https://api.recoder.xyz
# BACKEND_URL=https://api.recoder.xyz
# NEXT_PUBLIC_WEB_IDE_URL=https://web.recoder.xyz

NEXT_PUBLIC_APP_NAME=Recoder.xyz

# ----- Authentication (Better Auth) -----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars-change-in-production
# Legacy (still read by some services)
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-change-this-in-production
# Cross-domain session sync secret
SESSION_SYNC_SECRET=your-session-sync-secret-change-in-production

# Development
NEXTAUTH_URL=http://localhost:3000

# Production (uncomment for production)
# NEXTAUTH_URL=https://recoder.xyz

# ----- Database (PostgreSQL) -----
DATABASE_URL=postgresql://postgres:password@localhost:5432/recoder_dev

# ----- Redis (Session & Cache) -----
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

# ----- OAuth Providers -----
# GitHub OAuth App
GITHUB_ID=your-github-oauth-app-id
GITHUB_SECRET=your-github-oauth-secret
# Client-side (enables OAuth buttons in frontend — set to same value as GITHUB_ID)
NEXT_PUBLIC_GITHUB_ID=your-github-oauth-app-id

# GitHub App (for advanced features like repo access)
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_CLIENT_ID=your-github-app-client-id
GITHUB_APP_PRIVATE_KEY_PATH=./path-to-private-key.pem
# Or set the private key directly (base64 encoded):
# GITHUB_APP_PRIVATE_KEY=your-private-key-content-base64

# Google OAuth (Production - recoder.xyz)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Client-side (enables OAuth buttons in frontend — set to same value as GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth (Development - localhost)
GOOGLE_CLIENT_ID_LOCAL=your-google-client-id-local.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_LOCAL=your-google-client-secret-local

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# ----- AI Providers -----
# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-api-key

# OpenAI (GPT)
OPENAI_API_KEY=sk-your-openai-api-key

# Groq (Fast Inference)
GROQ_API_KEY=gsk_your-groq-api-key

# Google AI (Gemini)
GOOGLE_API_KEY=AIza-your-google-api-key

# Ollama (Local AI)
OLLAMA_BASE_URL=http://localhost:11434

# ----- Payment & Billing -----
# DODO Pay (Standard Payment Processor - NOT crypto)
DODO_API_KEY_TEST=your-dodo-test-api-key
DODO_API_KEY_LIVE=your-dodo-live-api-key
DODO_API_SECRET=your-dodo-api-secret
DODO_WEBHOOK_SECRET=your-dodo-webhook-secret
NEXT_PUBLIC_DODO_PUBLISHABLE_KEY=pk_test_your-dodo-key

# Paddle (Subscription Management)
NEXT_PUBLIC_PADDLE_VENDOR_ID=your-paddle-vendor-id
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret
NEXT_PUBLIC_PADDLE_PRODUCT_WEEKLY=prod_weekly_id
NEXT_PUBLIC_PADDLE_PRODUCT_MONTHLY=prod_monthly_id
NEXT_PUBLIC_PADDLE_PRODUCT_PRO=prod_pro_id

# ----- Email Service -----
# Option 1: SMTP (Gmail, Outlook, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password  # For Gmail: Use App Password, not regular password
SMTP_FROM=noreply@recoder.xyz

# Option 2: Resend (Recommended for production)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@recoder.xyz

# Note: If RESEND_API_KEY is set, it will be used instead of SMTP

# ----- Security & Encryption -----
# API Key Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-64-char-hex-encryption-key-change-this-in-production
ENCRYPTION_SALT=your-production-salt-string-change-this

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Admin API secret for privileged endpoints (x-admin-secret header)
ADMIN_SECRET=

# Platform API Keys (for premium users - encrypted in DB)
# These are your OpenRouter keys that premium users will use
PLATFORM_OPENROUTER_KEY_1=sk-or-your-first-key
PLATFORM_OPENROUTER_KEY_2=sk-or-your-second-key
PLATFORM_OPENROUTER_KEY_3=sk-or-your-third-key

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ----- Monitoring & Logging -----
# Sentry (Error Tracking) — NEXT_PUBLIC_ prefix required for client-side
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# LogTail / BetterStack
LOGTAIL_SOURCE_TOKEN=your-logtail-token

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token

# ----- Web Push -----
# Generate VAPID keypair and expose public key to browser
WEB_PUSH_ENABLED=true
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@recoder.xyz
# Optional relay endpoint for admin test push dispatch (server-to-server)
PUSH_TEST_WEBHOOK_URL=
PUSH_TEST_WEBHOOK_SECRET=

# ----- OpenTelemetry -----
OTEL_ENABLED=false
OTEL_SERVICE_NAME=recoder-app
OTEL_EXPORTER_OTLP_ENDPOINT=

# ----- AWS (for S3, etc.) -----
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=recoder-storage

# ----- Feature Flags -----
ENABLE_DEVICE_FLOW=true
ENABLE_API_KEYS=true
ENABLE_OAUTH=true
ENABLE_TWO_FACTOR=true

# ----- CLI Configuration -----
CLI_CALLBACK_PORT=8080
CLI_CLIENT_ID=recoder-cli
CLI_DEVICE_CODE_EXPIRY=900

# ----- Development -----
DEBUG=false
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# ----- Internal Service Communication -----
# Shared secret for authenticating internal service-to-service calls
# Must match across app, recoder-web, and docker-backend
INTERNAL_SERVICE_KEY=

# ----- Internal Service Keys -----
# Backend API key for service-to-service auth
# BACKEND_API_KEY=
# Admin key for privileged internal requests
# ADMIN_KEY=
# Encryption key for stored API keys
# API_KEY_ENCRYPTION_SECRET=

# ----- Payment Product IDs -----
# DodoPay product identifiers
# DODO_PRODUCT_PRO=
# DODO_PRODUCT_MONTHLY=
# DODO_PRODUCT_WEEKLY=
# DODO_PRODUCT_ENTERPRISE=
# Paddle plan identifiers (server-side)
# PADDLE_WEEKLY_PLAN_ID=
# PADDLE_MONTHLY_PLAN_ID=
# PADDLE_ENTERPRISE_PLAN_ID=
# Polar webhook secret
# POLAR_WEBHOOK_SECRET=

# ----- Platform Service URLs -----
# Cross-service URL overrides (defaults are derived from NEXT_PUBLIC_APP_URL)
# RECODER_BACKEND_URL=https://docker.recoder.xyz
# RECODER_FRONTEND_URL=https://recoder.xyz
# RECODER_STUDIO_URL=https://studio.recoder.xyz
# RECODER_PM_URL=https://recoderpm.app
# RECODER_CHAT_URL=https://chat.recoder.xyz
# DOCKER_BACKEND_URL=https://docker.recoder.xyz
# BASE_URL=https://recoder.xyz
# MAIN_SITE_URL=https://recoder.xyz

# ----- AI Provider Keys (Server-side) -----
# OpenRouter API key (platform-level)
# OPENROUTER_API_KEY=sk-or-your-key
# OpenRouter key pool (for load distribution)
# OPENROUTER_API_KEY_1=
# OPENROUTER_API_KEY_2=
# OPENROUTER_API_KEY_3=

# ----- Cron & Background Jobs -----
# Secret for authorizing /api/cron/* endpoints
# CRON_SECRET=

# ----- OpenTelemetry (Extended) -----
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_INSECURE=false
# OTEL_EXPORTER_PROMETHEUS_HOST=0.0.0.0
# OTEL_EXPORTER_PROMETHEUS_PORT=9464

# ----- Testing & Development -----
# Show test credentials in seed output
# SHOW_TEST_CREDENTIALS=false
# Skip env validation during startup
# SKIP_ENV_VALIDATION=false
# Debug auth logging
# DEBUG_AUTH=false

# ----- Production Only -----
# (Uncomment and configure for production)
# HTTPS_ENABLED=true
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
# ENABLE_CORS=true
# ALLOWED_ORIGINS=https://recoder.xyz,https://www.recoder.xyz
