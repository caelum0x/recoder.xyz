/**
 * TeamService
 * Team collaboration and management service
 * 
 * NOTE: DISABLED - Team models (team, teamMember, invitation) don't exist in current schema
 * This service is kept for future implementation when team features are added
 */

// eslint-disable-next-line @typescript-eslint/no-unused-vars
function DISABLED_SERVICE_WARNING() {
  throw new Error('Team service is disabled - team models not implemented in current schema');
}

import { PrismaClient } from '@prisma/client';
import { generateSecureToken } from '../crypto';
import crypto from 'crypto';

const prisma = new PrismaClient();

export class TeamService {
  /**
   * Create a new team
   */
  async createTeam(name: string, ownerId: string) {
    DISABLED_SERVICE_WARNING();
    try {
      // Generate unique slug
      const slug = this.generateSlug(name);

      const team = await prisma.team.create({
        data: {
          name,
          slug,
          ownerId,
          plan: 'free',
          status: 'active',
        },
      });

      // Add owner as team member
      await prisma.teamMember.create({
        data: {
          teamId: team.id,
          userId: ownerId,
          role: 'owner',
        },
      });

      // Log team creation
      await prisma.audit_logs.create({
        data: {
          id: crypto.randomUUID(),
          userId: ownerId,
          action: 'team_created',
          resource: 'team',
          resourceId: team.id,
        },
      });

      return {
        team,
      };
    } catch (error: any) {
      console.error('Create team error:', error);
      throw error;
    }
  }

  /**
   * Get team details
   */
  async getTeam(teamId: string, userId: string) {
    DISABLED_SERVICE_WARNING();
    try {
      // Verify user is a team member
      const membership = await prisma.teamMember.findFirst({
        where: {
          teamId,
          userId,
        },
      });

      if (!membership) {
        throw new Error('Not authorized to access this team');
      }

      const team = await prisma.team.findUnique({
        where: { id: teamId },
        include: {
          owner: {
            select: {
              id: true,
              email: true,
              name: true,
              image: true,
            },
          },
          members: {
            include: {
              user: {
                select: {
                  id: true,
                  email: true,
                  name: true,
                  image: true,
                },
              },
            },
          },
        },
      });

      return {
        team,
      };
    } catch (error: any) {
      console.error('Get team error:', error);
      throw error;
    }
  }

  /**
   * Update team details
   */
  async updateTeam(
    teamId: string,
    userId: string,
    data: {
      name?: string;
      description?: string;
      avatar?: string;
      website?: string;
    }
  ) {
    DISABLED_SERVICE_WARNING();
    try {
      // Verify user is owner or admin
      await this.verifyRole(teamId, userId, ['owner', 'admin']);

      const team = await prisma.team.update({
        where: { id: teamId },
        data,
      });

      // Log update
      await prisma.audit_logs.create({
        data: {
          id: crypto.randomUUID(),
          userId,
          action: 'team_updated',
          resource: 'team',
          resourceId: teamId,
          metadata: data,
        },
      });

      return {
        team,
      };
    } catch (error: any) {
      console.error('Update team error:', error);
      throw error;
    }
  }

  /**
   * Delete team
   */
  async deleteTeam(teamId: string, userId: string) {
    DISABLED_SERVICE_WARNING();
    try {
      // Verify user is owner
      await this.verifyRole(teamId, userId, ['owner']);

      // Delete team members
      await prisma.teamMember.deleteMany({
        where: { teamId },
      });

      // Delete invitations
      await prisma.invitation.deleteMany({
        where: { teamId },
      });

      // Delete team
      await prisma.team.delete({
        where: { id: teamId },
      });

      // Log deletion
      await prisma.audit_logs.create({
        data: {
          id: crypto.randomUUID(),
          userId,
          action: 'team_deleted',
          resource: 'team',
          resourceId: teamId,
        },
      });

      return {
        message: 'Team deleted successfully',
      };
    } catch (error: any) {
      console.error('Delete team error:', error);
      throw error;
    }
  }

  /**
   * Invite member to team
   */
  async inviteMember(
    teamId: string,
    senderId: string,
    email: string,
    role: string = 'member'
  ) {
    DISABLED_SERVICE_WARNING();
    try {
      // Verify sender has permission
      await this.verifyRole(teamId, senderId, ['owner', 'admin']);

      // Check if user already invited
      const existingInvite = await prisma.invitation.findFirst({
        where: {
          teamId,
          email,
          status: 'pending',
        },
      });

      if (existingInvite) {
        throw new Error('User already has a pending invitation');
      }

      // Generate invitation token
      const token = generateSecureToken('invite');
      const expiresAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000); // 7 days

      // Create invitation
      const invitation = await prisma.invitation.create({
        data: {
          teamId,
          email,
          token,
          role,
          senderId,
          expiresAt,
        },
      });

      // TODO: Send invitation email

      // Log invitation
      await prisma.audit_logs.create({
        data: {
          id: crypto.randomUUID(),
          userId: senderId,
          action: 'team_member_invited',
          resource: 'invitation',
          resourceId: invitation.id,
          metadata: { email, role },
        },
      });

      return {
        invitation,
        message: 'Invitation sent successfully',
      };
    } catch (error: any) {
      console.error('Invite member error:', error);
      throw error;
    }
  }

  /**
   * Accept invitation
   */
  async acceptInvitation(token: string, userId: string) {
    DISABLED_SERVICE_WARNING();
    try {
      const invitation = await prisma.invitation.findUnique({
        where: { token },
        include: { team: true },
      });

      if (!invitation) {
        throw new Error('Invalid invitation token');
      }

      if (invitation.status !== 'pending') {
        throw new Error('Invitation already processed');
      }

      if (invitation.expiresAt < new Date()) {
        throw new Error('Invitation has expired');
      }

      // Get user email
      const user = await prisma.users.findUnique({
        where: { id: userId },
      });

      if (!user || user.email !== invitation.email) {
        throw new Error('This invitation is for a different email');
      }

      // Add user to team
      await prisma.teamMember.create({
        data: {
          teamId: invitation.teamId,
          userId,
          role: invitation.role,
        },
      });

      // Mark invitation as accepted
      await prisma.invitation.update({
        where: { token },
        data: {
          status: 'accepted',
          acceptedAt: new Date(),
          recipientId: userId,
        },
      });

      // Log acceptance
      await prisma.audit_logs.create({
        data: {
          id: crypto.randomUUID(),
          userId,
          action: 'team_invitation_accepted',
          resource: 'team',
          resourceId: invitation.teamId,
        },
      });

      return {
        team: invitation.team,
        message: 'Successfully joined team',
      };
    } catch (error: any) {
      console.error('Accept invitation error:', error);
      throw error;
    }
  }

  /**
   * List team members
   */
  async listMembers(teamId: string, userId: string) {
    DISABLED_SERVICE_WARNING();
    try {
      // Verify user is a member
      await this.verifyMembership(teamId, userId);

      const members = await prisma.teamMember.findMany({
        where: { teamId },
        include: {
          user: {
            select: {
              id: true,
              email: true,
              name: true,
              image: true,
            },
          },
        },
        orderBy: { joinedAt: 'asc' },
      });

      return {
        members,
      };
    } catch (error: any) {
      console.error('List members error:', error);
      throw error;
    }
  }

  /**
   * Remove member from team
   */
  async removeMember(teamId: string, memberId: string, removerId: string) {
    DISABLED_SERVICE_WARNING();
    try {
      // Verify remover has permission
      await this.verifyRole(teamId, removerId, ['owner', 'admin']);

      // Can't remove owner
      const memberToRemove = await prisma.teamMember.findFirst({
        where: {
          teamId,
          userId: memberId,
        },
      });

      if (memberToRemove?.role === 'owner') {
        throw new Error('Cannot remove team owner');
      }

      // Remove member
      await prisma.teamMember.deleteMany({
        where: {
          teamId,
          userId: memberId,
        },
      });

      // Log removal
      await prisma.audit_logs.create({
        data: {
          id: crypto.randomUUID(),
          userId: removerId,
          action: 'team_member_removed',
          resource: 'team',
          resourceId: teamId,
          metadata: { removedUserId: memberId },
        },
      });

      return {
        message: 'Member removed successfully',
      };
    } catch (error: any) {
      console.error('Remove member error:', error);
      throw error;
    }
  }

  /**
   * Update member role
   */
  async updateMemberRole(
    teamId: string,
    memberId: string,
    newRole: string,
    updaterId: string
  ) {
    DISABLED_SERVICE_WARNING();
    try {
      // Verify updater has permission
      await this.verifyRole(teamId, updaterId, ['owner']);

      // Can't change owner role
      const member = await prisma.teamMember.findFirst({
        where: {
          teamId,
          userId: memberId,
        },
      });

      if (member?.role === 'owner') {
        throw new Error('Cannot change owner role');
      }

      // Update role
      await prisma.teamMember.updateMany({
        where: {
          teamId,
          userId: memberId,
        },
        data: { role: newRole },
      });

      // Log update
      await prisma.audit_logs.create({
        data: {
          id: crypto.randomUUID(),
          userId: updaterId,
          action: 'team_member_role_updated',
          resource: 'team',
          resourceId: teamId,
          metadata: { memberId, newRole },
        },
      });

      return {
        message: 'Member role updated successfully',
      };
    } catch (error: any) {
      console.error('Update member role error:', error);
      throw error;
    }
  }

  /**
   * Get team usage statistics
   */
  async getTeamUsage(teamId: string, userId: string) {
    DISABLED_SERVICE_WARNING();
    try {
      // Verify user is a member
      await this.verifyMembership(teamId, userId);

      // Get all team member IDs
      const members = await prisma.teamMember.findMany({
        where: { teamId },
        select: { userId: true },
      });

      const userIds = members.map((m) => m.userId);

      // Get usage for all team members
      const usage = await prisma.usage_records.aggregate({
        where: {
          userId: { in: userIds },
        },
        _sum: {
          tokensUsed: true,
          cost: true,
          requestCount: true,
        },
        _count: true,
      });

      return {
        usage: {
          totalTokens: usage._sum.tokensUsed || 0,
          totalCost: usage._sum.cost || 0,
          totalRequests: usage._sum.requestCount || 0,
          totalSessions: usage._count || 0,
        },
      };
    } catch (error: any) {
      console.error('Get team usage error:', error);
      throw error;
    }
  }

  /**
   * Transfer team ownership
   */
  async transferOwnership(teamId: string, currentOwnerId: string, newOwnerId: string) {
    DISABLED_SERVICE_WARNING();
    try {
      // Verify current owner
      await this.verifyRole(teamId, currentOwnerId, ['owner']);

      // Verify new owner is a member
      const newOwnerMembership = await prisma.teamMember.findFirst({
        where: {
          teamId,
          userId: newOwnerId,
        },
      });

      if (!newOwnerMembership) {
        throw new Error('New owner must be a team member');
      }

      // Update team owner
      await prisma.team.update({
        where: { id: teamId },
        data: { ownerId: newOwnerId },
      });

      // Update old owner role
      await prisma.teamMember.updateMany({
        where: {
          teamId,
          userId: currentOwnerId,
        },
        data: { role: 'admin' },
      });

      // Update new owner role
      await prisma.teamMember.updateMany({
        where: {
          teamId,
          userId: newOwnerId,
        },
        data: { role: 'owner' },
      });

      // Log transfer
      await prisma.audit_logs.create({
        data: {
          id: crypto.randomUUID(),
          userId: currentOwnerId,
          action: 'team_ownership_transferred',
          resource: 'team',
          resourceId: teamId,
          metadata: { newOwnerId },
        },
      });

      return {
        message: 'Ownership transferred successfully',
      };
    } catch (error: any) {
      console.error('Transfer ownership error:', error);
      throw error;
    }
  }

  // Helper methods

  private async verifyMembership(teamId: string, userId: string) {
    const membership = await prisma.teamMember.findFirst({
      where: {
        teamId,
        userId,
      },
    });

    if (!membership) {
      throw new Error('Not a member of this team');
    }

    return membership;
  }

  private async verifyRole(teamId: string, userId: string, allowedRoles: string[]) {
    const membership = await this.verifyMembership(teamId, userId);

    if (!allowedRoles.includes(membership.role)) {
      throw new Error('Insufficient permissions');
    }

    return membership;
  }

  private generateSlug(name: string): string {
    return name
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');
  }
}

// Export singleton instance
export const teamService = new TeamService();
