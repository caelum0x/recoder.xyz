  MCPServer                                          MCPServer[]
  MCPToolCall                                        MCPToolCall[]
  legacy_accounts                                    account[]                 @relation("LegacyAccountUser")
  legacy_sessions                                    session[]                 @relation("LegacySessionUser")
  accounts                                           accounts[]
