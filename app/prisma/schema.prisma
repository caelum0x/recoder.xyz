  code_generations                                   code_generations[]
  codebase_knowledge                                 codebase_knowledge[]
  contract_deployments                               contract_deployments[]
  dodo_subscriptions                                 dodo_subscriptions[]
  dodo_usage                                         dodo_usage[]
  file_uploads                                       file_uploads[]
  game_analytics_events                              game_analytics_events[]
  game_assets                                        game_assets[]
