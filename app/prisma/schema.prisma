  push_notifications                                 push_notifications[]
  rag_sessions                                       rag_sessions[]
  remote_assistance                                  remote_assistance[]
  report_comments_report_comments_moderatedByTousers report_comments[]         @relation("report_comments_moderatedByTousers")
  report_comments_report_comments_userIdTousers      report_comments[]         @relation("report_comments_userIdTousers")
  report_executions                                  report_executions[]
