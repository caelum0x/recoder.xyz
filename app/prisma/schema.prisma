  paymentStatus                                      String?
  plan                                               String?
  onboardingStep                                     String?
  onboardingProfile                                  Json?
  onboardingCompletedAt                              DateTime?
  preferredModels                                    Json?
  totpSecret                                         String?
  totpSecretTemp                                     String?
  twoFactorEnabledAt                                 DateTime?
  twoFactorSetupAt                                   DateTime?
  AuthCode                                           AuthCode[]
