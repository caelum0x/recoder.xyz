model user_quota {
  id                String   @id @default(uuid())
  userId            String   @unique
  sessionsPerDay    Int      @default(5)
  sessionsUsedToday Int      @default(0)
  tokensPerSession  Int      @default(10000)
  periodStart       DateTime @default(now())
  periodEnd         DateTime
  lastResetAt       DateTime @default(now())
  requestsLimit     Int      @default(1000)
  requestsUsed      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())
  users             users    @relation("UserQuota", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model vector_embeddings {
  id                      String                    @id
  embedding               Float[]
  embeddingModel          String                    @default("text-embedding-3-small")
  dimension               Int                       @default(1536)
  provider                String                    @default("openai")
  contentHash             String
  similarity              Float?
  metadata                Json                      @default("{}")
  createdAt               DateTime                  @default(now())
  knowledgeBaseId         String
  chunkId                 String?                   @unique
  code_chunks             code_chunks?
  semantic_search_results semantic_search_results[]
  codebase_knowledge      codebase_knowledge        @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([contentHash])
  @@index([knowledgeBaseId])
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

model verifications {
  id         String   @id
  identifier String
  value      String
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model security_settings {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  twoFactorSecret  String?  @map("two_factor_secret")
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  backupCodes      String?  @map("backup_codes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  users            users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("security_settings")
}

model visual_scripts {
  id              String    @id
  name            String
  description     String?
  nodeGraph       Json      @default("{}")
  compiledCode    String?
  scriptType      String    @default("logic")
  engine          String
  language        String    @default("C#")
  nodeCount       Int       @default(0)
  connectionCount Int       @default(0)
  complexity      String    @default("simple")
  status          String    @default("draft")
  lastCompiled    DateTime?
  compileErrors   Json?
  isTemplate      Boolean   @default(false)
  isPublic        Boolean   @default(false)
  used            Boolean   @default(false)
  metadata        Json      @default("{}")
  version         String    @default("1.0.0")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())
  userId          String
  projectId       String?
  projects        projects? @relation(fields: [projectId], references: [id])
  users           users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([engine, language])
  @@index([projectId, scriptType])
  @@index([userId, createdAt])
}

model webhook_deliveries {
  id          String    @id
  event       String
  payload     Json
  response    Json?
  status      String
  attempts    Int       @default(1)
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  webhookId   String
  webhooks    webhooks  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
}

model webhook_events {
  id          String    @id
  externalId  String    @unique
  provider    String
  eventType   String
  data        Json
  processed   Boolean   @default(false)
  error       String?
  retryCount  Int       @default(0)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([processed, createdAt])
  @@index([provider, eventType])
}

model webhooks {
  id                 String               @id
  url                String
  events             String[]
  secret             String?
  isActive           Boolean              @default(true)
  lastDelivery       DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  userId             String
  webhook_deliveries webhook_deliveries[]
  users              users                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MCPServer {
  id        String   @id @default(cuid())
  userId    String
  serverId  String
  name      String
  config    Json
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([userId])
}

model MCPToolCall {
  id        String   @id @default(cuid())
  userId    String
  serverId  String
  toolName  String
  params    Json
  result    Json?
  error     String?
  createdAt DateTime @default(now())
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([serverId])
}

model chat_sessions {
  id               String                   @id @default(cuid())
  userId           String?
  anonymousId      String?
  urlId            String                   @unique
  title            String?
  description      String?
  artifactId       String?
  metadata         Json                     @default("{}")
  totalMessages    Int                      @default(0)
  lastMessageAt    DateTime?
  projectId        String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @default(now())
  chat_messages    chat_messages[]
  projects         projects?                @relation(fields: [projectId], references: [id])
  users            users?                   @relation("UserChatSessions", fields: [userId], references: [id], onDelete: Cascade)
  githubConnection chat_github_connections?

  @@index([userId])
  @@index([anonymousId])
  @@index([urlId])
  @@index([updatedAt])
  @@index([projectId])
}

model chat_messages {
  id            String        @id @default(cuid())
  sessionId     String
  role          String
  content       String
  metadata      Json          @default("{}")
  createdAt     DateTime      @default(now())
  chat_sessions chat_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

model chat_github_connections {
  id        String    @id @default(cuid())
  chatId    String    @unique @map("chat_id")
  userId    String    @map("user_id")
  repo      String
  branch    String    @default("main")
  autoSync  Boolean   @default(true) @map("auto_sync")
  lastSync  DateTime? @map("last_sync")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  chatSession chat_sessions @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user        users         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chatId])
}

model scheduled_emails {
  id          String    @id @default(cuid())
  userId      String
  email       String
  name        String    @default("")
  type        String    // 'getting_started', 'feature_deep_dive', 'engagement'
  scheduledAt DateTime
  sentAt      DateTime?
  status      String    @default("pending") // pending, sent, failed
  attempts    Int       @default(0)
  error       String?
  createdAt   DateTime  @default(now())
  users       users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([userId])
}

model newsletter_subscribers {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  status           String    @default("active")
  source           String?
  unsubscribeToken String?   @unique @map("unsubscribe_token")
  userId           String?   @map("user_id")
  metadata         Json      @default("{}")
  subscribedAt     DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt   DateTime? @map("unsubscribed_at")
  lastEmailSentAt  DateTime? @map("last_email_sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @map("updated_at")
  users            users?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([userId])
  @@map("newsletter_subscribers")
}

model marketplace_agents {
  id          String   @id @default(cuid())
  name        String
  description String
  author      String
  content     String   @db.Text
  version     String   @default("1.0.0")
  template    String   @default("custom")
  published   Boolean  @default(true)
  downloads   Int      @default(0)
  rating      Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([published])
  @@index([downloads])
  @@index([createdAt])
}
