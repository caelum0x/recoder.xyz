import { NextRequest, NextResponse } from 'next/server';
import { auth } from '@/lib/auth-config';
import { headers } from 'next/headers';

import { prisma } from '@/lib/prisma';

export async function GET(request: NextRequest) {
  try {
    const session = await getServerSession(authOptions);

    if (!session?.user?.email) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
    }

    const { searchParams } = new URL(request.url);
    const period = searchParams.get('period') || '30d';
    const groupBy = searchParams.get('groupBy') || 'day';

    const user = await prisma.user.findUnique({
      where: { email: session.user.email }
    });

    if (!user) {
      return NextResponse.json({ error: 'User not found' }, { status: 404 });
    }

    const periodDays = period === '7d' ? 7 : period === '30d' ? 30 : period === '90d' ? 90 : 30;
    const startDate = new Date();
    startDate.setDate(startDate.getDate() - periodDays);

    const usage = await prisma.usageRecord.findMany({
      where: {
        userId: user.id,
        timestamp: {
          gte: startDate
        }
      },
      orderBy: { timestamp: 'asc' }
    });

    const usageByDate: Record<string, any> = {};
    const usageByModel: Record<string, any> = {};
    const usageByHour: Record<string, any> = {};

    usage.forEach(record => {
      const date = record.timestamp.toISOString().split('T')[0];
      const hour = record.timestamp.getHours();
      const model = record.model || 'unknown';

      if (!usageByDate[date]) {
        usageByDate[date] = {
          date,
          requests: 0,
          tokens: 0,
          cost: 0
        };
      }
      usageByDate[date].requests += 1;
      usageByDate[date].tokens += record.tokensUsed || 0;
      usageByDate[date].cost += record.cost || 0;

      if (!usageByModel[model]) {
        usageByModel[model] = {
          model,
          requests: 0,
          tokens: 0,
          cost: 0
        };
      }
      usageByModel[model].requests += 1;
      usageByModel[model].tokens += record.tokensUsed || 0;
      usageByModel[model].cost += record.cost || 0;

      if (!usageByHour[hour]) {
        usageByHour[hour] = {
          hour,
          requests: 0,
          tokens: 0
        };
      }
      usageByHour[hour].requests += 1;
      usageByHour[hour].tokens += record.tokensUsed || 0;
    });

    const totalUsage = await prisma.usageRecord.aggregate({
      where: {
        userId: user.id,
        timestamp: {
          gte: startDate
        }
      },
      _sum: {
        tokensUsed: true,
        cost: true
      },
      _count: true
    });

    const topModels = Object.values(usageByModel)
      .sort((a: any, b: any) => b.requests - a.requests)
      .slice(0, 10);

    const peakHours = Object.values(usageByHour)
      .sort((a: any, b: any) => b.requests - a.requests)
      .slice(0, 5);

    const avgDailyRequests = totalUsage._count
      ? Math.round(totalUsage._count / periodDays)
      : 0;

    const avgDailyCost = totalUsage._sum.cost
      ? (totalUsage._sum.cost / periodDays).toFixed(4)
      : 0;

    return NextResponse.json({
      success: true,
      data: {
        period,
        startDate: startDate.toISOString(),
        endDate: new Date().toISOString(),
        summary: {
          totalRequests: totalUsage._count || 0,
          totalTokens: totalUsage._sum.tokensUsed || 0,
          totalCost: totalUsage._sum.cost || 0,
          avgDailyRequests,
          avgDailyCost
        },
        chartData: Object.values(usageByDate),
        usageByModel: topModels,
        usageByHour: peakHours,
        insights: generateInsights(usage, periodDays)
      }
    });

  } catch (error) {
    console.error('Analytics error:', error);
    return NextResponse.json(
      { error: 'Failed to fetch analytics data' },
      { status: 500 }
    );
  }
}

function generateInsights(usage: any[], periodDays: number) {
  if (usage.length === 0) {
    return {
      trend: 'stable',
      message: 'No usage data available for this period',
      recommendations: ['Start using the platform to see analytics']
    };
  }

  const midPoint = Math.floor(usage.length / 2);
  const firstHalf = usage.slice(0, midPoint);
  const secondHalf = usage.slice(midPoint);

  const firstHalfAvg = firstHalf.length > 0 ? firstHalf.length / (periodDays / 2) : 0;
  const secondHalfAvg = secondHalf.length > 0 ? secondHalf.length / (periodDays / 2) : 0;

  let trend = 'stable';
  let message = 'Your usage is steady';
  const recommendations = [];

  if (secondHalfAvg > firstHalfAvg * 1.2) {
    trend = 'increasing';
    message = 'Your usage is growing!';
    recommendations.push('Consider upgrading your plan for better rates');
  } else if (secondHalfAvg < firstHalfAvg * 0.8) {
    trend = 'decreasing';
    message = 'Your usage is declining';
    recommendations.push('Check if everything is working as expected');
  }

  const totalCost = usage.reduce((sum, u) => sum + (u.cost || 0), 0);
  if (totalCost > 50) {
    recommendations.push('Using your own API key could save costs');
  }

  return { trend, message, recommendations };
}

export async function POST(request: NextRequest) {
  try {
    const session = await getServerSession(authOptions);

    if (!session?.user?.email) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
    }

    const body = await request.json();
    const { format, period } = body;

    const user = await prisma.user.findUnique({
      where: { email: session.user.email }
    });

    if (!user) {
      return NextResponse.json({ error: 'User not found' }, { status: 404 });
    }

    const periodDays = period === '7d' ? 7 : period === '30d' ? 30 : period === '90d' ? 90 : 30;
    const startDate = new Date();
    startDate.setDate(startDate.getDate() - periodDays);

    const usage = await prisma.usageRecord.findMany({
      where: {
        userId: user.id,
        timestamp: {
          gte: startDate
        }
      },
      orderBy: { timestamp: 'asc' }
    });

    if (format === 'csv') {
      const csv = generateCSV(usage);
      return new NextResponse(csv, {
        headers: {
          'Content-Type': 'text/csv',
          'Content-Disposition': `attachment; filename="usage-${period}.csv"`
        }
      });
    } else {
      return NextResponse.json({
        success: true,
        data: usage
      });
    }

  } catch (error) {
    console.error('Export error:', error);
    return NextResponse.json(
      { error: 'Failed to export data' },
      { status: 500 }
    );
  }
}

function generateCSV(usage: any[]): string {
  const headers = ['Date', 'Model', 'Tokens', 'Cost'];
  const rows = usage.map(u => [
    u.timestamp.toISOString(),
    u.model || 'unknown',
    u.tokensUsed || 0,
    u.cost || 0
  ]);

  return [headers, ...rows].map(row => row.join(',')).join('\n');
}
