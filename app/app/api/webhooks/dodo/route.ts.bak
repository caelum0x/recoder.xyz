async function handleSubscriptionCancelled(data: any) {
  const { user_id, subscription_id, cancellation_date } = data;

  await prisma.user.update({
    where: { id: user_id },
    data: {
      subscriptionStatus: 'cancelled',
      subscriptionCancelledAt: new Date(cancellation_date * 1000)
    }
  });

  await prisma.auditLog.create({
    data: {
      userId: user_id,
      action: 'subscription_cancelled',
      resource: 'billing',
      metadata: { subscription_id, provider: 'dodo' },
      ipAddress: '0.0.0.0',
      timestamp: new Date()
    }
  });

  console.log(`Subscription cancelled for user ${user_id}`);
}

async function handleSubscriptionRenewed(data: any) {
  const { user_id, subscription_id, current_period_end, amount } = data;

  await prisma.user.update({
    where: { id: user_id },
    data: {
      subscriptionEndDate: new Date(current_period_end * 1000),
      lastPaymentDate: new Date(),
      lastPaymentAmount: amount
    }
  });

  await prisma.auditLog.create({
    data: {
      userId: user_id,
      action: 'subscription_renewed',
      resource: 'billing',
      metadata: { subscription_id, amount, provider: 'dodo' },
      ipAddress: '0.0.0.0',
      timestamp: new Date()
    }
  });

  console.log(`Subscription renewed for user ${user_id}`);
}

async function handleRefundCreated(data: any) {
  const { user_id, amount, transaction_id, reason } = data;

  await prisma.auditLog.create({
    data: {
      userId: user_id,
      action: 'refund_created',
      resource: 'billing',
      metadata: { amount, transaction_id, reason, provider: 'dodo' },
      ipAddress: '0.0.0.0',
      timestamp: new Date()
    }
