import { NextRequest, NextResponse } from 'next/server';
import { auth } from '@/lib/auth-config';
import { headers } from 'next/headers';

import { prisma } from '@/lib/prisma';

const PLAN_PRICES = {
  free: 0,
  weekly: 7,
  monthly: 20,
  enterprise: 99
};

export async function POST(request: NextRequest) {
  try {
    const session = await getServerSession(authOptions);

    if (!session?.user?.email) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
    }

    const body = await request.json();
    const { newPlan } = body;

    const user = await prisma.user.findUnique({
      where: { email: session.user.email }
    });

    if (!user) {
      return NextResponse.json({ error: 'User not found' }, { status: 404 });
    }

    const currentPlan = user.plan || 'free';
    
    if (currentPlan === 'free') {
      return NextResponse.json({
        success: true,
        amount: PLAN_PRICES[newPlan as keyof typeof PLAN_PRICES] || 0,
        proration: 0,
        total: PLAN_PRICES[newPlan as keyof typeof PLAN_PRICES] || 0
      });
    }

    const currentPrice = PLAN_PRICES[currentPlan as keyof typeof PLAN_PRICES] || 0;
    const newPrice = PLAN_PRICES[newPlan as keyof typeof PLAN_PRICES] || 0;

    if (!user.subscriptionEndDate) {
      return NextResponse.json({
        success: true,
        amount: newPrice,
        proration: 0,
        total: newPrice
      });
    }

    const now = new Date();
    const endDate = new Date(user.subscriptionEndDate);
    const daysRemaining = Math.max(0, Math.ceil((endDate.getTime() - now.getTime()) / (1000 * 60 * 60 * 24)));
    const totalDaysInPeriod = currentPlan === 'weekly' ? 7 : 30;
    
    const unusedAmount = (currentPrice / totalDaysInPeriod) * daysRemaining;
    
    const newPeriodDays = newPlan === 'weekly' ? 7 : 30;
    const proratedNewAmount = (newPrice / newPeriodDays) * daysRemaining;
    
    const proratedCharge = Math.max(0, proratedNewAmount - unusedAmount);

    return NextResponse.json({
      success: true,
      currentPlan,
      newPlan,
      daysRemaining,
      unusedCredit: unusedAmount.toFixed(2),
      proratedAmount: proratedCharge.toFixed(2),
      total: proratedCharge.toFixed(2)
    });

  } catch (error) {
    console.error('Proration calculation error:', error);
    return NextResponse.json(
      { error: 'Failed to calculate proration' },
      { status: 500 }
    );
  }
}
