/**
 * Notifications API
 * GET - Fetch user notifications
 */

import { NextResponse } from 'next/server';
import { auth } from '@/lib/auth-config';
import { headers } from 'next/headers';

export async function GET(request: Request) {
  try {
    const session = await getServerSession();
    
    if (!session?.user) {
      return NextResponse.json(
        { success: false, error: 'Unauthorized' },
        { status: 401 }
      );
    }

    // TODO: Fetch from database when Notification model is added to Prisma schema
    // For now, return mock notifications
    const notifications = [
      {
        id: '1',
        type: 'success',
        title: 'Welcome to Recoder!',
        message: 'Your account has been successfully created.',
        read: false,
        link: '/dashboard',
        createdAt: new Date().toISOString(),
      },
      {
        id: '2',
        type: 'info',
        title: 'New Feature Available',
        message: 'Command Palette (Cmd+K) is now available!',
        read: false,
        createdAt: new Date(Date.now() - 3600000).toISOString(),
      },
      {
        id: '3',
        type: 'warning',
        title: 'Usage Alert',
        message: 'You have used 80% of your monthly quota.',
        read: true,
        link: '/dashboard/usage',
        createdAt: new Date(Date.now() - 7200000).toISOString(),
      },
    ];

    return NextResponse.json({
      success: true,
      notifications,
    });
  } catch (error) {
    console.error('Failed to fetch notifications:', error);
    return NextResponse.json(
      { success: false, error: 'Failed to fetch notifications' },
      { status: 500 }
    );
  }
}
