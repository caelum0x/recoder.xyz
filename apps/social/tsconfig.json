{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esnext",
    // The @recoder/connectors package resolves its 8 per-channel adapters via
    // package.json "exports" subpaths; the base node10 resolution cannot see
    // those, so this app uses bundler resolution (it is executed via tsx/tsup).
    "moduleResolution": "bundler",
    "types": ["node"],
    // Explicit paths so `tsc --noEmit` works even before the owner adds this
    // app to pnpm-workspace.yaml (runtime resolution already works through the
    // root node_modules symlink for @recoder/connectors).
    "paths": {
      "@recoder/connectors": ["../../modules/social/openclaw/dist/index"],
      "@recoder/connectors/*": ["../../modules/social/openclaw/dist/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
