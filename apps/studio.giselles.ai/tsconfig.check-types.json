{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"incremental": false,
		"plugins": [],
		"paths": {
			"@/*": ["./*"],
			"@recoder/ecosystem-config": [
				"../../packages/ecosystem-config/src/index.ts"
			]
		},
		"typeRoots": ["./types", "./node_modules/@types"]
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		"trigger.config.ts",
		".next/dev/types/**/*.ts",
		"types/**/*.d.ts"
	],
	"exclude": ["node_modules", "../../packages/**", "../../internal-packages/**"]
}
