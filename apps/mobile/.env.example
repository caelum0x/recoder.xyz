# Mobile public runtime configuration (Expo)
# Copy to .env.local for local development.

# Environment mode
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_ENV_MODE=local

# Core backend/frontend URLs
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000/v1
EXPO_PUBLIC_FRONTEND_URL=http://localhost:3000
EXPO_PUBLIC_WEB_APP_URL=http://localhost:3000
EXPO_PUBLIC_AUTH_PROVIDER_URL=http://localhost:3000/api/auth

# Network helpers
EXPO_PUBLIC_DEV_HOST=localhost

# A2A / interop
EXPO_PUBLIC_A2A_API_URL=http://localhost:5173/api/a2a
EXPO_PUBLIC_INTEROP_INGEST_URL=http://localhost:5173/api/interop/events

# Feature toggles
EXPO_PUBLIC_DISABLE_PRESENCE=false
EXPO_PUBLIC_USE_REVENUECAT=false

# Optional public keys
EXPO_PUBLIC_AUTH_PROVIDER_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_VOICE_REFERENCE_AUDIO_URL=
