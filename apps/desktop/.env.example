# Apple Code Signing & Notarization
# Copy this file to .env and fill in your values

# Path to your exported P12 certificate file
CSC_LINK="./certs/Recoder-Signing.p12"

# Password for the P12 certificate
CSC_KEY_PASSWORD="your_p12_password_here"

# Your Apple ID email
APPLE_ID="you@example.com"

# App-specific password from appleid.apple.com
APPLE_APP_SPECIFIC_PASSWORD="abcd-efgh-ijkl-mnop"

# Your Apple Team ID (10 characters)
APPLE_TEAM_ID="AB12CD34EF"

# --- Notarization credentials ---
# The afterSign hook (notarize.js) notarizes the signed .app with notarytool.
# It is DEGRADE-SAFE: if none of these are set it skips notarization with a
# clear log line and the build still succeeds (unsigned/un-notarized).
#
# Strategy A (Apple ID + app-specific password) requires ALL THREE:
#   APPLE_ID, APPLE_APP_SPECIFIC_PASSWORD, APPLE_TEAM_ID (above).
#
# Strategy B (App Store Connect API key) is an alternative — requires ALL THREE:
# APPLE_API_KEY="./certs/AuthKey_XXXXXXXXXX.p8"   # path to the .p8 private key
# APPLE_API_KEY_ID="XXXXXXXXXX"                    # Key ID
# APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"  # Issuer UUID

# Optional: Build for specific architecture
# ARCH=arm64  # or x64 or universal

# --- Embedded backend supervisor ---
# Self-contained mode: the desktop app boots a local docker-backend on a free
# loopback port so opening it runs agents on the whole stack (tmux + engines).
# Default: ON for packaged builds, OFF in dev (so it does not collide with a
# manually-run backend on :3100). Override:
#   RECODER_EMBEDDED_BACKEND=true    # force on (e.g. to test embedded mode in dev)
#   RECODER_EMBEDDED_BACKEND=false   # force off (e.g. packaged build using a remote backend)
# Optional explicit tmux binary path (else resolved from c/tmux/tmux):
#   RECODER_DESKTOP_TMUX_BIN=/abs/path/to/tmux
# Per-install API_KEY_HASH_SALT + INTERNAL_SERVICE_KEY are generated once and
# persisted to <userData>/backend-supervisor-secrets.json (NOT committed).

# Runtime controls
# DESKTOP_AUTO_UPDATE=true
# DESKTOP_CRASH_WEBHOOK_URL=https://hooks.example.com/services/recoder-desktop-crash
# DOCKER_BACKEND_URL=http://localhost:3100
# RECODER_SESSION_TOKEN=your_internal_session_token
# RECODER_API_KEY=your_public_api_key
# RECODER_WORKFLOW_FETCH_RETRIES=2
# RECODER_WORKFLOW_STRICT_CONTRACT=true

# A2A Task API (SFA-020) - defaults to DOCKER_BACKEND_URL if not set
# RECODER_A2A_TASK_API_URL=http://localhost:3100
# RECODER_A2A_ADMIN_TOKEN=your_a2a_admin_token
# RECODER_A2A_BRIDGE_ID=desktop-default
