{
  "name": "recoder-desktop",
  "version": "1.0.0",
  "description": "Recoder Desktop",
  "author": {
    "name": "Recoder",
    "email": "support@recoder.xyz",
    "url": "https://recoder.xyz"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lint": "npm run lint:syntax",
    "lint:syntax": "node --check main.js && node --check preload.js && node --check build-signed.js && node --check notarize.js && node --check backend-supervisor.js && node --check before-build.js && node --check after-pack.js",
    "test": "vitest run",
    "dev:boot-proof": "node scripts/dev-boot-proof.js",
    "test:watch": "vitest",
    "smoke:prod": "node scripts/smoke-production.js",
    "validate:release": "node scripts/validate-release-artifacts.js",
    "build:cockpit": "cd cockpit && pnpm install --ignore-workspace && pnpm run build",
    "prepackage": "node cockpit/build.mjs",
    "build": "electron-builder",
    "build:mac": "node -r dotenv/config -e 'require(\"./build-signed.js\")' || electron-builder --mac",
    "build:mac:ci-signed": "electron-builder --mac",
    "build:mac:unsigned": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.3.2",
    "dotenv": "^16.4.5",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "xyz.recoder.desktop",
    "productName": "Recoder",
    "protocols": {
      "name": "Recoder",
      "schemes": ["recoder"]
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "beforeBuild": "before-build.js",
    "afterSign": "notarize.js",
    "dmg": {
      "sign": false,
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend-supervisor.js",
      "assets/**/*",
      "cockpit/dist/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/electron-updater/**/*"
    ],
    "extraResources": [
      {
        "from": "../../docker-backend/dist",
        "to": "backend/dist",
        "filter": ["**/*"]
      },
      {
        "from": "../../docker-backend/node_modules",
        "to": "backend/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": "../../docker-backend/package.json",
        "to": "backend/package.json"
      },
      {
        "from": "../../docker-backend/data",
        "to": "backend/data-template",
        "filter": ["**/*"]
      },
      {
        "from": "../../c/tmux/tmux",
        "to": "backend/c/tmux/tmux"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "recoder-xyz",
      "repo": "recoder-desktop"
    }
  }
}
