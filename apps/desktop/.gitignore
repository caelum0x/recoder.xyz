.claude

# Vendored Go engines (server/engines/*) keep their own tracked/ignored status:
# the app-level rules above (bin/, .claude, ...) must not swallow engine content.
# Each engine's nested .gitignore still applies (deeper files take precedence).
!server/engines/**/bin/
!server/engines/**/bin/**
!server/engines/**/.claude
!server/engines/**/.claude/**
# ...but the oversized vendored engine binaries exceed GitHub's 100MB hard limit.
# Keep them on disk (the engines need them); never commit them (re-excluded after
# the bin/** re-inclusion above). Root .gitignore also lists these but the nested
# bin/** negation would otherwise swallow the exclusion.
server/engines/ziti/bin/ziti
server/engines/ziti/bin/ziti.*
server/engines/beads/bin/bd
server/engines/beads/bin/bd.*
# Any backup copy of an engine binary is oversized by definition.
server/engines/**/bin/*.bak

# Vendored TS/C engines (engines/*) keep their own tracked/ignored status too:
# the app-level rules above (bindings/, .claude, bin/, ...) must not swallow
# engine content. Each engine's nested .gitignore still applies.
!engines/**/bindings/
!engines/**/bindings/**
!engines/**/bin/
!engines/**/bin/**
!engines/**/.claude
!engines/**/.claude/**
# ...but never local Claude settings (normally caught by the user-global ignore,
# which the re-include above would otherwise override):
engines/**/.claude/settings.local.json

# The vendored Loom engine ships its agent-detection manifests + libghostty-vt
# source as build-embedded SOURCE; the broad rules above (manifests/, dist/) must
# NOT hide them. Only build outputs under the engine stay ignored.
!engines/loom/src/detect/manifests/
!engines/loom/src/detect/manifests/**
engines/loom/target/
