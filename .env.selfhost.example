# Recoder self-host environment template.
#
# Copy to `.env.selfhost` and fill in the REQUIRED values, then run:
#   scripts/selfhost-up.sh
#
# The up-script will GENERATE any of the safe-to-generate secrets (marked
# "[auto]") for you if they are empty, and will FAIL FAST with a clear message
# for any REQUIRED value it cannot safely generate (e.g. POSTGRES_PASSWORD).
#
# NEVER commit a filled-in .env.selfhost. NO REAL SECRETS belong in this file.

# ============================================================================
# REQUIRED — the stack will not start without these.
# ============================================================================

# Postgres superuser the stack runs as. Owns recoder_main / recoder_backend /
# recoder_pm. Choose a strong password; this is NOT auto-generated so you keep
# control of the credential that owns your data.
POSTGRES_USER=recoder
POSTGRES_PASSWORD=

# Shared key for worker->backend /internal/* calls and aggregator loopback.
# [auto] selfhost-up.sh generates a 64-hex value if left empty.
INTERNAL_SERVICE_KEY=

# Signing key for governance audit envelopes (tamper-evident audit chain).
# [auto] selfhost-up.sh generates a 64-hex value if left empty.
RECODER_GOVERNANCE_SIGNING_KEY=

# Better Auth server secret (session/JWT signing on the auth source of truth).
# [auto] selfhost-up.sh generates a 64-hex value if left empty.
BETTER_AUTH_SECRET=

# ============================================================================
# OPTIONAL — features degrade safely (truthful health) when unset.
# ============================================================================

# --- Ports (host-side) ---
BACKEND_PORT=3100
EDGE_HTTP_PORT=8080
ENVOY_ADMIN_PORT=9901

# --- Billing (Polar) ---
# Missing keys disable billing and report unavailable instead of faking success.
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production

# --- Agent sandboxes (Daytona) ---
# Without these the Conductor runs in-process/tmux substrate only.
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_ORGANIZATION_ID=
DAYTONA_TARGET=
USE_DAYTONA_CONTAINERS=false

# --- Model providers (BYOK) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
