{
  "expo": {
    "name": "Recoder Chat",
    "slug": "recoder-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "recoder-chat",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "xyz.recoder.chat",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to take photos for your AI conversations.",
        "NSMicrophoneUsageDescription": "This app uses the microphone for voice messages.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to share images in chat."
      }
    },
    "android": {
      "package": "xyz.recoder.chat",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Recoder Chat to access your camera to take photos for AI conversations."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Recoder Chat to access your photos to share in conversations."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "recoder-chat-mobile"
      }
    }
  }
}