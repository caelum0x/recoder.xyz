{
  "expo": {
    "name": "Recoder Chat",
    "slug": "recoder-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "recoder-chat",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "xyz.recoder.chat",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to take photos for your AI conversations.",
        "NSMicrophoneUsageDescription": "This app uses the microphone for voice messages.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to share images in chat.",
        "NSUserNotificationsUsageDescription": "This app uses notifications to alert you when code generation is complete."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "xyz.recoder.chat",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Recoder Chat to access your camera to take photos for AI conversations."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Recoder Chat to access your photos to share in conversations."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff",
          "sounds": ["./assets/sounds/notification.wav"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "recoder-chat-mobile"
      }
    }
  }
}