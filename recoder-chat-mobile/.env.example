# 🚀 RECODER MOBILE - AI PROVIDER CONFIGURATION
# Copy this file to .env and add your API keys for cloud AI access
# Local AI (Ollama/LM Studio) works without any API keys!

#################################################################################
# 🆓 LOCAL AI (FREE) - Priority #1
#################################################################################
# No configuration needed - mobile app connects directly to localhost

#################################################################################
# 🤖 CLOUD AI PROVIDERS (ADD YOUR KEYS FOR PREMIUM ACCESS)
#################################################################################

# OpenRouter (Multi-model gateway) - PRIORITY #2 after local AI
# Access to 400+ models including Claude Sonnet 4 (#1 with 57% usage)
EXPO_PUBLIC_OPENROUTER_API_KEY=""

# Claude/Anthropic (High quality coding AI)
EXPO_PUBLIC_ANTHROPIC_API_KEY=""

# Groq (Fast inference - great for mobile)
EXPO_PUBLIC_GROQ_API_KEY=""

# Google AI (Gemini models)
EXPO_PUBLIC_GOOGLE_API_KEY=""

# OpenAI (GPT-4o - general purpose)
EXPO_PUBLIC_OPENAI_API_KEY=""

# xAI (Grok - backup option)
EXPO_PUBLIC_XAI_API_KEY=""

#################################################################################
# 📱 MOBILE-SPECIFIC CONFIGURATION
#################################################################################
# Mobile apps have native access to localhost AI services
# No proxy or bridge setup required - direct connection to:
# - Ollama: http://localhost:11434
# - LM Studio: http://localhost:1234

# Enable local AI detection (default: true)
EXPO_PUBLIC_LOCAL_AI_ENABLED="true"

# Enable cloud AI fallback (default: true) 
EXPO_PUBLIC_CLOUD_AI_ENABLED="true"

# API request timeout (mobile friendly - default: 30000ms)
EXPO_PUBLIC_API_TIMEOUT="30000"

#################################################################################
# 🚀 GET STARTED FREE
#################################################################################
# 1. Install Ollama: https://ollama.ai
# 2. Run: ollama pull qwen2.5-coder:7b
# 3. Start: ollama serve
# 4. Launch mobile app - unlimited free AI coding!
#
# Optional: Add cloud API keys above for premium models
#################################################################################