# Production Environment Configuration for Recoder.xyz
# Copy to .env.production and fill in all required values

#====================================
# Core Database & Cache
#====================================
DB_NAME=recoder_production
DB_USER=recoder
DB_PASSWORD=your_super_secure_database_password_here

REDIS_PASSWORD=your_redis_password_here

#====================================
# Security & JWT
#====================================
JWT_SECRET=your_jwt_secret_32_chars_minimum
JWT_REFRESH_SECRET=your_jwt_refresh_secret_different_from_above
ENCRYPTION_KEY=your_encryption_key_32_chars_exactly

#====================================
# AI Providers (Priority Order: Together > Groq > Gemini > Others)
#====================================

# Together AI (FREE MODELS - Primary Provider)
TOGETHER_API_KEY=your_together_ai_api_key_here

# Groq (Fast Inference - Secondary)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (Multimodal - Tertiary)  
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Anthropic Claude (Premium - Quaternary)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (Fallback Only - Last Resort)
OPENAI_API_KEY=your_openai_api_key_here

#====================================
# Domain & SSL Configuration
#====================================
DOMAIN=recoder.xyz
WEB_URL=https://recoder.xyz
API_URL=https://api.recoder.xyz
CHAT_URL=https://chat.recoder.xyz
MONITOR_DOMAIN=monitor.recoder.xyz

# SSL Certificate Email (Required for Let's Encrypt)
ACME_EMAIL=admin@recoder.xyz

#====================================
# OAuth Providers (Optional)
#====================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

#====================================
# Payment Processing (Optional)
#====================================
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

#====================================
# Monitoring & Logging
#====================================
GRAFANA_PASSWORD=secure_grafana_admin_password

# Sentry (Optional Error Tracking)
SENTRY_DSN=your_sentry_dsn_here

#====================================
# Email Configuration (Optional)
#====================================
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASS=your_email_app_password

#====================================
# Performance & Scaling
#====================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
LOG_LEVEL=info

# Node.js Memory Limits (Optional)
NODE_OPTIONS=--max-old-space-size=2048

#====================================
# Development Overrides (Remove in Production)
#====================================
# NODE_ENV=production (automatically set in docker-compose)
# PORT settings (automatically set per service)

#====================================
# Production Deployment Notes
#====================================

# 1. REQUIRED VARIABLES (Must be set):
#    - DB_PASSWORD
#    - REDIS_PASSWORD
#    - JWT_SECRET
#    - JWT_REFRESH_SECRET
#    - ENCRYPTION_KEY
#    - TOGETHER_API_KEY (Primary AI provider)
#    - ACME_EMAIL (for SSL certificates)

# 2. SECURITY BEST PRACTICES:
#    - Use strong, unique passwords (minimum 32 characters)
#    - Never commit this file with real values
#    - Rotate secrets regularly
#    - Use environment-specific secrets management

# 3. AI PROVIDER STRATEGY:
#    - Together AI: FREE models for cost optimization
#    - Groq: Fast inference for time-sensitive operations
#    - Gemini: Multimodal capabilities when needed
#    - Claude: Complex reasoning tasks (premium)
#    - OpenAI: Emergency fallback only

# 4. SSL CERTIFICATE AUTOMATION:
#    - Certbot automatically renews Let's Encrypt certificates
#    - ACME_EMAIL must be valid for certificate notifications
#    - Domain must point to your server before first deployment

# 5. MONITORING ACCESS:
#    - Grafana: https://monitor.recoder.xyz (admin/GRAFANA_PASSWORD)
#    - Prometheus: Internal network only (security)
#    - Logs: Centralized through Loki/Promtail

# 6. BACKUP STRATEGY:
#    - Database: Automated daily backups to /backups volume
#    - Retention: 7 days local, extend with cloud storage
#    - Recovery: Restore from /backups/*.sql.gz files

# 7. DEPLOYMENT COMMAND:
#    docker-compose -f docker-compose.production-enhanced.yml --profile monitoring up -d