# Zrok + OpenZiti Self-Hosting — Environment Variables
#
# Copy to .env.zrok and edit the values below.
# Then: docker compose -f docker-compose.zrok.yml up -d
#
# DNS required: *.preview.recoder.xyz → A → your-server-ip

# ── Required ─────────────────────────────────────────────────────────────────

# The DNS zone for preview URLs. Must have a wildcard A record.
ZROK2_DNS_ZONE=preview.recoder.xyz

# Admin token for the zrok2 controller (min 32 chars).
ZROK2_ADMIN_TOKEN=CHANGE_ME_ZROK2_ADMIN_TOKEN_MIN_32_CHARS

# Password for the OpenZiti controller admin user.
ZITI_PWD=CHANGE_ME_ZITI_PASSWORD

# ── Optional ─────────────────────────────────────────────────────────────────

# Zrok database password
ZROK2_DB_PASSWORD=zrok2_recoder_prod

# Ports (defaults are fine for most setups)
# ZITI_CTRL_PORT=1280
# ZITI_ROUTER_PORT=3022
# ZROK2_CTRL_PORT=18080
# ZROK2_FRONTEND_PORT=8080
