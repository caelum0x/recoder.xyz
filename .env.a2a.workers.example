# Copy to .env.a2a.workers and adjust for your Hetzner deployment.

# Shared Redis for stream ingest + worker results
RECODER_A2A_REDIS_URL=redis://:changeme@127.0.0.1:6379/0

# Shared A2A stream keys
RECODER_A2A_INTENT_STREAM_KEY=recoder:a2a:intents
RECODER_A2A_RESULTS_STREAM_KEY=recoder:a2a:results
RECODER_A2A_DEADLETTER_STREAM_KEY=recoder:a2a:deadletter

# Worker tuning
RECODER_A2A_CLAIM_MIN_IDLE_MS=30000
RECODER_A2A_MAX_RETRIES=2
RECODER_A2A_RETRY_DELAY_MS=500
RECODER_A2A_RETRY_BACKOFF_MULTIPLIER=2
RECODER_A2A_RETRY_MAX_DELAY_MS=10000
RECODER_A2A_CONSUME_UNTARGETED=false
RECODER_A2A_GROUP_START_ID=$

# Optional worker auth between worker -> /api/a2a/intents/*
RECODER_A2A_WORKER_TOKEN=replace_with_worker_token

# Internal service bases (used by scripts/a2a-workers-hetzner.sh defaults)
RECODER_WEB_INTERNAL_URL=http://127.0.0.1:5173
RECODER_AGENCY_INTERNAL_URL=http://127.0.0.1:3005
RECODER_PM_API_INTERNAL_URL=http://127.0.0.1:3004
DOCKER_BACKEND_INTERNAL_URL=http://127.0.0.1:3100

# Optional global handler overrides (otherwise script auto-targets each service base)
# RECODER_A2A_PLAN_HANDLER_URL=http://127.0.0.1:3100/api/a2a/intents/plan
# RECODER_A2A_EXECUTE_HANDLER_URL=http://127.0.0.1:3100/api/a2a/intents/execute
# RECODER_A2A_HANDOFF_HANDLER_URL=http://127.0.0.1:3100/api/a2a/intents/handoff
# RECODER_A2A_TOOL_CALL_HANDLER_URL=http://127.0.0.1:3100/api/a2a/intents/tool_call
# RECODER_A2A_DEFAULT_HANDLER_URL=http://127.0.0.1:3100/api/a2a/intents/default

# Optional downstream workflow executors called by each service intent handler
# RECODER_A2A_INTENT_PLAN_EXECUTOR_URL=
# RECODER_A2A_INTENT_EXECUTE_EXECUTOR_URL=
# RECODER_A2A_INTENT_REVIEW_EXECUTOR_URL=
# RECODER_A2A_INTENT_HANDOFF_EXECUTOR_URL=
# RECODER_A2A_INTENT_TOOL_CALL_EXECUTOR_URL=

# Envelope ingress auth/signature
RECODER_A2A_SHARED_SECRET=replace_with_strong_secret
RECODER_A2A_ALLOWED_AGENTS=recoder-web,recoder-agency,recoder-pm,docker-backend,codex,claude_code
RECODER_A2A_EGRESS_ALLOWLIST=https://web.recoder.xyz,https://docker.recoder.xyz,https://agency.recoder.xyz,https://pm.recoder.xyz

# Optional admin token for A2A registry/orchestration APIs:
# - GET/PUT /api/a2a/agents
# - POST /api/a2a/agents/test
# - POST /api/a2a/orchestrate
RECODER_A2A_ADMIN_TOKEN=replace_with_admin_token
# Optional single-scope claim for RECODER_A2A_ADMIN_TOKEN
# RECODER_A2A_ADMIN_TOKEN_SCOPE=team-alpha
# Optional token->scope map (JSON). When set, this takes precedence over RECODER_A2A_ADMIN_TOKEN.
# RECODER_A2A_ADMIN_TOKEN_SCOPES={"alpha_admin_token":"team-alpha","beta_admin_token":"team-beta"}

# Agent registry bootstrap for terminal bridge targets
RECODER_A2A_ENABLE_CODEX=true
RECODER_A2A_ENABLE_CLAUDE_CODE=true
RECODER_A2A_CODEX_BASE_URL=http://127.0.0.1:9911
RECODER_A2A_CLAUDE_CODE_BASE_URL=http://127.0.0.1:9922

# Optional terminal bridge mode (Codex/Claude local CLIs behind web Recoder)
# Set base URLs to bridge://<bridgeId> OR leave blank and enable bridge fallback.
RECODER_A2A_ENABLE_BRIDGE_FALLBACK=true
RECODER_A2A_BRIDGE_DEFAULT_ID=default
RECODER_A2A_BRIDGE_TOKEN=replace_with_bridge_token
# Optional single-scope claim for static bridge token
# RECODER_A2A_BRIDGE_TOKEN_SCOPE=team-alpha
RECODER_A2A_BRIDGE_SESSION_TTL_MS=86400000
RECODER_A2A_BRIDGE_HEARTBEAT_TTL_MS=60000
RECODER_A2A_ORCH_ALLOWED_INTENTS=plan,execute,handoff,tool_call,review
RECODER_A2A_ORCH_DUAL_APPROVAL_INTENTS=execute
RECODER_A2A_ORCH_MAX_TARGETS=2
RECODER_A2A_ORCH_MAX_DEADLINE_MS=600000
RECODER_A2A_ORCH_POLICY_KEY=recoder:a2a:orchestration:policy
RECODER_A2A_AUDIT_STREAM_KEY=recoder:a2a:audit
RECODER_A2A_AUDIT_TTL_MS=604800000
RECODER_A2A_HISTORY_STREAM_BUFFER_SIZE=200
RECODER_A2A_HISTORY_STREAM_POLL_MS=1000
RECODER_A2A_ENFORCE_SCOPE=false
RECODER_A2A_SCOPE_HEADER=x-recoder-a2a-scope
# Optional migration fallback: allow scope from request header when token has no scope claim.
RECODER_A2A_ALLOW_HEADER_SCOPE_FALLBACK=false
# Optional prefixes for bridge queue/result/ack storage
# RECODER_A2A_BRIDGE_JOB_QUEUE_PREFIX=recoder:a2a:bridge:jobs
# RECODER_A2A_BRIDGE_RESULT_KEY_PREFIX=recoder:a2a:bridge:results
# RECODER_A2A_BRIDGE_RESULT_ACK_KEY_PREFIX=recoder:a2a:bridge:result-ack
# RECODER_A2A_BRIDGE_HEARTBEAT_KEY_PREFIX=recoder:a2a:bridge:heartbeat
# RECODER_A2A_BRIDGE_SESSION_KEY_PREFIX=recoder:a2a:bridge:sessions
# RECODER_A2A_HISTORY_STREAM_KEY_PREFIX=recoder:a2a:history:stream
