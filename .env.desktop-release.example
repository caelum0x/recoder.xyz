# Desktop Release signing/notarization secrets template
# Copy to .env.desktop-release and fill values before syncing:
#   cp .env.desktop-release.example .env.desktop-release
#   bash scripts/set-desktop-release-secrets.sh --from-env-file .env.desktop-release --write

DESKTOP_CSC_LINK=
DESKTOP_CSC_KEY_PASSWORD=

# Preferred notarization path. The bootstrap script base64-encodes this file
# into DESKTOP_APPLE_API_KEY; the file path itself is never uploaded.
DESKTOP_APPLE_API_KEY_FILE=
DESKTOP_APPLE_API_KEY_ID=
DESKTOP_APPLE_API_ISSUER=

# Alternative legacy notarization path. Leave blank when using the API key.
DESKTOP_APPLE_ID=
DESKTOP_APPLE_APP_SPECIFIC_PASSWORD=
DESKTOP_APPLE_TEAM_ID=
