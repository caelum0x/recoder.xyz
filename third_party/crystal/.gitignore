# Recoder vendor preservation: the parent repository has broad output/name rules
# that would otherwise hide these files even though they are tracked upstream.
# Keep this list narrow so generated node_modules/dist/runtime data stays ignored.
!/.npmrc
!/build/
!/build/**
!/frontend/public/
!/frontend/public/**
!/frontend/src/components/panels/claude/ClaudePanel.tsx.backup
!/frontend/src/components/panels/codex/CodexInputPanel.tsx.backup
!/frontend/src/styles/tokens.css
!/frontend/src/styles/tokens/
!/frontend/src/styles/tokens/**
!/main/src/database/migrations/add_conversation_support.sql
!/main/src/services/panels/claude/claudeCodeManager.ts.backup
