# ==============================================
# RECODER.XYZ MONOREPO - Environment Configuration
# ==============================================
# Copy this to .env and configure for your setup
# 
# 🚀 LOCAL-FIRST: Works great with just Ollama (no API keys needed!)
# 🌐 CLOUD-ENHANCED: Add API keys for advanced AI capabilities
# 🏗️ MONOREPO: Shared configuration for all projects

#====================================
# 🏗️ CORE CONFIGURATION
#====================================

# Environment & Server
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3001

# Service Ports (for local development)
BACKEND_PORT=3001
PRODUCTION_ENGINE_PORT=3002
WEB_PORT=3000
ROUTER_PORT=8080

#====================================
# 🔐 AUTHENTICATION & SECURITY
#====================================

# JWT Configuration (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-256-bits-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Session Management
SESSION_SECRET=your-session-secret-key-here
COOKIE_SECRET=your-cookie-secret-here

#====================================
# 🤖 LOCAL AI (NO API KEYS REQUIRED)
#====================================

# Ollama Local AI (RECOMMENDED - Works offline!)
OLLAMA_BASE_URL=http://localhost:11434
# Install: brew install ollama && ollama pull tinyllama

#====================================
# 🚀 PRIMARY AI PROVIDERS
#====================================

# Anthropic Claude (Best for complex reasoning, security, blockchain)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# OpenAI (GPT-4, reliable but expensive)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Google Gemini (Great for multimodal, large codebases, analysis)
GOOGLE_API_KEY=your-google-gemini-api-key-here

# Groq (Fastest inference, great for rapid iterations)
GROQ_API_KEY=YOUR_GROQ_API_KEY

#====================================
# 🌟 SPECIALIZED PROVIDERS
#====================================

# DeepSeek (Cost-optimized coding model)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Mistral (European privacy-focused, good for general coding)
MISTRAL_API_KEY=your-mistral-api-key-here

# Perplexity (Excellent for research, documentation, web search)
PERPLEXITY_API_KEY=pplx-your-perplexity-api-key-here

# Cohere (Text generation, classification, embeddings)
COHERE_API_KEY=your-cohere-api-key-here

# Together AI (Multi-model platform)
TOGETHER_API_KEY=your-together-api-key-here

#====================================
# 🌏 REGIONAL PROVIDERS
#====================================

# Kimi/Moonshot (Chinese AI, good for analysis)
KIMI_API_KEY=your-kimi-api-key-here
MOONSHOT_API_KEY=your-moonshot-api-key-here

# Qwen/DashScope (Alibaba's models, coding focused)
QWEN_API_KEY=your-qwen-api-key-here
DASHSCOPE_API_KEY=your-dashscope-api-key-here

#====================================
# Stripe Payment Processing
#====================================
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_endpoint_secret_here

# Stripe Price IDs (from your Stripe Dashboard)
STRIPE_PREMIUM_PRICE_ID=price_premium_monthly_20_usd
STRIPE_PRO_PRICE_ID=price_pro_monthly_100_usd

#====================================
# Database Configuration
#====================================
DATABASE_URL=<DATABASE_URL>
REDIS_URL=redis://localhost:6379

#====================================
# Next.js Web App
#====================================
NEXT_PUBLIC_BASE_URL=https://recoder.xyz
NEXT_PUBLIC_API_URL=https://api.recoder.xyz
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

#====================================
# CLI Configuration
#====================================
RECODER_API_URL=https://api.recoder.xyz
RECODER_WEB_URL=https://recoder.xyz

#====================================
# Usage Limits by Tier (Target 79% Margin)
#====================================

# Free Tier (Local models only)
FREE_TOKEN_LIMIT=0
FREE_REQUEST_LIMIT=0

# Premium Tier ($20/month - optimized for 79% margin)
PREMIUM_TOKEN_LIMIT=400000
PREMIUM_REQUEST_LIMIT=5000
PREMIUM_COST_BUDGET=15.00

# Pro Tier ($100/month - 5x premium limits)
PRO_TOKEN_LIMIT=2000000
PRO_REQUEST_LIMIT=25000
PRO_COST_BUDGET=75.00

# Enterprise Tier (Unlimited)
ENTERPRISE_TOKEN_LIMIT=-1
ENTERPRISE_REQUEST_LIMIT=-1

#====================================
# AI Model Cost Optimization
#====================================

# Target cost per 1M tokens for each model
DEEPSEEK_COST_PER_1M=0.14
GROQ_COST_PER_1M=0.08
CLAUDE_COST_PER_1M=3.00
GEMINI_COST_PER_1M=1.25
OPENAI_COST_PER_1M=2.00

# Routing percentages (should add up to 100)
DEEPSEEK_USAGE_PERCENT=70
GROQ_USAGE_PERCENT=20
CLAUDE_USAGE_PERCENT=8
GEMINI_USAGE_PERCENT=2
