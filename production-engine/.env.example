# ==============================================
# PRODUCTION ENGINE - Environment Configuration  
# ==============================================
# Copy this to .env and configure based on your setup
# 
# 🏭 PRODUCTION-READY CODE GENERATION ENGINE
# 🤖 LOCAL-FIRST: Works with Ollama, enhanced with cloud AI

#====================================
# 🏗️ CORE ENGINE CONFIGURATION
#====================================

# Server Settings
NODE_ENV=development
PORT=3002
SERVICE_NAME=production-engine

# Engine Configuration
ENGINE_VERSION=1.0.0
MAX_CONCURRENT_GENERATIONS=5
GENERATION_TIMEOUT=300000

#====================================
# 🤖 AI PROVIDERS - PRODUCTION FOCUS
#====================================

# Local AI (Primary for cost-effective generation)
OLLAMA_BASE_URL=http://localhost:11434

# Cloud AI Providers (for enhanced capabilities)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_API_KEY=your-google-gemini-api-key-here
GROQ_API_KEY=gsk_your-groq-api-key-here

# Specialized Providers
MISTRAL_API_KEY=your-mistral-api-key-here
PERPLEXITY_API_KEY=pplx-your-perplexity-api-key-here
COHERE_API_KEY=your-cohere-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Regional Providers
KIMI_API_KEY=your-kimi-api-key-here
MOONSHOT_API_KEY=your-moonshot-api-key-here
QWEN_API_KEY=your-qwen-api-key-here
DASHSCOPE_API_KEY=your-dashscope-api-key-here
TOGETHER_API_KEY=your-together-api-key-here

#====================================
# 🎯 MODEL ROUTING & OPTIMIZATION
#====================================

# Model selection strategy (cost_optimized, quality_first, speed_first)
MODEL_SELECTION_STRATEGY=cost_optimized

# Usage distribution for cost optimization
OLLAMA_USAGE_PERCENT=50
DEEPSEEK_USAGE_PERCENT=25
GROQ_USAGE_PERCENT=15
ANTHROPIC_USAGE_PERCENT=8
GOOGLE_USAGE_PERCENT=2

# Model preferences by task type
BLOCKCHAIN_PREFERRED_MODEL=claude-3-sonnet
WEB_PREFERRED_MODEL=deepseek-coder
MOBILE_PREFERRED_MODEL=groq-llama
BACKEND_PREFERRED_MODEL=deepseek-coder
AI_PREFERRED_MODEL=claude-3-sonnet

#====================================
# 🔒 SECURITY & VALIDATION
#====================================

# Security Engine Configuration
ENABLE_SECURITY_SCANNING=true
SECURITY_SCORE_THRESHOLD=70
MAX_VULNERABILITY_SEVERITY=medium

# Code Validation Settings
ENABLE_SYNTAX_VALIDATION=true
ENABLE_FUNCTIONALITY_VALIDATION=true
ENABLE_PRODUCTION_READINESS_CHECK=true

# Security Integration (connect to security package)  
SECURITY_PACKAGE_URL=../packages/security
VULNERABILITY_SCANNER_ENABLED=true
SECRET_DETECTOR_ENABLED=true

#====================================
# 📁 FILE GENERATION SETTINGS
#====================================

# Output Configuration
DEFAULT_OUTPUT_PATH=./generated
MAX_FILES_PER_GENERATION=50
MAX_FILE_SIZE_MB=10

# Template System
TEMPLATE_ENGINE=handlebars
TEMPLATE_CACHE_ENABLED=true
CUSTOM_TEMPLATES_PATH=./templates

#====================================
# 🚀 PERFORMANCE & CACHING
#====================================

# Caching Configuration
ENABLE_RESPONSE_CACHE=true
CACHE_TTL_MINUTES=60
CACHE_MAX_SIZE_MB=100

# Generation Performance
ENABLE_PARALLEL_GENERATION=true
MAX_PARALLEL_WORKERS=3
GENERATION_QUEUE_SIZE=10

# Resource Limits
MAX_MEMORY_USAGE_MB=1024
MAX_CPU_USAGE_PERCENT=80

#====================================
# 🔄 BACKEND INTEGRATION
#====================================

# Backend Service Connection
BACKEND_API_URL=http://localhost:3001
BACKEND_AUTH_TOKEN=your-backend-auth-token

# CLI Integration
CLI_WEBHOOK_URL=http://localhost:8080/webhook
CLI_AUTH_SECRET=your-cli-auth-secret

#====================================
# 📊 MONITORING & TELEMETRY
#====================================

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Metrics Collection
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs/production-engine.log

# OpenTelemetry (Optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=recoder-production-engine

#====================================
# 🌐 EXTERNAL INTEGRATIONS
#====================================

# Docker Integration (for containerized generation)
DOCKER_ENABLED=false
DOCKER_SOCKET=/var/run/docker.sock

# Git Integration (for repository operations)
GIT_DEFAULT_BRANCH=main
GIT_COMMIT_MESSAGE_TEMPLATE="Generated by Recoder Production Engine"

# Package Manager Integration
NPM_REGISTRY_URL=https://registry.npmjs.org
PYTHON_PACKAGE_INDEX=https://pypi.org/simple

#====================================
# 🔧 DEVELOPMENT SETTINGS
#====================================

# Development Mode Features
ENABLE_HOT_RELOAD=true
ENABLE_DEBUG_ENDPOINTS=true
MOCK_AI_RESPONSES=false

# Testing Configuration
TEST_OLLAMA_MODEL=tinyllama:latest
TEST_GENERATION_TIMEOUT=30000
ENABLE_INTEGRATION_TESTS=true

#====================================
# 🏭 PRODUCTION OPTIMIZATIONS
#====================================

# Production-specific settings (uncomment for production)
# NODE_ENV=production
# ENABLE_RESPONSE_COMPRESSION=true
# ENABLE_REQUEST_RATE_LIMITING=true
# MAX_REQUESTS_PER_MINUTE=100

# Security Headers
# ENABLE_SECURITY_HEADERS=true
# CSP_POLICY=default-src 'self'

# SSL/TLS Configuration
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

#====================================
# 💡 QUICK START GUIDE
#====================================
# 
# Local Development (No API Keys):
# 1. Install Ollama: brew install ollama
# 2. Pull models: ollama pull tinyllama deepseek-coder
# 3. Start Ollama: ollama serve
# 4. Run engine: npm run dev
# 5. Test: curl http://localhost:3002/health
# 
# ✅ Production Engine works great with just Ollama!
# 
# 🚀 For enhanced capabilities:
#   - Add cloud AI provider keys
#   - Enable security scanning
#   - Configure performance monitoring