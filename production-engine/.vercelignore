# Testing
test-results/
playwright-report/

# Cache directories
.cache/
.parcel-cache/

# Temporary directories
tmp/
temp/

# Documentation (not needed in production)
docs/
*.md
!README.md

# Development only files
docker-compose.yml
Dockerfile
.dockerignore

# Large example files
examples/
samples/
demo/

# Git
.git/
.gitignore

# Package manager lock files (will be generated)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Compliance scan results (large files)
compliance-reports/
scan-results/

