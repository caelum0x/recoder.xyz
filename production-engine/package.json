    "eslint": "^8.54.0",
    "eslint-config-standard": "^17.1.0",
    "jest": "^30.0.5",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
