{
  "name": "@recoder/production-engine",
  "version": "2.0.0",
  "description": "Commercial Production Code Engine - Real AI-powered code generation with OpenRouter integration",
  "main": "src/server.js",
  "scripts": {
    "dev": "npx tsx src/server.ts",
    "start": "npx tsx src/server.ts",
    "build": "tsc",
    "build:types": "tsc --noEmit || true",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testMatch='**/integration/**/*.test.js'",
    "test:blockchain": "jest --testMatch='**/blockchain/**/*.test.js'",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "validate:all": "node src/scripts/validate-all.js",
    "docker:build": "docker build -t codecraft-production-engine .",
    "docker:run": "docker run -p 3002:3002 codecraft-production-engine"
  },
  "keywords": [
    "production",
    "validation",
    "real-functionality",
    "blockchain",
    "ai",
    "integrations"
  ],
  "author": "CodeCraft Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@anthropic-ai/vertex-sdk": "^0.13.1",
