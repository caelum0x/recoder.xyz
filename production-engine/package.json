{
  "name": "@codecraft/production-engine",
  "version": "1.0.0",
  "description": "Production Code Engine - Ensures real functionality and production readiness",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "npm run lint && npm run test",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testMatch='**/integration/**/*.test.js'",
    "test:blockchain": "jest --testMatch='**/blockchain/**/*.test.js'",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "validate:all": "node src/scripts/validate-all.js",
    "docker:build": "docker build -t codecraft-production-engine .",
    "docker:run": "docker run -p 3002:3002 codecraft-production-engine"
  },
  "keywords": [
    "production",
    "validation",
    "real-functionality",
    "blockchain",
    "ai",
    "integrations"
  ],
  "author": "CodeCraft Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "axios": "^1.6.2",
    "lodash": "^4.17.21",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    
    "ws": "^8.14.2",
    "socket.io-client": "^4.7.4",
    
    "fs-extra": "^11.2.0",
    "tar": "^6.2.0",
    "adm-zip": "^0.5.10",
    
    "@solana/web3.js": "^1.87.6",
    "@project-serum/anchor": "^0.28.0",
    "@solana/spl-token": "^0.3.8",
    "@solana/wallet-adapter-base": "^0.9.23",
    
    "web3": "^4.3.0",
    "ethers": "^6.8.1",
    "@openzeppelin/contracts": "^5.0.1",
    "hardhat": "^2.19.2",
    
    "openai": "^4.20.1",
    "@anthropic-ai/sdk": "^0.9.1",
    "langchain": "^0.0.200",
    "@pinecone-database/pinecone": "^1.1.2",
    
    "stripe": "^14.9.0",
    "paypal-rest-sdk": "^1.8.1",
    
    "pg": "^8.11.3",
    "mongodb": "^6.3.0",
    "redis": "^4.6.10",
    "prisma": "^5.7.0",
    "@prisma/client": "^5.7.0",
    
    "@aws-sdk/client-s3": "^3.465.0",
    "@aws-sdk/client-lambda": "^3.465.0",
    "@aws-sdk/client-ec2": "^3.465.0",
    
    "jest": "^29.7.0",
    "playwright": "^1.40.1",
    "puppeteer": "^21.6.1",
    "supertest": "^6.3.3",
    "artillery": "^2.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.54.0",
    "eslint-config-standard": "^17.1.0",
    "@types/node": "^20.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codecraft-team/codecraft.git",
    "directory": "production-engine"
  }
}