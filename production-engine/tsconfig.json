{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "strict": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "downlevelIteration": true,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@services/*": ["src/services/*"],
      "@generators/*": ["src/generators/*"],
      "@validators/*": ["src/validators/*"],
      "@utils/*": ["src/utils/*"],
      "@recoder/shared": ["../packages/shared/src"],
      "@recoder/shared/*": ["../packages/shared/src/*"],
      "@recoder/security": ["../packages/security/src"],
      "@recoder/security/*": ["../packages/security/src/*"],
      "@roo-code/types": ["../packages/roo-code-types/src"],
      "@roo-code/types/*": ["../packages/roo-code-types/src/*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "../packages/shared/src/auth-client.ts",
    "../packages/shared/src/oauth-handler.ts",
    "../packages/shared/src/oauth-web.ts",
    "../packages/shared/src/oauth-mobile.ts",
    "../packages/shared/src/websocket-client.ts",
    "src/compliance/**/*",
    "src/compliance.disabled/**/*",
    "src/services/real-code-generator-service.ts",
    "src/services/unified-backend-ai.ts",
    "src/services/analytics-service.ts",
    "src/services/ai-cost-optimizer.ts",
    "src/services/ai-provider-manager.ts",
    "src/services/code-analysis.ts",
    "src/services/intelligent-failover.ts",
    "src/api/transform/vscode-lm-format.ts",
    "src/api/transform/openai-format.ts",
    "src/api/providers/vscode-lm.ts",
    "src/api/providers/human-relay.ts",
    "src/api/providers/**/*",
    "src/api/transform/reasoning.ts",
    "src/middleware/**/*",
    "src/types/index.ts",
    "src/generators/real-code-generator.ts",
    "src/server.ts",
    "src/services/real-time-optimization-service.ts",
    "src/services/security-integration.ts"
  ]
}