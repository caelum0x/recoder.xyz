{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "strict": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "downlevelIteration": true,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@services/*": ["./services/*"],
      "@generators/*": ["./generators/*"],
      "@validators/*": ["./validators/*"],
      "@utils/*": ["./utils/*"]
    }
  },
  "include": [
    "src/utils/**/*.ts",
    "src/services/commercial-ai-hub-service.ts",
    "src/services/openrouter-service.ts",
    "src/server.ts",
    "src/minimal-server.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../packages",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/compliance/**/*",
    "src/compliance.disabled/**/*",
    "src/services/real-code-generator-service.ts",
    "src/services/unified-backend-ai.ts",
    "src/services/analytics-service.ts",
    "src/api/index.ts",
    "src/api/transform/model-params.ts",
    "src/services/ai-cost-optimizer.ts",
    "src/services/ai-provider-manager.ts",
    "src/services/code-analysis.ts",
    "src/services/intelligent-failover.ts",
    "src/api/transform/vscode-lm-format.ts",
    "src/api/transform/openai-format.ts",
    "src/api/providers/vscode-lm.ts",
    "src/api/providers/human-relay.ts",
    "src/api/providers/**/*",
    "src/api/transform/reasoning.ts",
    "src/middleware/**/*",
    "src/types/index.ts",
    "src/generators/real-code-generator.ts",
    "src/server.ts",
    "src/services/real-time-optimization-service.ts",
    "src/services/security-integration.ts"
  ]
}