# CodeCraft Environment Configuration

# Application
NODE_ENV=development
LOG_LEVEL=info

# CodeCraft API
CODECRAFT_API_URL=https://api.recoder.xyz
CODECRAFT_API_KEY=your_api_key_here

# AI Services (Optional - for enhanced features)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Database (Backend Development)
DATABASE_URL=postgresql://codecraft:password@localhost:5432/codecraft_dev
DATABASE_SSL=false

# Redis (Caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
SESSION_SECRET=your_session_secret

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=.js,.ts,.jsx,.tsx,.json,.md,.txt

# External Services
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=codecraft-uploads

# Blockchain (Optional)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PRIVATE_KEY=your_solana_private_key
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your_project_id

# Payment Processing (Optional)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Monitoring & Analytics
SENTRY_DSN=your_sentry_dsn
GOOGLE_ANALYTICS_ID=your_ga_id
MIXPANEL_TOKEN=your_mixpanel_token

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@codecraft.dev

# Development
HOT_RELOAD=true
ENABLE_CORS=true
TRUST_PROXY=false

# Testing
TEST_DATABASE_URL=postgresql://codecraft:password@localhost:5432/codecraft_test
TEST_REDIS_URL=redis://localhost:6379/1

# Production
PRODUCTION_URL=https://codecraft.dev
CDN_URL=https://cdn.codecraft.dev
ENABLE_COMPRESSION=true
ENABLE_RATE_LIMITING=true

# Feature Flags
ENABLE_REAL_INTEGRATIONS=true
ENABLE_BLOCKCHAIN_FEATURES=true
ENABLE_AI_FEATURES=true
ENABLE_TELEMETRY=true
ENABLE_ANALYTICS=true