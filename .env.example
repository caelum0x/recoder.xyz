# =============================================================================
# RECODER.XYZ - Environment Configuration
# =============================================================================

# =============================================================================
# CORE APPLICATION PORTS
# =============================================================================
NODE_ENV=development
BACKEND_PORT=3100
WEB_PORT=5173
ENGINE_PORT=3002
APP_NAME=recoder.xyz
APP_URL=http://localhost:5173

# =============================================================================
# SHARED ACROSS ALL SERVICES
# These vars must be identical in every service that reads them.
# =============================================================================
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"
AUTH_DATABASE_URL="postgresql://username:password@localhost:5432/recoder_auth"
INTERNAL_SERVICE_KEY="your-internal-service-key-hex-64-chars"

# =============================================================================
# PER-SERVICE: OAUTH PROVIDERS
# =============================================================================
GITHUB_ID="your-github-oauth-app-id"
GITHUB_SECRET="your-github-oauth-app-secret"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
DISCORD_CLIENT_ID="your-discord-oauth-client-id"
DISCORD_CLIENT_SECRET="your-discord-oauth-client-secret"

# =============================================================================
# PER-SERVICE: MULTI-AI PROVIDER CONFIGURATION
# Used by recoder-web for BYOK and server-side AI calls.
# =============================================================================

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=8000

# Groq
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama3-70b-8192
GROQ_MAX_TOKENS=8000

# Google Gemini
GOOGLE_API_KEY=AIza_your_gemini_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MAX_TOKENS=8000

# OpenAI
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=8000

# Ollama (local/offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama:13b

# =============================================================================
# AI SMART ROUTING
# =============================================================================
AI_SELECTION_STRATEGY=smart
AI_FALLBACK_ENABLED=true
AI_RETRY_COUNT=3
AI_COST_LIMIT_DAILY=100.00

# =============================================================================
# PER-SERVICE: DATABASE & STORAGE
# =============================================================================
DATABASE_URL=postgresql://recoder:password@localhost:5432/recoder_db
DATABASE_SSL=false
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# File storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50485760

# =============================================================================
# PER-SERVICE: SECURITY
# =============================================================================
API_ENCRYPTION_KEY="your-api-encryption-key-32-bytes-hex"

# Vault encryption (REQUIRED for production secret storage)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_MASTER_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
VAULT_SALT=

# RAG embedding profile (optional, defaults to openai-text-embedding-3-small)
# RAG_EMBEDDING_PROFILE=openai-text-embedding-3-small

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
CORS_ORIGINS=http://localhost:5173,http://localhost:3100

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ENABLED=true
METRICS_PORT=9090
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project

# =============================================================================
# NOTIFICATIONS
# =============================================================================
SENDGRID_API_KEY=SG.your_sendgrid_key
FROM_EMAIL=noreply@recoder.xyz
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_CHAT_INTERFACE=true
ENABLE_AGENT_SYSTEM=true
ENABLE_PROJECT_CONTEXT=true
ENABLE_REALITY_VALIDATION=true

# =============================================================================
# OPENCLAW ECOSYSTEM (OPTIONAL)
# =============================================================================
RECODER_WEB_URL=https://web.recoder.xyz
RECODER_DOCKER_URL=https://docker.recoder.xyz
RECODER_API_URL=https://api.recoder.xyz
# RECODER_API_KEY=sk_...

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
DEBUG=recoder:*
VERBOSE_LOGGING=false
HOT_RELOAD=true
ENABLE_CORS=true

# =============================================================================
# TESTING
# =============================================================================
TEST_DATABASE_URL=postgresql://recoder:password@localhost:5432/recoder_test
TEST_REDIS_URL=redis://localhost:6379/1

# =============================================================================
# PRODUCTION DEPLOYMENT
# =============================================================================
PRODUCTION_URL=https://recoder.xyz
CDN_URL=https://cdn.recoder.xyz
ENABLE_COMPRESSION=true
ENABLE_RATE_LIMITING=true

# Docker
DOCKER_IMAGE_TAG=latest
DOCKER_REGISTRY=your_registry_url

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
HTTP_TIMEOUT=30000
AI_REQUEST_TIMEOUT=120000
DATABASE_TIMEOUT=10000
MAX_CONCURRENT_REQUESTS=50
CACHE_TTL=3600
