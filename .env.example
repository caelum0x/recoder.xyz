# =============================================================================
# RECODER.XYZ - Complete Environment Configuration
# Production-Ready AI Development Platform with Unified Authentication
# =============================================================================

# =============================================================================
# CORE APPLICATION
# =============================================================================
NODE_ENV=development
PORT=3003
BACKEND_PORT=3001
ENGINE_PORT=3002
WEB_PORT=3000
CHAT_PORT=3001
MAIN_PORT=3003
APP_NAME=recoder.xyz
APP_URL=http://localhost:3003
API_VERSION=v1

# =============================================================================
# UNIFIED AUTHENTICATION
# =============================================================================
DATABASE_URL="postgresql://username:password@localhost:5432/recoder_unified"
NEXTAUTH_URL="http://localhost:3003"
NEXTAUTH_SECRET="your-nextauth-secret-key-minimum-32-characters"

# Cross-domain session sync
SESSION_SYNC_SECRET="your-session-sync-secret-key-32-chars"
API_ENCRYPTION_KEY="your-api-encryption-key-32-bytes-hex"

# OAuth Providers
GITHUB_ID="your-github-oauth-app-id"
GITHUB_SECRET="your-github-oauth-app-secret"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
DISCORD_CLIENT_ID="your-discord-oauth-client-id"
DISCORD_CLIENT_SECRET="your-discord-oauth-client-secret"

# =============================================================================
# MULTI-AI PROVIDER CONFIGURATION
# =============================================================================

# Anthropic Claude (Primary: Complex logic, security, blockchain)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=8000

# Groq (Primary: Fast coding, React/Next.js, rapid prototyping)
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama3-70b-8192
GROQ_MAX_TOKENS=8000

# Google Gemini (Primary: Multimodal, large codebases, documentation)
GOOGLE_API_KEY=AIza_your_gemini_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MAX_TOKENS=8000

# OpenAI (Backup only, limited coding use)
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=8000

# Ollama (Local/Private projects, offline use)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama:13b

# =============================================================================
# AI SMART ROUTING
# =============================================================================
AI_SELECTION_STRATEGY=smart
AI_FALLBACK_ENABLED=true
AI_RETRY_COUNT=3
AI_COST_LIMIT_DAILY=100.00

# Task-specific model preferences
AI_BLOCKCHAIN_MODEL=claude-3-sonnet
AI_WEB_MODEL=groq-llama3-70b
AI_MOBILE_MODEL=groq-llama3-70b
AI_BACKEND_MODEL=claude-3-sonnet
AI_SECURITY_MODEL=claude-3-sonnet
AI_DEVOPS_MODEL=gemini-1.5-pro

# =============================================================================
# DATABASE & STORAGE
# =============================================================================
DATABASE_URL=postgresql://recoder:password@localhost:5432/recoder_db
DATABASE_SSL=false
DATABASE_POOL_SIZE=20

# Redis for caching and sessions
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# File storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50485760
S3_BUCKET=recoder-storage
S3_REGION=us-east-1

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
JWT_SECRET=your_super_secure_jwt_secret_min_32_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
API_KEY=your_recoder_api_key
SESSION_SECRET=your_session_secret

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# BLOCKCHAIN INTEGRATIONS
# =============================================================================

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL_DEVNET=https://api.devnet.solana.com
SOLANA_WALLET_PRIVATE_KEY=your_solana_private_key

# Ethereum
ETH_RPC_URL=https://mainnet.infura.io/v3/your_infura_id
ETH_RPC_URL_TESTNET=https://sepolia.infura.io/v3/your_infura_id
ETH_PRIVATE_KEY=your_ethereum_private_key

# Web3 Storage
IPFS_API_KEY=your_ipfs_key
ARWEAVE_WALLET=your_arweave_wallet

# =============================================================================
# PAYMENT PROCESSORS
# =============================================================================

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
PAYPAL_ENVIRONMENT=sandbox

# =============================================================================
# CLOUD SERVICES
# =============================================================================

# AWS
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=recoder-files

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ENABLED=true
METRICS_PORT=9090

# Error tracking
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your_mixpanel_token

# =============================================================================
# NOTIFICATIONS
# =============================================================================

# Email
SENDGRID_API_KEY=SG.your_sendgrid_key
FROM_EMAIL=noreply@recoder.xyz
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/your/webhook

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Core features
ENABLE_CHAT_INTERFACE=true
ENABLE_AGENT_SYSTEM=true
ENABLE_PROJECT_CONTEXT=true
ENABLE_REALITY_VALIDATION=true

# Advanced features
ENABLE_BLOCKCHAIN_GENERATION=true
ENABLE_PAYMENT_INTEGRATION=true
ENABLE_MOBILE_GENERATION=true

# Experimental features
ENABLE_VOICE_INTERFACE=false
ENABLE_CODE_REVIEW_AI=false
ENABLE_AUTOMATED_DEPLOYMENT=false

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
DEBUG=recoder:*
VERBOSE_LOGGING=false
HOT_RELOAD=true
ENABLE_CORS=true

# Mock services for development
MOCK_AI_PROVIDERS=false
MOCK_PAYMENTS=true
MOCK_BLOCKCHAIN=true

# =============================================================================
# TESTING
# =============================================================================
TEST_DATABASE_URL=postgresql://recoder:password@localhost:5432/recoder_test
TEST_REDIS_URL=redis://localhost:6379/1

# =============================================================================
# PRODUCTION DEPLOYMENT
# =============================================================================
PRODUCTION_URL=https://recoder.xyz
CDN_URL=https://cdn.recoder.xyz
ENABLE_COMPRESSION=true
ENABLE_RATE_LIMITING=true

# SSL
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# Docker
DOCKER_IMAGE_TAG=latest
DOCKER_REGISTRY=your_registry_url

# Kubernetes
K8S_NAMESPACE=recoder
K8S_CONFIG_PATH=/path/to/kubeconfig

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
HTTP_TIMEOUT=30000
AI_REQUEST_TIMEOUT=120000
DATABASE_TIMEOUT=10000
MAX_CONCURRENT_REQUESTS=50
CACHE_TTL=3600

# =============================================================================
# BACKUP & DISASTER RECOVERY
# =============================================================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=recoder-backups