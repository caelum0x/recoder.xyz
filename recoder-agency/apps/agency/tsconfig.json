{
	"compilerOptions": {
		"lib": ["dom", "dom.iterable", "esnext"],
		"downlevelIteration": true,
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./*"],
			"@recoder/*": ["./packages/*"],
			"@recoder/shared": ["../../../shared/src/index.ts"],
			"@recoder/shared/*": ["../../../shared/src/*"],
			"@recoder/icons/*": [
				"../../internal-packages/workflow-designer-ui/src/icons/*"
			],
			"@recoder/storage": ["../../packages/storage/src/index.ts"],
			"@recoder/vault": ["../../packages/vault/src/index.ts"]
		},
		"target": "ES2017"
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		"trigger.config.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
