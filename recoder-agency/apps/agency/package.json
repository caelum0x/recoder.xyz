{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "agency",
	"version": "0.1.0",
	"engines": {
		"node": "24.x"
	},
	"private": true,
	"scripts": {
		"dev": "next dev",
		"dev-debug": "LOGLEVEL=debug pnpm run dev",
		"email:dev": "email dev --dir emails --port 3333",
		"email:export": "email export --dir emails --outDir out",
		"build": "next build && node ./scripts/prepare-standalone-assets.mjs",
		"build:analyze": "ANALYZE=true next build && node ./scripts/prepare-standalone-assets.mjs",
		"start": "next start",
		"format": "biome check --write .",
		"lint": "next lint",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"ops:staging:delivery-check": "bash ./scripts/staging-delivery-transition-check.sh",
		"ops:staging:refresh-weekly-metrics": "psql \"$AGENCY_STAGING_DATABASE_URL\" -v ON_ERROR_STOP=1 -f ./db/scripts/refresh_weekly_delivery_metrics.sql",
		"ops:staging:check-weekly-metrics-freshness": "psql \"$AGENCY_STAGING_DATABASE_URL\" -v ON_ERROR_STOP=1 -v stale_days=${WEEKLY_METRICS_STALE_AFTER_DAYS:-10} -f ./db/scripts/check_weekly_metrics_freshness.sql",
		"ops:staging:seed-weekly-metrics-fixture": "psql \"$AGENCY_STAGING_DATABASE_URL\" -v ON_ERROR_STOP=1 -f ./db/scripts/seed_weekly_delivery_metrics_fixture.sql",
		"ops:staging:assert-weekly-metrics-fixture": "psql \"$AGENCY_STAGING_DATABASE_URL\" -v ON_ERROR_STOP=1 -f ./db/scripts/assert_weekly_delivery_metrics_fixture.sql",
		"ops:staging:cleanup-weekly-metrics-fixture": "psql \"$AGENCY_STAGING_DATABASE_URL\" -v ON_ERROR_STOP=1 -f ./db/scripts/cleanup_weekly_delivery_metrics_fixture.sql",
		"ops:staging:verify-weekly-metrics-pipeline": "pnpm ops:staging:seed-weekly-metrics-fixture && pnpm ops:staging:assert-weekly-metrics-fixture && pnpm ops:staging:cleanup-weekly-metrics-fixture",
		"ops:staging:test-transition-guardrails": "psql \"$AGENCY_STAGING_DATABASE_URL\" -v ON_ERROR_STOP=1 -f ./db/scripts/test_transition_guardrails.sql",
		"ops:staging:assert-release-readiness": "psql \"$AGENCY_STAGING_DATABASE_URL\" -v ON_ERROR_STOP=1 -v stale_days=${WEEKLY_METRICS_STALE_AFTER_DAYS:-10} -f ./db/scripts/assert_delivery_release_readiness.sql",
		"ops:staging:assert-release-readiness:full": "psql \"$AGENCY_STAGING_DATABASE_URL\" -v ON_ERROR_STOP=1 -v stale_days=${WEEKLY_METRICS_STALE_AFTER_DAYS:-10} -v check_p1_phase2=true -f ./db/scripts/assert_delivery_release_readiness.sql",
		"ops:staging:check-unit-economics": "psql \"$AGENCY_STAGING_DATABASE_URL\" -v ON_ERROR_STOP=1 -f ./db/scripts/check_project_unit_economics.sql",
		"ops:staging:backup-restore-drill": "bash ./scripts/ops-backup-restore-drill.sh",
		"ops:generate-bootstrap": "bash ./scripts/generate-bootstrap-sql.sh",
		"ops:staging:log-restore-drill": "psql \"$AGENCY_STAGING_DATABASE_URL\" -v ON_ERROR_STOP=1 -v team_db_id=${TEAM_DB_ID:-} -v operator_name=${RESTORE_OPERATOR:-unknown-operator} -v backup_reference=${RESTORE_BACKUP_REFERENCE:-manual} -v validation_summary=${RESTORE_VALIDATION_SUMMARY:-manual-validation} -f ./db/scripts/log_restore_drill.sql",
		"typegen": "next typegen",
		"check-types": "tsc --noEmit",
		"postinstall": "node ./scripts/copy-pdfium-wasm.mjs",
		"a2a:worker": "node ./scripts/a2a-intent-worker.mjs"
	},
	"packageManager": "pnpm@10.16.0",
	"dependencies": {
		"@recoder/design-tokens": "file:../../../packages/design-tokens",
		"@recoder/shared": "file:../../../shared",
		"@recoder/auth": "file:../../../packages/auth",
		"@aws-sdk/client-s3": "catalog:",
		"@embedpdf/pdfium": "catalog:",
		"@recoder-internal/ui": "workspace:*",
		"@recoder-internal/workflow-designer-ui": "workspace:*",
		"@recoder/data-store-registry": "workspace:*",
		"@recoder/document-preprocessor": "workspace:*",
		"@recoder/giselle": "workspace:*",
		"@recoder/github-tool": "workspace:*",
		"@recoder/langfuse": "workspace:*",
		"@recoder/language-model": "workspace:*",
		"@recoder/nextjs": "workspace:*",
		"@recoder/node-registry": "workspace:*",
		"@recoder/protocol": "workspace:*",
		"@recoder/rag": "workspace:*",
		"@recoder/react": "workspace:*",
		"@recoder/supabase-driver": "workspace:*",
		"@recoder/utils": "workspace:*",
		"@icons-pack/react-simple-icons": "10.0.0",
		"@next/env": "catalog:",
		"@next/third-parties": "catalog:",
		"@octokit/auth-app": "catalog:",
		"@octokit/core": "catalog:",
		"@octokit/request-error": "catalog:",
		"@paralleldrive/cuid2": "2.2.2",
		"@radix-ui/react-dropdown-menu": "2.1.16",
		"@radix-ui/react-icons": "1.3.2",
		"@radix-ui/react-label": "2.1.7",
		"@radix-ui/react-radio-group": "1.3.8",
		"@radix-ui/react-slot": "1.2.3",
		"@radix-ui/react-tooltip": "1.2.8",
		"@react-email/components": "1.0.1",
		"@sentry/nextjs": "10.28.0",
		"@supabase/supabase-js": "catalog:",
		"@ai-sdk/openai": "catalog:",
		"better-auth": "catalog:",
		"@trigger.dev/sdk": "catalog:",
		"@vercel/edge-config": "catalog:",
		"@vercel/functions": "catalog:",
		"@vercel/postgres": "0.9.0",
		"@vercel/speed-insights": "1.0.12",
		"ai": "catalog:",
		"boring-avatars": "1.11.1",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"drizzle-orm": "0.44.2",
		"flags": "4.0.0",
		"gaxios": "6.7.1",
		"google-auth-library": "9.15.0",
		"googleapis": "144.0.0",
		"happy-dom": "catalog:",
		"import-in-the-middle": "catalog:",
		"input-otp": "1.4.2",
		"ioredis": "^5.9.1",
		"jsdom": "catalog:",
		"lucide-react": "catalog:",
		"motion": "catalog:",
		"next": "catalog:",
		"next-themes": "0.3.0",
		"nodemailer": "7.0.11",
		"nuqs": "catalog:",
		"openai": "catalog:",
		"pg": "catalog:",
		"pino": "catalog:",
		"posthog-js": "1.194.2",
		"prettier": "catalog:",
		"radix-ui": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-email": "5.0.5",
		"require-in-the-middle": "catalog:",
		"shiki": "catalog:",
		"@polar-sh/sdk": "0.43.0",
		"tailwind-merge": "2.6.0",
		"tiny-invariant": "1.3.3",
		"valibot": "1.2.0",
		"zod": "catalog:",
		"zustand": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@next/bundle-analyzer": "16.0.7",
		"@octokit/openapi-types": "catalog:",
		"@playwright/test": "1.56.1",
		"@react-email/preview-server": "5.0.5",
		"@tailwindcss/postcss": "catalog:",
		"@types/node": "catalog:",
		"@types/nodemailer": "6.4.17",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"drizzle-kit": "0.31.4",
		"pino-pretty": "13.0.0",
		"playwright": "1.56.1",
		"postcss": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "5.7.3",
		"vite-tsconfig-paths": "5.1.4",
		"vitest": "catalog:"
	},
	"trustedDependencies": [
		"@sentry/cli"
	]
}
