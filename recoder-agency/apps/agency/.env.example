# Authentication (better-auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=

# for signed cookie
COOKIE_SECRET=

# for OAuth token encryption (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# for cron job
CRON_SECRET=

## Enable @vercel/flags at all times in the development environment
DEVELOPER_FLAG="true"

# @vercel/flags API Reference https://vercel.com/docs/workflow-collaboration/feature-flags/vercel-flags
# @see https://vercel.com/docs/workflow-collaboration/feature-flags/supporting-feature-flags#flags_secret-environment-variable
FLAGS_SECRET=

# Google Tag Manager https://tagmanager.google.com/
# @see https://support.google.com/tagmanager/answer/6102821
GTM_ID=

# Langfuse https://langfuse.com/
# @see https://langfuse.com/docs/get-started
LANGFUSE_BASEURL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# OpenAI API https://openai.com/index/openai-api/
# @see https://platform.openai.com/docs/quickstart
OPENAI_API_KEY=

# Vercel Postgres https://vercel.com/docs/storage/vercel-postgres
# @see https://vercel.com/docs/storage/vercel-postgres#getting-started
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NO_SSL=
POSTGRES_USER=

# Sentry https://sentry.io/
# @see https://docs.sentry.io/cli/configuration/
SENTRY_AUTH_TOKEN=

# Stripe https://stripe.com/
# @see https://docs.stripe.com/keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PLAN_PRICE_ID=
STRIPE_USER_SEAT_PRICE_ID=
STRIPE_MODEL_USAGE_PRICE_ID=
# Stripe Pricing Plans v2 (preview API)
STRIPE_PRO_PRICING_PLAN_ID=
STRIPE_PRO_LICENSE_FEE_COMPONENT_ID=
STRIPE_V2_WEBHOOK_SECRET=

# Supabase https://supabase.com/
# @see https://supabase.com/docs/guides/getting-started/tutorials/with-nextjs#initialize-a-nextjs-app
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# SMTP Email Configuration
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Email Debug Mode (set "true" to skip sending emails and show debug output)
SEND_EMAIL_DEBUG=1

# Delivery operations and rollout flags
FEATURE_RETRY_PANEL=true
NEXT_PUBLIC_FEATURE_RETRY_PANEL=true
NEXT_PUBLIC_FEATURE_FUNNEL_ANALYTICS=false
FEATURE_AUTO_REFRESH_WEEKLY_METRICS=false
FEATURE_MANUAL_REFRESH_WEEKLY_METRICS=true
WEEKLY_METRICS_STALE_AFTER_DAYS=10

# Used by CI and runbook scripts for staging delivery checks
AGENCY_STAGING_DATABASE_URL=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Deploy environment label (for non-Vercel deploys)
DEPLOY_ENV=

# Sentry override (auto-enabled in production; set explicitly to override)
SENTRY_ENABLED=

# ---
# for development only
# ---
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
