# Authentication (better-auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=
AUTH_DATABASE_URL=
CHANNEL_GATEWAY_SHARED_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# for signed cookie
COOKIE_SECRET=

# for OAuth token encryption (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# for cron job
CRON_SECRET=
CRON_RATE_LIMIT_MAX_REQUESTS=5
CRON_RATE_LIMIT_WINDOW_MS=60000

## Enable @vercel/flags at all times in the development environment
DEVELOPER_FLAG="true"

# @vercel/flags API Reference https://vercel.com/docs/workflow-collaboration/feature-flags/vercel-flags
# @see https://vercel.com/docs/workflow-collaboration/feature-flags/supporting-feature-flags#flags_secret-environment-variable
FLAGS_SECRET=

# Google Tag Manager https://tagmanager.google.com/
# @see https://support.google.com/tagmanager/answer/6102821
GTM_ID=

# Langfuse https://langfuse.com/
# @see https://langfuse.com/docs/get-started
LANGFUSE_BASEURL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# OpenAI API https://openai.com/index/openai-api/
# @see https://platform.openai.com/docs/quickstart
OPENAI_API_KEY=

# Vercel Postgres https://vercel.com/docs/storage/vercel-postgres
# @see https://vercel.com/docs/storage/vercel-postgres#getting-started
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NO_SSL=
POSTGRES_USER=

# Sentry https://sentry.io/
# @see https://docs.sentry.io/cli/configuration/
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_RELEASE=

# Polar.sh https://polar.sh/
# @see https://docs.polar.sh/integrate
POLAR_ACCESS_TOKEN=
POLAR_PRO_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=

# Slack Integration
SLACK_SIGNING_SECRET=

# WhatsApp Integration (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Recoder-Web (build automation)
RECODER_WEB_URL=
RECODER_WEB_API_KEY=

# A2A / Intent worker
RECODER_A2A_REDIS_URL=
RECODER_A2A_INTENT_STREAM_KEY=recoder:a2a:intents
RECODER_A2A_RESULTS_STREAM_KEY=recoder:a2a:results
RECODER_A2A_DEADLETTER_STREAM_KEY=recoder:a2a:deadletter
RECODER_A2A_CONSUMER_SERVICE=recoder_agency
RECODER_A2A_CONSUMER_NAME=
RECODER_A2A_CONSUMER_GROUP=
RECODER_A2A_GROUP_START_ID=$
RECODER_A2A_CONSUME_UNTARGETED=false
RECODER_A2A_CLAIM_MIN_IDLE_MS=30000
RECODER_A2A_MAX_RETRIES=2
RECODER_A2A_RETRY_DELAY_MS=500
RECODER_A2A_RETRY_BACKOFF_MULTIPLIER=2
RECODER_A2A_RETRY_MAX_DELAY_MS=10000
RECODER_A2A_WORKER_TOKEN=
RECODER_A2A_INTENT_PLAN_EXECUTOR_URL=
RECODER_A2A_INTENT_EXECUTE_EXECUTOR_URL=
RECODER_A2A_INTENT_HANDOFF_EXECUTOR_URL=
RECODER_A2A_INTENT_TOOL_CALL_EXECUTOR_URL=
RECODER_A2A_DEFAULT_HANDLER_URL=
RECODER_A2A_AMB_BASE_URL=http://localhost:7777
RECODER_A2A_AMB_DISABLED=0

# SMTP Email Configuration
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Email Debug Mode (set "true" to skip sending emails and show debug output)
SEND_EMAIL_DEBUG=1

# Delivery operations and rollout flags
FEATURE_RETRY_PANEL=true
NEXT_PUBLIC_FEATURE_RETRY_PANEL=true
NEXT_PUBLIC_FEATURE_FUNNEL_ANALYTICS=false
FEATURE_AUTO_REFRESH_WEEKLY_METRICS=false
FEATURE_MANUAL_REFRESH_WEEKLY_METRICS=true
WEEKLY_METRICS_STALE_AFTER_DAYS=10

# Used by CI and runbook scripts for staging delivery checks
# Keep this on one line. Do not wrap across lines.
AGENCY_STAGING_DATABASE_URL=

# Google OAuth
# Canonical names used by Better Auth. Do not use GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Deploy environment label (for non-Vercel deploys)
DEPLOY_ENV=

# Sentry override (auto-enabled in production; set explicitly to override)
SENTRY_ENABLED=

# ---
# for development only
# ---
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
