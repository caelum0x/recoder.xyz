# =============================================================================
# Recoder Agency — Next.js App (port 3007)
# =============================================================================
# Copy this file to .env.local (for local dev) or .env.docker (for Docker).
# All fields marked [REQUIRED] must be set for the app to start.

# =============================================================================
# DATABASE [REQUIRED]
# =============================================================================

# Agency's own PostgreSQL database (Neon recommended)
POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://user:password@direct-host:5432/dbname?sslmode=require
POSTGRES_HOST=your-db-host.neon.tech
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
POSTGRES_DATABASE=your-db-name

# Drizzle ORM uses this for migrations
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# =============================================================================
# AUTH — BETTER AUTH [REQUIRED]
# =============================================================================

# MUST match the secret used by recoder-app and recoder-pm for cross-subdomain SSO
BETTER_AUTH_SECRET=your-better-auth-secret-minimum-32-characters
BETTER_AUTH_URL=https://recoder.xyz

# Shared auth database — points to recoder-app's Neon Postgres
# (shared tables: user, session, account, verification)
AUTH_DATABASE_URL=postgresql://user:password@auth-host:5432/authdb?sslmode=require

# Public-facing URL of this service
NEXT_PUBLIC_APP_URL=https://agency.recoder.xyz

# =============================================================================
# SECURITY
# =============================================================================

# Cookie signing secret (32+ hex characters recommended)
COOKIE_SECRET=your-cookie-secret-32-hex-chars

# Token encryption key (32 bytes / 256 bits, base64 or hex)
TOKEN_ENCRYPTION_KEY=your-32-byte-token-encryption-key

# Secret for authenticating cron job requests
CRON_SECRET=your-cron-secret

# Feature flags secret (Vercel Edge Config)
# FLAGS_SECRET=

# =============================================================================
# AI PROVIDERS
# =============================================================================

# OpenAI — required for embeddings and text generation
OPENAI_API_KEY=sk-your-openai-key-here

# AI Gateway headers (optional, for OpenRouter proxy)
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_HTTP_REFERER=https://agency.recoder.xyz
# AI_GATEWAY_X_TITLE=Recoder Agency

# =============================================================================
# SUPABASE STORAGE [REQUIRED]
# =============================================================================

# S3-compatible storage endpoint (Supabase Storage)
SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=your-region
SUPABASE_STORAGE_ACCESS_KEY_ID=your-access-key
SUPABASE_STORAGE_SECRET_ACCESS_KEY=your-secret-key

# Supabase vault driver
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Optional: specific storage bucket for document vector stores
# DOCUMENT_VECTOR_STORE_STORAGE_BUCKET=app

# =============================================================================
# GITHUB APP [REQUIRED]
# =============================================================================

# GitHub App credentials — all five are required at startup
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour-private-key\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_CLIENT_ID=Iv1.your-github-app-client-id
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
GITHUB_APP_WEBHOOK_SECRET=your-github-webhook-secret

# =============================================================================
# GOOGLE OAUTH (optional — for Google Drive integrations)
# =============================================================================

# GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# POLAR.SH PAYMENTS
# =============================================================================

# POLAR_ACCESS_TOKEN=your-polar-access-token
# POLAR_PRO_PRODUCT_ID=your-product-id
# POLAR_WEBHOOK_SECRET=your-polar-webhook-secret
# POLAR_ORGANIZATION_ID=your-polar-org-id

# =============================================================================
# EMAIL — SMTP (RESEND)
# =============================================================================

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your-resend-api-key
SMTP_FROM=agency@recoder.xyz
SMTP_FROM_NAME=Recoder Agency

# Debug mode: set to "1" to log email content instead of sending
# SEND_EMAIL_DEBUG=0

# =============================================================================
# RECODER-WEB INTEGRATION
# =============================================================================

RECODER_WEB_URL=https://web.recoder.xyz
# RECODER_WEB_API_KEY=your-recoder-web-api-key

# =============================================================================
# OBSERVABILITY
# =============================================================================

# LangFuse (LLM tracing)
# LANGFUSE_BASEURL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
# LANGFUSE_SECRET_KEY=your-langfuse-secret-key

# Sentry (error tracking)
# SENTRY_AUTH_TOKEN=your-sentry-auth-token
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/123
# SENTRY_RELEASE=

# PostHog (product analytics)
# NEXT_PUBLIC_ENABLE_POSTHOG=false
# NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# FEATURE FLAGS
# =============================================================================

FEATURE_RETRY_PANEL=true
NEXT_PUBLIC_FEATURE_RETRY_PANEL=true
NEXT_PUBLIC_FEATURE_FUNNEL_ANALYTICS=false
FEATURE_AUTO_REFRESH_WEEKLY_METRICS=false
FEATURE_MANUAL_REFRESH_WEEKLY_METRICS=true
WEEKLY_METRICS_STALE_AFTER_DAYS=10
# RESTORE_DRILL_STALE_AFTER_DAYS=14

# =============================================================================
# WEBHOOK INTEGRATIONS (optional)
# =============================================================================

# WhatsApp Business
# WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
# WHATSAPP_APP_SECRET=your-whatsapp-app-secret

# Slack
# SLACK_SIGNING_SECRET=your-slack-signing-secret

# =============================================================================
# GISELLE ENGINE (optional — API secret scrypt tuning)
# =============================================================================

# GISELLE_API_SECRET_SCRYPT_N=16384
# GISELLE_API_SECRET_SCRYPT_R=8
# GISELLE_API_SECRET_SCRYPT_P=1
# GISELLE_API_SECRET_SCRYPT_KEY_LEN=32
# GISELLE_API_SECRET_SCRYPT_SALT_BYTES=
# GISELLE_API_SECRET_SCRYPT_LOG_DURATION=0

# Sample app workspace IDs (comma-separated, optional)
# SAMPLE_APP_WORKSPACE_IDS=

# Task execution runtime: "trigger.dev", "vercel", or "local"
# TRIGGERDOTDEV=0
# USE_TRIGGER_DEV=0

# =============================================================================
# A2A (AGENT-TO-AGENT) MESSAGING (optional — Redis Streams)
# =============================================================================

# RECODER_A2A_SHARED_SECRET=your-a2a-shared-secret
# RECODER_A2A_REDIS_URL=redis://:password@redis:6379/0
# RECODER_A2A_WORKER_TOKEN=your-worker-token
# RECODER_A2A_CONSUMER_SERVICE=recoder_agency
# RECODER_A2A_PLAN_HANDLER_URL=
# RECODER_A2A_EXECUTE_HANDLER_URL=
# RECODER_A2A_HANDOFF_HANDLER_URL=
# RECODER_A2A_TOOL_CALL_HANDLER_URL=
# RECODER_A2A_DEFAULT_HANDLER_URL=

# =============================================================================
# CRON RATE LIMITING (optional)
# =============================================================================

# CRON_RATE_LIMIT_WINDOW_MS=60000
# CRON_RATE_LIMIT_MAX_REQUESTS=5

# =============================================================================
# STAGING DATABASE (optional — admin dashboard cross-env queries)
# =============================================================================

# AGENCY_STAGING_DATABASE_URL=

# =============================================================================
# RUNTIME
# =============================================================================

NODE_ENV=development
PORT=3007
HOSTNAME=0.0.0.0

# Bundle analyzer (set to "true" to enable)
# ANALYZE=false

# Supabase public URL (used for Next.js image optimization)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SITE_URL=https://agency.recoder.xyz
