# Recoder production server capability config (ubuntu-16gb-hel1-1: 16 GB RAM, NO GPU).
#
# Policy for THIS box: cloud LLM (BYOK / OpenRouter / Gemini) + on-box Qdrant & ziti.
# Do NOT self-host Ollama or vLLM here — there is no GPU and no RAM headroom; those
# run on users' local machines or a separate GPU box. (E2B is cloud; zero local load.)
#
# Bring up only the light services here:
#   docker compose -f docker-compose.capabilities.yml up -d qdrant
#   docker compose -f docker-compose.capabilities.yml --profile ziti up -d ziti-controller
# (Do NOT start the ollama / vllm services on this box.)

# ── Agent memory (mem0 OSS) — on-box Qdrant + CLOUD LLM/embeddings ───────────
QDRANT_URL=http://localhost:6333
MEM0_COLLECTION=recoder_mem0
# Gemini does BOTH chat + embeddings with one key (simplest for this box):
MEM0_LLM_PROVIDER=google
MEM0_EMBEDDER_PROVIDER=google
# GEMINI_API_KEY=...        # powers mem0 LLM + embeddings AND the LLM router 'google' provider
# Alternatives:
#   OPENAI_API_KEY=...      # OpenAI for both LLM + embeddings (set MEM0_*_PROVIDER=openai)
#   OPENROUTER_API_KEY=...  # LLM only — OpenRouter has NO embeddings API, so pair it
#                           # with GEMINI_API_KEY or OPENAI_API_KEY for embeddings.
# NEVER set OLLAMA_BASE_URL or VLLM_BASE_URL on this server.

# ── Unified LLM router — cloud providers via BYOK/env (no local inference) ────
# Set whichever you use; the router exposes them all, BYOK per-user still applies:
#   OPENROUTER_API_KEY=...  OPENAI_API_KEY=...  ANTHROPIC_API_KEY=...
#   GEMINI_API_KEY=...      GROQ_API_KEY=...    DEEPSEEK_API_KEY=...  XAI_API_KEY=...

# ── Zero-trust network (OpenZiti) — self-hosted controller on this box ────────
# ZITI_CONTROLLER_URL=https://localhost:1280
# ZITI_ADMIN_USERNAME=admin
# ZITI_ADMIN_PASSWORD=recoder_ziti_admin
# NODE_EXTRA_CA_CERTS=/abs/path/ziti-ca.pem   # export CA from the controller volume

# ── Secure runner (E2B) — cloud, no local infra ──────────────────────────────
# E2B_API_KEY=...

# ── Library docs (Context7) — free tier keyless; key only for higher limits ───
# CONTEXT7_API_KEY=...
