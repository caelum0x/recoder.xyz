{
  "name": "recoder-docker-backend",
  "version": "1.0.0",
  "description": "Docker-based execution backend for recoder.xyz",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "docker:build": "docker build -t recoder-node-base ./docker",
    "smoke:queue": "bash scripts/smoke-public-queue.sh",
    "a2a:worker": "tsx src/a2a-intent-worker.ts",
    "agent-os:persistence-smoke": "tsx scripts/agent-os-persistence-smoke.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "ci:preflight": "[ -x ./node_modules/.bin/vitest ] && [ -x ./node_modules/.bin/tsc ] || (echo 'Missing local devDependencies (vitest/tsc). Install dependencies when registry/lockfile is available.' >&2; exit 10)",
    "ci:check": "pnpm run ci:preflight && vitest --run src/subagent-workflow.test.ts src/public-api/internal-auth-parity.test.ts src/public-api/byok-readiness.test.ts src/public-api/task-stream-protocol.test.ts src/resources/execution-limits.test.ts src/a2a/__tests__/a2a-routes.e2e.test.ts src/a2a/__tests__/sse-reconnect.e2e.test.ts src/a2a/__tests__/connector-chaos.test.ts src/a2a/__tests__/a2a-openapi-drift.test.ts src/a2a/__tests__/a2a-slo-metrics.test.ts src/__tests__/domain-manager.test.ts src/__tests__/git-operations-enhanced.test.ts src/__tests__/git-operations.test.ts",
    "ci:check:noninteractive": "CI=1 pnpm run ci:check",
    "ci:install-and-check": "pnpm run ci:check:noninteractive",
    "ci:install-and-check:local": "pnpm run ci:check:noninteractive"
  },
  "optionalDependencies": {
    "@mariozechner/pi-ai": "file:../pi-mono/packages/ai",
    "@mariozechner/pi-coding-agent": "file:../pi-mono/packages/coding-agent"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@recoder/a2a-sdk": "workspace:*",
    "@recoder/agent-events": "workspace:*",
    "@recoder/agent-os": "workspace:*",
    "@recoder/agent-instructions": "workspace:*",
    "@recoder/agent-mcp": "workspace:*",
    "@recoder/oss-registry": "workspace:*",
    "@recoder/shared": "workspace:*",
    "@recoder/stream": "workspace:*",
    "@recoder/ui-agent-os": "workspace:*",
    "@recoder/vault": "workspace:*",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^16.3.1",
    "duckdb": "^1.4.4",
    "e2b": "^1.13.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-ws": "^5.0.2",
    "http-proxy-middleware": "^2.0.6",
    "ioredis": "^5.9.1",
    "lib0": "^0.2.117",
    "mem0ai": "^3.0.6",
    "nats": "^2.29.3",
    "node-fetch": "^2.7.0",
    "node-pty": "^1.1.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "recast": "^0.23.11",
    "uuid": "^9.0.1",
    "ws": "^8.18.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.23",
    "@types/express": "^4.17.21",
    "@types/express-ws": "^3.0.4",
    "@types/http-proxy-middleware": "^1.0.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^9.0.7",
    "@vitest/coverage-v8": "^2.0.1",
    "@vitest/ui": "^2.0.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^2.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "duckdb",
      "better-sqlite3",
      "node-pty"
    ]
  }
}
