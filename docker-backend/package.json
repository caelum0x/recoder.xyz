{
  "name": "recoder-docker-backend",
  "version": "1.0.0",
  "description": "Docker-based execution backend for recoder.xyz",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "docker:build": "docker build -t recoder-node-base ./docker"
  },
  "dependencies": {
    "dockerode": "^4.0.2",
    "express": "^4.18.2",
    "express-ws": "^5.0.2",
    "cors": "^2.8.5",
    "uuid": "^9.0.1",
    "dotenv": "^16.3.1",
    "http-proxy-middleware": "^2.0.6"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.23",
    "@types/express": "^4.17.21",
    "@types/express-ws": "^3.0.4",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.7",
    "@types/http-proxy-middleware": "^1.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
