FROM oven/bun:1.3

# Install build tools for native addons (tree-sitter bindings need node-gyp)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ripgrep git ca-certificates wget \
    python3 python3-pip make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the entire monorepo. .dockerignore excludes node_modules, .git, dist.
COPY . .

# Install all workspace dependencies. Skip native tree-sitter bindings that
# require node-gyp builds — opencode uses them for syntax highlighting which
# is optional for the HTTP server mode.
# Use --ignore-scripts to skip postinstall scripts that fail in containers.
RUN bun install --no-frozen-lockfile --force --ignore-scripts || bun install --no-frozen-lockfile --ignore-scripts

# Create XDG data directories
RUN mkdir -p /data /config /cache /state
ENV XDG_DATA_HOME=/data
ENV XDG_CONFIG_HOME=/config
ENV XDG_CACHE_HOME=/cache
ENV XDG_STATE_HOME=/state
ENV BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
ENV OPENCODE_DISABLE_EMBEDDED_WEB_UI=1

EXPOSE 4096

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=90s \
  CMD bun -e "fetch('http://localhost:4096/session').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

WORKDIR /app/packages/opencode

ENTRYPOINT ["bun", "run", "src/index.ts", "serve", "--hostname", "0.0.0.0", "--port", "4096"]
