{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "paths": {
      "@recoder/shared/a2a": ["./node_modules/@recoder/shared/src/a2a/index.ts"],
      "@recoder/shared/a2a/schemas": ["./node_modules/@recoder/shared/src/a2a/schemas/index.ts"],
      "@recoder/stream/public-task-stream": ["../packages/stream/dist/public-task-stream"],
      "@recoder/vault": ["../packages/vault/dist/index"],
      "@recoder/vault/node-crypto": ["../packages/vault/dist/node-crypto"]
    },
    "lib": ["ES2022", "dom"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "downlevelIteration": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "src/a2a/opencode-bash-tool.ts",
    "src/a2a/opencode-edit-tool.ts",
    "src/a2a/opencode-session-processor.ts"
  ]
}
