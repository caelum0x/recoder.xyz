PORT=3100
ALLOWED_ORIGINS=http://localhost:5173,https://recoder.xyz,https://web.recoder.xyz

# Claude Code Integration
# URL of the main app (for fetching user tokens)
APP_API_URL=https://recoder.xyz

# Shared service key (must match app's INTERNAL_SERVICE_KEY)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_KEY=your-internal-service-key-here
