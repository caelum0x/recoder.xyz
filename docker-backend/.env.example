PORT=3100
ALLOWED_ORIGINS=https://recoder.xyz,https://agents.recoder.xyz,https://pm.recoder.xyz,https://agency.recoder.xyz

# Authentication Configuration
# URL of the main app (for verifying Better Auth session tokens)
APP_API_URL=https://recoder.xyz

# Shared service key (must match app's INTERNAL_SERVICE_KEY)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_KEY=your-internal-service-key-here

# Public prompt task queue backend (auto|redis|sqlite)
# Production recommendation: redis
PUBLIC_PROMPT_TASK_QUEUE_BACKEND=redis

# Redis connection for prompt queue + session store (required when backend=redis)
REDIS_URL=redis://localhost:6379

# API Key hashing salt (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_HASH_SALT=your-api-key-hash-salt-here

# Identity Token secret (REQUIRED for identity token feature)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IDENTITY_TOKEN_SECRET=your-identity-token-secret-here

# Vault encryption (REQUIRED for production BYOK key caching)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_MASTER_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
VAULT_SALT=

# ============================================
# Moltbook Integration (Optional)
# ============================================
# App key for verifying Moltbook identity tokens
# Get from your Moltbook account dashboard
MOLTBOOK_APP_KEY=
# Moltbook verification endpoint (default: https://moltbook.com/api/v1/identity/verify)
MOLTBOOK_VERIFY_URL=https://moltbook.com/api/v1/identity/verify

# Strict authentication mode
# Set to 'true' to require authentication on all API endpoints
# Default (unset or 'false'): Migration mode - allows requests from allowed origins without auth
# IMPORTANT: Frontend is now updated to pass auth tokens - set to true for production
REQUIRE_AUTH=true

# Public URL for this backend (used for tunnel callbacks and external access)
# For Hetzner deployment, set this to your docker backend domain
BACKEND_PUBLIC_URL=https://docker.recoder.xyz

# ============================================
# Container Pool Configuration
# ============================================
# Adjust based on your server's RAM
#
# For 16GB server (Hetzner CX43):
#   - Use 1GB per container → ~10 concurrent users
#   - Pre-warm 5 containers (5GB) + OS/docker (~3GB) = 8GB idle
#   - Peak 10 containers (10GB) + OS/docker (3GB) = 13GB
#
# For 32GB server:
#   - Use 2GB per container → ~12 concurrent users
#   - Pre-warm 8 containers (16GB) + OS/docker (~3GB) = 19GB idle
#
# For 64GB+ server:
#   - Use 2GB per container → ~25 concurrent users
#   - Pre-warm 10 containers (20GB) + OS/docker (~3GB) = 23GB idle

# Number of containers to keep warm (instant project start)
CONTAINER_POOL_MIN_SIZE=5

# Maximum containers (hard limit)
CONTAINER_POOL_MAX_SIZE=10

# Memory per container in bytes (1GB = 1073741824, 2GB = 2147483648)
CONTAINER_MEMORY_LIMIT=1073741824

# CPU quota (100000 = 100% of 1 CPU core)
CONTAINER_CPU_QUOTA=50000

# Port range for container allocation
CONTAINER_PORT_START=10000
CONTAINER_PORT_END=20000

# Recycling configuration
CONTAINER_MAX_RECYCLES=10
CONTAINER_MAX_AGE_MS=7200000
CONTAINER_STALE_TIMEOUT_MS=1800000

# ============================================
# Security & Alerting (Optional)
# ============================================
# Slack/Discord webhook URL for admin alerts (critical security events)
# ADMIN_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# Minimum severity to trigger webhook notifications (low, medium, high, critical)
ADMIN_ALERT_MIN_SEVERITY=medium

# ============================================
# Custom Domain Configuration (Optional)
# ============================================
# Email for Let's Encrypt SSL certificates (required for custom domains)
# ACME_EMAIL=admin@recoder.xyz
# Directory for generated nginx configs (shared volume with nginx container)
# NGINX_CUSTOM_DOMAINS_DIR=/etc/nginx/conf.d/custom-domains
# Webroot for ACME challenges (shared volume with nginx container)
# CERTBOT_WEBROOT=/var/www/html

# ============================================
# A2A (Agent-to-Agent) Configuration
# ============================================
# Ecosystem service URLs used by Agent Registry for self-registration
# PREVIEW_PUBLIC_URL=https://docker.recoder.xyz
# RECODER_AGENCY_URL=https://agency.recoder.xyz
# RECODER_PM_URL=https://recoderpm.app

# Agent heartbeat timeout (ms, default: 300000 = 5 min)
# RECODER_A2A_HEARTBEAT_TIMEOUT_MS=300000

# --- Claude Code MCP Connector ---
# CLAUDE_CODE_COMMAND=claude
# CLAUDE_CODE_ARGS=mcp,serve
# CLAUDE_CODE_CWD=
# CLAUDE_CONNECTOR_REQUEST_TIMEOUT_MS=120000
# CLAUDE_CONNECTOR_STARTUP_TIMEOUT_MS=30000
# CLAUDE_CONNECTOR_MAX_RESTART_ATTEMPTS=3
# CLAUDE_CONNECTOR_RESTART_DELAY_MS=2000
# CLAUDE_CONNECTOR_AUTO_RESTART=true

# --- Codex CLI Connector ---
# CODEX_COMMAND=codex
# CODEX_ARGS=--jsonrpc
# CODEX_CWD=
# CODEX_CONNECTOR_REQUEST_TIMEOUT_MS=120000
# CODEX_CONNECTOR_STARTUP_TIMEOUT_MS=30000
# CODEX_CONNECTOR_MAX_RESTART_ATTEMPTS=3
# CODEX_CONNECTOR_RESTART_DELAY_MS=2000
# CODEX_CONNECTOR_AUTO_RESTART=true

# --- Context Bridge ---
# RECODER_A2A_CONTEXT_MAX_SIZE_BYTES=10485760
# RECODER_A2A_CONTEXT_SWEEP_MS=60000
# RECODER_A2A_CONTEXT_KEY_PREFIX=recoder:a2a:context

# --- Data Hygiene / Retention ---
# RECODER_A2A_CONTEXT_TTL_MS=3600000
# RECODER_A2A_EVENT_RETENTION_MS=86400000
# RECODER_A2A_AUDIT_RETENTION_MS=2592000000
# RECODER_A2A_EVENT_MAX_RECORDS=5000
# RECODER_A2A_AUDIT_MAX_RECORDS=10000

# --- A2A Intent Worker (requires Redis) ---
# RECODER_A2A_INTENT_STREAM_KEY=recoder:a2a:intents

# --- Cursor IDE Connector (Tier-2) ---
# CURSOR_COMMAND=cursor
# CURSOR_ARGS=--bridge
# CURSOR_CWD=
# CURSOR_CONNECTOR_REQUEST_TIMEOUT_MS=120000
# CURSOR_CONNECTOR_STARTUP_TIMEOUT_MS=30000
# CURSOR_CONNECTOR_MAX_RESTART_ATTEMPTS=3
# CURSOR_CONNECTOR_RESTART_DELAY_MS=2000
# CURSOR_CONNECTOR_AUTO_RESTART=true

# --- Windsurf IDE Connector (Tier-2) ---
# WINDSURF_COMMAND=windsurf
# WINDSURF_ARGS=--bridge
# WINDSURF_CWD=
# WINDSURF_CONNECTOR_REQUEST_TIMEOUT_MS=120000
# WINDSURF_CONNECTOR_STARTUP_TIMEOUT_MS=30000
# WINDSURF_CONNECTOR_MAX_RESTART_ATTEMPTS=3
# WINDSURF_CONNECTOR_RESTART_DELAY_MS=2000
# WINDSURF_CONNECTOR_AUTO_RESTART=true

# --- Replit Agent Connector (REST-based) ---
# REPLIT_API_URL=
# REPLIT_API_KEY=
# REPLIT_CONNECTOR_REQUEST_TIMEOUT_MS=30000
# REPLIT_CONNECTOR_HEALTH_CHECK_INTERVAL_MS=60000
# REPLIT_CONNECTOR_MAX_RETRIES=3
# REPLIT_CONNECTOR_AUTO_RECONNECT=true

# --- A2A Gateway Identity & Security ---
# RECODER_A2A_AGENT_ID=docker-backend
# RECODER_A2A_SHARED_SECRET=your-shared-secret-here
# RECODER_A2A_ADMIN_TOKEN=your-admin-token-here
# RECODER_A2A_BRIDGE_TOKEN=your-bridge-token-here
# Comma-separated list of allowed agent IDs
# RECODER_A2A_ALLOWED_AGENTS=docker-backend,recoder-agency,recoder-pm
# Comma-separated list of allowed egress URLs
# RECODER_A2A_EGRESS_ALLOWLIST=https://agents.recoder.xyz,https://agency.recoder.xyz,https://pm.recoder.xyz
# Enable connector processes (set to 'true' when binaries are installed)
# RECODER_A2A_ENABLE_CODEX=false
# RECODER_A2A_ENABLE_CLAUDE_CODE=false

# --- A2A Orchestration ---
# RECODER_A2A_ORCH_MAX_TARGETS=2
# RECODER_A2A_ORCH_MAX_DEADLINE_MS=600000
# RECODER_A2A_ORCH_ALLOWED_INTENTS=plan,execute,handoff,tool_call,review

# ============================================
# Logging & Debugging
# ============================================
# LOG_LEVEL=info
# DEBUG_AUTH_LOGS=false

# ============================================
# Container Runtime
# ============================================
# Docker image used for workspace containers (default: recoder-workspace:latest)
# CONTAINER_IMAGE=recoder-workspace:latest
# Per-user container limit
# MAX_CONTAINERS_PER_USER=5
# Timeout for container creation (ms)
# CONTAINER_CREATE_TIMEOUT_MS=120000
# Enable/disable container pool (default: true)
# ENABLE_CONTAINER_POOL=true

# ============================================
# Persistence
# ============================================
# Data directory for file-based stores (default: ./data)
# DATA_DIR=./data
# Collaboration persistence directory
# COLLAB_PERSISTENCE_DIR=
# Backup directory (default: ./data/backups)
# BACKUP_DIR=./data/backups

# ============================================
# Networking
# ============================================
# CORS origin (default: uses ALLOWED_ORIGINS)
# CORS_ORIGIN=*
# Trust proxy setting (set to true behind reverse proxy)
# TRUST_PROXY=true
# Public hostname for external callbacks
# PUBLIC_HOSTNAME=docker.recoder.xyz
# Public URL for this backend
# PUBLIC_URL=https://docker.recoder.xyz

# ============================================
# Monitoring & Health
# ============================================
# Health check polling interval (ms)
# HEALTH_CHECK_INTERVAL_MS=30000
# Bearer token required for /metrics endpoint
# METRICS_BEARER_TOKEN=

# ============================================
# Alerting Webhooks (fallbacks for ADMIN_ALERT_WEBHOOK_URL)
# ============================================
# ALERT_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# Comma-separated admin user IDs for privileged operations
# ADMIN_USER_IDS=

# ============================================
# A2A Gateway Public URLs
# ============================================
# Public URLs used by the A2A gateway for cross-service routing
# AGENCY_PUBLIC_URL=https://agency.recoder.xyz
# PM_API_PUBLIC_URL=https://recoderpm.app
# RECODER_DOCKER_BACKEND_URL=https://docker.recoder.xyz

# ============================================
