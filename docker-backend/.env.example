PORT=3100
ALLOWED_ORIGINS=http://localhost:5173,https://recoder.xyz,https://web.recoder.xyz

# Authentication Configuration
# URL of the main app (for verifying Better Auth session tokens)
APP_API_URL=https://recoder.xyz

# Shared service key (must match app's INTERNAL_SERVICE_KEY)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_KEY=your-internal-service-key-here

# Strict authentication mode
# Set to 'true' to require authentication on all API endpoints
# Default (unset or 'false'): Migration mode - allows requests from allowed origins without auth
# IMPORTANT: Frontend is now updated to pass auth tokens - set to true for production
REQUIRE_AUTH=true

# Public URL for this backend (used for tunnel callbacks and external access)
# For Hetzner deployment, set this to your docker backend domain
BACKEND_PUBLIC_URL=https://docker.recoder.xyz

# ============================================
# Container Pool Configuration
# ============================================
# Adjust based on your server's RAM
#
# For 16GB server (Hetzner CX43):
#   - Use 1GB per container → ~10 concurrent users
#   - Pre-warm 5 containers (5GB) + OS/docker (~3GB) = 8GB idle
#   - Peak 10 containers (10GB) + OS/docker (3GB) = 13GB
#
# For 32GB server:
#   - Use 2GB per container → ~12 concurrent users
#   - Pre-warm 8 containers (16GB) + OS/docker (~3GB) = 19GB idle
#
# For 64GB+ server:
#   - Use 2GB per container → ~25 concurrent users
#   - Pre-warm 10 containers (20GB) + OS/docker (~3GB) = 23GB idle

# Number of containers to keep warm (instant project start)
CONTAINER_POOL_MIN_SIZE=5

# Maximum containers (hard limit)
CONTAINER_POOL_MAX_SIZE=10

# Memory per container in bytes (1GB = 1073741824, 2GB = 2147483648)
CONTAINER_MEMORY_LIMIT=1073741824

# CPU quota (100000 = 100% of 1 CPU core)
CONTAINER_CPU_QUOTA=50000

# Port range for container allocation
CONTAINER_PORT_START=10000
CONTAINER_PORT_END=20000

# Recycling configuration
CONTAINER_MAX_RECYCLES=10
CONTAINER_MAX_AGE_MS=7200000
CONTAINER_STALE_TIMEOUT_MS=1800000
