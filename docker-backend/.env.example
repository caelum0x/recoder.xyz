# RECODER_OPENCLAW_WORKSPACE_ID=
# RECODER_OPENCLAW_MAX_TASKS=10

# ============================================
# Database Encryption
# ============================================
# Encryption key for database connection manager
# DATABASE_ENCRYPTION_KEY=

# ============================================
