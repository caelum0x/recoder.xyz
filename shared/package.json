{
  "name": "@recoder/shared",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./types/sandbox": "./src/types/sandbox.ts",
    "./streaming": "./src/streaming/index.ts",
    "./tools": "./src/tools/index.ts",
    "./utils": "./src/utils/index.ts",
    "./animations": "./src/animations/index.ts",
    "./a2a": {
      "require": "./src/a2a/index.js",
      "import": "./src/a2a/index.ts",
      "default": "./src/a2a/index.js"
    },
    "./a2a/schemas": {
      "require": "./src/a2a/schemas/index.js",
      "import": "./src/a2a/schemas/index.ts",
      "default": "./src/a2a/schemas/index.js"
    },
    "./constants": "./src/constants/upload-limits.ts",
    "./errors": "./src/errors/index.ts",
    "./opencode-client": "./src/opencode-client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:contracts": "vitest --run src/a2a/schemas/__tests__/",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.1"
  },
  "dependencies": {
    "zustand": "^5.0.9"
  }
}
