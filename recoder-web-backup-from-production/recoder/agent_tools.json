{
  "recoder-add-dependency": {
    "description": "Add a npm package dependency to the project. Use recoderAction type='shell' with 'npm install <package>'.",
    "parameters": {
      "properties": {
        "package": {
          "example": "lodash@latest",
          "type": "string"
        }
      },
      "required": ["package"],
      "type": "object"
    }
  },
  "recoder-search-files": {
    "description": "Regex-based code search with file filtering. Use recoderAction type='searchFiles'.",
    "parameters": {
      "properties": {
        "query": {
          "example": "useEffect\\(",
          "type": "string"
        },
        "include_pattern": {
          "example": "src/**",
          "type": "string"
        },
        "exclude_pattern": {
          "example": "src/components/ui/**",
          "type": "string"
        },
        "case_sensitive": {
          "example": "false",
          "type": "boolean"
        }
      },
      "required": ["query", "include_pattern"],
      "type": "object"
    }
  },
  "recoder-write": {
    "description": "Write to a file. Overwrites existing file or creates new. Use recoderAction type='file' with filePath attribute. Prefer recoder-line-replace for modifications.",
    "parameters": {
      "properties": {
        "file_path": {
          "example": "src/main.ts",
          "type": "string"
        },
        "content": {
          "example": "console.log('Hello, World!')",
          "type": "string"
        }
      },
      "required": ["file_path", "content"],
      "type": "object"
    }
  },
  "recoder-line-replace": {
    "description": "Line-based search and replace. PREFERRED tool for editing existing files. Use recoderAction type='lineReplace'.",
    "parameters": {
      "properties": {
        "file_path": {
          "example": "src/components/TaskList.tsx",
          "type": "string"
        },
        "first_replaced_line": {
          "description": "First line number to replace (1-indexed)",
          "example": "15",
          "type": "number"
        },
        "last_replaced_line": {
          "description": "Last line number to replace (1-indexed)",
          "example": "28",
          "type": "number"
        },
        "search": {
          "description": "Content to search for (use ... for large sections)",
          "type": "string"
        },
        "replace": {
          "description": "New content to replace with",
          "type": "string"
        }
      },
      "required": ["file_path", "search", "first_replaced_line", "last_replaced_line", "replace"],
      "type": "object"
    }
  },
  "recoder-download-to-repo": {
    "description": "Download a file from URL and save to repository. Use recoderAction type='downloadFile'.",
    "parameters": {
      "properties": {
        "source_url": {
          "description": "The URL of the file to download",
          "example": "https://example.com/image.png",
          "type": "string"
        },
        "target_path": {
          "description": "Path where file should be saved",
          "example": "public/images/logo.png",
          "type": "string"
        }
      },
      "required": ["source_url", "target_path"],
      "type": "object"
    }
  },
  "recoder-fetch-website": {
    "description": "Fetch a website and get its content (markdown, HTML, screenshot). Use recoderAction type='fetchWebsite'.",
    "parameters": {
      "properties": {
        "url": {
          "example": "https://example.com",
          "type": "string"
        },
        "formats": {
          "description": "Comma-separated: 'markdown', 'html', 'screenshot'",
          "example": "markdown,screenshot",
          "type": "string"
        }
      },
      "required": ["url"],
      "type": "object"
    }
  },
  "recoder-copy": {
    "description": "Copy a file or directory to new location. Use recoderAction type='copyFile'.",
    "parameters": {
      "properties": {
        "source_file_path": {
          "example": "src/main.ts",
          "type": "string"
        },
        "destination_file_path": {
          "example": "src/main_copy.ts",
          "type": "string"
        }
      },
      "required": ["source_file_path", "destination_file_path"],
      "type": "object"
    }
  },
  "recoder-view": {
    "description": "Read contents of a file. Use recoderAction type='readFile'. First 500 lines by default.",
    "parameters": {
      "properties": {
        "file_path": {
          "example": "src/App.tsx",
          "type": "string"
        },
        "lines": {
          "example": "1-800, 1001-1500",
          "type": "string"
        }
      },
      "required": ["file_path"],
      "type": "object"
    }
  },
  "recoder-read-console-logs": {
    "description": "Read browser console logs for debugging. Use recoderAction type='readConsoleLogs'.",
    "parameters": {
      "properties": {
        "search": {
          "example": "error",
          "type": "string"
        }
      },
      "required": ["search"],
      "type": "object"
    }
  },
  "recoder-read-network-requests": {
    "description": "Read browser network requests for debugging. Use recoderAction type='readNetworkRequests'.",
    "parameters": {
      "properties": {
        "search": {
          "example": "error",
          "type": "string"
        }
      },
      "required": ["search"],
      "type": "object"
    }
  },
  "recoder-remove-dependency": {
    "description": "Remove a npm package from project. Use recoderAction type='shell' with 'npm uninstall <package>'.",
    "parameters": {
      "properties": {
        "package": {
          "example": "lodash",
          "type": "string"
        }
      },
      "required": ["package"],
      "type": "object"
    }
  },
  "recoder-rename": {
    "description": "Rename a file. Use recoderAction type='renameFile'.",
    "parameters": {
      "properties": {
        "original_file_path": {
          "example": "src/main.ts",
          "type": "string"
        },
        "new_file_path": {
          "example": "src/main_new.ts",
          "type": "string"
        }
      },
      "required": ["original_file_path", "new_file_path"],
      "type": "object"
    }
  },
  "recoder-delete": {
    "description": "Delete a file. Use recoderAction type='deleteFile'.",
    "parameters": {
      "properties": {
        "file_path": {
          "example": "src/App.tsx",
          "type": "string"
        }
      },
      "required": ["file_path"],
      "type": "object"
    }
  },
  "websearch-web_search": {
    "description": "Search the web for current information, documentation, or any web content. Use recoderAction type='webSearch'.",
    "parameters": {
      "properties": {
        "query": {
          "description": "The search query",
          "type": "string"
        },
        "numResults": {
          "description": "Number of results (default: 5)",
          "type": "number"
        },
        "category": {
          "description": "Optional: 'news', 'github', 'pdf'",
          "type": "string"
        }
      },
      "required": ["query"],
      "type": "object"
    }
  },
  "imagegen-generate_image": {
    "description": "Generate an image from text prompt. Use recoderAction type='generateImage'.",
    "parameters": {
      "properties": {
        "prompt": {
          "description": "Text description of desired image",
          "type": "string"
        },
        "target_path": {
          "description": "Path to save image (prefer src/assets/)",
          "type": "string"
        },
        "width": {
          "description": "Image width (512-1920)",
          "type": "number"
        },
        "height": {
          "description": "Image height (512-1920)",
          "type": "number"
        }
      },
      "required": ["prompt", "target_path"],
      "type": "object"
    }
  },
  "recoder-shell": {
    "description": "Execute shell command. Use recoderAction type='shell'. NEVER run dev servers!",
    "parameters": {
      "properties": {
        "command": {
          "type": "string"
        }
      },
      "required": ["command"],
      "type": "object"
    }
  },
  "recoder-clone-github": {
    "description": "Clone a GitHub repository. Use recoderAction type='cloneGitHub'.",
    "parameters": {
      "properties": {
        "repoUrl": {
          "example": "https://github.com/user/repo",
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": ["repoUrl"],
      "type": "object"
    }
  },
  "recoder-import-starter": {
    "description": "Import a starter template. Use recoderAction type='importStarter'.",
    "parameters": {
      "properties": {
        "templateId": {
          "example": "nextjs-tailwind",
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": ["templateId"],
      "type": "object"
    }
  }
}
