{
  "channels": {
    "console": {
      "enabled": true
    },
    "email": {
      "enabled": false,
      "smtp": "smtp.gmail.com"
    },
    "slack": {
      "enabled": false,
      "webhook": ""
    },
    "discord": {
      "enabled": false,
      "webhook": ""
    }
  },
  "rules": {
    "performance": {
      "responseTime": {
        "threshold": 1000,
        "severity": "warning"
      },
      "errorRate": {
        "threshold": 5,
        "severity": "critical"
      },
      "availability": {
        "threshold": 95,
        "severity": "critical"
      }
    },
    "security": {
      "criticalIssues": {
        "threshold": 0,
        "severity": "critical"
      },
      "securityScore": {
        "threshold": 80,
        "severity": "warning"
      },
      "rateLimitHits": {
        "threshold": 50,
        "severity": "warning"
      }
    },
    "business": {
      "aiRequestFailures": {
        "threshold": 10,
        "severity": "warning"
      },
      "costSpike": {
        "threshold": 1000,
        "severity": "warning"
      }
    }
  }
}