# 🔥 RECODER.XYZ ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# 🔐 JWT Authentication (CRITICAL - MUST SET STRONG VALUES)
JWT_SECRET=generate-a-strong-random-jwt-secret-at-least-64-characters-long
SESSION_SECRET=generate-a-strong-random-session-secret-at-least-64-characters-long

# 🤖 AI Provider Keys (Required for AI functionality)
ANTHROPIC_API_KEY=sk-ant-your-actual-anthropic-key-here
OPENAI_API_KEY=sk-your-actual-openai-key-here
GROQ_API_KEY=gsk_your-actual-groq-key-here
GOOGLE_API_KEY=your-actual-google-gemini-key-here
OPENROUTER_API_KEY=sk-or-your-actual-openrouter-key-here
TOGETHER_API_KEY=your-actual-together-api-key-here

# 🔐 NextAuth Configuration  
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-strong-nextauth-secret

# 🔐 OAuth Configuration (Get from provider consoles)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
APPLE_CLIENT_ID=your-apple-oauth-client-id
APPLE_CLIENT_SECRET=your-apple-oauth-client-secret

# 🗄️ Database Configuration
DATABASE_URL=postgresql://username:secure-password@localhost:5432/recoder_db
REDIS_URL=redis://localhost:6379

# 🌐 Service URLs
BACKEND_URL=http://localhost:3001
PRODUCTION_ENGINE_URL=http://localhost:3002
WEB_URL=http://localhost:3000
CHAT_URL=http://localhost:3010

# 💳 Payment Integration
STRIPE_SECRET_KEY=sk_test_your-actual-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-actual-stripe-publishable-key
DODO_PAY_SECRET=your-actual-dodo-pay-secret

# 🚀 Deployment
NODE_ENV=development
PORT=3000
VERCEL_URL=
RAILWAY_STATIC_URL=

# 📧 Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 📊 Analytics (Optional)
SENTRY_DSN=
ANALYTICS_ID=

# 🔒 Security Tips:
# 1. Generate JWT secrets with: openssl rand -base64 64
# 2. Use strong database passwords: openssl rand -base64 32
# 3. Never share these values or commit them to git
# 4. Rotate secrets regularly in production
# 5. Use environment-specific values for each deployment