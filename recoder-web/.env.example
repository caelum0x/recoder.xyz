# ==============================================
# RECODER WEB - Environment Configuration
# ==============================================
# Copy this to .env.local and configure based on your setup
# 
# 🌐 NEXT.JS WEB APPLICATION
# 🚀 LOCAL-FIRST: Works with backend + Ollama

#====================================
# 🏗️ NEXT.JS CONFIGURATION
#====================================

# Environment
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Application URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Production URLs (uncomment for production)
# NEXT_PUBLIC_BASE_URL=https://recoder.xyz
# NEXT_PUBLIC_API_URL=https://api.recoder.xyz

#====================================
# 🔐 AUTHENTICATION
#====================================

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# JWT Settings (should match backend)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-256-bits-long

#====================================
# 🗄️ DATABASE (SHARED WITH BACKEND)
#====================================

# PostgreSQL Database (same as backend)
DATABASE_URL=postgresql://postgres:password@localhost:5432/recoder_db

# Prisma Configuration
DIRECT_URL=postgresql://postgres:password@localhost:5432/recoder_db

#====================================
# 🤖 AI PROVIDERS (CLIENT-SIDE KEYS)
#====================================

# Note: Only add public/client-safe keys here
# Server-side AI calls should use backend environment

# For client-side AI features (optional)
# NEXT_PUBLIC_ANTHROPIC_API_KEY=sk-ant-your-public-key-here

# Local AI (always safe to expose)
NEXT_PUBLIC_OLLAMA_BASE_URL=http://localhost:11434

#====================================
# 💰 PAYMENT PROCESSING (CLIENT-SIDE)
#====================================

# Stripe Public Keys (safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Server Keys (server-side only)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_endpoint_secret_here

# Price IDs
NEXT_PUBLIC_STRIPE_FREE_PRICE_ID=price_free
NEXT_PUBLIC_STRIPE_PREMIUM_PRICE_ID=price_premium_monthly_20_usd
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_pro_monthly_100_usd

#====================================
# 🔄 SERVICE CONNECTIONS
#====================================

# Backend API Connection
API_BASE_URL=http://localhost:3001
API_TIMEOUT=30000

# Production Engine Connection
PRODUCTION_ENGINE_URL=http://localhost:3002

# CLI Integration
CLI_DOWNLOAD_URL=https://github.com/recoder-xyz/cli/releases/latest

#====================================
# ⚡ PERFORMANCE & CACHING
#====================================

# Redis Cache (optional, shares with backend)
REDIS_URL=redis://localhost:6379

# Image Optimization
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# CDN Configuration (production)
# NEXT_PUBLIC_CDN_URL=https://cdn.recoder.xyz

#====================================
# 📊 ANALYTICS & MONITORING
#====================================

# Google Analytics
NEXT_PUBLIC_GA_TRACKING_ID=UA-your-tracking-id
NEXT_PUBLIC_GTM_ID=GTM-your-gtm-id

# PostHog Analytics (alternative)
NEXT_PUBLIC_POSTHOG_API_KEY=your-posthog-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=your-public-sentry-dsn
SENTRY_DSN=your-server-side-sentry-dsn

# Vercel Analytics (if using Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-vercel-analytics-id

#====================================
# 🔐 OAUTH PROVIDERS
#====================================

# GitHub OAuth (for GitHub integration)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Google OAuth (for Google Sign-in)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Discord OAuth (for Discord integration)
DISCORD_CLIENT_ID=your-discord-oauth-client-id
DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret

#====================================
# 📧 EMAIL & COMMUNICATIONS
#====================================

# Email Service (for transactional emails)
EMAIL_FROM=noreply@recoder.xyz
EMAIL_FROM_NAME=Recoder

# SendGrid (if using SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key

# Resend (alternative email service)
RESEND_API_KEY=your-resend-api-key

#====================================
# 🌐 CORS & SECURITY
#====================================

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Content Security Policy
NEXT_PUBLIC_CSP_NONCE=your-csp-nonce

# Security Headers
ENABLE_SECURITY_HEADERS=true

#====================================
# 🎨 UI & THEMING
#====================================

# Theme Configuration
NEXT_PUBLIC_DEFAULT_THEME=dark
NEXT_PUBLIC_THEME_STORAGE_KEY=recoder-theme

# Brand Colors (CSS custom properties)
NEXT_PUBLIC_PRIMARY_COLOR=#6366f1
NEXT_PUBLIC_SECONDARY_COLOR=#8b5cf6

#====================================
# 🔧 DEVELOPMENT SETTINGS
#====================================

# Development Features
ENABLE_DEVELOPMENT_FEATURES=true
ENABLE_DEBUG_PANEL=true

# Hot Reload Configuration
NEXT_PUBLIC_HOT_RELOAD=true

# API Mocking (for development)
ENABLE_API_MOCKING=false
MOCK_API_DELAY=1000

#====================================
# 🌍 INTERNATIONALIZATION
#====================================

# Default Language
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,es,fr,de,zh,ja

# Translation Service (optional)
CROWDIN_API_KEY=your-crowdin-api-key

#====================================
# 📱 MOBILE & PWA
#====================================

# PWA Configuration
NEXT_PUBLIC_PWA_ENABLED=true
NEXT_PUBLIC_APP_NAME=Recoder
NEXT_PUBLIC_APP_SHORT_NAME=Recoder

# Mobile App Links
NEXT_PUBLIC_IOS_APP_ID=your-ios-app-id
NEXT_PUBLIC_ANDROID_PACKAGE=com.recoder.app

#====================================
# 🏭 PRODUCTION OPTIMIZATIONS
#====================================

# Production-specific settings (uncomment for production)
# NODE_ENV=production
# ANALYZE_BUNDLE=true
# OPTIMIZE_IMAGES=true
# ENABLE_STATIC_OPTIMIZATION=true

# Image Optimization
# NEXT_PUBLIC_IMAGE_DOMAINS=recoder.xyz,cdn.recoder.xyz
# NEXT_PUBLIC_IMAGE_LOADER=custom

#====================================
# 💡 LOCAL DEVELOPMENT SETUP
#====================================
# 
# Quick Start:
# 1. Copy this file to .env.local
# 2. Start backend: cd ../backend && npm run dev
# 3. Install dependencies: npm install
# 4. Run development server: npm run dev
# 5. Open http://localhost:3000
# 
# ✅ Web app works with minimal configuration!
# 
# 🚀 For full functionality:
#   - Configure Stripe for payments
#   - Add OAuth providers for social login
#   - Set up analytics and monitoring
#   - Configure email service for notifications