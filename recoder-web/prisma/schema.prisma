generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  bio           String?
  location      String?
  company       String?
  blog          String?
  publicRepos   Int?
  followers     Int?
  following     Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Enhanced security fields
  mfaEnabled    Boolean   @default(false)
  totpSecret    String?
  backupCodes   String[]  @default([])
  lastLoginAt   DateTime?
  lastLoginIp   String?

  accounts      Account[]
  sessions      Session[]
  chats         Chat[]
  generatedApps GeneratedApp[]
  settings      UserSettings?
  usage         UsageStats[]
  userSessions  UserSession[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  routers       Router[]
  projects      Project[]
  aiConsensusLogs AiConsensusLog[]
  
  // Media Processing relations
  mediaFiles     MediaFile[]
  processingJobs ProcessingJob[]
  batchJobs      BatchJob[]
  campaignTemplates CampaignTemplate[]
  templateUsages TemplateUsage[]
  analyticsEvents AnalyticsEvent[]
  subscription   Subscription?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Enhanced application models
model GeneratedApp {
  id        String   @id @default(nanoid(5))
  model     String
  prompt    String
  code      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  metadata  Json?    // Store additional generation metadata
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([id])
  @@index([userId])
}

model Chat {
  id                String    @id @default(nanoid(16))
  model             String
  quality           String
  prompt            String
  title             String
  llamaCoderVersion String    @default("v2")
  shadcn            Boolean
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  isPublic          Boolean   @default(false)
  messages          Message[]
  createdAt         DateTime  @default(now())

  @@index([userId])
}

model Message {
  id        String   @id @default(nanoid(16))
  role      String
  content   String
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  position  Int
  metadata  Json?    // Store generation metadata (model, tokens, cost, etc.)
  createdAt DateTime @default(now())

  @@index([chatId])
}

// User preferences and settings
model UserSettings {
  id          String @id @default(cuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences Json   // Theme, default model, code style, etc.
  limits      Json   // Usage limits and quotas
  apiKeys     Json?  // Encrypted user API keys
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Usage tracking and analytics
model UsageStats {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @default(now()) @db.Date
  generationsUsed Int      @default(0)
  tokensUsed      Int      @default(0)
  modelsUsed      Json     // Track which models were used
  costAccrued     Float    @default(0)
  createdAt       DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

// Unified Authentication Models
model UserSession {
  id           String   @id @default(cuid())
  userId       String
  deviceId     String
  platform     String   // 'web', 'cli', 'extension', 'router'
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  scopes       String[]
  expiresAt    DateTime
  riskLevel    String   @default("low") // 'low', 'medium', 'high', 'critical'
  metadata     Json
  createdAt    DateTime @default(now())
  lastUsed     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
}

model ApiKey {
  id          String   @id @default(cuid())
  keyId       String   @unique
  userId      String
  name        String
  hashedKey   String
  scopes      String[]
  restrictions Json // IP whitelist, rate limits, platform restrictions, expiry
  lastUsed    DateTime?
  createdAt   DateTime @default(now())
  active      Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyId])
  @@index([active])
}

model DeviceFlow {
  id           String    @id @default(cuid())
  deviceCode   String    @unique
  userCode     String    @unique
  userId       String?
  status       String    @default("pending") // 'pending', 'authorized', 'denied', 'expired'
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([deviceCode])
  @@index([userCode])
  @@index([status])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // 'login', 'logout', 'token_refresh', 'api_key_used', etc.
  platform    String?  // 'web', 'cli', 'extension', 'router'
  ip          String?
  userAgent   String?  @db.Text
  success     Boolean
  riskLevel   String?  // 'low', 'medium', 'high', 'critical'
  metadata    Json
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([riskLevel])
}

model SecurityEvent {
  id          String   @id @default(cuid())
  userId      String?
  eventType   String   // 'suspicious_login', 'multiple_failures', 'mfa_bypass_attempt'
  severity    String   // 'low', 'medium', 'high', 'critical'
  description String   @db.Text
  ip          String?
  userAgent   String?  @db.Text
  resolved    Boolean  @default(false)
  metadata    Json
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([severity])
  @@index([createdAt])
  @@index([resolved])
}

// Router and Analytics Models
model Router {
  id          String   @id @default(cuid())
  routerId    String   @unique // CLI router identifier
  userId      String
  name        String?
  version     String?
  status      String   @default("active") // 'active', 'inactive', 'suspended'
  metadata    Json     // Configuration, settings, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastUsed    DateTime @default(now())

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  usage           RouterUsage[]
  analytics       RouterAnalytics[]

  @@index([userId])
  @@index([routerId])
  @@index([status])
  @@index([lastUsed])
}

model RouterUsage {
  id          String   @id @default(cuid())
  routerId    String
  timestamp   DateTime @default(now())
  provider    String   // 'anthropic', 'groq', 'openai', etc.
  model       String   // Model used
  tokens      Int      @default(0)
  cost        Float    @default(0)
  success     Boolean  @default(true)
  responseTime Int     @default(0) // in ms
  metadata    Json     // Request details, error info, etc.
  
  router Router @relation(fields: [routerId], references: [routerId], onDelete: Cascade)

  @@index([routerId])
  @@index([timestamp])
  @@index([provider])
  @@index([model])
}

model RouterAnalytics {
  id            String   @id @default(cuid())
  routerId      String
  analyticsData Json     // Cost analytics, optimization data, etc.
  timestamp     DateTime
  createdAt     DateTime @default(now())

  router Router @relation(fields: [routerId], references: [routerId], onDelete: Cascade)

  @@index([routerId])
  @@index([timestamp])
}

// Error tracking and monitoring models
model ErrorLog {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  type         String   // 'javascript_error', 'react_error', 'api_error', 'auth_error', 'validation_error'
  message      String   @db.Text
  stack        String?  @db.Text
  url          String
  lineNumber   Int?
  columnNumber Int?
  userAgent    String   @db.Text
  userId       String?
  sessionId    String
  platform     String   // 'web', 'chat', 'cli', 'engine'
  severity     String   // 'low', 'medium', 'high', 'critical'
  context      Json?    // Additional context data
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([timestamp])
  @@index([platform])
  @@index([severity])
  @@index([sessionId])
  @@index([userId])
  @@index([resolved])
  @@index([type])
}

model PerformanceLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  type      String   // 'navigation', 'resource', 'api_call', 'form_submission'
  duration  Int      // Duration in milliseconds
  url       String
  success   Boolean  @default(true)
  userId    String?
  sessionId String
  platform  String
  metadata  Json?    // Additional performance metadata
  createdAt DateTime @default(now())

  @@index([timestamp])
  @@index([platform])
  @@index([type])
  @@index([sessionId])
  @@index([userId])
  @@index([duration])
  @@index([success])
}

// Project management models
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  framework   String?  // 'nextjs', 'react', 'vue', 'angular', etc.
  language    String?  // 'typescript', 'javascript', 'python', etc.
  repository  String?  // Git repository URL
  visibility  String   @default("private") // 'public', 'private'
  status      String   @default("active") // 'active', 'archived', 'deleted'
  metadata    Json?    // Additional project metadata

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deploymentHistory DeploymentHistory[]
  mediaFiles MediaFile[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Advanced deployment automation models
model DeploymentHistory {
  id                    String   @id @default(cuid())
  projectId             String
  platforms             String[] // Array of platform IDs
  results               Json     // Array of deployment results
  config                Json     // Deployment configuration
  timestamp             DateTime @default(now())
  totalDeployments      Int
  successfulDeployments Int
  createdAt             DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([timestamp])
}

// AI Consensus System models
model AiConsensusLog {
  id                   String   @id @default(cuid())
  userId               String
  projectId            String?
  validationTypes      String   // Comma-separated list
  consensusScore       Float
  consensusReached     Boolean
  validatorCount       Int
  totalCost            Float
  totalTokens          Int
  executionTime        Int      // Milliseconds
  language             String
  codeLength           Int
  isQuickValidation    Boolean  @default(false)
  metadata             Json?    // Additional validation metadata
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([consensusScore])
  @@index([language])
  @@index([isQuickValidation])
}

// Media Processing Platform models
model MediaFile {
  id                String   @id @default(cuid())
  originalName      String
  fileName          String
  filePath          String
  fileSize          Int
  mimeType          String
  format            String
  purpose           String   @default("general") // general, campaign, template, etc.
  width             Int?
  height            Int?
  duration          Float?   // Duration in seconds for video/audio
  thumbnailPath     String?
  previewPath       String?
  metadata          Json?
  deleted           Boolean  @default(false)
  userId            String
  projectId         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  processingJobs    ProcessingJob[]
  templateUsages    TemplateUsage[]

  @@index([userId])
  @@index([projectId])
  @@index([purpose])
  @@index([createdAt])
}

model ProcessingJob {
  id                String   @id @default(cuid())
  type              String   // video, audio, image, batch
  status            String   @default("queued") // queued, processing, completed, failed
  operation         String   // compress, convert, watermark, etc.
  parameters        Json
  progress          Int      @default(0)
  inputPath         String
  outputPath        String?
  error             String?
  startedAt         DateTime?
  completedAt       DateTime?
  userId            String
  mediaFileId       String?
  batchJobId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaFile         MediaFile? @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)
  batchJob          BatchJob? @relation(fields: [batchJobId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([mediaFileId])
  @@index([batchJobId])
  @@index([createdAt])
}

model BatchJob {
  id                String   @id @default(cuid())
  name              String
  description       String?
  status            String   @default("queued") // queued, processing, completed, failed, cancelled
  operation         String
  parameters        Json
  progress          Int      @default(0)
  processedFiles    Int      @default(0)
  totalFiles        Int
  error             String?
  startedAt         DateTime?
  completedAt       DateTime?
  userId            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  processingJobs    ProcessingJob[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model CampaignTemplate {
  id                String   @id @default(cuid())
  name              String
  description       String
  category          String   // social, ads, presentations, marketing, branding
  platform          String   // youtube, instagram, tiktok, facebook, linkedin, universal
  aspectRatio       String
  resolution        Json     // {width: number, height: number}
  duration          Int?     // Duration in seconds
  framerate         Int?
  settings          Json     // format, quality, codec, bitrate settings
  branding          Json     // logo, watermark, brand colors
  effects           Json     // filters, transitions, animations
  isPublic          Boolean  @default(false)
  featured          Boolean  @default(false)
  popularity        Int      @default(0)
  tags              String[]
  usageCount        Int      @default(0)
  userId            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  templateUsages    TemplateUsage[]

  @@index([userId])
  @@index([category])
  @@index([platform])
  @@index([isPublic])
  @@index([featured])
  @@index([popularity])
}

model TemplateUsage {
  id                String   @id @default(cuid())
  userId            String
  templateId        String
  mediaFileId       String?
  customizations    Json?
  createdAt         DateTime @default(now())

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  template          CampaignTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  mediaFile         MediaFile? @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([templateId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id                String   @id @default(cuid())
  userId            String
  type              String   // media_upload, processing_complete, template_usage, etc.
  metadata          Json?
  createdAt         DateTime @default(now())

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  plan              String   // free, pro, enterprise
  status            String   // active, cancelled, expired
  currentPeriodStart DateTime
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean  @default(false)
  stripeCustomerId  String?
  stripeSubscriptionId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
