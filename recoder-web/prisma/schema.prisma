// recoder-web/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                 @id @default(cuid())
  name                 String?
  email                String                 @unique
  emailVerified        DateTime?
  image                String?
  role                 String                 @default("user")
  password             String?
  twoFactorEnabled     Boolean                @default(false)
  totpSecret           String?
  backupCodes          Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  accounts             Account[]
  sessions             Session[]
  teams                TeamMember[]
  ownedTeams           Team[]                 @relation("ownedTeams")
  teamInvitesSent      TeamInvite[]
  integrations         UserIntegration[]
  webhooks             Webhook[]
  projects             Project[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  settings             UserSettings?
  securityEvents       SecurityEvent[]
  subscriptions        Subscription[]
  projectMemberships   ProjectMember[]
  projectInvites       ProjectInvite[]        @relation("ProjectInviter")
  monitoringAlerts     MonitoringAlert[]
  monitoringDashboards MonitoringDashboard[]
  dataExportRequests   DataExportRequest[]
  userAuditLogs        UserAuditLog[]
  privacySettings      PrivacySettings?
  securitySettings     SecuritySettings?
  apiKeys              ApiKey[]
  chats                Chat[]
  messages             Message[]
  payments             Payment[]
  customerLtv          CustomerLifetimeValue?
  createdFeatureFlags  FeatureFlag[]         @relation("FeatureFlagCreator")
  featureFlagUsage     FeatureFlagUsage[]
  refunds              Refund[]
  subscriptionChanges  SubscriptionChange[]
  securityScans        SecurityScan[]        @relation("SecurityScanCreator")
  complianceAudits     ComplianceAudit[]     @relation("ComplianceAuditCreator")
  securityAlertsCreated SecurityAlert[]      @relation("SecurityAlertCreator")
  securityAlertsResolved SecurityAlert[]     @relation("SecurityAlertResolver")
  remediationsInitiated SecurityRemediation[] @relation("SecurityRemediationInitiator")
  // Additional user fields for analytics
  lastLoginAt          DateTime?
  acquisitionChannel   String?
  companySize          String?
  industry             String?
  country              String?
  // Blockchain-related relations
  smartContracts       SmartContract[]       @relation("SmartContractCreator")
  contractDeployments  ContractDeployment[]  @relation("ContractDeploymentInitiator")
  dappProjects         DappProject[]         @relation("DappProjectCreator")
  // Analytics reporting relations
  analyticsReports     AnalyticsReport[]     @relation("AnalyticsReportCreator")
  reportExecutions     ReportExecution[]     @relation("ReportExecutionCreator")
  reportExports        ReportExport[]        @relation("ReportExportCreator")
  reportShares         ReportShare[]         @relation("ReportShareCreator")
  scheduledExecutions  ScheduledExecution[]  @relation("ScheduledExecutionCreator")
  generatedApps        GeneratedApp[]        @relation("GeneratedAppCreator")
  dataExports          DataExport[]          @relation("DataExportCreator")
  aIConsensusLogs      AIConsensusLog[]      @relation("AIConsensusLogCreator")
  oldIntegrations      Integration[]         @relation("UserIntegrationUser")
  processingJobs       ProcessingJob[]       @relation("ProcessingJobUser")
  mediaFiles           MediaFile[]           @relation("MediaFileUser")
  analyticsEvents      AnalyticsEvent[]      @relation("AnalyticsEventUser")
  usageAnalytics       UsageAnalytics[]      @relation("UsageAnalyticsUser")
  deviceAnalytics      DeviceAnalytics[]     @relation("DeviceAnalyticsUser")
  oauthStates          OAuthState[]
  tooltipInteractions  TooltipInteraction[]
  dashboards           Dashboard[]           @relation("UserDashboards")
  deviceFlows          DeviceFlow[]          @relation("DeviceFlowUser")
  userSessions         UserSession[]         @relation("UserSessions")
  aiGeneratedProjects  AiGeneratedProject[]  @relation("UserAiProjects")
  usageRecords         UsageRecord[]         @relation("UserUsageRecords")
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Team {
  id            String       @id @default(cuid())
  name          String
  description   String?
  avatar        String?
  plan          String       @default("free")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  settings      Json         @default("{}")
  stats         Json         @default("{}")
  subscription  Json         @default("{}")
  userId        String

  user    User         @relation("ownedTeams", fields: [userId], references: [id], onDelete: Cascade)
  members TeamMember[] @relation("members")
  invites TeamInvite[] @relation("invites")
}

model TeamMember {
  id            String    @id @default(cuid())
  userId        String
  teamId        String
  email         String
  name          String
  avatar        String?
  role          String    @default("member")
  status        String    @default("active")
  joinedAt      DateTime  @default(now())
  lastActivity  DateTime?
  permissions   String[]  @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation("members", fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model TeamInvite {
  id            String    @id @default(cuid())
  teamId        String
  email         String
  role          String    @default("member")
  invitedBy     String
  invitedAt     DateTime  @default(now())
  expiresAt     DateTime
  status        String    @default("pending")

  team Team @relation("invites", fields: [teamId], references: [id], onDelete: Cascade)
  inviter User @relation(fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([teamId, email])
}

model UserIntegration {
  id           String    @id @default(cuid())
  userId       String
  name         String    // Display name for the integration
  type         String    // github, slack, discord, stripe, etc.
  provider     String    // OAuth provider name
  isEnabled    Boolean   @default(true)
  isConnected  Boolean   @default(false)
  status       String    @default("active") // active, expired, disabled
  // OAuth fields
  accessToken  String?   // OAuth access token
  refreshToken String?   // OAuth refresh token  
  tokenType    String?   @default("bearer") // Token type (bearer, etc.)
  permissions  String[]  @default([]) // OAuth scopes/permissions granted
  scopes       String[]  @default([]) // Alias for permissions
  expiresAt    DateTime? // Token expiration
  // Configuration and data
  config       Json      @default("{}") // Integration-specific configuration
  credentials  Json      @default("{}") // Encrypted tokens/keys
  settings     Json      @default("{}") // User preferences for this integration
  capabilities String[]  @default([]) // What this integration can do
  metadata     Json      @default("{}") // Additional data
  stats        Json      @default("{}") // Usage statistics
  lastSyncAt   DateTime?
  lastError    String?   // Last error message if any
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, provider])
  @@map("user_integrations")
}

model Project {
  id                String                @id @default(cuid())
  name              String
  description       String?
  userId            String
  status            String                @default("active")
  // TODO: Add type field - uncomment when ready to migrate
  // type              String                @default("general") // Types: general, web, mobile, game, blockchain, ai
  framework         String?
  language          String?
  repository        String?
  visibility        String                @default("private")
  settings          Json                  @default("{}")
  metadata          Json                  @default("{}")
  plan              String                @default("free")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  members           ProjectMember[]
  invites           ProjectInvite[]
  deployments       Deployment[]
  deploymentHistory DeploymentExecution[]
  securityScans     SecurityScan[]
  complianceAudits  ComplianceAudit[]
  securityAlerts    SecurityAlert[]
  // Blockchain-related relations
  smartContracts    SmartContract[]
  dappProjects      DappProject[]
  // Mobile app relations
  mobileApps        MobileApp[]           @relation("ProjectMobileApps")
  
  @@map("projects")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String?
  resourceId String?
  platform   String?
  ip         String?
  userAgent  String?
  success    Boolean  @default(true)
  metadata   Json     @default("{}")
  timestamp  DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  category  String?
  priority  String    @default("low")
  actionUrl String?
  actionText String?
  channels  String[]  @default([])
  isRead    Boolean   @default(false)
  metadata  Json      @default("{}")
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model UserSettings {
  id          String   @id @default(cuid())
  userId      String   @unique
  preferences Json     @default("{}")
  theme       String   @default("light")
  language    String   @default("en")
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model SecurityEvent {
  id          String   @id @default(cuid())
  userId      String
  eventType   String
  severity    String
  description String
  ip          String?
  userAgent   String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("security_events")
}

model Subscription {
  id                String    @id @default(cuid())
  userId            String
  plan              String
  status            String
  amount            Float     @default(0)
  billingCycle      String    @default("monthly")
  seats             Int       @default(1)
  planId            String?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime?
  stripeCustomerId  String?
  stripePriceId     String?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("subscriptions")
  @@index([status])
  @@index([planId])
}


model Webhook {
  id              String            @id @default(cuid())
  userId          String
  name            String
  url             String
  events          String[]          @default([])
  isActive        Boolean           @default(true)
  secret          String?
  headers         Json?             @default("{}")
  timeout         Int?              @default(10000)
  lastDelivery    DateTime?
  lastTriggeredAt DateTime? // Added field
  lastTestAt      DateTime?         // Added for webhook testing
  responseTime    Float? // Added field
  failureCount    Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
  
  @@map("webhooks")
  @@index([userId])
  @@index([isActive])
}

model ProjectMember {
  id           String    @id @default(cuid())
  userId       String
  projectId    String
  teamId       String
  role         String    @default("member")
  status       String    @default("active")
  permissions  String[]  @default([])
  joinedAt     DateTime  @default(now())
  lastActivity DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model ProjectInvite {
  id        String   @id @default(cuid())
  projectId String
  teamId    String
  email     String
  role      String   @default("member")
  token     String   @unique
  invitedBy String
  invitedAt DateTime @default(now())
  expiresAt DateTime
  status    String   @default("pending")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter User    @relation("ProjectInviter", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
}

model Deployment {
  id          String   @id @default(cuid())
  name        String
  projectId   String
  platform    String
  environment String
  status      String   @default("inactive")
  url         String?
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions        DeploymentExecution[]
  monitoringAlerts  MonitoringAlert[]
  
  @@index([projectId])
}

model DeploymentExecution {
  id           String    @id @default(cuid())
  deploymentId String
  projectId    String
  status       String    @default("pending")
  results      Json      @default("{}")
  duration     Int?
  logs         String?
  error        String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
  @@index([projectId])
}

model MonitoringAlert {
  id                   String    @id @default(cuid())
  name                 String
  condition            String
  threshold            Float
  deploymentId         String?
  notificationChannels String[]  @default([])
  status               String    @default("active")
  createdBy            String
  acknowledgedBy       String?
  acknowledgedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  creator    User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  deployment Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  @@index([deploymentId])
}

model MonitoringDashboard {
  id            String   @id @default(cuid())
  name          String
  widgets       Json     @default("[]")
  deploymentIds String[] @default([])
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)
}

model DataExportRequest {
  id          String    @id @default(cuid())
  userId      String
  type        String
  status      String    @default("pending")
  downloadUrl String?
  error       String?
  ipAddress   String?
  userAgent   String?
  requestedAt DateTime  @default(now())
  processedAt DateTime?
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model DataExportData {
  id         String   @id @default(cuid())
  exportId   String   
  dataType   String?  // Optional data type field
  tableName  String?  // Optional table name field
  data       Json
  createdAt  DateTime @default(now())

  export     DataExport @relation(fields: [exportId], references: [id], onDelete: Cascade)

  @@index([exportId])
}

model UserAuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   Json     @default("{}")
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PrivacySettings {
  id              String  @id @default(cuid())
  userId          String  @unique
  profileVisible  Boolean @default(true)
  emailVisible    Boolean @default(false)
  activityVisible Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecuritySettings {
  id                    String  @id @default(cuid())
  userId                String  @unique
  twoFactorEnabled      Boolean @default(false)
  loginNotifications    Boolean @default(true)
  securityAlerts        Boolean @default(true)
  sessionTimeout        Int     @default(86400) // 24 hours in seconds
  allowedIPs            String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  key         String?   @unique
  keyPrefix   String    // First part of the key for display
  keyHash     String    // Hashed full key for verification
  permissions String[]  @default([])
  rateLimit   Json?     @default("{}")
  lastUsed    DateTime?
  lastUsedAt  DateTime? // Alias for lastUsed
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyPrefix])
  @@index([isActive])
}

model WebhookDelivery {
  id            String    @id @default(cuid())
  webhookId     String
  event         String
  payload       Json
  response      Json?
  status        String    // success, failed, pending
  success       Boolean   @default(false)
  statusCode    Int?
  responseTime  Int?      // milliseconds
  attempts      Int       @default(1)
  attempt       Int       @default(1)
  error         String?
  isTest        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?

  webhook     Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  
  @@map("webhook_deliveries")
  @@index([webhookId])
  @@index([status])
  @@index([isTest])
}

model Chat {
  id          String    @id @default(cuid())
  userId      String
  title       String?
  model       String?
  prompt      String?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  
  @@index([userId])
}

model Message {
  id          String    @id @default(cuid())
  chatId      String
  userId      String
  role        String    // user, assistant, system
  content     String
  position    Int?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  
  chat        Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([chatId])
  @@index([userId])
}

model WorkflowExecution {
  id          String    @id @default(cuid())
  workflowId  String
  status      String    @default("pending")
  input       Json      @default("{}")
  output      Json      @default("{}")
  error       String?
  progress    Float     @default(0)
  logs        String?
  metadata    Json      @default("{}")
  results     Json      @default("{}")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([workflowId])
  @@index([status])
}

model ProcessingJob {
  id             String    @id @default(cuid())
  userId         String
  mediaFileId    String?
  type           String    // video, audio, image, batch
  status         String    @default("queued") // queued, processing, completed, failed
  operation      String    // compress, convert, watermark, etc.
  parameters     Json      @default("{}")
  progress       Float     @default(0)
  inputPath      String?
  outputPath     String?
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User       @relation("ProcessingJobUser", fields: [userId], references: [id], onDelete: Cascade)
  mediaFile      MediaFile? @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  amount          Float
  currency        String    @default("USD")
  status          String    @default("pending")
  type            String    @default("one_time")
  paymentMethod   String?
  stripePaymentId String?
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
}

model CustomerLifetimeValue {
  id                    String    @id @default(cuid())
  userId                String    @unique
  totalValue            Float     @default(0)
  averageOrderValue     Float     @default(0)
  orderCount            Int       @default(0)
  firstOrderDate        DateTime?
  lastOrderDate         DateTime?
  churnRisk             String    @default("low")
  segment               String    @default("new")
  // Additional LTV analysis fields
  cohortMonth           String?
  totalRevenue          Float     @default(0)
  monthsActive          Int       @default(0)
  averageMonthlyRevenue Float     @default(0)
  predictedLtv          Float     @default(0)
  churnProbability      Float     @default(0.5)
  segments              String[]  @default([])
  subscriptionStart     DateTime?
  totalMonths           Int       @default(0)
  lastCalculatedAt      DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeamProgress {
  id        String   @id @default(cuid())
  teamId    String
  metric    String
  value     Float
  period    String
  createdAt DateTime @default(now())
  
  @@unique([teamId, metric, period])
  @@index([teamId])
}

model SubscriptionAnalytics {
  id              String   @id @default(cuid())
  userId          String
  subscriptionId  String
  metric          String
  value           Float
  period          DateTime
  createdAt       DateTime @default(now())
  
  @@unique([userId, subscriptionId, metric, period])
  @@index([userId])
  @@index([subscriptionId])
}

model FeatureFlag {
  id             String              @id @default(cuid())
  key            String              @unique
  name           String
  description    String?
  enabled        Boolean             @default(false)
  startDate      DateTime?
  endDate        DateTime?
  rolloutPercentage Float            @default(100)
  category       String?
  tags           Json                @default("[]")
  conditions     Json                @default("{}")
  metadata       Json                @default("{}")
  createdBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  
  creator        User?               @relation("FeatureFlagCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  userSegments   FeatureFlagUserSegment[]
  usage          FeatureFlagUsage[]
  
  @@index([key])
  @@index([enabled])
  @@index([category])
}

model FeatureFlagUserSegment {
  id            String      @id @default(cuid())
  featureFlagId String
  segment       String      // "all", "beta", "premium", "new_users", etc.
  criteria      Json        @default("{}")  // Segment matching criteria
  createdAt     DateTime    @default(now())
  
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  
  @@unique([featureFlagId, segment])
  @@index([featureFlagId])
  @@index([segment])
}

model FeatureFlagUsage {
  id            String      @id @default(cuid())
  featureFlagId String
  userId        String
  enabled       Boolean
  context       Json        @default("{}")  // Additional context when flag was evaluated
  createdAt     DateTime    @default(now())
  
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([featureFlagId, userId])
  @@index([featureFlagId])
  @@index([userId])
}

model Refund {
  id              String    @id @default(cuid())
  userId          String
  paymentId       String?
  amount          Float
  reason          String?
  status          String    @default("pending")
  stripeRefundId  String?
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model SubscriptionChange {
  id                String    @id @default(cuid())
  subscriptionId    String
  userId            String
  changeType        String    // upgrade, downgrade, cancel, reactivate
  fromPlan          String?
  toPlan            String?
  fromAmount        Float?
  toAmount          Float?
  effectiveDate     DateTime
