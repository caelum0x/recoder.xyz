{
  "buildCommand": "pnpm install --no-frozen-lockfile && node scripts/build-starters.mjs && pnpm exec remix vite:build",
  "installCommand": "npm install -g pnpm && pnpm install --no-frozen-lockfile",
  "outputDirectory": "build/client",
  "framework": "remix",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ],
  "env": {
    "VITE_DOCKER_URL": "https://docker.recoder.xyz",
    "VITE_APP_URL": "https://recoder.xyz",
    "NODE_ENV": "production"
  }
}
