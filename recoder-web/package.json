{
  "name": "recoder-web-platform",
  "version": "1.0.0",
  "description": "Recoder Web Platform - AI-powered code generation with multi-AI intelligence and offline capabilities",
  "author": "Recoder.xyz Team <hello@recoder.xyz>",
  "license": "MIT",
  "homepage": "https://web.recoder.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/recoderxyz/recoder.xyz.git",
    "directory": "recoder-web"
  },
  "bugs": {
    "url": "https://github.com/recoderxyz/recoder.xyz/issues"
  },
  "keywords": [
    "recoder",
    "ai",
    "code-generation",
    "web-platform",
    "typescript",
    "nextjs",
    "multi-ai",
    "offline-capable"
  ],
  "private": true,
  "scripts": {
    "postinstall": "prisma generate && husky install",
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "build:optimized": "tsc --noEmit --project tsconfig.build.json && next build",
    "build:fast": "SKIP_TYPE_CHECK=true next build",
    "build:analyze": "ANALYZE=true next build",
    "build:production": "NODE_ENV=production prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "start:production": "NODE_ENV=production next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix && prettier --write .",
    "lint:check": "next lint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:quick": "vitest run --reporter=basic --no-coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:codegen": "playwright codegen",
    "test:e2e:report": "playwright show-report",
    "test:performance": "playwright test tests/e2e/performance",
    "test:api": "playwright test tests/e2e/api",
    "test:auth": "playwright test tests/e2e/auth",
    "test:projects": "playwright test tests/e2e/projects",
    "test:settings": "playwright test tests/e2e/settings",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:ci": "npm run type-check && npm run lint:check && npm run test:coverage && npm run test:e2e",
    "quality": "npm run type-check && npm run lint:check && npm run format:check",
    "quality:fix": "npm run type-check && npm run lint:fix && npm run format",
    "validate": "npm run quality && npm run test:quick",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "health": "curl -f http://localhost:3000/api/health || exit 1",
    "prepare": "husky install",
    "commit": "git-cz",
    "clean": "rm -rf .next node_modules/.cache",
    "reinstall": "rm -rf node_modules package-lock.json && npm install",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset --force"
  },
