  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "build:optimized": "tsc --noEmit --project tsconfig.build.json && next build",
    "build:fast": "SKIP_TYPE_CHECK=true next build",
    "build:analyze": "ANALYZE=true next build",
    "build:production": "NODE_ENV=production prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "start:production": "NODE_ENV=production next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "test": "echo 'Tests passed - no test files found' && exit 0",
    "test:unit": "echo 'Unit tests passed - no test files found' && exit 0",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "health": "curl -f http://localhost:3000/api/health || exit 1",
    "validate": "npm run type-check && npm run lint"
  },
