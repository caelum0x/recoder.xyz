{
  "name": "bolt",
  "description": "StackBlitz AI Agent",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.4.0",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "deploy": "npm run build && wrangler pages deploy",
    "build": "node scripts/build-starters.mjs && pnpm exec remix vite:build",
    "dev": "pnpm exec remix vite:dev",
    "dev:clean": "./dev-safe.sh",
    "dev:force": "rm -rf node_modules/.vite && pnpm run dev",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "npm run lint -- --fix",
    "start": "bindings=$(./bindings.sh) && wrangler pages dev ./build/client $bindings",
    "typecheck": "tsc",
    "typegen": "wrangler types",
    "preview": "pnpm run build && pnpm run start",
    "db:init": "tsx scripts/init-database.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "db:seed": "tsx scripts/seed-database.ts",
    "db:subscriptions": "tsx scripts/init-subscription-db.ts",
    "test:templates": "tsx scripts/test-template-matching.ts",
    "test:openrouter": "tsx scripts/test-openrouter.ts",
    "test:clone": "tsx scripts/test-github-clone.mjs",
    "bundle:starters": "node scripts/build-starters.mjs"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^0.0.39",
    "@ai-sdk/google": "^2.0.17",
    "@ai-sdk/mistral": "^2.0.17",
    "@ai-sdk/openai": "^2.0.42",
    "@codemirror/autocomplete": "^6.17.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-css": "^6.2.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-wast": "^6.0.2",
    "@codemirror/language": "^6.10.2",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.4",
    "@iconify-json/ph": "^1.1.13",
    "@iconify-json/svg-spinners": "^1.1.2",
    "@lezer/highlight": "^1.2.0",
    "@nanostores/react": "^0.7.2",
    "@neondatabase/serverless": "^1.0.2",
    "@octokit/rest": "^22.0.1",
    "@paddle/paddle-node-sdk": "^3.2.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@remix-run/cloudflare": "^2.17.1",
    "@remix-run/cloudflare-pages": "^2.17.1",
    "@remix-run/react": "^2.17.1",
    "@remix-run/server-runtime": "^2.17.1",
    "@uiw/codemirror-theme-vscode": "^4.23.0",
    "@unocss/reset": "^0.61.0",
    "@webcontainer/api": "1.3.0-internal.10",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ai": "3.3.4",
    "date-fns": "^3.6.0",
    "diff": "^5.2.0",
    "framer-motion": "^11.2.12",
    "isbot": "^4.1.0",
    "istextorbinary": "^9.5.0",
    "jose": "^5.6.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.544.0",
    "nanostores": "^0.10.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^4.5.0",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^2.0.20",
    "react-toastify": "^10.0.5",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remix-island": "^0.2.0",
    "remix-utils": "^7.6.0",
    "set-cookie-parser": "^2.7.1",
