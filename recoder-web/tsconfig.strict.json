{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "include": [
    "app/components/**/*.ts",
    "app/components/**/*.tsx",
    "app/hooks/**/*.ts",
    "app/hooks/**/*.tsx",
    "app/lib/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "starters"
  ]
}
