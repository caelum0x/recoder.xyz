# =============================================================================
# Recoder PM — Next.js Turbo Monorepo (port 3004)
# =============================================================================
# Copy this file to .env (for local dev) or .env.docker (for Docker).
# For Docker, set DOCKER=1 to skip env validation during build.

# =============================================================================
# CLOUDFLARE (optional — DNS + CDN + SSL)
# =============================================================================

# CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# =============================================================================
# CORE URLs [REQUIRED]
# =============================================================================

# Public-facing URLs for the PM service
RECODER_PM_WEB_URL=http://localhost:3000
RECODER_PM_API_URL=http://localhost:3001
RECODER_PM_PORTAL_URL=http://localhost:3002
NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=pm.recoder.xyz

# Admin organization ID (used to identify admin context)
RECODER_PM_ADMIN_ORGANIZATION_ID=local-dev-admin-org

# Optional: admin widget ID
# RECODER_PM_ADMIN_WIDGET_ID=

# =============================================================================
# AUTH — BETTER AUTH [REQUIRED]
# =============================================================================

# MUST match the secret used by recoder-app and recoder-agency for cross-subdomain SSO
BETTER_AUTH_SECRET=your-better-auth-secret-minimum-32-characters
BETTER_AUTH_URL=https://recoder.xyz

# Shared auth database — points to recoder-app's Neon Postgres
# This MUST be the app's database, not PM's own database
AUTH_DATABASE_URL=postgresql://user:password@auth-host:5432/authdb?sslmode=require

# =============================================================================
# DATABASE — NEON POSTGRESQL [REQUIRED]
# =============================================================================

# PM's own database (Drizzle/Prisma)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
POSTGRES_PRISMA_URL=postgresql://user:password@host:5432/dbname?sslmode=require&pgbouncer=true
POSTGRES_URL_NON_POOLING=postgresql://user:password@direct-host:5432/dbname?sslmode=require

# =============================================================================
# PAYMENTS — POLAR.SH
# =============================================================================

# POLAR_ACCESS_TOKEN=your-polar-access-token
# POLAR_WEBHOOK_SECRET=your-polar-webhook-secret
# POLAR_PRODUCT_PRO_ID=your-pro-product-id
# POLAR_PRODUCT_ENTERPRISE_ID=your-enterprise-product-id
# POLAR_SERVER=sandbox

# =============================================================================
# EMAIL — RESEND [REQUIRED]
# =============================================================================

# Resend API key (starts with re_)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM=Recoder PM <pm@recoder.xyz>

# Legacy key name used by email package
RESEND_TOKEN=re_your-resend-api-key

# General email sender
# EMAIL_FROM=noreply@recoder.xyz

# =============================================================================
# AI PROVIDERS
# =============================================================================

# Which AI provider to use: "openai", "openrouter", or "anthropic"
AI_PROVIDER=openrouter

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# OpenRouter (multi-model gateway)
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_TEXT_MODEL=claude-3.5-sonnet-latest

# Encryption secret for user-supplied AI keys (BYOK)
# AI_KEY_ENCRYPTION_SECRET=your-encryption-secret

# =============================================================================
# REDIS
# =============================================================================

REDIS_URL=redis://localhost:6379

# =============================================================================
# FILE STORAGE — MINIO (S3-COMPATIBLE)
# =============================================================================

# MinIO root credentials (only needed if running MinIO via docker-compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-production

# S3-compatible storage configuration
S3_ENDPOINT=http://minio:9000
S3_BUCKET=recoderpm
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-in-production
S3_PUBLIC_URL=https://storage.pm.recoder.xyz
S3_REGION=us-east-1

# =============================================================================
# GITHUB APP (optional — for GitHub integrations)
# =============================================================================

# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour-key\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_SLUG=your-github-app-slug

# =============================================================================
# OBSERVABILITY
# =============================================================================

# BetterStack (log management)
# BETTERSTACK_API_KEY=your-betterstack-key
# BETTERSTACK_URL=https://in.logs.betterstack.com

# Sentry (error tracking)
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/123

# PostHog (product analytics)
# NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-your-ga-id

# Logo.dev
# NEXT_PUBLIC_LOGO_DEV_API_KEY=your-logo-dev-key

# PostHog server-side
# POSTHOG_API_KEY=your-posthog-api-key

# =============================================================================
# A2A (AGENT-TO-AGENT) MESSAGING (optional — Redis Streams)
# =============================================================================

# RECODER_A2A_SHARED_SECRET=your-a2a-shared-secret
# RECODER_A2A_REDIS_URL=redis://:password@redis:6379/0
# RECODER_A2A_WORKER_TOKEN=your-worker-token
# RECODER_A2A_CONSUMER_SERVICE=recoder_pm
# RECODER_A2A_PLAN_HANDLER_URL=
# RECODER_A2A_EXECUTE_HANDLER_URL=
# RECODER_A2A_HANDOFF_HANDLER_URL=
# RECODER_A2A_TOOL_CALL_HANDLER_URL=
# RECODER_A2A_DEFAULT_HANDLER_URL=
# RECODER_A2A_EGRESS_ALLOWLIST=
# RECODER_A2A_ALLOWED_AGENTS=
# PM_API_PUBLIC_URL=https://pm.recoder.xyz/api

# =============================================================================
# WORKER (optional — background job processing)
# =============================================================================

# Health check port for background worker process
# WORKER_HEALTH_PORT=3006

# =============================================================================
# RUNTIME
# =============================================================================

NODE_ENV=development
PORT=3004
HOSTNAME=0.0.0.0

# Set to "1" when building inside Docker to skip env validation
# DOCKER=1

# Bundle analyzer
# ANALYZE=false
