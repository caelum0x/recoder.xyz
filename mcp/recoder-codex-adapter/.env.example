# Recoder Codex Adapter
#
# Safe local defaults are allowed for Recoder API URLs. Production or remote
# Recoder calls require RECODER_API_TOKEN unless explicitly opting into local
# unauthenticated development.

RECODER_DOCKER_URL=http://127.0.0.1:3002
RECODER_API_URL=http://127.0.0.1:3001
RECODER_API_TOKEN=

# Optional HMAC signing for Recoder A2A ingress.
RECODER_A2A_SIGNING_SECRET=

# Local development only. Do not enable for remote/prod URLs.
RECODER_ALLOW_UNAUTHENTICATED_LOCAL=false

# Required only for recoder_sandbox_run.
# Do not ship a real Daytona IP or production URL as a default.
RECODER_DAYTONA_URL=
DAYTONA_API_KEY=

# Optional request timeout for adapter fetches.
RECODER_MCP_TIMEOUT_MS=30000
