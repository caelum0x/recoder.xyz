    },
    "@recoder/opencode-core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@recoder/opencode-app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@recoder/opencode-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@recoder/opencode-session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
