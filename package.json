{
  "name": "recoder",
  "version": "1.0.0",
  "description": "AI-powered development platform with production-ready code generation",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "setup": "node scripts/setup-manual.js",
    "setup:full": "node scripts/setup.js",
    "setup:husky": "husky install",
    "setup:env": "cp .env.example .env || copy .env.example .env",
    "install:all": "pnpm install --recursive",
    "install:root": "pnpm install",
    "install:core": "pnpm run install:engine",
    "install:platforms": "npm-run-all --parallel install:mobile install:desktop",
    "install:engine": "cd docker-backend && pnpm install",
    "install:extension": "cd apps/desktop && npm ci",
    "install:mobile": "cd apps/mobile && pnpm install",
    "install:desktop": "cd apps/desktop && npm ci",
    "build": "pnpm run build:all",
    "build:all": "npm-run-all --parallel build:core build:platforms",
    "build:core": "pnpm run build:engine",
    "build:engine": "cd docker-backend && pnpm build",
    "build:agent-gateway": "pnpm --filter @recoder/agent-gateway build",
    "build:agent-worker": "pnpm --filter @recoder/agent-worker build",
    "build:agent-os": "pnpm --filter @recoder/agent-os build && pnpm --filter @recoder/agent-schemas build && pnpm --filter @recoder/agent-events build && pnpm --filter @recoder/agent-policy build && pnpm --filter @recoder/agent-memory build && pnpm --filter @recoder/agent-mcp build && pnpm --filter @recoder/agent-workflows build && pnpm --filter @recoder/agent-runtimes build && pnpm --filter @recoder/agent-oss build && pnpm --filter @recoder/beads-adapter build && pnpm --filter @recoder/recodergit build && pnpm --filter @recoder/pal build && pnpm --filter @recoder/oss-registry build && pnpm --filter @recoder/agent-sandbox build && pnpm --filter @recoder/browser-verification build && pnpm --filter @recoder/browser-tools build && pnpm --filter @recoder/ui-agent-os build && pnpm --filter @recoder/agent-observability build && pnpm run build:agent-gateway && pnpm run build:agent-worker",
    "build:extension": "cd apps/desktop && npm run build",
    "build:mobile": "cd apps/mobile && npx expo export -p web",
    "build:desktop": "cd apps/desktop && npm run build",
    "dev": "pnpm run dev:all",
    "dev:all": "concurrently \"pnpm run dev:engine\" \"pnpm run dev:mobile\" \"pnpm run dev:desktop\" --names \"engine,mobile,desktop\" --prefix-colors \"green,cyan,red\"",
    "dev:engine": "cd docker-backend && pnpm dev",
    "dev:agent-gateway": "pnpm --filter @recoder/agent-gateway dev",
    "dev:agent-worker": "pnpm --filter @recoder/agent-worker dev",
    "dev:agent-os": "concurrently \"pnpm run dev:engine\" \"pnpm run dev:agent-gateway\" \"pnpm run dev:agent-worker\" --names \"engine,agent-gateway,agent-worker\" --prefix-colors \"green,blue,magenta\"",
    "dev:mobile": "cd apps/mobile && pnpm dev",
    "dev:desktop": "cd apps/desktop && npm run start",
    "start": "pnpm run start:engine",
    "start:engine": "cd docker-backend && pnpm start",
    "herd": "pnpm --filter @recoder/herd build && node packages/herd/dist/cli.js",
    "herd:once": "pnpm --filter @recoder/herd build && node packages/herd/dist/cli.js --once",
    "test": "pnpm run test:all",
    "test:all": "npm-run-all --parallel test:core test:platforms",
    "test:coverage": "npm-run-all --parallel test:coverage:docker-backend",
    "test:coverage:docker-backend": "cd docker-backend && pnpm run test:coverage || echo 'docker-backend coverage not available'",
    "test:coverage:aggregate": "npm-run-all test:coverage coverage:aggregate",
    "test:core": "pnpm run test:engine",
    "test:platforms": "npm-run-all --parallel test:mobile test:desktop",
    "test:engine": "cd docker-backend && pnpm test",
    "test:extension": "cd apps/desktop && npm test",
    "test:mobile": "cd apps/mobile && pnpm run test --passWithNoTests",
    "test:desktop": "cd apps/desktop && npm test",
    "test:integration": "node scripts/test-cli.js",
    "test:full": "pnpm run build && pnpm run test:integration",
    "lint": "pnpm run lint:all",
    "lint:all": "npm-run-all --parallel lint:core lint:platforms",
    "lint:core": "pnpm run lint:engine",
    "lint:platforms": "npm-run-all --parallel lint:mobile lint:desktop",
    "lint:engine": "cd docker-backend && pnpm run ci:check",
    "lint:extension": "cd apps/desktop && npm run lint",
    "lint:mobile": "cd apps/mobile && pnpm run lint",
    "lint:desktop": "cd apps/desktop && npm run lint",
    "lint:fix": "pnpm run lint:all -- --fix",
    "typecheck": "pnpm run typecheck:all",
    "typecheck:all": "npm-run-all --parallel typecheck:core typecheck:platforms",
    "typecheck:core": "pnpm run typecheck:engine",
    "typecheck:platforms": "npm-run-all --parallel typecheck:mobile typecheck:desktop",
    "typecheck:engine": "cd docker-backend && pnpm run ci:check",
    "typecheck:extension": "cd apps/desktop && npm run lint",
    "typecheck:mobile": "cd apps/mobile && pnpm run typecheck",
    "typecheck:desktop": "cd apps/desktop && npm run lint",
    "clean": "pnpm run clean:all",
    "clean:all": "rimraf node_modules recoder-*/node_modules recoder-*/dist recoder-*/.next",
    "clean:cache": "rimraf .nx recoder-*/.nx .turbo recoder-*/.turbo",
    "clean:deps": "rimraf node_modules recoder-*/node_modules",
    "clean:build": "rimraf recoder-*/dist recoder-*/.next",
    "validate": "pnpm run validate:all",
    "validate:all": "npm-run-all validate:env validate:deps validate:build validate:test",
    "validate:env": "echo 'Checking environment configuration...'",
    "validate:deps": "pnpm run install:all",
    "validate:build": "pnpm run build:all",
    "validate:test": "pnpm run test:all",
    "production": "pnpm run production:all",
    "production:all": "npm-run-all clean validate production:build production:package",
    "production:build": "NODE_ENV=production pnpm run build:all",
    "production:package": "npm-run-all production:package:extension production:package:docker",
    "production:package:extension": "echo 'Deprecated: extension packaging is not configured in this repo'",
    "production:package:docker": "docker-compose build",
    "format": "prettier --write . || echo 'Prettier not configured'",
    "format:check": "prettier --check . || echo 'Prettier not configured'",
    "check-types": "pnpm run typecheck",
    "agent:instructions:check": "node --experimental-strip-types scripts/check-agent-instructions.ts",
    "agent:instructions:sample": "pnpm exec tsx scripts/compile-agent-instruction-sample.ts",
    "agent-os:gateway": "pnpm --filter @recoder/agent-gateway dev",
    "agent-os:worker": "pnpm --filter @recoder/agent-worker dev",
    "agent-os:smoke": "pnpm exec tsx scripts/agent-os-smoke.ts",
    "agent-os:schemas": "pnpm exec tsx scripts/generate-agent-schemas.ts",
    "oss:health": "pnpm exec tsx scripts/oss-stack-health.ts",
    "a2a:smoke": "pnpm exec tsx scripts/a2a-smoke.ts",
    "mcp:smoke": "pnpm exec tsx scripts/mcp-smoke.ts",
    "runtime-adapter:verify": "pnpm exec tsx scripts/verify-runtime-adapter.ts",
    "beads:sync": "pnpm exec tsx scripts/beads-sync.ts",
    "beads:task:create": "pnpm exec tsx scripts/beads-task-create.ts",
    "beads:task:status": "pnpm exec tsx scripts/beads-task-status.ts",
    "test:contracts:agent-os": "node --import tsx --test tests/contracts/agent-os/*.test.ts",
    "test:evals:agent-os": "node --import tsx --test tests/evals/agent-os/*.test.ts",
    "link:cli": "echo 'CLI is published package - install with: npm install -g recoder-cli'",
    "unlink:cli": "echo 'CLI is published package - uninstall with: npm uninstall -g recoder-cli'",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:dev": "docker-compose -f docker-compose.yml up -d postgres redis",
    "health": "node scripts/health-check.js",
    "health:backend": "curl -f http://localhost:3001/health || echo 'Backend not running'",
    "health:engine": "curl -f http://localhost:3002/health || echo 'Engine not running'",
    "sync:internal-service-key": "bash scripts/sync-internal-service-key.sh",
    "check:phase1-env": "bash scripts/check-phase1-env-consistency.sh",
    "smoke:phase1": "bash scripts/phase1-main-branch-smoke.sh",
    "smoke:a2a:production": "bash scripts/a2a-production-smoke.sh",
    "af:preflight": "bash scripts/af-networked-preflight.sh",
    "af:networked": "bash scripts/af-networked-runner.sh",
    "af:sync-docs": "bash scripts/af-sync-status-docs.sh",
    "af:handoff": "bash scripts/af-networked-handoff.sh",
    "closeout:hetzner": "bash scripts/hetzner-prod-closeout.sh",
    "release:evidence": "bash scripts/a5-release-evidence.sh",
    "phase3:gates": "bash scripts/phase3-production-gates.sh",
    "phase3:gates:dry": "DRY_RUN=true PHASE3_MODE=local-dev bash scripts/phase3-production-gates.sh",
    "phase3:gates:dev": "SKIP_ENV_GATES=true SKIP_TYPECHECK_GATES=true PHASE3_MODE=local-dev bash scripts/phase3-production-gates.sh",
    "phase3:assert-ga-ready": "bash scripts/check-phase3-ga-ready.sh",
    "phase3:connectors-status": "bash scripts/phase3-connectors-status.sh",
    "phase3:publish-support-status": "node tools/a2a-interop/js/publish-tier1-support-status.mjs",
    "p15:tier1:publish": "bash scripts/p15-tier1-status-autopublish.sh publish",
    "p15:tier1:check": "bash scripts/p15-tier1-status-autopublish.sh check",
    "p15:tier1:dry-run": "bash scripts/p15-tier1-status-autopublish.sh dry-run",
    "phase3:assert-tier1-support-status": "bash scripts/check-tier1-support-status.sh",
    "phase3:evidence-pack": "bash scripts/phase3-evidence-pack.sh",
    "phase3:tier2:gate": "bash scripts/check-tier2-promotion.sh",
    "phase3:tier2:assert": "ASSERT_TIER2_PROMOTABLE=true bash scripts/check-tier2-promotion.sh",
    "phase3:tier2:workflow:status": "node tools/a2a-interop/js/tier2-promotion-workflow.mjs status",
    "phase3:tier2:workflow:validate": "node tools/a2a-interop/js/tier2-promotion-workflow.mjs validate --connector cursor --to pilot",
    "test:tier2:validator": "node --test tools/a2a-interop/js/__tests__/validate-tier2-promotion.test.mjs",
    "test:tier1:publisher": "node --test tools/a2a-interop/js/__tests__/publish-tier1-support-status.test.mjs",
    "test:tier2:workflow": "node --test tools/a2a-interop/js/__tests__/tier2-promotion-workflow.test.mjs",
    "test:skill": "node --test tests/recoder-skill-smoke.test.mjs",
    "phase3:dispatch-signoff": "bash scripts/phase3-dispatch-signoff.sh",
    "phase3:preflight": "bash scripts/phase3-preflight.sh",
    "phase3:bootstrap-a2a-env": "bash scripts/phase3-bootstrap-a2a-env.sh",
    "phase3:closeout": "bash scripts/phase3-closeout.sh",
    "phase3:closeout:dev": "PHASE3_MODE=local-dev DRY_RUN=true SKIP_ENV_GATES=true SKIP_TYPECHECK_GATES=true ENABLE_A2A_INTEROP_SMOKE=false A2A_WORKER_STATUS_CHECK=false ASSERT_GA_READY=false ALLOW_NON_GA=true bash scripts/phase3-closeout.sh",
    "phase16:validate:production-deploy": "bash scripts/phase16-production-validation.sh",
    "phase16:validate:tier1-real-process": "bash scripts/phase16-tier1-real-process-validation.sh",
    "phase3:next-blockers": "bash scripts/phase3-next-blockers.sh",
    "generate:secrets": "bash scripts/generate-ecosystem-secrets.sh",
    "apply:secrets": "bash scripts/apply-ecosystem-secrets.sh",
    "set:prod-vars": "bash scripts/set-production-vars.sh",
    "check:prod-env-gate": "bash scripts/check-production-env-gate.sh",
    "check:prod-env-missing": "bash scripts/print-production-env-missing.sh",
    "check:desktop-release-readiness": "bash scripts/check-desktop-release-readiness.sh",
    "verify:desktop-release": "bash scripts/verify-desktop-release.sh",
    "set:desktop-release-secrets": "bash scripts/set-desktop-release-secrets.sh",
    "closeout:desktop-release": "bash scripts/desktop-release-closeout.sh",
    "check:plan-evidence": "bash scripts/check-plan-evidence.sh",
    "check:eval-gate": "node scripts/check-eval-gate.js",
    "eval:harness": "node scripts/run-eval-benchmark.js",
    "eval:composer-prepare": "node scripts/prepare-composer-results.js",
    "eval:composer-score": "node scripts/score-composer-dataset.js",
    "check:composer-inbox": "node scripts/check-composer-inbox.js",
    "check:ecosystem": "bash scripts/check-ecosystem-readiness.sh",
    "check:ecosystem:local": "bash scripts/check-ecosystem-readiness.sh --local-dev",
    "check:local-dev-stack": "bash scripts/check-local-dev-stack.sh",
    "agents:continuous": "bash scripts/agents-continuous-workflow.sh --mode local-dev --cycles 1",
    "agents:continuous:extended": "bash scripts/agents-continuous-workflow.sh --mode local-dev --cycles 1 --extended",
    "agents:continuous:loop": "bash scripts/agents-continuous-workflow.sh --mode local-dev --cycles 0 --sleep 120",
    "agents:continuous:loop:extended": "bash scripts/agents-continuous-workflow.sh --mode local-dev --cycles 0 --sleep 120 --extended",
    "deploy": "npm run build && npm run test && docker-compose up -d",
    "postinstall": "echo 'Run npm run setup for full setup'",
    "precommit": "lint-staged || echo 'Lint-staged not configured'",
    "prepare": "echo 'Husky setup skipped'",
    "a2a:smoke:codex-claude": "node tools/a2a-interop/js/codex-claude-http-smoke.mjs",
    "a2a:bridge:start": "node tools/a2a-interop/js/recoder-a2a-bridge.mjs",
    "issues:sfa:dry": "node tools/a2a-interop/js/create-sfa-github-issues.mjs --dry-run",
    "issues:sfa:create": "node tools/a2a-interop/js/create-sfa-github-issues.mjs --create",
    "issues:sfa:metadata": "node tools/a2a-interop/js/apply-sfa-issue-metadata.mjs",
    "project:sfa:dry": "node tools/a2a-interop/js/setup-sfa-project.mjs --dry-run",
    "project:sfa:apply": "node tools/a2a-interop/js/setup-sfa-project.mjs --apply",
    "connectors:tier2:validate": "node tools/a2a-interop/js/validate-tier2-promotion.mjs --all",
    "connectors:tier2:assert": "node tools/a2a-interop/js/validate-tier2-promotion.mjs --all --assert-promotable",
    "evidence:pack": "node tools/a2a-interop/js/generate-evidence-pack.mjs",
    "evidence:pack:30d": "node tools/a2a-interop/js/generate-evidence-pack.mjs --period-days 30",
    "test:load": "k6 run tests/load/smoke.k6.js",
    "test:load:health": "k6 run tests/load/health.k6.js",
    "test:load:full": "k6 run tests/load/api.k6.js",
    "test:load:stress": "k6 run tests/load/auth.k6.js",
    "test:load:all": "k6 run tests/load/smoke.k6.js && k6 run tests/load/health.k6.js && k6 run tests/load/api.k6.js && k6 run tests/load/auth.k6.js",
    "coverage:aggregate": "node scripts/aggregate-coverage.mjs",
    "changelog:weekly": "node scripts/generate-weekly-changelog.mjs",
    "changelog": "npx tsx scripts/generate-changelog.ts",
    "build:platforms": "npm-run-all --parallel build:mobile build:desktop",
    "audit:deps:security": "node scripts/audit-dependency-security.mjs"
  },
