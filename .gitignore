# Exceptions: legitimate source files whose names contain "secret"/"token" but
# carry no credential material. These must stay in version control or builds
# break on a fresh checkout. (Broader cleanup tracked in beads.)
!packages/agent-policy/src/rules/secret-access.ts
*password*
*passwd*

# Allow-list: security tooling that has "secret" in its filename by design.
# Without these negations, .gitignore's *secret*/*token* rules hide the
# scanners themselves and they never propagate to other machines.
!scripts/scan-secrets-strict.sh
!scripts/scan-secrets.sh
!scripts/secret-scan-allowlist.regex
!scripts/detect-tokens*.sh
!.husky/pre-commit

# Keep legitimate source files that include "token" in their names.
!recoder-web/app/lib/hooks/useTokenCount.ts
!recoder-web/app/**/*.ts
!recoder-web/app/**/*.tsx
!packages/design-tokens/
!packages/design-tokens/**

# === recoder-0n1f: re-include credential-free first-party source hidden by the
# broad *secret*/*token*/*password*/*apikey*/*api-key*/*api_key* rules above.
# Every path was scanned and verified to contain no credential material (test
# fixtures + tokenizer doc-sample corpus only). Real secret-bearing files (.env*,
# *.pem, *.key, credentials.json, service-account*.json, deploy-secrets,
# docker-backend/data/*.json) keep their dedicated ignore rules elsewhere.
# Bracketed Next.js route segments are escaped so gitignore treats them literally.
#
# Step 1: re-include directory entries whose NAME carries a trigger substring so
# files beneath them become reachable again.
!app/app/\[locale\]/auth/forgot-password/
!app/app/\[locale\]/auth/reset-password/
!app/app/\[locale\]/dashboard/api-keys/
!app/app/\[locale\]/docs/api-keys/
!app/app/\[locale\]/onboarding/setup-api-key/
!app/app/\[locale\]/settings/api-keys/
!internal-packages/workflow-designer-ui/src/editor/secret/
!packages/giselle/src/secrets/
!packages/protocol/src/secret/
!packages/pseudo-tiktoken/
!recoder-agency/apps/agency/app/(auth)/join/\[token\]/
!recoder-agency/apps/agency/app/(auth)/password_reset/
!recoder-agency/apps/agency/app/(auth)/password_reset/new_password/
!recoder-agency/apps/agency/app/(main)/manage/api-keys/
!recoder-agency/apps/agency/app/(main)/settings/team/api-keys/
!recoder-agency/apps/agency/app/client-portal/join/\[token\]/
!recoder-agency/apps/agency/lib/api-keys/
!recoder-agency/internal-packages/workflow-designer-ui/src/editor/secret/
!recoder-agency/packages/giselle/src/secrets/
!recoder-agency/packages/protocol/src/secret/
!recoder-agency/packages/pseudo-tiktoken/
!recoder-agents/src/app/(dashboard)/agents/secrets/
!recoder-agents/src/app/(dashboard)/settings/api-keys/
!recoder-agents/src/app/auth/password/
!recoder-agents/src/app/auth/reset-password/
!recoder-pm/apps/api/app/cron/atlassian/token/
!recoder-pm/apps/app/actions/api-key/

# Step 2: re-include whole subtrees for the pseudo-tiktoken package and the
# Next.js [token] route trees (their contents are themselves trigger-named).
!packages/pseudo-tiktoken/**
!recoder-agency/packages/pseudo-tiktoken/**
!recoder-agency/apps/agency/app/(auth)/join/\[token\]/**
!recoder-agency/apps/agency/app/client-portal/join/\[token\]/**

# Step 2b: but keep dependencies and build output out of those re-included subtrees.
packages/pseudo-tiktoken/**/node_modules/
packages/pseudo-tiktoken/**/dist/
packages/pseudo-tiktoken/**/.turbo/
recoder-agency/packages/pseudo-tiktoken/**/node_modules/
recoder-agency/packages/pseudo-tiktoken/**/dist/
recoder-agency/packages/pseudo-tiktoken/**/.turbo/

