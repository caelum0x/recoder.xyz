#!/bin/bash

# Fresh Start Script Template
# Instructions:
# 1. Copy this to fresh-start.sh
# 2. Source your environment variables: source .env.server

if [ -z "$SERVER_IP" ] || [ -z "$SERVER_PASS" ]; then
    echo "❌ Error: SERVER_IP and SERVER_PASS environment variables must be set"
    exit 1
fi

echo "🔄 Starting fresh deployment to: $SERVER_IP"

sshpass -p "$SERVER_PASS" ssh -o StrictHostKeyChecking=no root@$SERVER_IP << 'EOF'
echo "🧹 Cleaning up processes..."
pkill -f "next"
pkill -f "node"
pm2 kill

echo "📁 Removing old files..."
rm -rf /home/recoder/recoder.xyz/app/.next
rm -rf /home/recoder/recoder.xyz/recoder-web/.next

echo "🎯 Starting applications..."
cd /home/recoder/recoder.xyz && pm2 start ecosystem.config.js
EOF

echo "✅ Fresh start completed"
