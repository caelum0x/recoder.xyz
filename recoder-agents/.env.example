NEXT_PUBLIC_ENV_MODE="staging" #production, or staging
NEXT_PUBLIC_DISABLE_MOBILE_ADVERTISING="true"

# Auth (Better Auth — session via recoder.session_token cookie on .recoder.xyz)
# better-auth is configured in @recoder/auth and instantiated in src/lib/auth.ts
# No Supabase, no NextAuth — only better-auth.
BETTER_AUTH_SECRET="recoderxyz2024supersecretkey_change_this_in_production_minimum_32chars"
BETTER_AUTH_URL="http://localhost:3000"

NEXT_PUBLIC_BACKEND_URL="http://localhost:8000/v1"
NEXT_PUBLIC_DOCKER_BACKEND_URL="http://localhost:3001"

NEXT_PUBLIC_URL="http://localhost:3000"

NEXT_PUBLIC_GOOGLE_CLIENT_ID="placeholder-google-client-id"
NEXT_PUBLIC_POSTHOG_KEY=""
RECODER_ADMIN_API_KEY=""

EDGE_CONFIG="https://edge-config.vercel.com/REDACTED?token=REDACTED"

NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA_ID_1=""
NEXT_PUBLIC_GA_ID_2=""
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=""

NEXT_PUBLIC_FORCE_LOCALHOST="true"
